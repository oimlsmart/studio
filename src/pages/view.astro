---
import Site from '../layouts/Site.astro'
---

<Site title="SMART Studio — the viewer" description="The read-only viewer over the published OIML SMART models: the tree, canvas, code, mapping lenses, diff and validation — no editing surface.">
  <div id="editor-root"></div>
  <script type="module">
    import { mount } from '@primmel/editor'
    const params = new URLSearchParams(location.search)
    const model = params.get('model') || '/studio/models/oiml-r60.prl'
    let initialText
    try {
      const res = await fetch(model)
      if (res.ok) initialText = await res.text()
      else console.warn('Model fetch returned', res.status, model)
    } catch (e) {
      console.error('Failed to load model', model, e)
    }
    // The viewer is the editor's readOnly mount: the store refuses every
    // mutation and the editing chrome hides; the tree, canvas, code,
    // mapping lenses, diff and validation stay.
    mount(document.getElementById('editor-root'), {
      initialText,
      readOnly: true,
      brand: {
        name: 'OIML SMART',
        sub: 'VIEWER',
        logoUrl: '/img/components/smart-studio-light.svg',
      },
    })
  </script>
</Site>
