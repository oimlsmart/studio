---
import { Base, MinisiteNav, PageHero } from '@oimlsmart/site-shell'
import '../styles/app.css'

const NAV = [
  { label: 'About', href: '/' },
  { label: 'Story', href: '/story' },
  { label: 'Docs', href: '/docs' },
  { label: 'Demo', href: '/demo' },
]
---

<Base title="SMART Studio" description="OIML SMART Studio — the tool for viewing and authoring SMART Recommendations.">
  <MinisiteNav sections={NAV} base="/studio" />
  <main class="max-w-4xl mx-auto px-6 py-14">
    <PageHero
      eyebrow="OIML SMART · Component 2"
      title="SMART Studio"
      lede="The canvas where an expert models a Recommendation and the model itself is the published artifact — versioned, validated, and citable back to the source document."
      logo={{ name: 'smart-studio', alt: 'The SMART Studio logo.' }}
    />
    <section class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="border border-rule rounded-lg p-6 bg-paper-raised">
        <h2 class="font-serif text-lg font-semibold text-ink mb-2">The model canvas</h2>
        <p class="text-sm text-ink-soft leading-relaxed">A Recommendation is authored as a graph: subjects, attributes, processes, and mappings, drawn and connected directly. Reference and implementation models compose in layers.</p>
      </div>
      <div class="border border-rule rounded-lg p-6 bg-paper-raised">
        <h2 class="font-serif text-lg font-semibold text-ink mb-2">Inspectors</h2>
        <p class="text-sm text-ink-soft leading-relaxed">Every node carries its properties, constraints, and provenance in a structured inspector, validated as it is edited — schema, semantics, and the drift guards that keep a published model honest.</p>
      </div>
      <div class="border border-rule rounded-lg p-6 bg-paper-raised">
        <h2 class="font-serif text-lg font-semibold text-ink mb-2">The document map</h2>
        <p class="text-sm text-ink-soft leading-relaxed">Each model element cites its clause in the source publication, so the model reads against the document line by line. Nothing enters the model without provenance.</p>
      </div>
      <div class="border border-rule rounded-lg p-6 bg-paper-raised">
        <h2 class="font-serif text-lg font-semibold text-ink mb-2">Validation</h2>
        <p class="text-sm text-ink-soft leading-relaxed">The package is checked as it is built: primmel check over schema, references, layering, and constraints, with diagnostics at the node that broke the rule.</p>
      </div>
    </section>
    <p class="mt-10 text-sm"><a href="/studio/docs/" class="text-accent font-medium">Read the Studio guides →</a></p>
  </main>
</Base>
