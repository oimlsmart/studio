metadata {
  title ""
  schema ""
  edition ""
  author ""
  namespace ""
}

role applicant {
  name ""
  label "Applicant"
  description "Manufacturer or authorized representative submitting the type evaluation application"
}
role manufacturer {
  name ""
  label "Manufacturer"
  description "Company that produces the measuring instrument"
}
role issuing_authority {
  name ""
  label "Issuing Authority"
  description "OIML Issuing Authority that conducts type evaluation and issues certificates"
}
role test_laboratory {
  name ""
  label "Test Laboratory"
  description "Independent test laboratory performing tests on behalf of an IA"
}
role manufacturer_test_laboratory {
  name ""
  label "Manufacturer Test Laboratory"
  description "Manufacturer's own test lab, listed in IA declaration (Scheme A, PD-05 §5.3.1 b)"
}
role evaluator {
  name ""
  label "Evaluator"
  description "Person performing the test or evaluation"
}
role supervisor {
  name ""
  label "Supervisor"
  description "Supervising evaluator who reviews and approves evaluation results"
}
role test_operator {
  name ""
  label "Test Operator"
  description "Person conducting individual test steps"
}
role biml {
  name ""
  label "BIML"
  description "Bureau International de Métrologie Légale — registers certificates"
}
role executive_secretary {
  name ""
  label "Executive Secretary"
  description "The OIML-CS Executive Secretary (BIML) — receives appeals/complaints/misuse evidence and administers the scheme (PD-01, PD-06; B 18:2025 §10.2)"
}
role utilizer {
  name ""
  label "Utilizer"
  description "National issuing authority of an OIML Member State accepting OIML certificates/reports (B 18:2025 §5.6.1); Associates act through the same acceptance role (§5.6.2)"
}
role responsible_person_ia {
  name ""
  label "Responsible Person (IA)"
  description "Authorized signatory at the Issuing Authority"
}
role responsible_person_tl {
  name ""
  label "Responsible Person (TL)"
  description "Authorized signatory at the Test Laboratory"
}
process submit_application {
  name ""
  actor applicant
}
process review_application {
  name ""
  actor issuing_authority
  validate_provision {
    /req/cs/application-completeness
  }
}
process accept_application {
  name ""
  actor issuing_authority
  validate_provision {
    /req/cs/fee-estimate
    /req/cs/sample-count
  }
}
process reject_application {
  name ""
  actor issuing_authority
  validate_provision {
    /req/cs/rejection-reason
  }
}
process conduct_tests {
  name ""
  actor test_laboratory
  validate_provision {
    /req/metrological/mpe
    /req/metrological/repeatability
    /req/metrological/temperature-effect-mdlo
    /req/metrological/creep
    /req/metrological/dr
    /req/metrological/barometric-pressure
    /req/metrological/humidity-ch
    /req/metrological/humidity-sh
  }
}
process compile_test_report {
  name ""
  actor test_laboratory
  validate_provision {
    /req/cs/test-report-18-elements
  }
}
process compile_evaluation_report {
  name ""
  actor issuing_authority
  validate_provision {
    /req/cs/evaluation-report-contents
  }
}
process issue_certificate {
  name ""
  actor issuing_authority
  validate_provision {
    /req/cs/certificate-requirements
  }
}
process register_certificate {
  name ""
  actor biml
  validate_provision {
    /req/cs/biml-registration
  }
}
process handle_revision {
  name ""
  actor issuing_authority
}
process handle_edition_change {
  name ""
  actor issuing_authority
}
process evaluate_certificate_acceptance {
  name ""
  actor utilizer
}
process handle_appeal {
  name ""
  actor executive_secretary
}
process handle_complaint {
  name ""
  actor executive_secretary
}
process handle_misuse {
  name ""
  actor executive_secretary
}
process deregister_certificate {
  name ""
  actor biml
}
process verify_presented_certificate {
  name ""
  actor biml
}
process submit_participant_application {
  name ""
  actor applicant
}
process assess_participant_competence {
  name ""
  actor executive_secretary
}
process recommend_participation {
  name ""
  actor evaluator
}
process decide_participation {
  name ""
  actor supervisor
}
process record_participant_declaration {
  name ""
  actor executive_secretary
}
process publish_participant_register {
  name ""
  actor executive_secretary
}
process drive_scheme_lifecycle {
  name ""
  actor biml
}
process application {
  name ""
  actor applicant
  validate_provision {
    applicant_info
    model_family_matrix
    documentation
  }
}
process test-request-dispatch {
  name ""
  validate_provision {
    Application
    MeasuringInstrumentSample
    TestLaboratory
  }
}
process test-performance {
  name ""
  validate_provision {
    TestRequest
    MeasuringInstrumentSample
  }
}
process evaluation {
  name ""
  validate_provision {
    TestReport
    FormInstance
  }
}
process certificate-issuance {
  name ""
  validate_provision {
    EvaluationReport
    Application.model_family_id
  }
}
process load_weight {
  name "Load weighing — the load cell's measurement behavior (R 60-1, 4 Figure 2): force introduction, force conversion (strain gauges), passive analogue linearization, active analogue amplification, A/D conversion, digital filtering, digital scaling, then the overload decision against the safe load limit E_lim (R 60-1, 3.5.16; E_lim/E_max = 150 % typical, R 60-A). The executable anatomy of behavior load_weight (model/behaviors.prl) — the process id names the behavior it realizes."
  signature {
    in { applied_load : mass e_lim : mass }
    out { indication : mass last_indication : mass load_count : count }
  }
  invariants {
    "ocl{self.applied_load >= 0 and self.applied_load <= self.e_lim}"
  }
  executor machine
  registers { raw_signal : voltage = 0 V linearized_signal : voltage = 0 V amplified_signal : voltage = 0 V raw_counts : count = 0 filtered_counts : count = 0 overload_flag : dimensionless = false last_indication : mass = 0 kg load_count : count = 0 }
  does {
    start_event applied
    action transduce { executor machine read { applied_load } write { raw_signal } description "Force conversion (R 60-1, 4 Figure 2 block 2): the sensing element (e.g. strain gauges, 3.3) transduces the applied load into an analogue signal — the load cell is a measuring transducer (3.1)." }
    action linearize { executor machine read { raw_signal } write { linearized_signal } description "Passive analogue signal processing — linearization (R 60-1, 4 Figure 2 block 3)." }
    action amplify { executor machine read { linearized_signal } write { amplified_signal } description "Active analogue signal processing — amplification (R 60-1, 4 Figure 2 block 4; the analogue-active load cell, 3.1.3.2)." }
    action digitize { executor machine read { amplified_signal } write { raw_counts } description "Analogue/digital conversion (R 60-1, 4 Figure 2 block 5): the digital raw values (counts) of Figure 1 — the digital load cell, 3.1.3.3." }
    action filter { executor machine read { raw_counts } write { filtered_counts } description "Digital signal filtering (R 60-1, 4 names signal filtering a constituent function of the instrument); R 60 does not order it within the digital stage — placed between conversion and scaling." }
    action scale { executor machine calls scale_indication { with { in { filtered_counts : filtered_counts e_lim : e_lim } out { indication : indication overload_flag : overload_flag } } } description "Digital data processing (R 60-1, 4 Figure 2 block 6; Figure 1): scaling to the weighing value in mass units, with the safe-load comparison — the further data processing of 3.1.3.4." }
    gateway overload_check
    action deliver { executor machine read { indication } write { last_indication load_count } description "The indication is delivered as the process output; the state slots thread through (last_indication, load_count are the HAS state after the run)." }
    end_event delivered
    end_event refused
    flow {
      applied -> transduce
      transduce -> linearize
      linearize -> amplify
      amplify -> digitize
      digitize -> filter
      filter -> scale
      scale -> overload_check
      overload_check -> refused { when "ocl{self.overload_flag = 1}" }
      overload_check -> deliver
      deliver -> delivered
    }
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-2.3"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.16"
}
process scale_indication {
  name "Digital scaling (R 60-1, 4 Figure 2 block 6; the further data processing of 3.1.3.4): filtered counts are scaled to the weighing value in mass units (Figure 1), and the safe-load flag is raised when the indication exceeds E_lim (3.5.16). Abstract form — the declaration a calls step binds (C76); the executable refinement is a named follow-up."
  signature {
    in { filtered_counts : count e_lim : mass }
    out { indication : mass overload_flag : dimensionless }
  }
  invariants {
    "ocl{self.overload_flag = 1 implies self.indication > self.e_lim}"
  }
  executor machine
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-2.3"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.16"
}
class Application#data {
  store { applications }
  indexes { manufacturer_id status standard_id model_family_id }
  id: string {
    definition ""
    modality SHALL
  }
  standard_id: string {
    definition ""
    modality SHALL
  }
  application_number: string {
    definition ""
    modality SHALL
  }
  date_of_application: date {
    definition ""
    modality SHALL
  }
  status: enum {
    definition "Includes sample-receipt steps per TODO.UPGRADE/01 and the ia_requests_changes/applicant_resubmits loop (CHANGES_REQUESTED) per state-machines.yaml"
    modality SHALL
    enum_values { DRAFT SUBMITTED SAMPLES_REQUESTED SAMPLES_RECEIVED UNDER_REVIEW CHANGES_REQUESTED ACCEPTED REJECTED WITHDRAWN }
  }
  model_family_id: reference(MeasuringInstrumentModelFamily)[0..1] {
    definition "The instrument family this application covers (matrix model)"
    modality MAY
    on_delete restrict
    required false
  }
  model_ids: reference(MeasuringInstrumentModel)[0..*] {
    definition "In-scope matrix members the applicant declares"
    modality MAY
    on_delete nullify
    required false
  }
  sample_ids: reference(MeasuringInstrumentSample)[0..*] {
    definition "Physical samples logged against this application"
    modality MAY
    on_delete nullify
    required false
  }
  applicant: reference(ApplicantInfo) {
    definition ""
    modality SHALL
  }
  authorised_representative: reference(AuthorisedRep)[0..1] {
    definition ""
    modality MAY
  }
  no_concurrent_application: boolean[0..1] {
    definition ""
    modality MAY
  }
  instrument_id: reference(MeasuringInstrumentModel)[0..1] {
    definition "DEPRECATED — legacy single-model link (was required pre-matrix). Use model_family_id + model_ids."
    modality MAY
    on_delete restrict
    deprecated true
    required false
  }
  manufacturer_id: reference(Manufacturer) {
    definition ""
    modality SHALL
    on_delete restrict
    required true
  }
  model: string[0..1] {
    definition "DEPRECATED — legacy model name string. Use model_ids / MeasuringInstrumentModel.model_designation."
    modality MAY
    deprecated true
  }
  type_designation: string[0..1] {
    definition ""
    modality MAY
  }
  description: text[0..1] {
    definition ""
    modality MAY
  }
  operation_description: text[0..1] {
    definition ""
    modality MAY
  }
  dimensions: object[0..1] {
    definition "DEPRECATED — legacy free-form dimension selections. Dimensions now live on the subject chain classification maps."
    modality MAY
    deprecated true
  }
  manufacturer_documentation: reference(DocumentRef)[0..*] {
    definition ""
    modality MAY
  }
  sample_information: reference(SampleInfo)[0..1] {
    definition ""
    modality MAY
  }
  sample_request: reference(SampleRequest)[0..1] {
    definition "The IA's outstanding or answered sample request (PD-05 §4.3) — recorded when the application enters SAMPLES_REQUESTED; the applicant ships against it (manufacturer_ships per sample), receipt is logged by the receiver"
    modality MAY
  }
  previous_test_reports: reference(PreviousTestReportRef)[0..*] {
    definition "Previous evaluation reports for abbreviated testing (PD-05 §4.3.3)"
    modality MAY
  }
  scheme: enum[0..1] {
    definition ""
    modality MAY
    enum_values { A B }
  }
  issuing_authority_id: reference(IssuingAuthority)[0..1] {
    definition ""
    modality MAY
    on_delete nullify
    required false
  }
  laboratory_id: reference(TestLaboratory)[0..1] {
    definition ""
    modality MAY
    on_delete nullify
    required false
  }
  anr_countries: string[][0..*] {
    definition ""
    modality MAY
  }
  applied_anrs: reference(AppliedAnr)[0..*] {
    definition "Scheme A (PD-05 §5.1.4): the additional national requirement tests the applicant applies for, on the basis of the ANRs listed in a Utilizer/Associate OIML-CS Declaration; discharged at evaluation (§5.3.2/§5.4.2) and validated by the IA's letter to the BIML (§5.6.3)."
    modality MAY
  }
  fee_acceptance: reference(FeeAcceptance)[0..1] {
    definition ""
    modality MAY
  }
  ia_review_result: reference(IAReviewResult)[0..1] {
    definition "IA review outcome per PD-05 §4.2"
    modality MAY
  }
  documentation: reference(ApplicationDocument)[1..*] {
    definition ""
    modality SHALL
  }
  submitted_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  reviewed_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  reviewer: string[0..1] {
    definition ""
    modality MAY
  }
  review_notes: text[0..1] {
    definition ""
    modality MAY
  }
  rejection_reason: text[0..1] {
    definition "Required if status is REJECTED (PD-05 §4.2.2)"
    modality MAY
  }
  test_report_id: reference(TestReport)[0..1] {
    definition ""
    modality MAY
    on_delete nullify
    required false
  }
  evaluation_report_id: reference(EvaluationReport)[0..1] {
    definition ""
    modality MAY
    on_delete nullify
    required false
  }
  certificate_id: reference(Certificate)[0..1] {
    definition ""
    modality MAY
    on_delete nullify
    required false
  }
  created: datetime {
    definition ""
    modality SHALL
  }
  modified: datetime {
    definition ""
    modality SHALL
  }
}
class RunEvaluation#data {
  description { "The IA's per-test-run evaluation mark (TODO.deploying/08 — finer grain than the TR determination): one run of one test report marked approve/reject with the evaluator's provenance. A rejected run's form instance is excluded from the TR determination's pass basis — the rejection is recorded with its reason, never silently dropped. Embedded on EvaluationReport.run_evaluations." }
  helper { true }
  test_run_id: reference(TestRun) {
    definition ""
    modality SHALL
    on_delete cascade
    required true
  }
  test_report_id: reference(TestReport) {
    definition "The TestReport the run belongs to (denormalized for query)"
    modality SHALL
    on_delete cascade
    required true
  }
  mark: enum {
    definition ""
    modality SHALL
    enum_values { approve reject }
  }
  comment: text[0..1] {
    definition "The rejection reason (required on reject); an optional note on approve"
    modality MAY
  }
  evaluated_by: string {
    definition "The IA evaluator (audit provenance)"
    modality SHALL
  }
  evaluated_at: datetime {
    definition ""
    modality SHALL
  }
}
class TestRequest#data {
  store { testRequests }
  description { "IA-issued request to a test laboratory. The atomic unit of test work is the TestAssignment (one per form × sample pair). The IA explicitly chooses which (form, sample) tuples each lab performs — different labs may be assigned different tests on the same model, or the same test on different samples. One Application typically produces multiple TestRequests (one per lab)." }
  indexes { application_id assigned_laboratory_id requesting_authority_id status test_report_id standard_id }
  id: string {
    definition ""
    modality SHALL
  }
  standard_id: string {
    definition ""
    modality SHALL
  }
  request_number: string {
    definition "Unique within the parent Application (e.g. 'TR-ACME-2024-001-01')"
    modality SHALL
  }
  application_id: reference(Application) {
    definition ""
    modality SHALL
    on_delete cascade
    required true
  }
  requesting_authority_id: reference(IssuingAuthority) {
    definition ""
    modality SHALL
    on_delete restrict
    required true
  }
  assigned_laboratory_id: reference(TestLaboratory) {
    definition ""
    modality SHALL
    on_delete restrict
    required true
  }
  assignments: reference(TestAssignment)[1..*] {
    definition "Explicit (form_id, sample_id) tuples this lab must perform. Replaces the cross-product of required_forms × sample_ids — the IA chooses precisely which tests on which samples go to this lab. Different labs can be assigned different subsets."
    modality SHALL
    on_delete cascade
  }
  sample_ids: reference(MeasuringInstrumentSample)[0..*] {
    definition "Derived from assignments[].sample_id (denormalized for query)"
    modality MAY
    on_delete nullify
    required false
  }
  required_forms: string[][0..*] {
    definition "Derived from assignments[].form_id (denormalized for query)"
    modality MAY
  }
  model_ids: reference(MeasuringInstrumentModel)[0..*] {
    definition "Derived from assignments[].model_id (denormalized)"
    modality MAY
    on_delete nullify
    required false
  }
  test_conditions: object {
    definition "Ambient conditions, schedule, special instructions"
    modality SHALL
  }
  test_program_id: string[0..1] {
    definition "Reference to a pre-defined test program (e.g. 'R60-full-class-C')"
    modality MAY
  }
  special_instructions: text[0..1] {
    definition ""
    modality MAY
  }
  anr_countries: string[][0..*] {
    definition "ANR countries (PD-05 §5.1.4) this request applies to"
    modality MAY
  }
  scheme: enum {
    definition "PD-05 §5.3 scheme (A = with MTL, B = independent lab only)"
    modality SHALL
    enum_values { A B }
  }
  includes_mtl: boolean[0..1] {
    definition "Scheme A: lab is the manufacturer's own lab (MTL)"
    modality MAY
  }
  status: enum {
    definition ""
    modality SHALL
    enum_values { DRAFT ISSUED ACCEPTED_BY_LAB IN_PROGRESS COMPLETED WITHDRAWN REJECTED_BY_LAB }
  }
  issued_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  accepted_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  started_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  completed_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  withdrawn_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  withdrawn_reason: text[0..1] {
    definition ""
    modality MAY
  }
  test_report_id: reference(TestReport)[0..1] {
    definition "Primary TestReport issued by the lab against this request"
    modality MAY
    on_delete nullify
    required false
  }
  parent_request_ids: reference(TestRequest)[0..*] {
    definition "For re-tests or amended requests, the prior request(s)"
    modality MAY
    on_delete nullify
    required false
  }
  issued_by: string {
    definition "IA staff member who issued the request"
    modality SHALL
  }
  accepted_by: string[0..1] {
    definition "Lab staff member who accepted the request"
    modality MAY
  }
  created: datetime {
    definition ""
    modality SHALL
  }
  modified: datetime {
    definition ""
    modality SHALL
  }
}
class TestAssignment#data {
  store { testAssignments }
  description { "The atomic unit of test work: one R 60-3 form performed on one sample (which belongs to one model). The IA explicitly creates these tuples when dispatching a TestRequest — different labs may receive different subsets of (form, sample) pairs even for the same Application. Each assignment produces zero or one FormInstance when the lab completes the work." }
  indexes { test_request_id sample_id model_id laboratory_id form_id status application_id }
  id: string {
    definition ""
    modality SHALL
  }
  test_request_id: reference(TestRequest) {
    definition ""
    modality SHALL
    on_delete cascade
    required true
  }
  application_id: reference(Application) {
    definition "Denormalized from TestRequest for query efficiency"
    modality SHALL
    on_delete restrict
    required true
  }
  form_id: string {
    definition "R 60-3 form identifier (e.g. 'load-test')"
    modality SHALL
  }
  sample_id: reference(MeasuringInstrumentSample) {
    definition "Specific physical sample this test is performed on"
    modality SHALL
    on_delete restrict
    required true
  }
  model_id: reference(MeasuringInstrumentModel) {
    definition "Denormalized from sample_id.model_id for query efficiency"
    modality SHALL
    on_delete restrict
    required true
  }
  laboratory_id: reference(TestLaboratory) {
    definition "Denormalized from TestRequest.assigned_laboratory_id"
    modality SHALL
    on_delete restrict
    required true
  }
  origin: enum[0..1] {
    definition "Who put this test on the lab's bench: ia_assigned (the IA's dispatch — the DEFAULT; absent reads as ia_assigned) or lab_added (the laboratory performs an additional test of its own initiative, TODO.deploying/06); lab-added work is flagged, never silently merged with the IA-assigned set"
    modality MAY
    enum_values { ia_assigned lab_added }
  }
  status: enum {
    definition "Lifecycle: PENDING (lab not yet started) → ACCEPTED (lab acknowledged) → IN_PROGRESS → COMPLETED (FormInstance submitted) | OMITTED (lab cannot perform, with reason) | FAILED (attempted but could not complete)"
    modality SHALL
    enum_values { PENDING ACCEPTED IN_PROGRESS COMPLETED OMITTED FAILED }
  }
  form_instance_id: reference(FormInstance)[0..1] {
    definition "Filled in when the lab completes this assignment"
    modality MAY
    on_delete nullify
    required false
  }
  omit_reason: text[0..1] {
    definition "Required when status=OMITTED (e.g. equipment unavailable)"
    modality MAY
  }
  assigned_date: datetime {
    definition ""
    modality SHALL
  }
  accepted_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  started_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  completed_date: datetime[0..1] {
    definition ""
    modality MAY
  }
  notes: text[0..1] {
    definition ""
    modality MAY
  }
}
class TestReport#data {
  store { testReports }
  description { "Test lab's submission. Per user correction (2026-07-02): one TestReport per model family/group being tested. If a lab tests multiple groups, they produce multiple TestReports. The TestReport declares which MeasuringInstrumentModelGroup(s) and MeasuringInstrumentSample(s) it covers. Within each report, the lab fills in R 60-3 Test Report Forms. If a particular TRF doesn't apply to the group being tested, the lab marks it as omitted with a justification (form_omissions)." }
  indexes { laboratory_id status standard_id test_request_id application_id model_family_id model_group_id }
  id: string {
    definition ""
    modality SHALL
  }
  standard_id: string {
    definition ""
    modality SHALL
  }
  application_id: reference(Application)[0..1] {
    definition "Denormalized for query. Authoritative lineage: TestRequest → Application."
    modality MAY
    on_delete restrict
    required false
  }
  test_request_id: reference(TestRequest)[0..1] {
    definition "Originating TestRequest (the IA dispatch that produced this report)"
    modality MAY
    on_delete nullify
    required false
  }
  model_family_id: reference(MeasuringInstrumentModelFamily)[0..1] {
    definition "Which family this report covers"
    modality MAY
    on_delete restrict
    required false
  }
  model_group_id: reference(MeasuringInstrumentModelGroup)[0..1] {
    definition "Which MeasuringInstrumentModelGroup this report covers. Per user: \"1 test report for each model family/group that needs to be tested.\" When null, the report covers the entire family."
    modality MAY
    on_delete restrict
    required false
  }
  instrument_id: reference(MeasuringInstrumentModel) {
    definition "Primary model under test (kept from the legacy declaration; matrix coverage is via sample_ids)"
    modality SHALL
    on_delete restrict
    required true
  }
  laboratory_id: reference(TestLaboratory) {
    definition ""
    modality SHALL
    on_delete restrict
    required true
  }
  sample_ids: reference(MeasuringInstrumentSample)[0..*] {
    definition "Physical samples covered by this report. Each sample belongs to a specific model within the group. The same sample can appear in multiple FormInstances (one per test/TRF)."
    modality SHALL
    on_delete restrict
    required true
  }
  dimensions: object {
    definition "Dimension snapshot of the tested group at report time (classification context for calculations)"
    modality SHALL
  }
  definition_versions: object[0..1] {
    definition "INV-8 pin (version pinning — every definition executed in D2 is version-pinned in the TestReport): the definition versions this report's D2 execution used, captured at issuance before the report goes immutable. Shape: { standard: the standard edition URN whose definition corpus (requirements, verdict quantities, constraints, form schemas) was in force; forms: { <form_id>: the executed form-schema identifier, propagated from the completing TestRuns' method_version pins } }. D3 re-evaluation records these pins into its verdict snapshots so the chain stays auditable. Absent when no run-backed evidence pins anything (an assumed edition is never written); a form executed under two different schema versions drops its key — honest absence beats a false pin."
    modality MAY
  }
  required_forms: string[][1..*] {
    definition "R 60-3 form identifiers the lab should complete for this group"
    modality SHALL
  }
  form_instances: reference(FormInstance)[0..*] {
    definition "FormInstances bundled by this report (was string[] of ids; re-typed per the FK graph, one-to-many cascade)"
    modality SHALL
    on_delete cascade
  }
  form_omissions: reference(FormOmission)[0..*] {
    definition "Forms that don't apply to the group being tested, with justification. Per user: \"If the IA or test lab decides that a particular TRF doesn't need to be filled for a model family/group, then they should have a way to specify that.\""
    modality MAY
    on_delete cascade
  }
  forms: reference(TestReportFormRef)[0..*] {
    definition ""
    modality MAY
  }
  artifact_instances: reference(ArtifactInstance)[0..*] {
    definition "Artifact instances linked as evidence (TODO.roadmap/09) — produced outputs OF THE INSTRUMENT conforming to the standard's model/artifacts.yaml definitions (e.g. R 91's enforcement evidence file). Seeded from sample-data.yaml test_report.artifact_instances; captured at runtime in the lab report composer. A report covering an artifact-producing test must link ≥1 instance of each produced definition (linker rule artifact-presence)."
    modality MAY
  }
  anr_countries: string[][0..*] {
    definition ""
    modality MAY
  }
  status: enum {
    definition ""
    modality SHALL
    enum_values { DRAFT SUBMITTED UNDER_REVIEW ACCEPTED REJECTED }
  }
  evaluator: string {
    definition ""
    modality SHALL
  }
  signature_date: date[0..1] {
    definition "Date of signature by authorizing person (PD-05 §4.4.3 r)"
    modality MAY
  }
  test_location: string[0..1] {
    definition "Place of testing (PD-05 §4.4.3 j)"
    modality MAY
  }
  includes_mtl_results: boolean[0..1] {
    definition "Whether this report includes results from a Manufacturer Test Lab (Scheme A, PD-05 §5.3.1 b) — the MTL flag the §5.5.4 prominent-statement and §5.5.5 own-Declaration checks key on"
    modality MAY
  }
  supervising_ia_id: reference(IssuingAuthority)[0..1] {
    definition "MTL reports only — the Issuing Authority exercising controlled supervision over the Manufacturer Test Laboratory (PD-04, 7.1); must equal the IA utilising the report (PD-05 §5.5.5)"
    modality MAY
    on_delete nullify
    required false
  }
  created: datetime {
    definition ""
    modality SHALL
  }
  modified: datetime {
    definition ""
    modality SHALL
  }
  submitted_date: datetime[0..1] {
    definition ""
    modality MAY
  }
}
