state_machine LoadCellOperational {
  kind operational
  initial off
  states {
    off
    warming
    ready
    measuring
    fault
  }
  transition off -> warming action power_on {
  }
  transition warming -> ready action warm_up_complete {
    guard "elapsed time since power_on ≥ the manufacturer-declared warm_up_time (R 60-1, 3.5.17; during the designed warm-up time there shall be no transmission of measurement results, 5.7.2) — declarative; not evaluated on fire"
  }
  transition ready -> measuring action apply_load {
  }
  transition measuring -> ready action remove_load {
  }
  transition [off, warming, ready, measuring] -> fault action fault_detected {
    guard "a significant fault is detected and acted upon — the cell is made inoperative automatically or a fault detection output is issued until the fault is resolved (R 60-1, 5.7.1.1, 5.7.1.2) — declarative; not evaluated on fire"
  }
  transition [warming, ready, measuring] -> off action power_off {
  }
}
requirement /req/iso-17065/body/legal-entity {
  name "Legal entity"
  statement "The certification body shall be a legal entity, or a defined part of a legal entity, such that the legal entity can be held legally responsible for all its certification activities. (A governmental certification body is deemed to be a legal entity on the basis of its governmental status.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Legal-entity status (or defined part of one) documented for the body"
      - description: "Legal responsibility for all certification activities traceable to that entity"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment), outside the per-application certification process." }
  source { doc "ISO/IEC 17065:2012, 4.1.1" clause "" }
}
requirement /req/iso-17065/body/certification-agreement {
  name "Certification agreement"
  statement "The certification body shall have a legally enforceable agreement for the provision of certification activities to its clients, taking into account the responsibilities of the certification body and its clients. The agreement shall require that the client comply at least with: always fulfilling the certification requirements (including implementing communicated changes); continued fulfilment of the product requirements where certification applies to ongoing production; making all necessary arrangements for the conduct of the evaluation and surveillance, for the investigation of complaints and for the participation of observers; claims consistent with the scope of certification; no use of certification that brings the body into disrepute or is misleading; discontinuing advertising references upon suspension, withdrawal or termination; reproducing certification documents only in their entirety or as specified by the scheme; compliance with body/scheme requirements when referring to its certification; compliance with scheme requirements on the use of marks of conformity; keeping records of complaints known to it and making them available on request; and informing the body without delay of changes affecting its ability to conform (4.1.2 a–k)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Legally enforceable certification agreement in place with every client"
      - description: "Agreement covers the client obligations of 4.1.2 a–k"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 4.1.2" clause "" }
}
requirement /req/iso-17065/body/impartiality-responsibility {
  name "Impartiality responsibility"
  statement "Certification activities shall be undertaken impartially. The certification body shall be responsible for the impartiality of its certification activities and shall not allow commercial, financial or other pressures to compromise impartiality. The certification body shall have top management commitment to impartiality."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Responsibility for impartiality assigned and top-management commitment demonstrable"
      - description: "No commercial, financial or other pressure compromising impartiality identified"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 4.2.1, 4.2.2, 4.2.5" clause "" }
}
requirement /req/iso-17065/body/impartiality-risk-management {
  name "Impartiality risk management"
  statement "The certification body shall identify risks to its impartiality on an ongoing basis, including those risks that arise from its activities, from its relationships, or from the relationships of its personnel (see 4.2.12); such relationships may not necessarily present a certification body with a risk to impartiality. If a risk to impartiality is identified, the certification body shall be able to demonstrate how it eliminates or minimizes such risk, and this information shall be made available to the mechanism specified in 5.2."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Ongoing impartiality risk identification covering activities and (personnel) relationships"
      - description: "Elimination/minimization of identified risks demonstrable to the 5.2 mechanism"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 4.2.3, 4.2.4" clause "" }
}
requirement /req/iso-17065/body/no-conflicting-activities {
  name "No conflicting activities"
  statement "The certification body and any part of the same legal entity and entities under its organizational control (see 7.6.4) shall not: a) be the designer, manufacturer, installer, distributer or maintainer of the certified product; b) be the designer, implementer, operator or maintainer of the certified process; c) be the designer, implementer, provider or maintainer of the certified service; d) offer or provide consultancy to its clients; e) offer or provide management system consultancy or internal auditing to its clients where the certification scheme requires the evaluation of the client's management system."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "No design/manufacture/distribution/maintenance of the certified product by the body or controlled entities"
      - description: "No consultancy (incl. management-system consultancy/internal auditing) offered to clients"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 4.2.6" clause "" }
}
requirement /req/iso-17065/body/consultancy-bar {
  name "Consultancy bar on review and decision personnel"
  statement "Within a period specified by the certification body, personnel shall not be used to review or make a certification decision for a product for which they have provided consultancy. (The period can be specified in the certification scheme or, if specified by the certification body, it reflects a period long enough to ensure that the review or decision does not compromise impartiality; a specified period of two years is often used.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Body-specified consultancy-bar period documented (scheme- or body-level)"
      - description: "No review/decision assignment of personnel within the bar period for a consulted product"
  }
  verification { method deferred description "Declared constraint — the machine-checkable facet is the segregation entry of the review and decision abstract processes (evaluation/functional-approach.yaml); the assignment-level check is verified by assessment of the body." }
  source { doc "ISO/IEC 17065:2012, 4.2.10" clause "" }
}
requirement /req/iso-17065/body/safeguarding-mechanism {
  name "Mechanism for safeguarding impartiality"
  statement "The certification body shall have a mechanism for safeguarding its impartiality, providing input on the policies and principles relating to the impartiality of its certification activities, on any tendency to allow commercial or other considerations to prevent the consistent impartial provision of certification activities, and on matters affecting impartiality and confidence in certification, including openness. The mechanism shall be formally documented to ensure a balanced representation of significantly interested parties, such that no single interest predominates (internal or external personnel of the certification body are considered to be a single interest, and shall not predominate), and access to all the information necessary to enable it to fulfil all its functions. If the top management of the certification body does not follow the input of this mechanism, the mechanism shall have the right to take independent action (e.g. informing authorities, accreditation bodies, stakeholders), respecting the confidentiality requirements of 4.5."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Documented safeguarding mechanism with balanced interested-party representation"
      - description: "No single interest predominates; information access assured; independent-action right documented"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 5.2" clause "" }
}
requirement /req/iso-17065/body/personnel-competence {
  name "Personnel competence management"
  statement "The certification body shall employ, or have access to, a sufficient number of personnel to cover its operations related to the certification schemes and to the applicable standards and other normative documents; the personnel shall be competent for the functions they perform, including making required technical judgments, defining policies and implementing them. The certification body shall establish, implement and maintain a procedure for management of competencies of personnel involved in the certification process (see Clause 7), requiring the body to: a) determine the criteria for the competence of personnel for each function in the certification process, taking into account the requirements of the schemes; b) identify training needs and provide, as necessary, training programmes; c) demonstrate that the personnel have the required competencies for the duties and responsibilities they undertake; d) formally authorize personnel for functions in the certification process; e) monitor the performance of the personnel."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Competence criteria defined per certification-process function"
      - description: "Personnel formally authorized per function (evaluation, review, decision per 6.1.2 d)"
      - description: "Competence demonstrated and performance monitored"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 6.1.1, 6.1.2" clause "" }
}
requirement /req/iso-17065/body/personnel-records {
  name "Personnel records"
  statement "The certification body shall maintain the following records on the personnel involved in the certification process (see Clause 7): a) name and address; b) employer(s) and position held; c) educational qualification and professional status; d) experience and training; e) the assessment of competence; f) performance monitoring; g) authorizations held within the certification body; h) date of most recent updating of each record."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Records a–h maintained for every person involved in the certification process"
      - description: "Authorizations held (item g) traceable to the competence-management procedure"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 6.1.2" clause "" }
}
requirement /req/iso-17065/body/personnel-contract {
  name "Personnel contract and conflict-of-interest declaration"
  statement "The certification body shall require personnel involved in the certification process to sign a contract or other document by which they commit themselves: a) to comply with the rules defined by the certification body, including those relating to confidentiality (see 4.5) and independence from commercial and other interests; b) to declare any prior and/or present association on their own part, or on the part of their employer, with a supplier or designer of products, a provider or developer of services, or an operator or developer of processes to the evaluation or certification of which they are to be assigned; c) to reveal any situation known to them that may present them or the certification body with a conflict of interest (see 4.2). The declarations are used as input into identifying risks to impartiality (see 4.2.3)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Signed contract/commitment for every person involved in the certification process"
      - description: "Association and conflict-of-interest declarations feed impartiality risk identification"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 6.1.3" clause "" }
}
requirement /req/iso-17065/body/evaluation-resources {
  name "Resources for evaluation (ISO/IEC 17025/17020/17021 delegation)"
  statement "When a certification body performs evaluation activities, either with its internal resources or with other resources under its direct control, it shall meet the applicable requirements of the relevant International Standards and, as specified by the certification scheme, of other documents. For testing, it shall meet the applicable requirements of ISO/IEC 17025; for inspection, it shall meet the applicable requirements of ISO/IEC 17020; and for management system auditing, it shall meet the applicable requirements of ISO/IEC 17021. The impartiality requirements of the evaluation personnel stipulated in the relevant standard shall always be applicable."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Testing performed under ISO/IEC 17025-conformant resources (the OIML-CS TL tier, B 18:2025 §5.3)"
      - description: "Impartiality requirements of the relevant standard applied to evaluation personnel"
  }
  verification { method deferred description "Verified by assessment of the certification body and its evaluation resources (the ISO/IEC 17025 laboratory reference package lands in TODO.roadmap/39c)." }
  source { doc "ISO/IEC 17065:2012, 6.2.1" clause "" }
}
requirement /req/iso-17065/body/outsourcing {
  name "Outsourcing of evaluation"
  statement "The certification body shall outsource evaluation activities only to bodies that meet the applicable requirements of the relevant International Standards and, as specified by the certification scheme, of other documents (for testing ISO/IEC 17025, for inspection ISO/IEC 17020, for management system auditing ISO/IEC 17021). Where evaluation activities are outsourced to non-independent bodies (e.g. client laboratories), the certification body shall ensure that the evaluation activities are managed in a manner which provides confidence in the results and that records are available to justify the confidence. The certification body shall have a legally binding contract with the body providing the outsourced service (including confidentiality and conflict-of-interest provisions per 6.1.3 item c), shall take responsibility for all outsourced activities, shall maintain a list of approved providers of outsourced services, and shall inform the client in advance of outsourcing activities in order to provide the client with an opportunity to object."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Outsourced evaluation only to bodies meeting the relevant International Standards"
      - description: "Approved-provider list maintained; client informed in advance with opportunity to object"
  }
  verification { method deferred description "Verified by assessment of the certification body (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17065:2012, 6.2.2" clause "" }
}
requirement /req/iso-17065/process/application-information {
  name "Application information"
  statement "For application, the certification body shall obtain all the necessary information to complete the certification process in accordance with the relevant certification scheme — including the product(s) to be certified, the standards and/or other normative documents for which the client is seeking certification, the general features of the client, information concerning outsourced processes that will affect conformity to requirements, and all other information needed in accordance with the relevant certification requirements (e.g. for initial evaluation and surveillance activities)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Product(s), normative documents, client features and outsourced processes identified"
      - description: "Information for initial evaluation and surveillance collected"
  }
  verification { method inspection description "Application step (abstract process application)." }
  source { doc "ISO/IEC 17065:2012, 7.2" clause "" }
}
requirement /req/iso-17065/process/application-review {
  name "Application review"
  statement "The certification body shall conduct a review of the information obtained (see 7.2) to ensure that: a) the information about the client and the product is sufficient for the conduct of the certification process; b) any known difference in understanding between the certification body and the client is resolved, including agreement regarding standards or other normative documents; c) the scope of certification sought is defined; d) the means are available to perform all evaluation activities; e) the certification body has the competence and capability to perform the certification activity."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Sufficiency of information confirmed and understanding differences resolved"
      - description: "Scope of certification defined; means, competence and capability confirmed"
  }
  verification { method inspection description "Application-review step (abstract process application_review)." }
  source { doc "ISO/IEC 17065:2012, 7.3.1" clause "" }
}
requirement /req/iso-17065/process/decline-without-competence {
  name "Decline when competence is lacking"
  statement "The certification body shall decline to undertake a specific certification if it lacks any competence or capability for the certification activities it is required to undertake. (Where the request covers a product type, normative document or scheme with which the body has no prior experience, the body shall ensure it has the competence and capability for all the certification activities it is required to undertake and maintain a record of the justification for the decision to undertake certification, 7.3.2 / 7.3.3.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Decline path taken whenever competence/capability is lacking"
      - description: "Justification recorded for no-prior-experience undertakings"
  }
  verification { method inspection description "Application-review step (abstract process application_review)." }
  source { doc "ISO/IEC 17065:2012, 7.3.4" clause "" }
}
requirement /req/iso-17065/process/evaluation-plan {
  name "Evaluation plan and task assignment"
  statement "The certification body shall have a plan for the evaluation activities to allow for the necessary arrangements to be managed. The certification body shall assign personnel to perform each evaluation task that it undertakes with its internal resources (see 6.2.1). The certification body shall carry out the evaluation activities that it undertakes with its internal resources and shall manage outsourced resources (see 6.2.2) in accordance with the evaluation plan; the products shall be evaluated against the requirements covered by the scope of certification and other requirements specified in the certification scheme."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Evaluation plan in place; every internal evaluation task assigned to personnel"
      - description: "Evaluation executed per plan against the scope of certification"
  }
  verification { method inspection description "Evaluation step (abstract process evaluation)." }
  source { doc "ISO/IEC 17065:2012, 7.4.1, 7.4.2, 7.4.4" clause "" }
}
requirement /req/iso-17065/process/evaluation-results {
  name "Nonconformity information and evaluation results documentation"
  statement "The certification body shall inform the client of all nonconformities; if the client expresses interest in continuing the certification process, the certification body shall provide information regarding the additional evaluation tasks needed to verify that nonconformities have been corrected (the process specified in 7.4 being repeated to complete them). The results of all evaluation activities shall be documented prior to review (see 7.5)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Client informed of all nonconformities; additional-task path offered"
      - description: "All evaluation results documented before any review begins"
  }
  verification { method inspection description "Evaluation step (abstract process evaluation)." }
  source { doc "ISO/IEC 17065:2012, 7.4.6, 7.4.9" clause "" }
}
requirement /req/iso-17065/process/review-independence {
  name "Review independence and documented recommendation"
  statement "The certification body shall assign at least one person to review all information and results related to the evaluation. The review shall be carried out by person(s) who have not been involved in the evaluation process. Recommendations for a certification decision based on the review shall be documented, unless the review and the certification decision are completed concurrently by the same person."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "At least one reviewer assigned; no reviewer was involved in the evaluation"
      - description: "Review recommendation documented (or review and decision completed concurrently by the same person)"
  }
  verification { method inspection description "Review step (abstract process review; segregation entry review_not_evaluation)." }
  source { doc "ISO/IEC 17065:2012, 7.5.1, 7.5.2" clause "" }
}
requirement /req/iso-17065/process/decision-independence {
  name "Decision authority and independence"
  statement "The certification body shall be responsible for, and shall retain authority for, its decisions relating to certification. The certification body shall assign at least one person to make the certification decision based on all information related to the evaluation, its review, and any other relevant information. The certification decision shall be carried out by a person or group of persons (e.g. a committee, see 5.1.4) that has not been involved in the process for evaluation (see 7.4). (The review and the certification decision can be completed concurrently by the same person or group of persons.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Decision authority retained by the body (never outsourced)"
      - description: "No decider was involved in the evaluation"
  }
  verification { method inspection description "Decision step (abstract process decision; segregation entry decision_not_evaluation)." }
  source { doc "ISO/IEC 17065:2012, 7.6.1, 7.6.2" clause "" }
}
requirement /req/iso-17065/process/decision-employment {
  name "Decision-maker employment and refusal notification"
  statement "The person(s) (excluding members of committees, see 5.1.4) assigned by the certification body to make a certification decision shall be employed by, or shall be under contract with, the certification body (see 6.1) or an entity under the organizational control of the certification body (see 7.6.4). The certification body shall notify the client of a decision not to grant certification, and shall identify the reasons for the decision."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Decision personnel employed by/contracted to the body or a controlled entity"
      - description: "Refusals notified to the client with reasons"
  }
  verification { method inspection description "Decision step (abstract process decision)." }
  source { doc "ISO/IEC 17065:2012, 7.6.3, 7.6.6" clause "" }
}
requirement /req/iso-17065/process/certification-documentation {
  name "Certification documentation content and authorization"
  statement "The certification body shall provide the client with formal certification documentation that clearly conveys, or permits identification of: a) the name and address of the certification body; b) the date certification is granted (the date shall not precede the date on which the certification decision was completed); c) the name and address of the client; d) the scope of certification; e) the term or expiry date of certification, if certification expires after an established period; f) any other information required by the certification scheme. The formal certification documentation shall include the signature or other defined authorization of the person(s) of the certification body assigned such responsibility."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Documentation conveys items a–f (grant date not preceding the decision date)"
      - description: "Signature or defined authorization of the assigned person(s) present"
  }
  verification { method inspection description "Attestation step (abstract process attestation)." }
  source { doc "ISO/IEC 17065:2012, 7.7.1, 7.7.2" clause "" }
}
requirement /req/iso-17065/process/attestation-preconditions {
  name "Attestation preconditions"
  statement "Formal certification documentation (see 7.7) shall only be issued after, or concurrent with, the following: a) the decision to grant or extend the scope of certification (see 7.6.1) has been made; b) certification requirements have been fulfilled; c) the certification agreement (see 4.1.2) has been completed/signed."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Grant/extension decision made before (or concurrent with) issuance"
      - description: "Certification requirements fulfilled and agreement completed/signed at issuance"
  }
  verification { method inspection description "Attestation step (abstract process attestation)." }
  source { doc "ISO/IEC 17065:2012, 7.7.3" clause "" }
}
requirement /req/iso-17065/process/directory {
  name "Directory of certified products"
  statement "The certification body shall maintain information on certified products which contains at least: a) identification of the product; b) the standard(s) and other normative document(s) to which conformity has been certified; c) identification of the client. The parts of this information that need to be published or made available upon request in a directory are stipulated by the relevant scheme(s); as a minimum, the certification body shall provide information, upon request, about the validity of a given certification."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Certified-product information (product, normative documents, client) maintained"
      - description: "Validity of a given certification provided on request"
  }
  verification { method inspection description "Attestation-completion leg (abstract process attestation; the OIML-CS's public register realizes this directory)." }
  source { doc "ISO/IEC 17065:2012, 7.8.1, 7.8.2" clause "" }
}
requirement /req/iso-17065/process/surveillance {
  name "Surveillance per the scheme"
  statement "If surveillance is required by the certification scheme, or as specified in 7.9.3 or 7.9.4, the certification body shall initiate surveillance of the product(s) covered by the certification decision in accordance with the certification scheme (the criteria and process for surveillance activities are defined by each certification scheme). When surveillance utilizes evaluation, review or a certification decision, the requirements in 7.4, 7.5 or 7.6, respectively, shall be fulfilled."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Surveillance initiated wherever the scheme requires it"
      - description: "Surveillance re-using evaluation/review/decision fulfils 7.4/7.5/7.6 respectively"
  }
  verification { method inspection description "Surveillance step (abstract process surveillance)." }
  source { doc "ISO/IEC 17065:2012, 7.9.1, 7.9.2" clause "" }
}
requirement /req/iso-17065/process/surveillance-marked-products {
  name "Mandatory surveillance for continued mark use"
  statement "When continuing use of a certification mark is authorized for placement on a product (or its packaging, or information accompanying it) (for process or service, see 7.9.4) of a type which has been certified, surveillance shall be established and shall include periodic surveillance of marked products to ensure ongoing validity of the demonstration of fulfilment of product requirements. When continuing use of a certification mark is authorized for a process or service, surveillance shall be established and shall include periodic surveillance activities to ensure ongoing validity of the demonstration of fulfilment of process or service requirements."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Periodic surveillance established wherever a certification mark continues in use"
  }
  verification { method inspection description "Surveillance step (abstract process surveillance)." }
  source { doc "ISO/IEC 17065:2012, 7.9.3, 7.9.4" clause "" }
}
requirement /req/iso-17065/process/changes {
  name "Changes affecting certification"
  statement "When the certification scheme introduces new or revised requirements that affect the client, the certification body shall ensure these changes are communicated to all clients, shall verify the implementation of the changes by its clients, and shall take actions required by the scheme. The certification body shall consider other changes affecting certification, including changes initiated by the client, and shall decide upon the appropriate action. The actions to implement changes affecting certification shall include, if required: evaluation (see 7.4), review (see 7.5), decision (see 7.6), issuance of revised formal certification documentation (see 7.7), and issuance of certification documentation of revised surveillance activities — completed in accordance with the applicable parts of 7.4, 7.5, 7.6, 7.7 and 7.8, with records (see 7.12) including the rationale for excluding any of these activities."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Scheme changes communicated to all clients; implementation verified"
      - description: "Change actions run per 7.4–7.8; exclusions' rationale recorded"
  }
  verification { method inspection description "Changes step (abstract process changes)." }
  source { doc "ISO/IEC 17065:2012, 7.10.1, 7.10.2, 7.10.3" clause "" }
}
requirement /req/iso-17065/process/termination {
  name "Termination, reduction, suspension or withdrawal"
  statement "When a nonconformity with certification requirements is substantiated, either as a result of surveillance or otherwise, the certification body shall consider and decide upon the appropriate action (e.g. continuation under specified conditions, reduction of the scope of certification, suspension pending remedial action, or withdrawal). When the appropriate action includes evaluation, review or a certification decision, the requirements in 7.4, 7.5 or 7.6, respectively, shall be fulfilled. If certification is terminated (by request of the client), suspended or withdrawn, the certification body shall take actions specified by the certification scheme and shall make all necessary modifications to formal certification documents, public information, authorizations for use of marks, etc., in order to ensure it provides no indication that the product continues to be certified; if a scope of certification is reduced, the reduced scope shall be clearly communicated to the client and clearly specified in certification documentation and public information."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Substantiated nonconformity decided upon; 7.4/7.5/7.6 applied when re-entered"
      - description: "No indication of continued certification after termination/suspension/withdrawal/reduction"
  }
  verification { method inspection description "Termination step (abstract process termination)." }
  source { doc "ISO/IEC 17065:2012, 7.11.1, 7.11.2, 7.11.3" clause "" }
}
requirement /req/iso-17065/process/records {
  name "Records"
  statement "The certification body shall retain records to demonstrate that all certification process requirements (those in this International Standard and those of the certification scheme) have been effectively fulfilled (see also 8.4). The certification body shall keep records confidential; records shall be transported, transmitted and transferred in a way that ensures confidentiality is maintained (see also 4.5). If the certification scheme involves complete re-evaluation of the product(s) within a determined cycle, records shall be retained at least for the current and the previous cycle; otherwise, records shall be retained for a period defined by the certification body."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Records demonstrating fulfilment of all certification process requirements retained"
      - description: "Confidentiality preserved; retention covers at least current and previous cycle where applicable"
  }
  verification { method inspection description "Records step (abstract process records)." }
  source { doc "ISO/IEC 17065:2012, 7.12.1, 7.12.2, 7.12.3" clause "" }
}
requirement /req/iso-17065/process/complaints-process {
  name "Complaints and appeals process"
  statement "The certification body shall have a documented process to receive, evaluate and make decisions on complaints and appeals, and shall record and track complaints and appeals, as well as actions undertaken to resolve them. Upon receipt of a complaint or appeal, the certification body shall confirm whether the complaint or appeal relates to certification activities for which it is responsible and, if so, shall address it. The certification body shall acknowledge receipt of a formal complaint or appeal, and shall be responsible for gathering and verifying all necessary information (as far as possible) to progress the complaint or appeal to a decision."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Documented receive/evaluate/decide process with recording and tracking"
      - description: "Receipt acknowledged; responsibility confirmed; information gathered and verified"
  }
  verification { method inspection description "Complaints step (abstract process complaints)." }
  source { doc "ISO/IEC 17065:2012, 7.13.1, 7.13.2, 7.13.3, 7.13.4" clause "" }
}
requirement /req/iso-17065/process/complaint-resolution-independence {
  name "Complaint-resolution independence"
  statement "The decision resolving the complaint or appeal shall be made by, or reviewed and approved by, person(s) not involved in the certification activities related to the complaint or appeal."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "No complaint-resolution decider/reviewer/approver was involved in the related certification activities"
  }
  verification { method inspection description "Complaints step (abstract process complaints; segregation entry complaint_resolution_not_case)." }
  source { doc "ISO/IEC 17065:2012, 7.13.5" clause "" }
}
requirement /req/iso-17065/process/complaint-consultancy-bar {
  name "Two-year consultancy bar on complaint resolution"
  statement "To ensure that there is no conflict of interest, personnel (including those acting in a managerial capacity) who have provided consultancy for a client, or been employed by a client, shall not be used by the certification body to review or approve the resolution of a complaint or appeal for that client within two years following the end of the consultancy or employment."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "No complaint-resolution reviewer/approver within two years of consultancy for or employment by that client"
  }
  verification { method inspection description "Complaints step (abstract process complaints; segregation entry complaint_consultancy_two_year_bar)." }
  source { doc "ISO/IEC 17065:2012, 7.13.6" clause "" }
}
requirement /req/cs/application-completeness {
  name "Application completeness"
  statement "The Issuing Authority shall review the application for completeness: it shall identify the applicant and the manufacturer(s), describe the measuring instrument type (single model or model family) with its declared metrological characteristics and dimensions, and include the documentation required for type evaluation. Where the application is incomplete, the Issuing Authority may request the applicant to provide additional information and documents prior to further processing."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Applicant and manufacturer(s) identified"
      - description: "Type (model or model family) described with declared characteristics and dimensions"
      - description: "Type evaluation documentation included"
      - description: "Deficiencies communicated to the applicant when incomplete"
  }
  verification { method inspection description "IA application review step (process review_application)." }
  source { doc "PD-05 §4.2.1" clause "" }
}
requirement /req/cs/application-contents {
  name "Application contents"
  statement "The application shall include: the name and address of the manufacturer and, if appropriate, of the authorised representative; a statement that no concurrent application for OIML type evaluation has been made to any other OIML Issuing Authority; a description of the type as distinct from other types (for a family of instruments or modules, information concerning each member as appropriate); a description of the instrument's operation, including the manufacturer's operating instructions; a list of the manufacturer's documentation necessary and sufficient for the identification of the type; information on the sample(s), representative of the production envisaged, to be submitted for tests and examinations; and, if applicable, the results of OIML test reports of previous OIML type evaluations."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Manufacturer (and authorised representative) name and address recorded"
      - description: "No-concurrent-application statement present"
      - description: "Type description (per family member as appropriate) recorded"
      - description: "Operation description and manufacturer's operating instructions included"
      - description: "Type-identification documentation list included"
      - description: "Sample information representative of production recorded"
      - description: "Previous OIML test reports referenced where applicable"
  }
  verification { method inspection description "Applicant submission (abstract process application)." }
  source { doc "PD-05 §4.1.2" clause "" }
}
requirement /req/cs/fee-estimate {
  name "Fee estimate on acceptance"
  statement "On acceptance of an application, the Issuing Authority shall inform the applicant of the fee for application and an estimate of the fees for the type evaluation (including testing and reviewing any applicant-submitted test reports) and for issuing the certificate. The fees shall be determined by the Issuing Authority and the associated Test Laboratory(ies) (PD-05 §4.2.8)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Fee estimate communicated to the applicant on acceptance"
      - description: "Fees determined by the Issuing Authority and the associated Test Laboratory(ies)"
  }
  verification { method inspection description "IA acceptance notification (process accept_application)." }
  source { doc "PD-05 §4.2.8" clause "" }
}
requirement /req/cs/application-time-estimate {
  name "Approximate time estimate on acceptance"
  statement "The Issuing Authority shall inform the applicant in writing of the approximate time necessary to draw up the OIML type evaluation report and OIML test report(s) and complete the OIML type evaluation."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Approximate completion time communicated to the applicant in writing"
  }
  verification { method inspection description "IA acceptance notification (process accept_application)." }
  source { doc "PD-05 §4.2.9" clause "" }
}
requirement /req/cs/sample-count {
  name "Sample count on acceptance"
  statement "On acceptance of an application, the Issuing Authority shall inform the applicant of the rules of the OIML-CS and of the number of samples of the type required for testing — usually specified in the relevant OIML Recommendation, otherwise mutually agreed between the Issuing Authority and the applicant. Where the Issuing Authority is satisfied with the results of OIML test reports of a previous OIML type evaluation instead of testing new samples, it shall obtain evidence that the type for which the certificate is requested is identical to the previously evaluated type, and the OIML type evaluation report or accompanying document shall indicate which previous results were accepted and utilised (PD-05 §4.2.5). For a family of instruments or modules, the Issuing Authority shall inform the applicant of the identity and number of family members to be submitted (PD-05 §4.2.6); for modules, of the equipment or simulation setup necessary to enable testing (PD-05 §4.2.7)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Required sample count stated per the Recommendation, or mutually agreed"
      - description: "Type-identity evidence obtained and accepted previous results indicated when previous reports are used"
      - description: "Family-member identity and count stated for family applications"
  }
  verification { method inspection description "IA acceptance notification (process accept_application)." }
  source { doc "PD-05 §4.2.5" clause "" }
}
requirement /req/cs/rejection-reason {
  name "Rejection with reason"
  statement "The Issuing Authority may refuse an application only on clearly identified grounds: the category of measuring instrument or module is not included in its scope, the type does not correspond to the category or module covered in the relevant OIML Recommendation, the information required for the application is incomplete, or other clearly identified reasons (PD-05 §4.2.2 a–d). Where an application is rejected, the Issuing Authority shall inform the applicant in writing of its decision and state the reasons for the rejection (PD-05 §4.2.4)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Refusal rests on the §4.2.2 a–d grounds"
      - description: "Rejection communicated to the applicant in writing"
      - description: "Reasons for the rejection recorded and stated"
  }
  verification { method inspection description "IA rejection step (process reject_application)." }
  source { doc "PD-05 §4.2.2" clause "" }
}
requirement /req/cs/test-laboratory-eligibility {
  name "Test laboratory eligibility"
  statement "The tests and examinations for OIML type evaluation shall be performed by Test Laboratories that are listed in the OIML-CS Declaration of an OIML Issuing Authority, and the test procedures shall be consistent with those described in the relevant OIML Recommendation (PD-05 §4.3.2). (Platform enforcement interpretation, not PD-05 text — PD-05 defines no dispatch step: the Issuing Authority shall dispatch each test report request only to Test Laboratories eligible for the tests it assigns.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Every dispatched Test Laboratory is listed in an OIML-CS Declaration"
      - description: "Assigned test procedures are those of the relevant Recommendation"
  }
  verification { method inspection description "IA dispatch step (abstract process dispatch)." }
  source { doc "PD-05 §4.3.1" clause "" }
}
requirement /req/cs/multiple-test-laboratories {
  name "One test report per Test Laboratory"
  statement "The Test Laboratory conducting tests according to the relevant OIML Recommendation shall issue an OIML test report. Where several Test Laboratories conduct such tests, each Test Laboratory shall issue an OIML test report that includes the results of the tests it has conducted."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "One OIML test report issued per testing Test Laboratory"
      - description: "Each report covers only the tests that laboratory conducted"
  }
  verification { method inspection description "TL report compilation (process compile_test_report)." }
  source { doc "PD-05 §4.4.1" clause "" }
}
requirement /req/cs/test-report-18-elements {
  name "Test report content (18-element checklist)"
  statement "The Test Laboratory shall compile the OIML test report so that it covers every element of the OIML-CS test-report checklist (PD-05, 4.4.3): identification of the report and the laboratory, identification of the tested samples, the test methods and conditions applied, the results obtained with their measurement uncertainties, and the responsible sign-off. The test-report skeleton of the Recommendation's execution layer realizes this checklist; the 18-element validation checklist is enforced at report compilation."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Report and laboratory identification elements present"
      - description: "Sample identification for every tested specimen"
      - description: "Test methods, conditions and results (with uncertainties) recorded per test"
      - description: "Responsible Test Laboratory sign-off on the report"
      - description: "All required form instances completed (completed_forms = required_forms)"
  }
  verification { method inspection description "TL report compilation (process compile_test_report)." }
  source { doc "PD-05 §4.4.3" clause "" }
}
requirement /req/cs/test-report-authorization {
  name "Test report authorization"
  statement "The OIML test report shall be dated, signed, and provided with a unique identification number by the responsible person of the Test Laboratory who authorises the report."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Report dated by the authorizing responsible person"
      - description: "Responsible-person signature recorded"
      - description: "Unique report identification number assigned"
  }
  verification { method inspection description "TL report authorization (approval tl_authorize_test_report; abstract process testing)." }
  source { doc "PD-05 §4.4.4" clause "" }
}
requirement /req/cs/test-report-language {
  name "Test report language"
  statement "The OIML test report shall be in English or the national language of the Test Laboratory. Where the OIML test report is issued in a language other than English, an English translation shall be provided or authorised by the responsible OIML Issuing Authority."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Report in English or the Test Laboratory's national language"
      - description: "English translation provided or authorised by the Issuing Authority where applicable"
  }
  verification { method inspection description "TL report compilation (process compile_test_report)." }
  source { doc "PD-05 §4.4.5" clause "" }
}
requirement /req/cs/test-report-logo {
  name "Test report OIML-CS logo conditions"
  statement "An OIML test report may bear the OIML-CS logo only under the conditions of PD-05 §4.4.6: the format and specifications of the logo comply with OIML B 20; the report clearly indicates the results of testing performed exclusively by an OIML-CS approved Test Laboratory within its scope of accreditation or peer assessment; the logo is not used on test reports that include 'old test data' (reports issued under the Basic Certificate System, the OIML Mutual Acceptance Arrangement, or any other scheme); and the report clearly identifies the results required by the relevant OIML Recommendation and any results not from the relevant OIML Recommendation (e.g. tests in support of additional national requirements)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Logo format and specifications per OIML B 20"
      - description: "OIML-CS Test Laboratory results within scope clearly indicated"
      - description: "No logo on reports including old test data"
      - description: "Recommendation-required results distinguished from other results"
  }
  verification { method inspection description "TL report compilation (process compile_test_report)." }
  source { doc "PD-05 §4.4.6" clause "" }
}
requirement /req/cs/evaluation-report-contents {
  name "Evaluation report contents"
  statement "The Issuing Authority shall compile the type evaluation report so that it records the evaluation of every test report and examination result against the applicable requirements of the Recommendation: full coverage of the required test reports, a determination (pass / fail / indeterminate) for each evaluated provision, and a conclusion on the conformity of the type. Where tests were abbreviated or omitted on the basis of a previous evaluation, that shall be clearly indicated (PD-05 §4.3.3)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Every required test report reviewed (checklist coverage complete)"
      - description: "Per-provision determinations recorded with notes where indeterminate"
      - description: "Conformity conclusion stated and signed by the Issuing Authority"
  }
  verification { method inspection description "IA evaluation step (process compile_evaluation_report)." }
  source { doc "PD-05 §4.5.1" clause "" }
}
requirement /req/cs/evaluation-report-id {
  name "Evaluation report identification"
  statement "The OIML type evaluation report shall be dated, signed by the responsible persons of the Issuing Authority that performed the OIML type evaluation (e.g. evaluator and supervisors according to OIML D 32 or OIML D 37), and provided with a unique identification number."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Report dated"
      - description: "Signed by the responsible persons (evaluator and supervisors)"
      - description: "Unique report identification number assigned"
  }
  verification { method inspection description "IA evaluation step (process compile_evaluation_report; approval ia_approve_evaluation_report)." }
  source { doc "PD-05 §4.5.2" clause "" }
}
requirement /req/cs/evaluation-report-logo {
  name "Evaluation report OIML-CS logo"
  statement "The OIML-CS logo shall be affixed on the OIML type evaluation report."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "OIML-CS logo affixed on the evaluation report"
  }
  verification { method inspection description "IA evaluation step (process compile_evaluation_report)." }
  source { doc "PD-05 §4.5.3" clause "" }
}
requirement /req/cs/evaluation-report-language {
  name "Evaluation report language"
  statement "The OIML type evaluation report shall be in English or the national language of the Issuing Authority. Where the OIML type evaluation report is issued in a language other than English, an English translation shall be provided or authorised by the Issuing Authority."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Report in English or the Issuing Authority's national language"
      - description: "English translation provided or authorised by the Issuing Authority where applicable"
  }
  verification { method inspection description "IA evaluation step (process compile_evaluation_report)." }
  source { doc "PD-05 §4.5.4" clause "" }
}
requirement /req/cs/sample-retention {
  name "Report file copy and sample retention"
  statement "The Issuing Authority shall keep on file a copy of the OIML type evaluation report and the information provided with the application. By agreement with the applicant, the tested samples may be kept by the Issuing Authority, the Test Laboratory(ies) or the applicant, the decision taking into account the size and, if appropriate, the commercial value of those samples."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Evaluation report copy and application information kept on file by the Issuing Authority"
      - description: "Sample keeping by agreement recorded, taking size and commercial value into account"
  }
  verification { method inspection description "IA evaluation step (process compile_evaluation_report) and sample custody records." }
  source { doc "PD-05 §4.5.5" clause "" }
}
requirement /req/cs/failure-notice {
  name "Failure notice"
  statement "If the samples do not meet the requirements of the OIML Recommendation, the applicant shall be informed in writing of the reason for the failure, and the OIML type evaluation report shall be given to the applicant, if requested."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Written failure reason communicated to the applicant"
      - description: "Evaluation report given to the applicant on request"
  }
  verification { method inspection description "IA conformity decision (abstract process decision; process compile_evaluation_report)." }
  source { doc "PD-05 §4.5.6" clause "" }
}
requirement /req/cs/re-application {
  name "Re-application after failure"
  statement "Where the samples failed a previous evaluation, the applicant may submit a new application with samples of a modified or newly identified type. New tests may be conducted but may be limited to those requirements for which the previous type was found not to comply only if the evidence provided supports the conclusion that the instrument's performance for all other requirements is not likely to have been affected by the modification of the type. Where the application applies to a type for which an OIML certificate has already been issued, the certificate revision procedure applies (PD-05 §4.5.7 cites \"the procedure in 7.1\" — a stale cross-reference in the published text; the revision procedure is §8.1)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "New application linked to the previous failed evaluation"
      - description: "Retest limitation rests on recorded supporting evidence"
      - description: "Applications for already-certified types routed to the revision procedure"
  }
  verification { method inspection description "IA review of the re-application (abstract process re_application — no concrete Core process yet; named gap)." }
  source { doc "PD-05 §4.5.7" clause "" }
}
requirement /req/cs/scheme-a-national-requirements {
  name "Scheme A additional national requirements"
  statement "Under Scheme A, when applicable, the applicant shall inform the Issuing Authority which additional tests and examinations it is applying for on the basis of additional national requirements listed in the OIML-CS Declaration of a Utilizer or Associate (PD-05 §5.1.4). The test procedures shall be consistent with those described in the relevant OIML Recommendation and/or the additional testing procedures for the additional national requirements included in the scope of that Declaration (PD-05 §5.3.2). Results of tests corresponding to the additional national requirements may be provided in separate test reports, or may be included in the OIML test reports issued for the tests and examinations conducted according to the relevant OIML Recommendation (PD-05 §5.4.2)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Applied-for additional national requirement tests declared at application"
      - description: "Test procedures consistent with the Recommendation and/or the Declaration's additional procedures"
      - description: "Additional-requirement results in separate or shared test reports"
  }
  verification { method inspection description "Scheme A processing (abstract process scheme_a_certification — unrealized; named gap)." }
  source { doc "PD-05 §5.1.4" clause "" }
}
requirement /req/cs/scheme-a-mtl-test-data {
  name "Scheme A Manufacturer Test Laboratory data"
  statement "Under Scheme A, the tests and examinations may be performed by Manufacturer Test Laboratories listed in the OIML-CS Declaration of the Issuing Authority considering the application (PD-05 §5.3.1 b). Where OIML test reports from a Manufacturer Test Laboratory are utilised, this shall be prominently stated and the respective tests identified at the beginning of the OIML type evaluation report, together with the designation of the Manufacturer Test Laboratory (PD-05 §5.5.4). Issuing Authorities shall only utilise OIML test reports from Manufacturer Test Laboratories that are listed in their own OIML-CS Declaration (PD-05 §5.5.5)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Manufacturer Test Laboratories listed in the considering Issuing Authority's Declaration"
      - description: "Manufacturer Test Laboratory use prominently stated with tests identified at the head of the evaluation report"
      - description: "Only own-Declaration Manufacturer Test Laboratory reports utilised"
  }
  verification { method inspection description "Scheme A processing (abstract process scheme_a_certification — unrealized; named gap)." }
  source { doc "PD-05 §5.3.1" clause "" }
}
requirement /req/cs/scheme-a-anr-validation-letter {
  name "Scheme A additional-requirements validation letter"
  statement "Under Scheme A, where tests according to the additional national requirements included in the OIML-CS Declaration of a Utilizer or Associate have been conducted, a letter issued by the OIML Issuing Authority shall validate the conformity of the instrument to these requirements. A copy of such a letter shall be sent to the BIML with the OIML certificate."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Issuing Authority letter validating conformity to the additional national requirements"
      - description: "Letter copy sent to the BIML with the certificate"
  }
  verification { method inspection description "Scheme A issuance (abstract process scheme_a_certification — unrealized; named gap)." }
  source { doc "PD-05 §5.6.3" clause "" }
}
requirement /req/cs/certificate-requirements {
  name "Certificate issuance requirements"
  statement "The Issuing Authority shall issue the OIML Certificate only when the type evaluation report concludes that the type conforms to all the requirements of the relevant Recommendation (PD-05 §4.6.1, §4.5.6). The certificate shall carry the information required by the OIML-CS and the Recommendation's certificate template: the type designation, the applicant and manufacturer(s), the certified metrological characteristics, the issuing authority, the date of issue and the signature of the responsible person, and the certificate number."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Issued only on a conforming evaluation report"
      - description: "Type designation, applicant and manufacturer(s) stated"
      - description: "Certified characteristics per the Recommendation's certificate template"
      - description: "Certificate number, date of issue and IA sign-off present"
  }
  verification { method inspection description "IA issuance step (process issue_certificate)." }
  source { doc "PD-05 §4.6.1" clause "" }
}
requirement /req/cs/certificate-format {
  name "Certificate format"
  statement "The OIML certificate shall be drawn up according to the requirements of PD-05 Annex A and the OIML Certificate Template published on the OIML-CS pages of the OIML website — identical to that format or based on it, including the essential elements, with additional pages defining the essential technical and metrological characteristics of the instrument. It shall be signed by the responsible person within the Issuing Authority and shall bear the OIML-CS logo. The certificate shall be in English or in the national language of the Issuing Authority; a certificate issued in another language shall be accompanied by a provided or authorised English translation (PD-05 §4.6.3). The identification of the certified type shall be defined as marked on the instrument and identical to that in the type evaluation report (Annex A, A.5). Where the certificate concerns a module, the module shall be clearly identified in the certificate under the heading \"designation of the module\" (Annex A, A.4)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Certificate drawn up per the OIML Certificate Template (Annex A)"
      - description: "Signed by the responsible person within the Issuing Authority"
      - description: "OIML-CS logo affixed"
      - description: "Language rule satisfied (English or authorised translation)"
      - description: "Certified-type identification identical to the evaluation report's"
      - description: "Module identified under the \"designation of the module\" heading where applicable"
  }
  verification { method inspection description "IA issuance step (abstract process issue)." }
  source { doc "PD-05 §4.6.2" clause "" }
}
requirement /req/cs/certificate-number {
  name "Certificate number"
  statement "The OIML certificate shall have a unique certificate number established according to the form specified in PD-05 Annex B, indicating: the relevant OIML Recommendation with its year of publication; the scheme letter ('A' or 'B'); the ISO country code of the Member State of issue supplemented by the numbering of the Issuing Authority for the instrument category; the year of issue and a sequential two-digit number; and the revision number. The certificate shall also include the identification number of the associated type evaluation report and of the documentation file (PD-05 §4.6.5; numbering guidance: OIML-CS Guidance Note GN-01)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Number carries Recommendation number and year of publication"
      - description: "Number carries the scheme letter and the country/authority code"
      - description: "Number carries year of issue, sequential number, and revision number"
      - description: "Associated evaluation report and documentation file identifiers on the certificate"
  }
  verification { method inspection description "IA issuance step (abstract process issue)." }
  source { doc "PD-05 §4.6.4" clause "" }
}
requirement /req/cs/certificate-delivery {
  name "Certificate delivery and retention"
  statement "The OIML certificate and the associated type evaluation report and test report(s) shall be given to the applicant, who then becomes their owner. The Issuing Authority shall keep a copy of the certificate, the type evaluation report and the test report(s)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Certificate with evaluation report and test reports handed to the applicant"
      - description: "Issuing Authority copies retained on file"
  }
  verification { method inspection description "IA issuance step (abstract process issue)." }
  source { doc "PD-05 §4.6.6" clause "" }
}
requirement /req/cs/certificate-revision {
  name "Certificate revision"
  statement "A revised OIML certificate shall keep the certificate number of the initial certificate, indicating in addition the revision number and a statement explaining the reason for the amendment, and shall be registered according to PD-05 clause 6. A statement shall indicate that the revised certificate replaces the previous version(s) and summarise the reason(s) for the revision (PD-05 §8.1.2); a revision that modifies the certified type shall include all information from the previous revision(s) with references to every evaluation/test report used to determine conformity (PD-05 §8.1.3)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Initial certificate number retained with revision number"
      - description: "Replacement statement and revision reason recorded"
      - description: "Revised certificate registered with the BIML"
  }
  verification { method inspection description "IA revision handling (process handle_revision)." }
  source { doc "PD-05 §8.1" clause "" }
}
requirement /req/cs/biml-registration {
  name "BIML registration"
  statement "The Issuing Authority shall send a copy of each OIML certificate it issues to the BIML for registration, and the registered certificate shall be made available on the OIML-CS register of issued certificates (PD-05 §6.4)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Issued certificate transmitted to the BIML"
      - description: "Certificate visible in the public OIML-CS register"
  }
  verification { method inspection description "BIML registration step (process register_certificate)." }
  source { doc "PD-05 §6.1" clause "" }
}
requirement /req/cs/registration-fee {
  name "BIML registration fee"
  statement "The BIML shall send the OIML Issuing Authority an invoice for the registration fee. The OIML certificate will be added to the list of registered certificates but will be withdrawn if payment is not received from the OIML Issuing Authority within 3 months of the invoice date. The registration fee is set by the CIML (PD-05 §6.2 Note 1); the Issuing Authority may choose to pass the registration fee on to the owner of the certificate, in which case the exact amount in Euros shall be charged (PD-05 §6.2 Note 2)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "BIML invoice for the registration fee sent to the Issuing Authority"
      - description: "Certificate listing withdrawn when payment is not received within 3 months of the invoice date"
      - description: "Pass-through to the owner charges the exact amount in Euros"
  }
  verification { method inspection description "BIML registration fee handling (abstract process registration_fee — unrealized; named gap)." }
  source { doc "PD-05 §6.2" clause "" }
}
requirement /req/cs/registration-withdrawal {
  name "Registration fee invoiced to the owner"
  statement "Where national regulations do not permit the OIML Issuing Authority to pass the BIML registration fee on to the owner of the OIML certificate, the BIML shall invoice the owner of the certificate instead of the Issuing Authority. When the owner is invoiced, the OIML certificate will be added to the list of registered certificates when payment has been received."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Owner invoiced directly where national regulations bar pass-through"
      - description: "Certificate listed when the owner's payment has been received"
  }
  verification { method inspection description "BIML registration fee handling (abstract process registration_fee — unrealized; named gap)." }
  source { doc "PD-05 §6.3" clause "" }
}
requirement /req/cs/incorrect-conclusions {
  name "Certificate issued on incorrect conclusions"
  statement "The Executive Secretary shall consult with the relevant OIML Issuing Authority when documented and substantiated evidence is presented indicating that the tests providing the basis for issuing the OIML certificate were performed and/or interpreted incorrectly. In this instance the procedure detailed in clause 6 of PD-01 (complaints) shall be applied."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Documented and substantiated evidence triggers Executive Secretary consultation with the Issuing Authority"
      - description: "PD-01 clause 6 procedure applied"
  }
  verification { method inspection description "Incorrect-conclusions handling (abstract process incorrect_conclusions — unrealized; named gap)." }
  source { doc "PD-05 §7.1" clause "" }
}
requirement /req/cs/certificate-revision-mechanics {
  name "Certificate revision mechanics"
  statement "When revising an OIML certificate, the Issuing Authority is responsible for determining the list of tests and examinations to be performed on the modified instrument (PD-05 §8.1.4). Where a revised certificate is issued to correct an error, the previous certificate shall be marked as being superseded in the lists maintained by the BIML when the revised certificate is registered (PD-05 §8.1.5). Where the revision concerns the transfer of ownership to a new applicant, the Issuing Authority shall verify that the new applicant is in possession of all the technical documentation defined in §4.1.2 and of the relevant OIML type evaluation report and OIML test report(s), and should make any necessary inquiry to ensure the validity of the transfer (PD-05 §8.1.6). Previous versions of OIML certificates remain on the OIML website except in the case of the correction of errors (PD-05 §8.1.7)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Retest list for the modified instrument determined by the Issuing Authority"
      - description: "Previous certificate marked superseded on registration of an error-correction revision"
      - description: "Ownership-transfer documentation possession verified, with inquiry where necessary"
      - description: "Previous certificate versions remain publicly available except error corrections"
  }
  verification { method inspection description "IA revision handling (process handle_revision)." }
  source { doc "PD-05 §8.1.4" clause "" }
}
requirement /req/cs/parallel-certificates {
  name "Certificates issued in parallel"
  statement "A new applicant may apply to the original OIML Issuing Authority to issue a new OIML certificate in parallel to the one previously issued to the original applicant, provided that the new applicant is also in possession of all the technical documentation defined in §4.1.2 and of the existing OIML type evaluation report (PD-05 §8.2.1). The Issuing Authority should make any necessary inquiry to ensure the validity of the application — including, for example, the permission of the original applicant (PD-05 §8.2.2). The registration of the OIML certificate by the BIML is performed according to clause 6 (PD-05 §8.2.3)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "New applicant's possession of the full documentation and the existing evaluation report verified"
      - description: "Validity inquiry (e.g. original applicant's permission) made where necessary"
      - description: "Parallel certificate registered per clause 6"
  }
  verification { method inspection description "IA parallel issuance (abstract process parallel_certificates; process issue_certificate)." }
  source { doc "PD-05 §8.2" clause "" }
}
requirement /req/cs/recommendation-revision-updates {
  name "Certificate update after a Recommendation revision"
  statement "After revision of the relevant OIML Recommendation, the owner of an OIML certificate issued on the basis of the previous edition may apply for updating the certificate on the basis of the revised Recommendation; the Issuing Authority must be approved by the Management Committee to issue certificates in accordance with the revised Recommendation (PD-05 §8.3.1). When reviewing the application, the Issuing Authority is responsible for determining, depending on the modifications implemented in the revised Recommendation, whether the type complies with the revised Recommendation and, if applicable, defining the additional tests and examinations to be performed (PD-05 §8.3.2). Upon successful completion of any additional tests and examinations, a new OIML certificate and OIML type evaluation report shall be issued to the owner by the relevant Issuing Authority, and the certificate registered according to clause 6 (PD-05 §8.3.3)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Update application by the certificate owner on the revised Recommendation"
      - description: "Compliance determination and additional tests defined by the Issuing Authority"
      - description: "New certificate and evaluation report issued and registered on successful completion"
  }
  verification { method inspection description "IA edition-change handling (abstract process recommendation_update; process handle_edition_change)." }
  source { doc "PD-05 §8.3" clause "" }
}
requirement /req/iso-17025/lab/personnel-impartiality-competence {
  name "Personnel impartiality and competence"
  statement "All personnel of the laboratory, either internal or external, that could influence the laboratory activities shall act impartially, be competent and work in accordance with the laboratory's management system. The laboratory shall ensure that the personnel have the competence to perform laboratory activities for which they are responsible and to evaluate the significance of deviations."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Every person influencing laboratory activities demonstrably impartial, competent and management-system-bound"
      - description: "Competence covers the evaluation of the significance of deviations"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment), outside the per-application certification process." }
  source { doc "ISO/IEC 17025:2017, 6.2.1, 6.2.3" clause "" }
}
requirement /req/iso-17025/lab/personnel-competence-requirements {
  name "Documented competence requirements per function"
  statement "The laboratory shall document the competence requirements for each function influencing the results of laboratory activities, including requirements for education, qualification, training, technical knowledge, skills and experience."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Competence requirements documented for every function influencing results"
      - description: "Documentation covers education, qualification, training, technical knowledge, skills and experience"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.2.2" clause "" }
}
requirement /req/iso-17025/lab/personnel-procedure-records {
  name "Personnel procedure and competence records"
  statement "The laboratory shall have procedure(s) and retain records for: determining the competence requirements; selection of personnel; training of personnel; supervision of personnel; authorization of personnel; monitoring competence of personnel."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Procedure(s) in place covering all six personnel-management stages"
      - description: "Records of selection, training, supervision, authorization and competence monitoring retained"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.2.5" clause "" }
}
requirement /req/iso-17025/lab/authorized-personnel {
  name "Authorized personnel for specific activities"
  statement "The laboratory shall authorize personnel to perform specific laboratory activities, including but not limited to, the following: a) development, modification, verification and validation of methods; b) analysis of results, including statements of conformity or opinions and interpretations; c) report, review and authorization of results."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Per-activity authorizations documented for every person performing 6.2.6 a–c activities"
      - description: "Statements of conformity and opinions/interpretations released only by personnel authorized for them (feeds 7.8.6/7.8.7)"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.2.6" clause "" }
}
requirement /req/iso-17025/lab/equipment-conformity {
  name "Equipment conformity and capability"
  statement "The laboratory shall verify that equipment conforms to specified requirements before being placed or returned into service. The equipment used for measurement shall be capable of achieving the measurement accuracy and/or measurement uncertainty required to provide a valid result."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Conformity verification recorded before (re-)entry into service"
      - description: "Demonstrated capability of the required accuracy / measurement uncertainty"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.4.4, 6.4.5" clause "" }
}
requirement /req/iso-17025/lab/equipment-calibration {
  name "Equipment calibration"
  statement "Measuring equipment shall be calibrated when: the measurement accuracy or measurement uncertainty affects the validity of the reported results, and/or calibration of the equipment is required to establish the metrological traceability of the reported results. (Equipment having an effect on the validity of the reported results includes that used for the direct measurement of the measurand, that used to make corrections to the measured value, and that used to obtain a result calculated from multiple quantities.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Every validity-affecting / traceability-required instrument calibrated"
      - description: "Calibration certificates current at the time of use"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.4.6" clause "" }
}
requirement /req/iso-17025/lab/calibration-programme {
  name "Calibration programme and status identification"
  statement "The laboratory shall establish a calibration programme, which shall be reviewed and adjusted as necessary in order to maintain confidence in the status of calibration. All equipment requiring calibration or which has a defined period of validity shall be labelled, coded or otherwise identified to allow the user of the equipment to readily identify the status of calibration or period of validity."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Calibration programme established, reviewed and adjusted"
      - description: "Calibration status / validity period identifiable on every instrument concerned"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.4.7, 6.4.8" clause "" }
}
requirement /req/iso-17025/lab/equipment-records {
  name "Equipment records"
  statement "Records shall be retained for equipment which can influence laboratory activities. The records shall include the following, where applicable: a) the identity of equipment, including software and firmware version; b) the manufacturer's name, type identification, and serial number or other unique identification; c) evidence of verification that equipment conforms with specified requirements; d) the current location; e) calibration dates, results of calibrations, adjustments, acceptance criteria, and the due date of the next calibration or the calibration interval; f) documentation of reference materials, results, acceptance criteria, relevant dates and the period of validity; g) the maintenance plan and maintenance carried out to date, where relevant to the performance of the equipment; h) details of any damage, malfunction, modification to, or repair of, the equipment."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "A retained record exists for every instrument that can influence laboratory activities"
      - description: "Each record carries the applicable 6.4.13 a–h items"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.4.13" clause "" }
}
requirement /req/iso-17025/lab/traceability-chain {
  name "Metrological traceability chain"
  statement "The laboratory shall establish and maintain metrological traceability of its measurement results by means of a documented unbroken chain of calibrations, each contributing to the measurement uncertainty, linking them to an appropriate reference."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Documented unbroken calibration chain from every reported result to its reference"
      - description: "Every link's contribution to the measurement uncertainty recorded"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.5.1" clause "" }
}
requirement /req/iso-17025/lab/si-traceability {
  name "Traceability to the SI"
  statement "The laboratory shall ensure that measurement results are traceable to the International System of Units (SI) through: a) calibration provided by a competent laboratory (laboratories fulfilling the requirements of this document are considered to be competent); or b) certified values of certified reference materials provided by a competent producer with stated metrological traceability to the SI (reference material producers fulfilling ISO 17034 are considered to be competent); or c) direct realization of the SI units ensured by comparison, directly or indirectly, with national or international standards. (Annex A.2.1: establishing traceability considers and ensures the specification of the measurand, a documented unbroken chain of calibrations going back to stated and appropriate references, measurement uncertainty evaluated for each step according to agreed methods, each step performed in accordance with appropriate methods with recorded results and associated uncertainties, and evidence of the technical competence of the laboratories performing the chain's steps. Annex A.3.1: internationally accepted demonstration paths include the CIPM MRA / BIPM KCDB and accreditation under the ILAC Arrangement; A.3.2: the Joint BIPM, OIML, ILAC and ISO Declaration on Metrological Traceability.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "SI traceability of every reported result via one of the 6.5.2 a–c routes"
      - description: "Chain-laboratory competence evidence (accreditation / CIPM MRA listing) on file"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.5.2, Annex A.2.1, A.3 (Annex A informative)" clause "" }
}
requirement /req/iso-17025/lab/non-si-traceability {
  name "Traceability when SI realization is not possible"
  statement "When metrological traceability to the SI units is not technically possible, the laboratory shall demonstrate metrological traceability to an appropriate reference, e.g.: a) certified values of certified reference materials provided by a competent producer; b) results of reference measurement procedures, specified methods or consensus standards that are clearly described and accepted as providing measurement results fit for their intended use and ensured by suitable comparison."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Non-SI traceability demonstrated to an appropriate reference wherever SI traceability is technically impossible"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, 6.5.3" clause "" }
}
requirement /req/iso-17025/lab/conformity-only-dissemination {
  name "Conformity-only dissemination of traceability"
  statement "Measurement standards that have reported information from a competent laboratory that includes only a statement of conformity to a specification (omitting the measurement results and associated uncertainties) are sometimes used to disseminate metrological traceability. This approach, in which the specification limits are imported as the source of uncertainty, is dependent upon: a) the use of an appropriate decision rule to establish conformity; b) the specification limits subsequently being treated in a technically appropriate way in the uncertainty budget. (Example: the use of OIML R 111 class weights to calibrate a balance.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Conformity-only dissemination relies on an appropriate decision rule"
      - description: "Imported specification limits treated technically appropriately in the uncertainty budget"
  }
  verification { method deferred description "Verified by assessment of the laboratory (accreditation or OIML-CS peer assessment)." }
  source { doc "ISO/IEC 17025:2017, Annex A.2.3 (informative)" clause "" }
}
requirement /req/iso-17025/process/request-review {
  name "Review of requests, tenders and contracts"
  statement "The laboratory shall have a procedure for the review of requests, tenders and contracts. The procedure shall ensure that: a) the requirements are adequately defined, documented and understood; b) the laboratory has the capability and resources to meet the requirements; c) where external providers are used, the requirements of 6.6 are applied and the laboratory advises the customer of the specific laboratory activities to be performed by the external provider and gains the customer's approval; d) the appropriate methods or procedures are selected and are capable of meeting the customers' requirements."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Request/tender/contract review procedure in place covering 7.1.1 a–d"
      - description: "Capability, resources and method adequacy confirmed before acceptance"
  }
  verification { method inspection description "Request-review step (abstract process request_review)." }
  source { doc "ISO/IEC 17025:2017, 7.1.1" clause "" }
}
requirement /req/iso-17025/process/decision-rule {
  name "Decision rule for statements of conformity"
  statement "When the customer requests a statement of conformity to a specification or standard for the test or calibration (e.g. pass/fail, in-tolerance/out-of-tolerance), the specification or standard and the decision rule shall be clearly defined. Unless inherent in the requested specification or standard, the decision rule selected shall be communicated to, and agreed with, the customer."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Specification/standard and decision rule clearly defined for every requested conformity statement"
      - description: "Non-inherent decision rules communicated to and agreed with the customer"
  }
  verification { method inspection description "Request-review step (abstract process request_review; the decision-rule triangle 3.7 + 7.1.3 + 7.8.6)." }
  source { doc "ISO/IEC 17025:2017, 7.1.3" clause "" }
}
requirement /req/iso-17025/process/method-selection {
  name "Selection of methods"
  statement "The laboratory shall use appropriate methods and procedures for all laboratory activities and, where appropriate, for evaluation of the measurement uncertainty as well as statistical techniques for analysis of data. The laboratory shall ensure that it uses the latest valid version of a method unless it is not appropriate or possible to do so; when necessary, the application of the method shall be supplemented with additional details to ensure consistent application. When the customer does not specify the method to be used, the laboratory shall select an appropriate method and inform the customer of the method chosen."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Appropriate, latest-valid-version methods in use for every laboratory activity"
      - description: "Customer informed of the method chosen when it did not specify one"
  }
  verification { method inspection description "Method-selection step (abstract process method_selection)." }
  source { doc "ISO/IEC 17025:2017, 7.2.1.1, 7.2.1.3, 7.2.1.4" clause "" }
}
requirement /req/iso-17025/process/method-verification {
  name "Verification of methods"
  statement "The laboratory shall verify that it can properly perform methods before introducing them by ensuring that it can achieve the required performance. Records of the verification shall be retained. If the method is revised by the issuing body, verification shall be repeated to the extent necessary. Deviations from methods for all laboratory activities shall occur only if the deviation has been documented, technically justified, authorized, and accepted by the customer."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Method verification performed before introduction and repeated on method revision; records retained"
      - description: "Every deviation documented, technically justified, authorized and customer-accepted"
  }
  verification { method inspection description "Method-selection step (abstract process method_selection)." }
  source { doc "ISO/IEC 17025:2017, 7.2.1.5, 7.2.1.7" clause "" }
}
requirement /req/iso-17025/process/method-validation {
  name "Validation of methods"
  statement "The laboratory shall validate non-standard methods, laboratory-developed methods and standard methods used outside their intended scope or otherwise modified. The validation shall be as extensive as is necessary to meet the needs of the given application or field of application. The laboratory shall retain the following records of validation: a) the validation procedure used; b) specification of the requirements; c) determination of the performance characteristics of the method; d) results obtained; e) a statement on the validity of the method, detailing its fitness for the intended use."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Validation performed for every non-standard / laboratory-developed / out-of-scope / modified method"
      - description: "Validation records 7.2.2.4 a–e retained"
  }
  verification { method inspection description "Method-validation step (abstract process method_validation)." }
  source { doc "ISO/IEC 17025:2017, 7.2.2.1, 7.2.2.4" clause "" }
}
requirement /req/iso-17025/process/sampling-plan {
  name "Sampling plan and method"
  statement "The laboratory shall have a sampling plan and method when it carries out sampling of substances, materials or products for subsequent testing or calibration. The sampling method shall address the factors to be controlled to ensure the validity of subsequent testing or calibration results. The sampling plan and method shall be available at the site where sampling is undertaken. Sampling plans shall, whenever reasonable, be based on appropriate statistical methods. The sampling method shall describe: a) the selection of samples or sites; b) the sampling plan; c) the preparation and treatment of sample(s) from a substance, material or product to yield the required item for subsequent testing or calibration."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Sampling plan and method available at the sampling site, statistically based whenever reasonable"
      - description: "Method describes sample/site selection, the plan, and preparation/treatment"
  }
  verification { method inspection description "Sampling step (abstract process sampling)." }
  source { doc "ISO/IEC 17025:2017, 7.3.1, 7.3.2" clause "" }
}
requirement /req/iso-17025/process/sampling-records {
  name "Sampling records"
  statement "The laboratory shall retain records of sampling data that forms part of the testing or calibration that is undertaken. These records shall include, where relevant: a) reference to the sampling method used; b) date and time of sampling; c) data to identify and describe the sample; d) identification of the personnel performing sampling; e) identification of the equipment used; f) environmental or transport conditions; g) diagrams or other equivalent means to identify the sampling location, when appropriate; h) deviations, additions to or exclusions from the sampling method and sampling plan."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Sampling records with the relevant 7.3.3 a–h content retained"
  }
  verification { method inspection description "Sampling step (abstract process sampling)." }
  source { doc "ISO/IEC 17025:2017, 7.3.3" clause "" }
}
requirement /req/iso-17025/process/item-handling {
  name "Handling and identification of items"
  statement "The laboratory shall have a procedure for the transportation, receipt, handling, protection, storage, retention, and disposal or return of test or calibration items, including all provisions necessary to protect the integrity of the item and to protect the interests of the laboratory and the customer; precautions shall be taken to avoid deterioration, contamination, loss or damage, and handling instructions provided with the item shall be followed. The laboratory shall have a system for the unambiguous identification of test or calibration items; the identification shall be retained while the item is under the responsibility of the laboratory and shall ensure that items will not be confused physically or in records, accommodating, if appropriate, a sub-division of an item or groups of items and the transfer of items."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Item-handling procedure covering transport to disposal/return with integrity precautions"
      - description: "Unambiguous identification retained for the whole period of laboratory responsibility"
  }
  verification { method inspection description "Item-handling step (abstract process item_handling)." }
  source { doc "ISO/IEC 17025:2017, 7.4.1, 7.4.2" clause "" }
}
requirement /req/iso-17025/process/item-receipt-storage {
  name "Item receipt deviations and storage conditions"
  statement "Upon receipt of the test or calibration item, deviations from specified conditions shall be recorded. When there is doubt about the suitability of an item for test or calibration, or when an item does not conform to the description provided, the laboratory shall consult the customer for further instructions before proceeding and shall record the results of this consultation; when the customer requires the item to be tested or calibrated acknowledging a deviation from specified conditions, the laboratory shall include a disclaimer in the report indicating which results may be affected by the deviation. When items need to be stored or conditioned under specified environmental conditions, these conditions shall be maintained, monitored and recorded."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Receipt deviations recorded; doubtful items consulted on before proceeding"
      - description: "Storage/conditioning conditions maintained, monitored and recorded; disclaimer where applicable"
  }
  verification { method inspection description "Item-handling step (abstract process item_handling)." }
  source { doc "ISO/IEC 17025:2017, 7.4.3, 7.4.4" clause "" }
}
requirement /req/iso-17025/process/activity-records {
  name "Technical records of laboratory activities"
  statement "The laboratory shall ensure that technical records for each laboratory activity contain the results, report and sufficient information to facilitate, if possible, identification of factors affecting the measurement result and its associated measurement uncertainty and enable the repetition of the laboratory activity under conditions as close as possible to the original. The technical records shall include the date and the identity of personnel responsible for each laboratory activity and for checking data and results. Original observations, data and calculations shall be recorded at the time they are made and shall be identifiable with the specific task."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Per-activity records enable repetition under near-original conditions and identify affecting factors"
      - description: "Date, responsible personnel and data/result checkers identified; original observations recorded when made"
  }
  verification { method inspection description "Test-execution step (abstract process test_execution)." }
  source { doc "ISO/IEC 17025:2017, 7.5.1" clause "" }
}
requirement /req/iso-17025/process/record-amendments {
  name "Amendments to technical records"
  statement "The laboratory shall ensure that amendments to technical records can be tracked to previous versions or to original observations. Both the original and amended data and files shall be retained, including the date of alteration, an indication of the altered aspects and the personnel responsible for the alterations."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Amendments trackable to previous versions/original observations"
      - description: "Original and amended data retained with date, altered aspects and responsible personnel"
  }
  verification { method inspection description "Technical-records discipline (abstract process technical_records)." }
  source { doc "ISO/IEC 17025:2017, 7.5.2" clause "" }
}
requirement /req/iso-17025/process/measurement-uncertainty {
  name "Evaluation of measurement uncertainty"
  statement "Laboratories shall identify the contributions to measurement uncertainty; when evaluating measurement uncertainty, all contributions that are of significance, including those arising from sampling, shall be taken into account using appropriate methods of analysis. A laboratory performing calibrations, including of its own equipment, shall evaluate the measurement uncertainty for all calibrations. A laboratory performing testing shall evaluate measurement uncertainty; where the test method precludes rigorous evaluation of measurement uncertainty, an estimation shall be made based on an understanding of the theoretical principles or practical experience of the performance of the method. (Following a well-recognized test method that specifies limits to the values of the major sources of measurement uncertainty and specifies the form of presentation of the calculated results satisfies 7.6.3.)"
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "All significant MU contributions identified, including sampling contributions"
      - description: "MU evaluated for all calibrations and for testing (estimated where the method precludes rigour)"
  }
  verification { method inspection description "Measurement-uncertainty step (abstract process measurement_uncertainty)." }
  source { doc "ISO/IEC 17025:2017, 7.6.1, 7.6.2, 7.6.3" clause "" }
}
requirement /req/iso-17025/process/validity-of-results {
  name "Ensuring the validity of results"
  statement "The laboratory shall have a procedure for monitoring the validity of results; the resulting data shall be recorded in such a way that trends are detectable and, where practicable, statistical techniques shall be applied to review the results. This monitoring shall be planned and reviewed (including, where appropriate, use of reference materials, alternative traceable instrumentation, functional checks, check standards with control charts, intermediate checks, replicate tests, retesting of retained items, correlation of results, review of reported results, intralaboratory comparisons and blind-sample testing). The laboratory shall monitor its performance by comparison with results of other laboratories, where available and appropriate, including participation in proficiency testing and/or interlaboratory comparisons other than proficiency testing. Data from monitoring activities shall be analysed, used to control and, if applicable, improve the laboratory's activities; results outside pre-defined criteria shall lead to appropriate action to prevent incorrect results from being reported."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Validity-monitoring procedure with trend-detectable recording, planned and reviewed"
      - description: "Interlaboratory comparison / proficiency testing participation where available and appropriate"
      - description: "Out-of-criteria analysis followed by action preventing incorrect reporting"
  }
  verification { method inspection description "Validity-monitoring step (abstract process validity_monitoring)." }
  source { doc "ISO/IEC 17025:2017, 7.7.1, 7.7.2, 7.7.3" clause "" }
}
requirement /req/iso-17025/process/results-review-release {
  name "Review and authorization of results before release"
  statement "The results shall be reviewed and authorized prior to release. The results shall be provided accurately, clearly, unambiguously and objectively, usually in a report (e.g. a test report or a calibration certificate or report of sampling), and shall include all the information agreed with the customer and necessary for the interpretation of the results and all information required by the method used. All issued reports shall be retained as technical records."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Review and authorization of results recorded before every release"
      - description: "Issued reports retained as technical records"
  }
  verification { method inspection description "Reporting step (abstract process reporting)." }
  source { doc "ISO/IEC 17025:2017, 7.8.1.1, 7.8.1.2" clause "" }
}
requirement /req/iso-17025/process/report-common-content {
  name "Common report content"
  statement "Each report shall include at least the following information, unless the laboratory has valid reasons for not doing so, thereby minimizing any possibility of misunderstanding or misuse: a) a title; b) the name and address of the laboratory; c) the location of performance of the laboratory activities, including when performed at a customer facility or at sites away from the laboratory's permanent facilities, or in associated temporary or mobile facilities; d) unique identification that all its components are recognized as a portion of a complete report and a clear identification of the end; e) the name and contact information of the customer; f) identification of the method used; g) a description, unambiguous identification, and, when necessary, the condition of the item; h) the date of receipt of the test or calibration item(s), and the date of sampling, where this is critical to the validity and application of the results; i) the date(s) of performance of the laboratory activity; j) the date of issue of the report; k) reference to the sampling plan and sampling method used by the laboratory or other bodies where these are relevant to the validity or application of the results; l) a statement to the effect that the results relate only to the items tested, calibrated or sampled; m) the results with, where appropriate, the units of measurement; n) additions to, deviations, or exclusions from the method; o) identification of the person(s) authorizing the report; p) clear identification when results are from external providers. The laboratory shall be responsible for all the information provided in the report, except when information is provided by the customer; customer-provided data shall be clearly identified and a disclaimer placed on the report when it can affect the validity of results; where the laboratory has not been responsible for the sampling stage, it shall state in the report that the results apply to the sample as received."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Every report carries the 7.8.2.1 a–p content (or documented valid reasons)"
      - description: "Customer-provided data identified and disclaimed; sample-as-received statement where applicable"
  }
  verification { method inspection description "Reporting step (abstract process reporting)." }
  source { doc "ISO/IEC 17025:2017, 7.8.2.1, 7.8.2.2" clause "" }
}
requirement /req/iso-17025/process/test-report-content {
  name "Test-report specific content"
  statement "In addition to the requirements listed in 7.8.2, test reports shall, where necessary for the interpretation of the test results, include the following: a) information on specific test conditions, such as environmental conditions; b) where relevant, a statement of conformity with requirements or specifications (see 7.8.6); c) where applicable, the measurement uncertainty presented in the same unit as that of the measurand or in a term relative to the measurand when it is relevant to the validity or application of the test results, when a customer's instruction so requires, or when the measurement uncertainty affects conformity to a specification limit; d) where appropriate, opinions and interpretations (see 7.8.7); e) additional information that may be required by specific methods, authorities, customers or groups of customers."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Test reports carry the 7.8.3.1 a–e content where necessary for interpretation"
      - description: "MU reported in measurand units or relative terms when validity-relevant, customer-required, or conformity-affecting"
  }
  verification { method inspection description "Reporting step (abstract process reporting)." }
  source { doc "ISO/IEC 17025:2017, 7.8.3.1" clause "" }
}
requirement /req/iso-17025/process/conformity-statements {
  name "Statements of conformity"
  statement "When a statement of conformity to a specification or standard is provided, the laboratory shall document the decision rule employed, taking into account the level of risk (such as false accept and false reject and statistical assumptions) associated with the decision rule employed, and apply the decision rule. (Where the decision rule is prescribed by the customer, regulations or normative documents, a further consideration of the level of risk is not necessary.) The laboratory shall report on the statement of conformity, such that the statement clearly identifies: a) to which results the statement of conformity applies; b) which specifications, standards or parts thereof are met or not met; c) the decision rule applied (unless it is inherent in the requested specification or standard)."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Decision rule documented (risk taken into account) and applied"
      - description: "Statement identifies the results covered, the specifications met/not met, and the decision rule"
  }
  verification { method inspection description "Reporting step (abstract process reporting)." }
  source { doc "ISO/IEC 17025:2017, 7.8.6.1, 7.8.6.2" clause "" }
}
requirement /req/iso-17025/process/opinions-interpretations {
  name "Opinions and interpretations"
  statement "When opinions and interpretations are expressed, the laboratory shall ensure that only personnel authorized for the expression of opinions and interpretations release the respective statement; the laboratory shall document the basis upon which the opinions and interpretations have been made. (Opinions and interpretations are to be distinguished from statements of inspections and product certifications as intended in ISO/IEC 17020 and ISO/IEC 17065, and from statements of conformity as referred to in 7.8.6.) The opinions and interpretations expressed in reports shall be based on the results obtained from the tested or calibrated item and shall be clearly identified as such. When opinions and interpretations are directly communicated by dialogue with the customer, a record of the dialogue shall be retained."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Opinions/interpretations released only by personnel authorized for them (6.2.6 b)"
      - description: "Basis documented; clearly identified as based on the tested/calibrated item's results; dialogues recorded"
  }
  verification { method inspection description "Reporting step (abstract process reporting)." }
  source { doc "ISO/IEC 17025:2017, 7.8.7.1, 7.8.7.2, 7.8.7.3" clause "" }
}
requirement /req/iso-17025/process/report-amendments {
  name "Amendments to reports"
  statement "When an issued report needs to be changed, amended or re-issued, any change of information shall be clearly identified and, where appropriate, the reason for the change included in the report. Amendments to a report after issue shall be made only in the form of a further document, or data transfer, which includes the statement \"Amendment to Report, serial number... [or as otherwise identified]\", or an equivalent form of wording, and shall meet all the requirements of this document. When it is necessary to issue a complete new report, this shall be uniquely identified and shall contain a reference to the original that it replaces."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Post-issue changes only via an identified amendment document or a uniquely identified replacement report"
  }
  verification { method inspection description "Reporting step (abstract process reporting)." }
  source { doc "ISO/IEC 17025:2017, 7.8.8.1, 7.8.8.2, 7.8.8.3" clause "" }
}
requirement /req/iso-17025/process/complaints {
  name "Complaints"
  statement "The laboratory shall have a documented process to receive, evaluate and make decisions on complaints; a description of the handling process shall be available to any interested party on request. Upon receipt of a complaint, the laboratory shall confirm whether the complaint relates to laboratory activities that it is responsible for and, if so, shall deal with it; the laboratory shall be responsible for all decisions at all levels of the handling process. The process shall include at least: a) a description of the process for receiving, validating, investigating the complaint, and deciding what actions are to be taken in response to it; b) tracking and recording complaints, including actions undertaken to resolve them; c) ensuring that any appropriate action is taken. The laboratory receiving the complaint shall be responsible for gathering and verifying all necessary information to validate the complaint. Whenever possible, the laboratory shall acknowledge receipt of the complaint, and provide the complainant with progress reports and the outcome; the outcomes to be communicated to the complainant shall be made by, or reviewed and approved by, individual(s) not involved in the original laboratory activities in question. Whenever possible, the laboratory shall give formal notice of the end of the complaint handling to the complainant."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Documented receive/validate/investigate/decide process with tracking and recording"
      - description: "Outcomes decided or reviewed/approved by individuals not involved in the original activities"
  }
  verification { method inspection description "Complaint-handling step (abstract process complaint_handling)." }
  source { doc "ISO/IEC 17025:2017, 7.9.1, 7.9.2, 7.9.3, 7.9.4, 7.9.5, 7.9.6, 7.9.7" clause "" }
}
requirement /req/iso-17025/process/nonconforming-work {
  name "Nonconforming work"
  statement "The laboratory shall have a procedure that shall be implemented when any aspect of its laboratory activities or results of this work do not conform to its own procedures or the agreed requirements of the customer. The procedure shall ensure that: a) the responsibilities and authorities for the management of nonconforming work are defined; b) actions (including halting or repeating of work and withholding of reports, as necessary) are based upon the risk levels established by the laboratory; c) an evaluation is made of the significance of the nonconforming work, including an impact analysis on previous results; d) a decision is taken on the acceptability of the nonconforming work; e) where necessary, the customer is notified and work is recalled; f) the responsibility for authorizing the resumption of work is defined. The laboratory shall retain records of nonconforming work and actions as specified in 7.10.1 b) to f). Where the evaluation indicates that the nonconforming work could recur, or that there is doubt about the conformity of the laboratory's operations with its own management system, the laboratory shall implement corrective action."
  obligation shall
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Nonconforming-work procedure with risk-based actions, significance evaluation and acceptability decision"
      - description: "Records retained; corrective action implemented where recurrence is possible"
  }
  verification { method inspection description "Nonconforming-work step (abstract process nonconforming_work)." }
  source { doc "ISO/IEC 17025:2017, 7.10.1, 7.10.2, 7.10.3" clause "" }
}
requirement /req/iso-17067/scheme-content/scope {
  name "Scope of the scheme"
  statement "The scheme should specify the scope of the scheme, including the type of products covered."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Scheme scope documented, naming the type of products covered"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 a)" clause "" }
}
requirement /req/iso-17067/scheme-content/requirements {
  name "Requirements against which products are evaluated"
  statement "The scheme should specify the requirements against which the products are evaluated, by reference to standards or other normative documents; where it is necessary to elaborate upon the requirements to remove ambiguity, the explanations should be formulated by competent people and should be made available to all interested parties. (ISO/IEC 17007 provides further guidance on how to formulate specified requirements.)"
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Evaluation requirements referenced to standards or other normative documents"
      - description: "Ambiguity-removing elaborations formulated by competent people and available to all interested parties"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 b)" clause "" }
}
requirement /req/iso-17067/scheme-content/activities {
  name "Selection of activities"
  statement "The scheme should specify the selection of the activities (see Table 1) appropriate to the purpose and the scope of the scheme; as a minimum, a certification scheme should include the functions and activities I, II, III, IV and V a)."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Scheme activities selected from Table 1 appropriate to the scheme's purpose and scope"
      - description: "The minimum set — selection (I), determination (II), review (III), decision (IV), attestation by issue of a statement of conformity (V a) — present"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 c)" clause "" }
}
requirement /req/iso-17067/scheme-content/client-requirements {
  name "Other client requirements"
  statement "The scheme should specify other requirements to be met by the client, e.g. the operation of a management system or process control activities to assure the demonstration of fulfilment of specified requirements is valid for the ongoing production of certified products."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Client obligations beyond product conformity (management-system or process-control requirements, where applicable) documented"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 d)" clause "" }
}
requirement /req/iso-17067/scheme-content/cab-requirements {
  name "Requirements for conformity assessment bodies"
  statement "The scheme should specify the requirements for certification bodies and other conformity assessment bodies involved in the certification process; these requirements should not be in contradiction to the requirements of the applicable standards for conformity assessment bodies."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Body requirements documented for every conformity assessment body kind involved in the certification process"
      - description: "No contradiction with the applicable CAB standards (ISO/IEC 17065, ISO/IEC 17025, ISO/IEC 17020 as applicable)"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 e)" clause "" }
}
requirement /req/iso-17067/scheme-content/cab-qualification {
  name "Qualification of conformity assessment bodies"
  statement "The scheme should specify whether conformity assessment bodies involved in the scheme (e.g. testing laboratories, inspection bodies, product certification bodies, bodies auditing manufacturers' management systems) are to be accredited, participate in peer assessment or qualified in another manner; if the scheme is to require that conformity assessment bodies are accredited, the appropriate references should be specified, e.g. that the accreditation body is a member of a mutual recognition arrangement between accreditation bodies."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Qualification mode (accreditation, peer assessment or other) specified per body kind"
      - description: "Where accreditation is required, the appropriate references specified (e.g. mutual-recognition-arrangement membership of the accreditation body)"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 f)" clause "" }
}
requirement /req/iso-17067/scheme-content/methods-procedures {
  name "Methods and procedures"
  statement "The scheme should specify the methods and procedures to be used by the conformity assessment bodies and other organizations involved in the certification process, so as to assure the integrity and consistency of the outcome of the conformity assessment process."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Methods and procedures documented for the bodies and organizations involved"
      - description: "Integrity and consistency of the conformity assessment outcome addressed"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 g)" clause "" }
}
requirement /req/iso-17067/scheme-content/applicant-information {
  name "Applicant information"
  statement "The scheme should specify the information to be supplied to the certification body by an applicant for certification."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "The application information set documented"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 h)" clause "" }
}
requirement /req/iso-17067/scheme-content/statement-of-conformity {
  name "Content of the statement of conformity"
  statement "The scheme should specify the content of the statement of conformity (e.g. certificate) which unambiguously identifies the product to which it applies."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Statement-of-conformity content specified, unambiguously identifying the product it applies to"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 i)" clause "" }
}
requirement /req/iso-17067/scheme-content/statement-and-mark-use {
  name "Conditions for use of the statement of conformity and marks"
  statement "The scheme should specify the conditions under which the client may use the statement of conformity or marks of conformity."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Conditions for the client's use of the statement of conformity (and of marks, where the scheme provides them) documented"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 j)" clause "" }
}
requirement /req/iso-17067/scheme-content/mark-ownership-control {
  name "Ownership, use and control of marks of conformity"
  statement "Where marks of conformity may be used, the scheme should specify the ownership, use and control of the marks; the requirements of ISO/IEC 17030 should be applied."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Mark ownership, use and control documented where marks of conformity may be used"
      - description: "ISO/IEC 17030 requirements applied"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 k)" clause "" }
}
requirement /req/iso-17067/scheme-content/scheme-resources {
  name "Resources for the operation of the scheme"
  statement "The scheme should specify the resources required for the operation of the scheme, including impartiality and competence of the personnel (internal and external), the evaluation resources, and the use of subcontractors."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Operating resources documented — personnel impartiality and competence (internal and external), evaluation resources, subcontracting"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 l)" clause "" }
}
requirement /req/iso-17067/scheme-content/results-reporting {
  name "Reporting and use of determination and surveillance results"
  statement "The scheme should specify how the results of the determination (evaluation) and surveillance stages are to be reported and used by the certification body and the scheme owner."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Reporting flow and use of determination (evaluation) and surveillance results by the certification body and the scheme owner documented"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 m)" clause "" }
}
requirement /req/iso-17067/scheme-content/nonconformity-resolution {
  name "Dealing with nonconformities"
  statement "The scheme should specify the question of how non-conformities with the certification requirements, which include product requirements, are to be dealt with and resolved."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Handling and resolution of nonconformities with the certification requirements (including product requirements) documented"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 n)" clause "" }
}
requirement /req/iso-17067/scheme-content/surveillance-procedures {
  name "Surveillance procedures"
  statement "The scheme should specify surveillance procedures, where surveillance is part of the scheme. (Type-conditioned: a scheme classified type 1a or 1b — specification/scheme-types.yaml, 5.3.1 — requires no surveillance, so the provision is N/A for such a scheme with the classification justification.)"
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Surveillance procedures (the Table-1 VI activities selected per the scheme type) documented — or the scheme's type-1a/1b classification recorded as the N/A justification"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 o)" clause "" }
}
requirement /req/iso-17067/scheme-content/access-criteria {
  name "Access criteria"
  statement "The scheme should specify the criteria for access of conformity assessment bodies to the scheme and for the access of clients to the scheme."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Access criteria documented for conformity assessment bodies and for clients"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 p)" clause "" }
}
requirement /req/iso-17067/scheme-content/directory {
  name "Directory of certified products"
  statement "The scheme should specify the content, conditions and responsibility for publication of the directory of certified products by the certification body or the scheme owner."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Directory content, publication conditions and the responsible party (certification body or scheme owner) documented"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 q)" clause "" }
}
requirement /req/iso-17067/scheme-content/contracts {
  name "Contracts"
  statement "The scheme should specify the need for, and content of, contracts, e.g. between scheme owner and certification body, scheme owner and clients, certification body and clients: the rights, responsibilities and liabilities of the various parties should be defined in contracts. (An example contract between a certification body and its clients can be found in ISO/IEC Guide 28:2004, Annex B.)"
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Contract needs identified for the scheme's party relations and contract content defining the parties' rights, responsibilities and liabilities"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 r)" clause "" }
}
requirement /req/iso-17067/scheme-content/certification-lifecycle {
  name "Conditions for granting, maintaining, suspending and withdrawing certification"
  statement "The scheme should specify general conditions for granting, maintaining, continuing, extending the scope of, reducing the scope of, suspending and withdrawing certification: this includes requirements for discontinuation of advertising and return of certification documents and any other action if the certification is suspended, withdrawn or terminated."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "General conditions documented for granting, maintaining, continuing, extending, reducing, suspending and withdrawing certification"
      - description: "Suspension/withdrawal/termination actions specified (discontinuation of advertising, return of certification documents, other actions)"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 s)" clause "" }
}
requirement /req/iso-17067/scheme-content/complaints-records-verification {
  name "Verification of clients' complaints records"
  statement "The scheme should specify the way in which the clients' complaints records are to be verified if such verification is part of the scheme."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Verification of clients' complaints records documented where such verification is part of the scheme"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 t)" clause "" }
}
requirement /req/iso-17067/scheme-content/scheme-reference-in-publicity {
  name "Client reference to the scheme in publicity"
  statement "The scheme should specify the way in which the clients make reference to the scheme in their publicity material."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Rules for client references to the scheme in publicity material documented"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 u)" clause "" }
}
requirement /req/iso-17067/scheme-content/records-retention {
  name "Retention of records"
  statement "The scheme should specify retention of records by scheme owner and certification bodies."
  obligation should
  acceptance_criteria {
    type: "qualitative"
    items:
      - description: "Record-retention obligations documented for the scheme owner and the certification bodies"
  }
  verification { method deferred description "Verified by assessment of the scheme corpus (the task-43 oiml-cs→17067 scheme-completeness map)." }
  source { doc "ISO/IEC 17067:2013, 6.5.1 v)" clause "" }
}
requirement /req/class-a/mpe {
  name "Class A MPE"
  statement "For Class A load cells, the maximum permissible error shall not exceed: 0 ≤ L < 50000v: 0.5 × p_LC 50000 ≤ L < 200000v: 1.0 × p_LC L ≥ 200000v: 1.5 × p_LC"
  binds_to { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc }
  parameters {
    param p_LC: number { description "Apportioning factor" unit "dimensionless" default 0.7 range { min 0.3 max 1 } }
  }
  limit {
    expression "ocl{group.parameters.mpe = lookupMPE(load, group.classification.accuracy_class, family.parameters.p_lc)}"
    uses { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc formula:lookupMPE table:mpe_tiers }
  }
  acceptance_criteria {
    type: "tiered"
    description: "Class A MPE with breakpoints at 50000v and 200000v (Table 4 of R 60-1).\n"
    variable: "load"
    variable_unit: "v"
    limit_expression: "factor × p_LC"
    referenced_function: "lookupMPE"
    tiers:
      - range:
          min: 0
          max: 50000
        limit:
          factor: 0.5
          expression: "0.5 × p_LC"
      - range:
          min: 50000
          max: 200000
        limit:
          factor: 1
          expression: "1.0 × p_LC"
      - range:
          min: 200000
        limit:
          factor: 1.5
          expression: "1.5 × p_LC"
  }
  dependencies { /req/metrological/mpe }
  ref derives-from "urn:oiml:pub:r:60-1:2021#table-4"
}
requirement /req/class-a/repeatability {
  name "Class A repeatability"
  statement "For Class A load cells, the repeatability error shall not exceed the absolute value of MPE for that load, determined using 5 runs."
  binds_to { group.parameters.mpe group.classification.accuracy_class }
  parameters {
    param runs: integer { description "Number of identical load applications per test point" default 5 range { min 5 max 5 } }
  }
  limit {
    expression "ocl{abs(e_r) <= abs(group.parameters.mpe)}"
    uses { observable:e_r group.parameters.mpe group.classification.accuracy_class table:test_runs }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class A repeatability error ≤ |MPE|, determined using 5 runs.\n"
    limit:
      expression: "|E_R|"
      operator: "lte"
      threshold_expression: "|MPE|"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "per load point, across 5 runs"
  }
  dependencies { /req/metrological/repeatability }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.4"
}
requirement /req/class-a/temperature-effect-mdlo {
  name "Class A temperature effect on MDLO"
  statement "For Class A load cells, the temperature effect on minimum dead load output shall not exceed p_LC × v_min per 2°C temperature increment."
  binds_to { family.parameters.p_lc group.parameters.v_min group.classification.accuracy_class }
  parameters {
    param temperature_increment: integer { description "Temperature increment for MDLO evaluation" unit "°C" default 2 range { min 2 max 2 } }
  }
  limit {
    uses { observable:c_m observable:delta_t profile:temperature_increment family.parameters.p_lc group.parameters.v_min sample.test_context.d_max sample.test_context.d_min group.classification.accuracy_class }
    accepts { verdict mdlo_normalized op lte limit "ocl{p_lc}" }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class A temperature effect on MDLO ≤ p_LC × v_min per 2°C.\n"
    limit:
      expression: "|ΔMDLO|"
      operator: "lte"
      threshold_expression: "p_LC × v_min"
      unit: "v"
    per_condition: "per 2°C temperature increment"
  }
  dependencies { /req/metrological/temperature-effect-mdlo }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1.3"
}
requirement /req/class-a/creep {
  name "Class A creep"
  statement "For Class A load cells, creep over 30 min shall not exceed 0.7 × |MPE|, and the difference between 20 and 30 minute readings shall not exceed 0.15 × |MPE|."
  binds_to { group.parameters.mpe sample.test_context.d_max }
  limit {
    uses { observable:c_c group.parameters.mpe group.classification.accuracy_class sample.test_context.d_max formula:lookupMPE table:mpe_tiers }
    accepts { verdict creep op lte limit "ocl{0.7 * abs(lookupMPE(sample.test_context.d_max, group.classification.accuracy_class, 0.7))}" }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class A creep ≤ 0.7 × |MPE| over 30 min, and ≤ 0.15 × |MPE| between 20–30 min.\n"
    limit:
      expression: "|creep|"
      operator: "lte"
      threshold_expression: "0.7 × |MPE|"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "over 30 minutes at 90%–100% of E_max"
  }
  dependencies { /req/metrological/creep /req/metrological/creep-20-30 }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.5.1"
}
requirement /req/class-a/special-temperature-limits {
  name "Class A special temperature limits"
  statement "For Class A load cells, the minimum temperature test range shall be at least 5°C. The temperature increment for MDLO determination is 2°C."
  binds_to { family.parameters.t_min family.parameters.t_max group.classification.accuracy_class }
  parameters {
    param min_temperature_span: integer { description "Minimum span of special working temperature range" unit "°C" default 5 range { min 5 max 5 } }
  }
  limit {
    expression "ocl{(family.parameters.t_max - family.parameters.t_min) >= lookupProfile('min_temperature_span', group.classification.accuracy_class)}"
    uses { family.parameters.t_min family.parameters.t_max group.classification.accuracy_class profile:min_temperature_span formula:lookupProfile }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class A special temperature range shall span at least 5°C.\n"
    limit:
      expression: "temperature_span"
      operator: "gte"
      threshold_expression: "5"
      unit: "°C"
  }
  dependencies { /req/metrological/temperature-limits }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1.2"
}
requirement /req/class-b/mpe {
  name "Class B MPE"
  statement "For Class B load cells, the maximum permissible error shall not exceed: 0 ≤ L < 5000v: 0.5 × p_LC 5000 ≤ L < 20000v: 1.0 × p_LC L ≥ 20000v: 1.5 × p_LC"
  binds_to { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc }
  parameters {
    param p_LC: number { description "Apportioning factor" unit "dimensionless" default 0.7 range { min 0.3 max 1 } }
  }
  limit {
    expression "ocl{group.parameters.mpe = lookupMPE(load, group.classification.accuracy_class, family.parameters.p_lc)}"
    uses { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc formula:lookupMPE table:mpe_tiers }
  }
  acceptance_criteria {
    type: "tiered"
    description: "Class B MPE with breakpoints at 5000v and 20000v (Table 4 of R 60-1).\n"
    variable: "load"
    variable_unit: "v"
    limit_expression: "factor × p_LC"
    referenced_function: "lookupMPE"
    tiers:
      - range:
          min: 0
          max: 5000
        limit:
          factor: 0.5
          expression: "0.5 × p_LC"
      - range:
          min: 5000
          max: 20000
        limit:
          factor: 1
          expression: "1.0 × p_LC"
      - range:
          min: 20000
        limit:
          factor: 1.5
          expression: "1.5 × p_LC"
  }
  dependencies { /req/metrological/mpe }
  ref derives-from "urn:oiml:pub:r:60-1:2021#table-4"
}
requirement /req/class-b/repeatability {
  name "Class B repeatability"
  statement "For Class B load cells, the repeatability error shall not exceed the absolute value of MPE for that load, determined using 5 runs."
  binds_to { group.parameters.mpe group.classification.accuracy_class }
  parameters {
    param runs: integer { description "Number of identical load applications per test point" default 5 range { min 5 max 5 } }
  }
  limit {
    expression "ocl{abs(e_r) <= abs(group.parameters.mpe)}"
    uses { observable:e_r group.parameters.mpe group.classification.accuracy_class table:test_runs }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class B repeatability error ≤ |MPE|, determined using 5 runs.\n"
    limit:
      expression: "|E_R|"
      operator: "lte"
      threshold_expression: "|MPE|"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "per load point, across 5 runs"
  }
  dependencies { /req/metrological/repeatability }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.4"
}
requirement /req/class-b/temperature-effect-mdlo {
  name "Class B temperature effect on MDLO"
  statement "For Class B load cells, the temperature effect on minimum dead load output shall not exceed p_LC × v_min per 5°C temperature increment."
  binds_to { family.parameters.p_lc group.parameters.v_min group.classification.accuracy_class }
  parameters {
    param temperature_increment: integer { description "Temperature increment for MDLO evaluation" unit "°C" default 5 range { min 5 max 5 } }
  }
  limit {
    uses { observable:c_m observable:delta_t profile:temperature_increment family.parameters.p_lc group.parameters.v_min sample.test_context.d_max sample.test_context.d_min group.classification.accuracy_class }
    accepts { verdict mdlo_normalized op lte limit "ocl{p_lc}" }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class B temperature effect on MDLO ≤ p_LC × v_min per 5°C.\n"
    limit:
      expression: "|ΔMDLO|"
      operator: "lte"
      threshold_expression: "p_LC × v_min"
      unit: "v"
    per_condition: "per 5°C temperature increment"
  }
  dependencies { /req/metrological/temperature-effect-mdlo }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1.3"
}
requirement /req/class-b/creep {
  name "Class B creep"
  statement "For Class B load cells, creep over 30 min shall not exceed 0.7 × |MPE|, and the difference between 20 and 30 minute readings shall not exceed 0.15 × |MPE|."
  binds_to { group.parameters.mpe sample.test_context.d_max }
  limit {
    uses { observable:c_c group.parameters.mpe group.classification.accuracy_class sample.test_context.d_max formula:lookupMPE table:mpe_tiers }
    accepts { verdict creep op lte limit "ocl{0.7 * abs(lookupMPE(sample.test_context.d_max, group.classification.accuracy_class, 0.7))}" }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class B creep ≤ 0.7 × |MPE| over 30 min, and ≤ 0.15 × |MPE| between 20–30 min.\n"
    limit:
      expression: "|creep|"
      operator: "lte"
      threshold_expression: "0.7 × |MPE|"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "over 30 minutes at 90%–100% of E_max"
  }
  dependencies { /req/metrological/creep /req/metrological/creep-20-30 }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.5.1"
}
requirement /req/class-b/span-stability {
  name "Class B span stability"
  statement "For Class B load cells with electronic components, span stability shall be maintained over the duration test period."
  binds_to { group.parameters.mpe sample.test_context.d_max group.classification.accuracy_class }
  parameters {
    param p_LC_span: number { description "p_LC used for span stability — always 1.0 regardless of manufacturer's declared value." default 1 range { min 1 max 1 } }
  }
  limit {
    expression "ocl{abs(span_variation) <= max(0.5, 0.5 * abs(lookupMPE(sample.test_context.d_max, group.classification.accuracy_class, 1.0)))}"
    uses { observable:span_variation group.parameters.mpe group.classification.accuracy_class sample.test_context.d_max formula:lookupMPE formula:maxAllowableSpanVariation table:mpe_tiers }
  }
  applicability {
    technology: [analogue-active, digital]
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class B span variation ≤ max(0.5v, 0.5 × |MPE|) using p_LC = 1.0.\n"
    limit:
      expression: "|Δspan|"
      operator: "lte"
      threshold_expression: "max(0.5, 0.5 × |MPE|)"
      referenced_function: "maxAllowableSpanVariation"
      unit: "v"
    per_condition: "over duration test period"
  }
  dependencies { /req/electronic/span-stability }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.6"
}
requirement /req/class-c/mpe {
  name "Class C MPE"
  statement "For Class C load cells, the maximum permissible error shall not exceed: 0 ≤ L < 500v: 0.5 × p_LC 500 ≤ L < 2000v: 1.0 × p_LC L ≥ 2000v: 1.5 × p_LC"
  binds_to { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc }
  parameters {
    param p_LC: number { description "Apportioning factor" unit "dimensionless" default 0.7 range { min 0.3 max 1 } }
  }
  limit {
    expression "ocl{group.parameters.mpe = lookupMPE(load, group.classification.accuracy_class, family.parameters.p_lc)}"
    uses { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc formula:lookupMPE table:mpe_tiers }
  }
  acceptance_criteria {
    type: "tiered"
    description: "Class C MPE with breakpoints at 500v and 2000v (Table 4 of R 60-1).\n"
    variable: "load"
    variable_unit: "v"
    limit_expression: "factor × p_LC"
    referenced_function: "lookupMPE"
    tiers:
      - range:
          min: 0
          max: 500
        limit:
          factor: 0.5
          expression: "0.5 × p_LC"
      - range:
          min: 500
          max: 2000
        limit:
          factor: 1
          expression: "1.0 × p_LC"
      - range:
          min: 2000
        limit:
          factor: 1.5
          expression: "1.5 × p_LC"
  }
  dependencies { /req/metrological/mpe }
  ref derives-from "urn:oiml:pub:r:60-1:2021#table-4"
}
requirement /req/class-c/repeatability {
  name "Class C repeatability"
  statement "For Class C load cells, the repeatability error shall not exceed the absolute value of MPE for that load, determined using 3 runs."
  binds_to { group.parameters.mpe group.classification.accuracy_class }
  parameters {
    param runs: integer { description "Number of identical load applications per test point" default 3 range { min 3 max 3 } }
  }
  limit {
    expression "ocl{abs(e_r) <= abs(group.parameters.mpe)}"
    uses { observable:e_r group.parameters.mpe group.classification.accuracy_class table:test_runs }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class C repeatability error ≤ |MPE|, determined using 3 runs.\n"
    limit:
      expression: "|E_R|"
      operator: "lte"
      threshold_expression: "|MPE|"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "per load point, across 3 runs"
  }
  dependencies { /req/metrological/repeatability }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.4"
}
requirement /req/class-c/temperature-effect-mdlo {
  name "Class C temperature effect on MDLO"
  statement "For Class C load cells, the temperature effect on minimum dead load output shall not exceed p_LC × v_min per 5°C temperature increment."
  binds_to { family.parameters.p_lc group.parameters.v_min group.classification.accuracy_class }
  parameters {
    param temperature_increment: integer { description "Temperature increment for MDLO evaluation" unit "°C" default 5 range { min 5 max 5 } }
  }
  limit {
    uses { observable:c_m observable:delta_t profile:temperature_increment family.parameters.p_lc group.parameters.v_min sample.test_context.d_max sample.test_context.d_min group.classification.accuracy_class }
    accepts { verdict mdlo_normalized op lte limit "ocl{p_lc}" }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Class C temperature effect on MDLO ≤ p_LC × v_min per 5°C.\n"
    limit:
      expression: "|ΔMDLO|"
      operator: "lte"
      threshold_expression: "p_LC × v_min"
      unit: "v"
    per_condition: "per 5°C temperature increment"
  }
  dependencies { /req/metrological/temperature-effect-mdlo }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1.3"
}
