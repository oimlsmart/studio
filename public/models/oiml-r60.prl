conformance_test /conf/electronic-tests/conducted-emc {
  name "Conducted electromagnetic fields test"
  type Testing
  purpose "Verify that conducted electromagnetic fields do not cause significant faults."
  method "Inject RF currents at specified frequencies into cables and interfaces. Record load cell output with and without disturbance."
  guidance "R 60-2, 2.10.7.10 (with 2.10.7.9 footnote): this test is not applicable for load cells without mains power supply or other input port — for such cells the radiated test (2.10.7.9) applies from 26 MHz instead; the port configuration is recorded on the conducted-emc form (has_mains_or_io_ports)."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.10/table-1"
  targets {
    /req/electronic/disturbances
    /req/electronic/no-significant-faults
  }
  binds_to {
    group.parameters.v_min
    family.classification.technology
  }
  procedure {
    1 "Record indication without disturbance" outputs { indication_without_disturbance }
    2 "Apply disturbance and record indication" outputs { indication_with_disturbance difference significant_fault }
  }
  procedure_steps { check_test_conditions insert_load_cell preload_load_cell check_indicating_instrument apply_test_load record_reference_indication apply_conducted_em_field record_indication_conducted check_for_significant_fault determine_pass_fail }
  kind disturbance
  variables {
    variable conversion_factor_f { type number unit "counts/v" source derived }
    variable indication_without_disturbance { type number unit "counts" source measured }
    variable indication_with_disturbance { type number unit "counts" source measured }
    variable difference { type number unit "v" source derived derivation "ocl{(indication_with_disturbance - indication_without_disturbance) / conversion_factor_f}" }
    variable significant_fault { type boolean source derived derivation "ocl{abs(difference) > 1}" }
  }
  conditions_to_enforce { load-cell-limiting-conditions }
  required_competence {
    competence emc_testing {
      method_standard "iec-61000-4-6"
      description "Conducted radio-frequency disturbance application at the prescribed severity (R 60-2, 2.10.7.10, applying IEC 61000-4-6)"
    }
    competence indication_readout {
      description "Indicating instrument recording the output before, during and after the disturbance (R 60-2, 2.7.2)"
    }
  }
  acceptance_criteria {
    type composite
    pass_if "ocl{disturbance_criterion}"
    criterion disturbance_criterion { pass_if "ocl{not significant_fault}" requirement /req/electronic/disturbances description "No significant fault (> v_min) from disturbance" }
  }
  design {
    specimens { count 1 max_additional 2 continuity same_eut_with_additional rules { unit-continuity } }
  }
  result_forms { conducted-emc }
}
conformance_test /conf/electronic-tests/span-stability {
  name "Span stability test"
  type Testing
  purpose "Verify that span variation over the test duration does not exceed the greater of 0.5 v or 0.5 times the absolute value of MPE for D_max."
  method "Perform minimum 8 measurement sets over test duration (28 days normally, up to 40 days for CH-marked). Class B: 5 runs per set. Classes C/D: 3 runs per set. Calculate span variation between measurements and compare against limits. Use p_LC = 1.0."
  guidance "Not applicable to Class A load cells."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.11"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.11"
  targets {
    /req/electronic/span-stability
  }
  binds_to {
    group.parameters.mpe
    sample.test_context.d_max
    group.classification.accuracy_class
  }
  applicability {
    accuracy_class: [B, C, D]
  }
  procedure {
    1 "Perform measurement set 1 (baseline)" outputs { span_vmin }
    2 "Perform measurement sets 2-8 over test duration (28 days, up to 40 for CH)" outputs { span_vmin variation }
    3 "Compare all variations against max allowable" outputs { max_allowable_variation }
  }
  procedure_steps { check_test_conditions insert_load_cell preload_load_cell check_indicating_instrument record_initial_span apply_periodic_load_cycles record_span_after_cycles determine_span_drift determine_pass_fail }
  kind span-stability
  variables {
    variable conversion_factor_f { type number unit "counts/v" source derived }
    variable span_vmin { type number unit "v" source derived derivation "ocl{span / conversion_factor_f}" }
    variable variation { type number unit "v" source derived derivation "ocl{abs(span_vmin - measurements[0].span_vmin)}" }
    variable max_allowable_variation { type number unit "v" source computed derivation "ocl{max(0.5, 0.5 * abs(lookupMPE(d_max, accuracy_class, 1.0)))}" }
  }
  conditions_to_enforce { load-cell-reference-conditions }
  required_competence {
    competence force_measurement {
      range { max "e_max" unit "kg" }
      description "Force-generating system applying the periodic load cycles of the endurance sequence (R 60-2, 2.10.7.11)"
    }
    competence temperature_control {
      range { min "t_min" max "t_max" unit "degC" }
      stability { value 2 unit "degC" }
      description "Climatic chamber conditioning for the temperature exposures of the sequence (R 60-2, 2.10.7.11)"
    }
    competence indication_readout {
      description "Indicating instrument recording span at every measurement set over the 28–40 day sequence (R 60-2, 2.7.2)"
    }
  }
  acceptance_criteria {
    type composite
    pass_if "ocl{span_stability_criterion}"
    criterion span_stability_criterion { pass_if "ocl{variation <= max_allowable_variation}" requirement /req/electronic/span-stability description "Span variation ≤ max(0.5 v, 0.5 × |MPE|) with p_LC = 1.0" }
  }
  design {
    schedule { duration P28D cadence PT12H constraints { "duration 28 days or the period of the performance tests, whichever is shorter; may be increased to 40 days for CH marked load cells (R 60-2, 2.10.7.11)" "time between measurements: 12 h to 10 days for SH marked, at most 14 days for CH marked, evenly distributed over the total duration" "at least 8 measurements; reasonably constant conditions (± 2 °C)" "two disconnections from the power supply of at least 8 hours each during the test period" "stabilise at least 5 h after switch-on, at least 16 h after any temperature or humidity test" "trend-continuation rule: where differences indicate a trend of more than half the allowable variation, continue the test until the trend comes to rest or reverses itself, or until the error exceeds the maximum allowable variation (R 60-2, 2.10.7.11)" } }
    specimens { count 1 continuity same_eut rules { unit-continuity } }
  }
  instances { by accuracy_class values { B { n_runs: 5 } C { n_runs: 3 } D { n_runs: 3 } } }
  result_forms { span-stability }
}
conformance_test /conf/examinations/documentation {
  name "Documentation review"
  type Inspection
  purpose "Verify that all required documentation has been submitted with the application for type evaluation."
  method "Inspect the submitted documentation for completeness: general principle of measurement, mechanical drawings, electric/electronic diagrams, installation requirements, operating instructions, evidence of compliance, and software documentation (if applicable)."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.5"
  targets {
    /req/technical/mandatory-markings
    /req/technical/mandatory-additional-info
    /req/classification/complete-classification
    /req/classification/standard-classification
    /req/classification/multiple-classifications
    /req/classification/min-verification-interval
    /req/classification/supplementary-loading
  }
  binds_to {
    model.aspects.application_documentation
    model.aspects.markings
  }
  procedure {
    1 "Verify all required documentation is submitted" outputs { principle_of_measurement mechanical_drawings electric_diagrams installation_requirements operating_instructions evidence_of_compliance software_documentation }
    2 "Verify classification and markings declarations" outputs { complete_classification markings_present }
  }
  procedure_steps { review_manufacturer_documentation verify_completeness check_test_pattern_definition verify_applicant_information determine_pass_fail }
  kind performance
  variables {
    variable principle_of_measurement { type boolean source measured description "General principle of measurement documentation provided" }
    variable mechanical_drawings { type boolean source measured description "Mechanical drawings provided" }
    variable electric_diagrams { type boolean source measured description "Electric/electronic diagrams provided" }
    variable installation_requirements { type boolean source measured description "Installation requirements provided" }
    variable operating_instructions { type boolean source measured description "Operating instructions provided" }
    variable evidence_of_compliance { type boolean source measured description "Evidence of compliance provided" }
    variable software_documentation { type boolean source measured description "Software documentation provided (if applicable)" }
    variable complete_classification { type boolean source measured description "Complete classification declared per R 60-1, 3.7" }
    variable markings_present { type boolean source measured description "All mandatory markings present and correct" }
  }
  required_competence {
    competence documentation_review {
      description "Review of the applicant's documentation against the documentation requirements (R 60-2, 2.5)"
    }
  }
  acceptance_criteria {
    type qualitative
    pass_if "ocl{principle_of_measurement and mechanical_drawings and electric_diagrams and installation_requirements and operating_instructions and evidence_of_compliance and complete_classification and markings_present}"
    criterion "" { description "All required documentation submitted" reference "R 60-2, 2.5" }
    criterion "" { description "Complete classification declared" reference "R 60-1, 3.7" }
    criterion "" { description "Mandatory markings present" reference "R 60-1, 6.2" }
  }
  result_forms { documentation-examination }
}
conformance_test /conf/examinations/inscriptions {
  name "Inscriptions examination"
  type Inspection
  purpose "Verify that all mandatory markings and designations are present, correct, and comply with the specified format."
  method "Perform visual inspection of the load cell for all mandatory markings (manufacturer, model, serial number, E_max, year, type approval mark). Verify accuracy class symbol, load type designation, working temperature designation, humidity symbol, and n_LC designation comply with R 60-1, 6.2."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.6"
  targets {
    /req/technical/mandatory-markings
    /req/technical/class-designation
    /req/technical/load-type-designation
    /req/technical/humidity-designation
    /req/technical/temperature-designation
    /req/technical/nlc-designation
  }
  binds_to {
    model.aspects.markings
  }
  procedure {
    1 "Visual inspection of all mandatory markings" outputs { manufacturer_marking model_designation serial_number emax_marking year_marking }
    2 "Verify accuracy class, load type, temperature, humidity, and n_LC designations" outputs { accuracy_class_symbol load_type_designation temperature_designation humidity_symbol nlc_designation }
  }
  procedure_steps { check_mandatory_markings_per_6_2_1 check_mandatory_additional_info_per_6_2_2 check_non_mandatory_info_per_6_2_3 check_specific_markings_per_6_2_4 verify_legibility determine_pass_fail }
  kind performance
  variables {
    variable manufacturer_marking { type boolean source measured description "Manufacturer name or trademark present" }
    variable model_designation { type boolean source measured description "Model/type designation present" }
    variable serial_number { type boolean source measured description "Serial number present" }
    variable emax_marking { type boolean source measured description "E_max marked" }
    variable year_marking { type boolean source measured description "Year of manufacture marked" }
    variable accuracy_class_symbol { type boolean source measured description "Accuracy class symbol correct per R 60-1, 6.2.2" }
    variable load_type_designation { type boolean source measured description "Load type designation correct" }
    variable temperature_designation { type boolean source measured description "Working temperature designation correct" }
    variable humidity_symbol { type boolean source measured description "Humidity symbol correct" }
    variable nlc_designation { type boolean source measured description "n_LC designation present and correct" }
  }
  required_competence {
    competence documentation_review {
      description "Visual inspection of the instrument's inscriptions and marking against the mandatory-marking requirements (R 60-2, 2.6)"
    }
  }
  acceptance_criteria {
    type qualitative
    pass_if "ocl{manufacturer_marking and model_designation and serial_number and emax_marking and year_marking and accuracy_class_symbol and load_type_designation and temperature_designation and humidity_symbol and nlc_designation}"
    criterion "" { description "All mandatory markings present" reference "R 60-1, 6.2.1" }
    criterion "" { description "Accuracy class symbol correct" reference "R 60-1, 6.2.2" }
    criterion "" { description "Load type designation correct" reference "R 60-1, 6.2.3" }
    criterion "" { description "Temperature designation correct" reference "R 60-1, 6.2.4" }
    criterion "" { description "Humidity symbol correct" reference "R 60-1, 6.2.5" }
    criterion "" { description "n_LC designation correct" reference "R 60-1, 6.2.6" }
  }
  result_forms { marking-examination }
}
conformance_test /conf/examinations/software {
  name "Software examination"
  type Inspection
  purpose "Verify that software sealing, identification, and protection comply with OIML D 31 requirements."
  method "Inspect software documentation, verify legally relevant software identification, check sealing provisions (mechanical, electronic, or cryptographic), and verify compliance with OIML D 31 severity level I validation procedure A."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.6"
  targets {
    /req/technical/software
  }
  binds_to {
    model.aspects.software
    model.aspects.sealing
  }
  applicability {
    technology: [analogue-active, digital]
  }
  procedure {
    1 "Inspect software documentation" outputs { software_identification }
    2 "Verify sealing provisions" outputs { software_sealing }
    3 "Verify OIML D 31 compliance" outputs { d31_compliance }
  }
  procedure_steps { identify_software_components verify_software_identification check_sealing_arrangements verify_documentation_per_5_2_5 determine_pass_fail }
  kind performance
  variables {
    variable software_identification { type boolean source measured description "Legally relevant software identified per OIML D 31" }
    variable software_sealing { type boolean source measured description "Software sealing provisions verified (mechanical, electronic, or cryptographic)" }
    variable d31_compliance { type boolean source measured description "Compliance with OIML D 31 severity level I, validation procedure A" }
  }
  required_competence {
    competence software_examination {
      method_standard "oiml-d-31"
      description "Examination of the load cell's software and its documentation per OIML D 31 (R 60-2, 2.6)"
    }
    competence documentation_review {
      description "Review of the software documentation and sealing arrangements (R 60-2, 2.6)"
    }
  }
  acceptance_criteria {
    type qualitative
    pass_if "ocl{software_identification and software_sealing and d31_compliance}"
    criterion "" { description "Software identification verified" reference "OIML D 31" }
    criterion "" { description "Software sealing verified" reference "R 60-1, 5.4" }
    criterion "" { description "OIML D 31 compliance verified" reference "OIML D 31" }
  }
  result_forms { software-examination }
}
conformance_test /conf/examinations/suitability {
  name "Suitability for testing"
  type Inspection
  purpose "Verify that the load cell is suitable for testing and that all necessary information and accessories have been provided."
  method "Inspect the load cell for general design and construction quality. Verify that installation instructions and all necessary accessories have been provided. Confirm that the load cell can be properly mounted in the test apparatus."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.3.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.4.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.4.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.4.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.4.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.4.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.4.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.6"
  targets {
    /req/technical/mandatory-additional-info
  }
  binds_to {
    model.aspects.construction
    model.aspects.application_documentation
  }
  procedure {
    1 "Inspect load cell for design and construction quality" outputs { construction_quality }
    2 "Verify installation instructions and accessories" outputs { installation_instructions accessories_provided }
    3 "Verify compatibility with test apparatus" outputs { test_apparatus_compatible }
  }
  procedure_steps { verify_load_cell_condition check_installation_provisions verify_mounting_hardware verify_indicating_instrument_provision determine_pass_fail }
  kind performance
  variables {
    variable construction_quality { type boolean source measured description "General design and construction quality acceptable" }
    variable installation_instructions { type boolean source measured description "Installation instructions provided" }
    variable accessories_provided { type boolean source measured description "All necessary accessories provided" }
    variable test_apparatus_compatible { type boolean source measured description "Load cell can be properly mounted in test apparatus" }
  }
  required_competence {
    competence documentation_review {
      description "Examination of the type's construction suitability for the intended use and testability (R 60-2, 2.3)"
    }
  }
  acceptance_criteria {
    type qualitative
    pass_if "ocl{construction_quality and installation_instructions and accessories_provided and test_apparatus_compatible}"
    criterion "" { description "Construction quality acceptable" reference "R 60-2, 2.6" }
    criterion "" { description "Installation instructions and accessories provided" reference "R 60-2, 2.6" }
    criterion "" { description "Compatible with test apparatus" reference "R 60-2, 2.6" }
  }
  result_forms { suitability-examination }
}
conformance_test /conf/metrological-tests/measurement-error-repeatability-mdlo {
  name "Determination of measurement error, repeatability error and temperature effect on MDLO"
  type Testing
  purpose "Verify that load cell errors do not exceed the MPE values given in Table 4, that repeatability error does not exceed the absolute value of MPE for that load, and that temperature effect on minimum dead load output does not exceed p_LC times v_min per temperature increment."
  method "Apply increasing and decreasing test loads at four temperatures (20 degC, T_high, T_low, 20 degC return). Record indications at each load point. Classes C/D: 3 identical load applications. Classes A/B: 5 identical load applications. Calculate conversion factor f from 75% load indication. Determine E_L, E_R, and C_M per R 60-3 section 2.1. Compare against MPE from Table 4."
  method_ref load_weight
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.8"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.8.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.8.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.8.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.8.3.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.8.3.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.7"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.8"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.9"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.11"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.12"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.13"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.14"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.15"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.16"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.11"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.11.1"
  targets {
    /req/metrological/mpe
    /req/metrological/repeatability
    /req/metrological/temperature-effect-mdlo
    /req/metrological/temperature-limits
    /req/metrological/special-temperature-limits
  }
  binds_to {
    group.parameters.mpe
    group.classification.accuracy_class
    family.parameters.p_lc
    group.parameters.v_min
    family.parameters.t_min
    family.parameters.t_max
  }
  procedure {
    1 "Determine conversion factor f from 75% load indication" inputs { conversion_factor_f } outputs { conversion_factor_f }
    2 "Apply test loads at 20°C reference temperature" outputs { e_l e_r mpe }
    3 "Apply test loads at T_high" outputs { e_l e_r mpe }
    4 "Apply test loads at T_low" outputs { e_l e_r mpe }
    5 "Apply test loads at 20°C return; calculate MDLO changes" outputs { e_l e_r mpe c_m }
  }
  procedure_steps { check_test_conditions insert_load_cell preload_load_cell check_indicating_instrument monitor_load_cell record_initial_indication apply_test_load_points apply_increasing_loads record_indications_increasing decrease_test_loads record_indications_decreasing repeat_per_accuracy_class repeat_per_temperature determine_measurement_error determine_repeatability_error determine_temperature_effect_mdlo }
  kind performance
  variables {
    variable n { type integer source derived derivation "ocl{(e_max - e_min) / v_min}" description "Verification intervals of the measuring range under test (= Y when the test spans the classified range, R 60-3, 2.1.2.4)" }
    variable conversion_factor_f { type number unit "counts/v" source derived derivation "ocl{(avgIndicationAt75pct - indicationAtDmin) / (0.75 * n)}" description "Conversion factor from counts to verification units" }
    variable e_l { type number unit "v" source derived derivation "ocl{(avg_indication - reference_indication) / conversion_factor_f}" description "Load cell error in verification units" }
    variable e_r { type number unit "v" source derived derivation "ocl{(max(runs->collect(r | r.indication)) - min(runs->collect(r | r.indication))) / conversion_factor_f}" description "Repeatability error across runs" }
    variable mpe { type number unit "v" source computed derivation "ocl{lookupMPE(test_load, accuracy_class, p_lc)}" description "Maximum permissible error at this load" }
    variable c_m { type number unit "v" source derived description "Raw temperature effect on MDLO of one temperature step, in v (BEFORE the T_f/(T_2−T_1) normalization and the v→v_min conversion — those live exactly once in the mdlo_normalized VerdictQuantity, R 60-3, 2.1.4)" }
  }
  conditions_to_enforce { load-cell-rated-conditions }
  preconditions {
    precondition temperature-stability { check "ocl{temperature_variation <= min(2, 0.2 * (family.parameters.t_max - family.parameters.t_min))}" description "Ambient temperature stability (R 60-2, 2.7.3.1): the difference between extreme temperatures noted during the test shall not exceed one fifth of the load cell's temperature range (t_max − t_min), and never 2 °C. A run recorded under unstable temperature is INVALID — not a fail." on_violation invalid }
  }
  required_competence {
    competence force_measurement {
      range { max "e_max" unit "kg" }
      description "Force-generating system applying test loads over the measuring range (R 60-2, 2.7.2), mass standards traceable per 2.7.3.2"
    }
    competence temperature_control {
      range { min "t_min" max "t_max" unit "degC" }
      stability { value 2 unit "degC" }
      description "Climatic chamber conditioning at 20 degC, T_high, T_low and return (R 60-2, 2.10.1), stable within one fifth of the cell's range, never more than 2 degC (R 60-2, 2.7.3.1)"
    }
    competence indication_readout {
      description "Indicating instrument reading the cell output at every load point and temperature (R 60-2, 2.7.2)"
    }
  }
  acceptance_criteria {
    type composite
    pass_if "ocl{mpe_criterion and repeatability_criterion and mdlo_criterion}"
    criterion mpe_criterion { pass_if "ocl{abs(e_l) <= abs(mpe)}" requirement /req/metrological/mpe description "|E_L| ≤ |MPE|" }
    criterion repeatability_criterion { pass_if "ocl{abs(e_r) <= abs(mpe)}" requirement /req/metrological/repeatability description "|E_R| ≤ |MPE|" }
    criterion mdlo_criterion { requirement /req/metrological/temperature-effect-mdlo description "C_M(v_min) ≤ p_LC per temperature increment (canonical verdict — never restated here; audit F1)" accepts { verdict mdlo_normalized op lte limit "ocl{p_lc}" } }
  }
  design {
    specimens { count 1 continuity same_eut rules { unit-continuity } }
  }
  instances { by accuracy_class values { A { n_runs: 5 } B { n_runs: 5 } C { n_runs: 3 } D { n_runs: 3 } } }
  result_forms { load-cell-errors load-test repeatability temperature-mdlo }
}
conformance_test /conf/metrological-tests/creep {
  name "Determination of creep error"
  type Testing
  purpose "Verify that creep over 30 minutes does not exceed 0.7 times the absolute value of MPE, and that the difference between 20 and 30 minute readings does not exceed 0.15 times the absolute value of MPE."
  method "Apply D_max (90-100% of E_max) and hold for 30 minutes. Record indications at specified intervals. Calculate C_C per R 60-3, 2.1.5. Always use p_LC = 0.7 for MPE calculation. Repeat at each test temperature."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.9"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.9.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.7"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.8"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.9"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.2.10"
  targets {
    /req/metrological/creep
    /req/metrological/creep-20-30
  }
  binds_to {
    group.parameters.mpe
    model.parameters.e_max
    sample.test_context.d_max
  }
  procedure {
    1 "Record initial indication at D_min"
    2 "Apply D_max load" inputs { d_max }
    3 "Record initial indication at D_max (t=0)" outputs { initial_dmax_indication }
    4 "Hold D_max for 30 minutes, recording at intervals" outputs { creep_readings c_c creep_30min creep_20min }
    5 "Remove load, return to D_min"
  }
  procedure_steps { check_test_conditions insert_load_cell preload_load_cell check_indicating_instrument monitor_load_cell record_initial_indication apply_load_dmax record_indications_30min repeat_per_temperature determine_creep_error }
  kind performance
  variables {
    variable d_max { type number unit "g, kg, or t" source declared description "Maximum test load, 90-100% of E_max" }
    variable conversion_factor_f { type number unit "counts/v" source derived derivation "ocl{(avgIndicationAt75pct - indicationAtDmin) / (0.75 * n)}" description "Conversion factor from counts to verification units" }
    variable initial_dmax_indication { type number unit "counts" source measured description "Initial indication at D_max at time t=0" }
    variable creep_readings { type collection source measured description "Time-series creep readings at D_max" }
    variable c_c { type number unit "v" source derived derivation "ocl{creep_readings->collect(r | r.change_v)->max()}" description "Maximum creep change across all readings" }
    variable creep_30min { type number unit "v" source derived derivation "ocl{reading_at(window(creep_readings->select(r | r.test_load = 'D_max'), 'elapsed_min', 20, 30), 'elapsed_min', 30, 'change_v')}" description "Creep change at 30 minutes (reading at t=30, per R 60-3, 2.1.5.2)" }
    variable creep_20min { type number unit "v" source derived derivation "ocl{reading_at(window(creep_readings->select(r | r.test_load = 'D_max'), 'elapsed_min', 20, 30), 'elapsed_min', 20, 'change_v')}" description "Creep change at 20 minutes (reading at t=20, per R 60-3, 2.1.5.2)" }
    variable mpe_at_dmax { type number unit "v" source computed derivation "ocl{lookupMPE(d_max, accuracy_class, 0.7)}" description "MPE at D_max with p_LC forced to 0.7" }
  }
  conditions_to_enforce { load-cell-rated-conditions }
  preconditions {
    precondition temperature-stability { check "ocl{temperature_variation <= min(2, 0.2 * (family.parameters.t_max - family.parameters.t_min))}" description "Ambient temperature stability (R 60-2, 2.7.3.1): the difference between extreme temperatures noted during the test shall not exceed one fifth of the load cell's temperature range (t_max − t_min), and never 2 °C. A creep run recorded under unstable temperature is INVALID — not a fail." on_violation invalid }
    precondition creep-load-envelope { check "ocl{sample.test_context.d_max >= 0.9 * model.parameters.e_max and sample.test_context.d_max <= model.parameters.e_max}" description "Load envelope (R 60-2, 2.10.2): the creep test applies 90–100 % of E_max (D_max). A run outside the load envelope is INVALID — not a fail. (Moved out of the requirement's inline limit expression with the characteristics migration, TODO.roadmap/10 — run-validity, not acceptance.) The envelope inputs (D_max, E_max) MUST be recorded for a creep run: when they are unresolvable the creep verdicts are INDETERMINATE — the unbound-reads discipline of the former inline conjunct, never a silent skip." on_violation invalid on_unresolvable indeterminate }
  }
  required_competence {
    competence force_measurement {
      range { max "e_max" unit "kg" }
      description "Force-generating system holding D_max (90–100% of E_max) constant for 30 minutes per run (R 60-2, 2.10.2)"
    }
    competence temperature_control {
      range { min "t_min" max "t_max" unit "degC" }
      stability { value 2 unit "degC" }
      description "Climatic chamber conditioning at each test temperature (R 60-2, 2.10.2), stable per R 60-2, 2.7.3.1"
    }
    competence indication_readout {
      description "Indicating instrument recording the output at the timed reading points (R 60-2, 2.7.2)"
    }
  }
  acceptance_criteria {
    type composite
    pass_if "ocl{creep_30min_criterion and creep_20_30_criterion}"
    criterion creep_30min_criterion { requirement /req/metrological/creep description "C_C ≤ 0.7 × |MPE| at D_max (canonical characteristic — never restated here; the run's mpe_at_dmax computes the same MPE)" accepts { verdict creep op lte limit "ocl{0.7 * abs(lookupMPE(sample.test_context.d_max, group.classification.accuracy_class, 0.7))}" } }
    criterion creep_20_30_criterion { pass_if "ocl{abs(creep_30min - creep_20min) <= 0.15 * abs(mpe_at_dmax)}" requirement /req/metrological/creep-20-30 description "|C_C(30-20)| ≤ 0.15 × |MPE|" }
  }
  design {
    schedule { duration PT30M constraints { "apply D_max (90-100 % of E_max) and hold for 30 minutes" "record indications at specified intervals incl. t=20 and t=30 min" "repeat at each test temperature" "loading/stabilisation times per R 60-2, Table 1" } }
    specimens { count 1 continuity same_eut rules { unit-continuity } }
  }
  result_forms { creep-dr }
}
conformance_test /conf/metrological-tests/dr {
  name "Determination of minimum dead load output return (DR)"
  type Testing
  purpose "Verify that the difference between the initial minimum load output reading and the reading after the creep test does not exceed 0.5 v."
  method "Record indication at D_min before applying D_max. Apply D_max and hold for 30 minutes. Return to D_min and record indication. Calculate C_DR per R 60-3, 2.1.5. Compare against 0.5 v limit. Repeat at each test temperature."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.9.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.7"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.8"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.9"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.11"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.3.12"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.11.2"
  targets {
    /req/metrological/dr
  }
  binds_to {
    group.parameters.dr
    sample.test_context.v
  }
  procedure {
    1 "Record initial indication at D_min" outputs { initial_dmin_indication }
    2 "Apply D_max, hold for 30 minutes, remove load" inputs { actual_time_s specified_time_s }
    3 "Record final indication at D_min" outputs { final_dmin_indication }
    4 "Calculate DR and evaluate against 0.5 v (relaxed per R 60-3, 2.1.5.6 when 100-150 % of the specified time)" outputs { c_dr x }
  }
  procedure_steps { check_test_conditions insert_load_cell preload_load_cell check_indicating_instrument monitor_load_cell record_initial_dmin_indication apply_load_dmax hold_30min return_to_dmin record_final_dmin_indication repeat_per_temperature determine_dr_value }
  kind performance
  variables {
    variable initial_dmin_indication { type number unit "counts" source measured description "Indication at D_min before creep test" }
    variable final_dmin_indication { type number unit "counts" source measured description "Indication at D_min after creep test" }
    variable conversion_factor_f { type number unit "counts/v" source derived derivation "ocl{(avgIndicationAt75pct - indicationAtDmin) / (0.75 * n)}" }
    variable c_dr { type number unit "v" source derived derivation "ocl{(final_dmin_indication - initial_dmin_indication) / conversion_factor_f}" description "Dead load output return in verification units" }
    variable actual_time_s { type number unit "s" source measured description "Actual loading/unloading time achieved (R 60-2, 2.8.3)" }
    variable specified_time_s { type number unit "s" source declared description "Specified loading/unloading time per R 60-2, Table 1" }
    variable x { type number source derived derivation "ocl{actual_time_s / specified_time_s}" description "Ratio of actual to specified loading time (R 60-3, 2.1.5.6)" }
  }
  conditions_to_enforce { load-cell-rated-conditions }
  preconditions {
    precondition temperature-stability { check "ocl{temperature_variation <= min(2, 0.2 * (family.parameters.t_max - family.parameters.t_min))}" description "Ambient temperature stability (R 60-2, 2.7.3.1): the difference between extreme temperatures noted during the test shall not exceed one fifth of the load cell's temperature range (t_max − t_min), and never 2 °C. A run recorded under unstable temperature is INVALID — not a fail." on_violation invalid }
    precondition loading-time-limit { check "ocl{x <= 1.5}" description "Loading-time ceiling (R 60-2, 2.8.3): for the minimum dead load output return test the time may be increased from 100 % to a limit of 150 % of the specified time — beyond 150 % the run is INVALID (the relaxed limit no longer applies), never a fail." on_violation invalid }
  }
  required_competence {
    competence force_measurement {
      range { max "e_max" unit "kg" }
      description "Force-generating system applying and removing the test load for the output-return reading (R 60-2, 2.10.3)"
    }
    competence indication_readout {
      description "Indicating instrument recording the dead load output before and after load application (R 60-2, 2.7.2)"
    }
  }
  acceptance_criteria {
    type composite
    pass_if "ocl{dr_criterion}"
    criterion dr_criterion { pass_if "ocl{if x <= 1 then abs(c_dr) <= 0.5 else abs(c_dr) <= 0.5 * (1 - (x - 1)) endif}" requirement /req/metrological/dr description "|C_DR| ≤ 0.5 v when the R 60-2, Table 1 time intervals are met; ≤ 0.5(1−(x−1)) v for 100–150 % loading times (x = actual/specified time, R 60-3, 2.1.5.6)" }
  }
  design {
    specimens { count 1 continuity same_eut rules { unit-continuity } }
  }
  result_forms { creep-dr }
}
conformance_test /conf/metrological-tests/barometric-pressure {
  name "Determination of barometric pressure effects"
  type Testing
  purpose "Verify that the output variation does not exceed v_min for any incremental change in barometric pressure of 1 kPa."
  method "At room temperature with unloaded load cell, record indication at atmospheric pressure. Change pressure by at least 1 kPa and record indication. Calculate C_P per R 60-3, 2.1.6. Compare against v_min limit."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.4.7"
  targets {
    /req/metrological/barometric-pressure
  }
  binds_to {
    group.parameters.v_min
  }
  procedure {
    1 "Record indication at current atmospheric pressure" outputs { pressure_readings }
    2 "Change pressure by at least 1 kPa and record indication" outputs { pressure_readings }
    3 "Calculate pressure effect C_P per kPa in v_min units (R 60-3, 2.1.6) and evaluate against v_min" outputs { c_p delta_p }
  }
  procedure_steps { check_test_conditions insert_load_cell check_indicating_instrument monitor_load_cell record_reference_indication change_barometric_pressure record_indications_per_pressure determine_barometric_pressure_error }
  kind influence
  variables {
    variable conversion_factor_f { type number unit "counts/v" source derived }
    variable pressure_readings { type collection source measured description "Indications at different barometric pressures" }
    variable c_p { type number unit "v" source derived description "Raw pressure-step change in v (R 60-3, 2.1.6: difference of indications divided by f)" }
    variable delta_p { type number unit "kPa" source measured description "Pressure step (P_2 − P_1) of the reading pair, kPa" }
  }
  conditions_to_enforce { load-cell-rated-conditions }
  required_competence {
    competence pressure_control {
      description "Barometric pressure variation for the determination of atmospheric pressure effects (R 60-2, 2.10.4; R 60-1, 5.6.2)"
    }
    competence force_measurement {
      range { max "e_max" unit "kg" }
      description "Force-generating system applying the reference load at each pressure step (R 60-2, 2.7.2)"
    }
    competence indication_readout {
      description "Indicating instrument recording the output at each pressure step (R 60-2, 2.7.2)"
    }
  }
  acceptance_criteria {
    type composite
    pass_if "ocl{barometric_criterion}"
    criterion barometric_criterion { requirement /req/metrological/barometric-pressure description "C_P(v_min) per kPa ≤ 1 v_min (canonical verdict — R 60-3, 2.1.6 full normalization incl. the ×(E_max−E_min)/n_LC step; audit F2)" accepts { verdict barometric_normalized op lte limit "ocl{1}" } }
  }
  design {
    specimens { count 1 continuity same_eut rules { unit-continuity } }
  }
  result_forms { barometric-pressure }
}
conformance_test /conf/metrological-tests/humidity-ch {
  name "Determination of humidity effects for CH or unmarked load cells"
  type Testing
  purpose "Verify that cyclic humidity exposure does not cause the minimum load output to vary by more than 4% of (E_max - E_min), and the maximum load output to vary by more than v."
  method "Perform load tests before and after exposure to cyclic humidity (12 cycles of 24h each, RH 80-96%, temp 25-40 degC). Record indications at D_min and D_max before and after. Calculate C_Hmin and C_Hmax per R 60-3, 2.1.7. Classes C/D: 3 runs. Classes A/B: 5 runs."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.7"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.8"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.9"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.11"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.12"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.12/table-1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.13"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.14"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.5.15"
  targets {
    /req/metrological/humidity-ch
  }
  binds_to {
    group.parameters.n_lc
    sample.test_context.v
    family.classification.humidity_class
  }
  applicability {
    humidity_class: [CH]
  }
  procedure {
    1 "Perform load tests before humidity exposure (baseline)" outputs { avg_indication_dmin_before avg_dmax_before avg_dmin_before }
    2 "Subject to cyclic humidity (12 cycles, 24h each, RH 80-96%, 25-40°C)"
    3 "Perform load tests after humidity exposure" outputs { avg_indication_dmin_after avg_dmax_after avg_dmin_after }
    4 "Calculate humidity effects and evaluate" outputs { c_hmin c_hmax chmin_limit }
  }
  procedure_steps { check_test_conditions insert_load_cell preload_load_cell check_indicating_instrument monitor_load_cell record_initial_indication apply_load_test_points record_indications_pre_humidity remove_load conduct_damp_heat_cyclic_test_ch remove_load_cell_from_chamber repeat_test_procedures determine_humidity_induced_variations }
  kind influence
  variables {
    variable n { type integer source derived derivation "ocl{(e_max - e_min) / v_min}" description "Verification intervals of the measuring range under test (= Y when the test spans the classified range, R 60-3, 2.1.2.4)" }
    variable conversion_factor_f { type number unit "counts/v" source derived }
    variable avg_indication_dmin_before { type number unit "counts" source measured description "Average D_min indication before humidity exposure" }
    variable avg_dmax_before { type number unit "counts" source measured description "Average D_max indication before humidity exposure" }
    variable avg_dmin_before { type number unit "counts" source measured description "Average D_min indication before humidity exposure (span baseline)" }
    variable avg_indication_dmin_after { type number unit "counts" source measured description "Average D_min indication after humidity exposure" }
    variable avg_dmax_after { type number unit "counts" source measured description "Average D_max indication after humidity exposure" }
    variable avg_dmin_after { type number unit "counts" source measured description "Average D_min indication after humidity exposure (span baseline)" }
    variable c_hmin { type number unit "v" source derived derivation "ocl{(avg_indication_dmin_after - avg_indication_dmin_before) / conversion_factor_f}" }
    variable c_hmax { type number unit "v" source derived derivation "ocl{((avg_dmax_after - avg_dmin_after) - (avg_dmax_before - avg_dmin_before)) / conversion_factor_f}" }
    variable chmin_limit { type number unit "v" source derived derivation "ocl{0.04 * n}" description "4 % of the (E_max − E_min) output = 0.04·n in v units (R 60-1, 5.6.3; n = intervals of the range under test per R 60-3, 2.1.7)" }
  }
  conditions_to_enforce { load-cell-rated-conditions }
  required_competence {
    competence humidity_testing {
      method_standard "iec-60068-2-30"
      description "Cyclic damp heat exposure, variant 2 when lowering the temperature (R 60-2, 2.10.5, applying IEC 60068-2-30)"
    }
    competence force_measurement {
      range { max "e_max" unit "kg" }
      description "Force-generating system applying the reference load before/during/after exposure (R 60-2, 2.7.2)"
    }
    competence indication_readout {
      description "Indicating instrument recording the output around the exposure (R 60-2, 2.7.2)"
    }
  }
  acceptance_criteria {
    type composite
    pass_if "ocl{chmin_criterion and chmax_criterion}"
    criterion chmin_criterion { pass_if "ocl{abs(c_hmin) <= chmin_limit}" requirement /req/metrological/humidity-ch description "|C_Hmin| ≤ 4 % of the (E_max − E_min) output = 0.04·n v (R 60-1, 5.6.3)" }
    criterion chmax_criterion { pass_if "ocl{abs(c_hmax) <= 1}" requirement /req/metrological/humidity-ch description "|C_Hmax| ≤ 1 v (R 60-1, 5.6.3; R 60-3, 2.1.7 states ≤ MPE — source discrepancy annotated, model follows the normative Part 1)" source_discrepancy { summary "R 60-3, 2.1.7 prose states the max-load humidity effect limit as ≤ MPE, contradicting R 60-1, 5.6.3.1 (≤ 1 v — confirmed by R 60-3's own Table 6.10.1-a mpc column = 1)" sources { "urn:oiml:pub:r:60-1:2021#clause-5.6.3.1" "urn:oiml:pub:r:60-3:2021#clause-2.1.7" } resolution follows_clause_x rationale "The model follows R 60-1, 5.6.3.1 — the normative requirement clause (max-load effect shall not exceed the verification interval v) — which R 60-3's own Table 6.10.1-a mpc column (= 1) confirms; only R 60-3, 2.1.7 prose states ≤ MPE. The requirement and form layers carry the same annotation. See analysis/deep-audit-r60.md F5." } }
  }
  design {
    specimens { count 1 continuity same_eut rules { unit-continuity } }
  }
  instances { by accuracy_class values { A { n_runs: 5 } B { n_runs: 5 } C { n_runs: 3 } D { n_runs: 3 } } }
  result_forms { humidity-ch }
}
conformance_test /conf/metrological-tests/humidity-sh {
  name "Determination of humidity effects for SH marked load cells"
  type Testing
  purpose "Verify that steady-state humidity exposure does not cause errors exceeding the MPE values in Table 4."
  method "Perform load tests at 85% RH constant humidity and the high temperature of the range specified in R 60-1, 5.6.1 for 48 hours (following temperature and humidity stabilisation). Reference condition: 20 °C at 50 % RH — or the MEAN VALUE of the temperature range whenever 20 °C is outside that range (R 60-2, 2.10.6). No condensation on the load cell. Determine load cell errors per R 60-3, 2.1.8. Compare against MPE from Table 4."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.7"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.8"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.9"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.11"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.11/table-1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.12"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.6.13"
  targets {
    /req/metrological/humidity-sh
  }
  binds_to {
    group.parameters.mpe
    family.classification.humidity_class
  }
  applicability {
    humidity_class: [SH]
  }
  procedure {
    1 "Perform load tests at 20°C, 50% RH (baseline)" outputs { reference_indication e_l mpe }
    2 "Expose to 85% RH constant for 48 hours at constant temperature"
    3 "Perform load tests at 85% RH" outputs { e_l mpe }
    4 "Perform load tests at 20°C return" outputs { e_l mpe }
  }
  procedure_steps { check_test_conditions insert_load_cell preload_load_cell check_indicating_instrument monitor_load_cell record_initial_indication apply_load_test_points record_indications_pre_humidity decrease_load conduct_damp_heat_steady_state_sh recording_indications_during_humidity determine_humidity_induced_variations }
  kind influence
  variables {
    variable conversion_factor_f { type number unit "counts/v" source derived }
    variable reference_indication { type number unit "counts" source measured description "Reference indication at baseline (20°C, 50% RH)" }
    variable e_l { type number unit "v" source derived derivation "ocl{(indication - reference_indication) / conversion_factor_f}" }
    variable mpe { type number unit "v" source computed derivation "ocl{lookupMPE(test_load, accuracy_class, p_lc)}" }
  }
  conditions_to_enforce { load-cell-rated-conditions }
  required_competence {
    competence humidity_testing {
      method_standard "iec-60068-2-78"
      description "Steady-state damp heat exposure (R 60-2, 2.10.6, applying IEC 60068-2-78)"
    }
    competence force_measurement {
      range { max "e_max" unit "kg" }
      description "Force-generating system applying the reference load before/during/after exposure (R 60-2, 2.7.2)"
    }
    competence indication_readout {
      description "Indicating instrument recording the output around the exposure (R 60-2, 2.7.2)"
    }
  }
  acceptance_criteria {
    type composite
    pass_if "ocl{humidity_sh_criterion}"
    criterion humidity_sh_criterion { pass_if "ocl{abs(e_l) <= abs(mpe)}" requirement /req/metrological/humidity-sh description "|E_L| ≤ |MPE| at 85% RH" }
  }
  design {
    specimens { count 1 continuity same_eut rules { unit-continuity } }
  }
  result_forms { humidity-sh }
}
subject LoadCell {
  is {
    endpoint loadcell_api {
      operation get_indication { kind query serves { indication } payload { quantity_kind mass unit kg timestamp true } }
      operation watch_state { kind subscribe serves { state } payload { quantity_kind state unit dimensionless timestamp true } }
      operation run_self_test { kind invoke does { self_test } payload { quantity_kind diagnostic_report unit dimensionless timestamp true } }
      access { public { get_indication } registered { watch_state } authority { run_self_test } }
      profile rest_json
    }
  }
  has {
    serve sample.test_context.d_min via get_indication { fresh_within 5s }
    serve sample.state via watch_state { fresh_within 1s }
  }
}
quantity_register r60 {
  kind mass { dimensions { M 1 } si_unit "kg" }
  kind length { dimensions { L 1 } si_unit "m" }
  kind time { dimensions { T 1 } si_unit "s" }
  kind temperature { dimensions { Θ 1 } si_unit "K" }
  kind electric-current { dimensions { I 1 } si_unit "A" }
  kind force { dimensions { L 1 M 1 T -2 } si_unit "N" }
  kind pressure { dimensions { L -1 M 1 T -2 } si_unit "Pa" }
  kind frequency { dimensions { T -1 } si_unit "Hz" }
  kind voltage { dimensions { I -1 L 2 M 1 T -3 } si_unit "V" }
  kind acceleration { dimensions { L 1 T -2 } si_unit "m/s²" }
  kind relative-humidity { si_unit "1" }
  kind verification_interval { si_unit "1" }
  kind count { si_unit "1" }
  kind dimensionless { si_unit "1" }
  kind currency { si_unit "EUR" }
  unit kg { symbol "kg" label "kilogram" kind mass }
  unit m { symbol "m" label "metre" kind length }
  unit s { symbol "s" label "second" kind time }
  unit K { symbol "K" label "kelvin" kind temperature }
  unit A { symbol "A" label "ampere" kind electric-current }
  unit N { symbol "N" label "newton" kind force definition "kg⋅m/s²" }
  unit Pa { symbol "Pa" label "pascal" kind pressure definition "N/m²" }
  unit Hz { symbol "Hz" label "hertz" kind frequency definition "1/s" }
  unit V { symbol "V" label "volt" kind voltage definition "W/A" }
  unit m/s2 { symbol "m/s²" label "metre per second squared" kind acceleration definition "acceleration of gravity (R 60-2, 2.7.3.2)" }
  unit degC { symbol "°C" label "degree Celsius" kind temperature offset 273.15 }
  unit min { symbol "min" label "minute" kind time factor 60 }
  unit h { symbol "h" label "hour" kind time factor 3600 }
  unit g { symbol "g" label "gram" kind mass factor 0.001 }
  unit t { symbol "t" label "tonne" kind mass factor 1000 }
  unit kPa { symbol "kPa" label "kilopascal" kind pressure factor 1000 }
  unit mbar { symbol "mbar" label "millibar" kind pressure factor 100 }
  unit pctRH { symbol "%RH" label "percent relative humidity" kind relative-humidity factor 0.01 }
  unit v { symbol "v" label "verification interval" kind verification_interval definition "load cell verification interval (errors and limits expressed in units of v — NOT a mass)" }
  unit counts { symbol "counts" label "ADC counts" kind count }
  unit dimensionless { label "dimensionless" kind dimensionless }
  unit mV { symbol "mV" label "millivolt" kind voltage factor 0.001 }
  unit EUR { symbol "€" label "euro" kind currency }
}
invariant INV-1 {
  name "No bare numbers"
  statement "every physical quantity is a QuantityValue (value + unit [+ uncertainty])."
  severity error
  applies_to { QuantityValue }
  source "docs/oiml-core/09-invariants.md#9.2"
  enforcement { kernel:C32 kernel:C33 linker:quantity-coherence linker:pair-list-components gate:schema-quantity-value }
}
invariant INV-2 {
  name "Schema/instance split"
  statement "an attribute is DEFINED once (AttributeDefinition: symbol, clause, IRDI) and VALUED per Model or Sample (Parameter)."
  severity error
  applies_to { AttributeDefinition Parameter }
  source "docs/oiml-core/09-invariants.md#9.3"
  enforcement { kernel:C1 linker:requirement-binding-targets linker:bind-paths gate:codegen-entity-types }
}
invariant INV-3 {
  name "Binding, never restating"
  statement "every D1 element references attribute paths into instrument-description; nothing physical is defined in conformity-specification."
  severity error
  applies_to { Requirement ConformanceTest FormSchema }
  source "docs/oiml-core/09-invariants.md#9.4"
  enforcement { linker:ocl-identifiers linker:requirement-targeting linker:bind-paths linker:requirement-binding-targets }
}
invariant INV-4 {
  name "Reports contain no verdicts"
  statement "D2 contains no verdicts. If a TestReport says 'pass', the schema is broken."
  severity error
  applies_to { TestReport }
  source "docs/oiml-core/09-invariants.md#9.5"
  enforcement { gate:testreport-no-outcome gate:verdict-chain }
}
invariant INV-5 {
  name "Re-evaluation without re-testing"
  statement "D3 consumes only definitions and reports; re-evaluation (new class limits, surveillance) requires no re-testing."
  severity error
  applies_to { Verdict }
  source "docs/oiml-core/09-invariants.md#9.6"
  enforcement { gate:verdict-reexecution }
}
invariant INV-6 {
  name "One sample, one report, one evaluation"
  statement "one Sample = one TestReport = one SampleEvaluation. Type conformity is established ONLY by TypeEvaluation across Samples."
  severity error
  applies_to { TestRun MeasuringInstrumentSample EvaluationReport }
  source "docs/oiml-core/09-invariants.md#9.7"
  enforcement { gate:testrun-sample-cardinality gate:evaluation-aggregator }
}
invariant INV-7 {
  name "Values, facts, judgments"
  statement "formula outputs are VALUES (instrument-description), Constraint results are FACTS (test-execution), Verdicts are JUDGMENTS (evaluation)."
  severity error
  applies_to { Calculation Constraint Verdict }
  source "docs/oiml-core/09-invariants.md#9.8"
  enforcement { kernel:C84 linker:constraint-references linker:verdict-no-shadow gate:codegen-entity-types }
}
invariant INV-8 {
  name "Version pinning"
  statement "every definition executed in D2 is version-pinned in the TestReport."
  severity error
  applies_to { TestRun TestReport Instance }
  source "docs/oiml-core/09-invariants.md#9.9"
  enforcement { kernel:C18 kernel:C80 gate:testrun-method-version gate:testreport-definition-versions }
}
invariant INV-9 {
  name "OCL only"
  statement "all derivations and rules are expressed in OCL (OMG Object Constraint Language, formal/2014-02-03)… The same statement executes identically in D2 (fact checks) and D3 (re-validation)."
  severity error
  applies_to { Expression }
  source "docs/oiml-core/09-invariants.md#9.10"
  enforcement { linker:ocl-identifiers gate:ocl-single-engine gate:verdict-registry-cache }
}
invariant INV-10 {
  name "Delegation never copies down"
  statement "encapsulation by delegation: a Sample resolves attributes through its Model, a Model through its Family; a value set at a lower level overrides the inherited one. Attribute values are never copied downward."
  severity error
  applies_to { MeasuringInstrumentFamily MeasuringInstrumentGroup MeasuringInstrumentModel MeasuringInstrumentSample }
  source "docs/oiml-core/09-invariants.md#9.11"
  enforcement { kernel:C1 kernel:C17 gate:instance-delegation }
}
test_sequence mdlo-creep-dr {
  name "MDLO → Creep → DR sequence"
  description "The three performance tests must run in this order on the same sample within the same lab visit: the MDLO test (measurement error, repeatability) establishes the baseline; creep follows it; the DR reading follows the creep loading (R 60-2, 2.10 + 2.11.1/2.11.2 — the recommended per-temperature sequence of fig-2/fig-3 — and 2.9.2, which defines DR against the D_max application of the creep test). Running creep before MDLO contaminates the baseline."
  step 1 { test "/conf/metrological-tests/measurement-error-repeatability-mdlo" role baseline }
  step 2 { test "/conf/metrological-tests/creep" role follow_up depends_on 1 }
  step 3 { test "/conf/metrological-tests/dr" role follow_up depends_on 2 }
  sample_applicability all
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.11.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.11.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.9.2"
}
test_sequence temperature-cycling {
  name "Temperature cycling (20 → T_high → T_low → 20)"
  description "The environment program of the MDLO test: stabilize at the 20 °C reference, then the higher temperature, then the lower temperature, then return to 20 °C — the per-temperature operations of 2.10.1.3 run at each step (R 60-2, 2.10.1.13; concurrent conduct per temperature per 2.10). Phase-shaped steps carry no test ref; the program gates no run by itself — it orders the environment, not the tests."
  step 1 { phase "20 °C reference" }
  step 2 { phase "T_high" }
  step 3 { phase "T_low" }
  step 4 { phase "20 °C return" }
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1.13"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10"
}
formulas_used /conf/metrological-tests/measurement-error-repeatability-mdlo {
  name "MDLO evaluation formulas"
  description "The evaluation-level quantities of R 60-3, 2.1 the MDLO test derives from the indication output: the conversion factor f (2.1.2.4), the load cell error E_L (2.1.2), the repeatability error E_R (2.1.3), and the raw temperature effect on MDLO of one temperature step C_M (2.1.4 — the normalization to v_min per temperature increment lives exactly once in the mdlo_normalized VerdictQuantity)."
  formulas { conversion_factor_f e_l e_r c_m }
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1"
}
