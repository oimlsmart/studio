class TestRunEquipment#data {
  description { "One piece of test equipment used in a run (metamodel D2 TestRun.equipment entry { id, calCert? }). Identity only — equipment is modelled as conditions (data/r60/model/conditions.yaml), not as an entity hierarchy." }
  helper { true }
  id: string {
    definition "Lab-local equipment identifier (e.g. force machine, chamber)"
    modality SHALL
  }
  cal_cert: string[0..1] {
    definition "Calibration certificate reference (traceability)"
    modality MAY
  }
}
class ConditionsLogEntry#data {
  description { "One logged influence-quantity value captured alongside a measurement (metamodel D2 EvidenceRecord.conditionsLog entry { quantityKind, value, unit }); quantity kinds per data/r60/model/conditions.yaml." }
  helper { true }
  quantity_kind: string {
    definition "Influence quantity kind (temperature, relative_humidity, barometric_pressure, ...)"
    modality SHALL
  }
  value: any {
    definition ""
    modality SHALL
  }
  unit: string[0..1] {
    definition ""
    modality MAY
  }
}
class EvidenceRecord#data {
  description { "A filled data-input slot of the run — mandatory evidence, typed by the form field it satisfies (metamodel D2 EvidenceRecord, embedded on TestRun.evidence). Per-measurement sign-off lives HERE (signed_by/signed_at), not on the FormInstance." }
  helper { true }
  field: string {
    definition "Form field name (data-input slot) this record fills, e.g. 'dmax', 'test_loads'"
    modality SHALL
  }
  value: reference(QuantityValue) {
    definition "Recorded value — QuantityValue { value, unit? }, never a bare number (INV-1)"
    modality SHALL
  }
  repetition: integer[0..1] {
    definition "Repetition index (1-based) when the same slot is measured repeatedly"
    modality MAY
  }
  conditions_log: reference(ConditionsLogEntry)[0..*] {
    definition "Influence-quantity values logged at capture time (embedded)"
    modality MAY
    on_delete cascade
  }
  timestamp: datetime {
    definition ""
    modality SHALL
  }
  signed_by: string[0..1] {
    definition "Lab evaluator/supervisor name who signed this measurement off"
    modality MAY
  }
  signed_by_account: string[0..1] {
    definition "Account id of the signing operator (per-entry attribution for multi-operator runs, TODO.deploying/05); signed_by stays the display name"
    modality MAY
  }
  signed_at: datetime[0..1] {
    definition ""
    modality MAY
  }
}
class RunOperator#data {
  description { "One lab operator of a multi-operator test run (TODO.deploying/05 — loads need two people: one moves masses, one reads the instrument). Embedded on TestRun.operators; every evidence entry's sign-off attributes to one of these accounts. Provenance is per-entry and per-run — never just 'the lab'." }
  helper { true }
  account_id: string {
    definition "The operator's account id (the auth account's id; provenance key)"
    modality SHALL
  }
  name: string {
    definition "Display name"
    modality SHALL
  }
  role_note: string[0..1] {
    definition "What this operator did on the run (lead, load handling, readings, …)"
    modality MAY
  }
  signed_off_at: datetime[0..1] {
    definition "When this operator signed off their part of the run's evidence"
    modality MAY
  }
}
class ConstraintCheckResult#data {
  description { "Execution of one instrument-description.Constraint (R 60 profile DL.5, e.g. constr:r60:fig3-2b) against the run's bound values (metamodel D2 ConstraintCheck, embedded on TestRun.constraint_checks). A violated test-setup constraint invalidates the run AS A TEST, regardless of results." }
  helper { true }
  constraint: string {
    definition "Constraint id from the Recommendation profile (e.g. 'constr:r60:fig3-2b')"
    modality SHALL
  }
  evaluated_values: object {
    definition "Input name -> numeric value the OCL invariant was evaluated with"
    modality SHALL
  }
  result: enum {
    definition ""
    modality SHALL
    enum_values { satisfied violated }
  }
  effect_on_admissibility: string {
    definition "'invalidates_run' when a violated test-setup constraint voids the run; 'none' otherwise"
    modality SHALL
  }
}
class RunAdmissibility#data {
  description { "The admissibility gate of a run (metamodel D2 TestRunResult.admissibility map). Computed by the test-run service from evidence coverage, evidence units, and constraint-check outcomes." }
  helper { true }
  all_required_slots_filled: boolean {
    definition ""
    modality SHALL
  }
  units_valid: boolean {
    definition ""
    modality SHALL
  }
  conditions_within_envelope: boolean {
    definition ""
    modality SHALL
  }
  status: enum {
    definition ""
    modality SHALL
    enum_values { admissible inadmissible }
  }
}
class TestRun#data {
  store { testRuns }
  description { "One execution of one conformance test on one MeasuringInstrumentSample (metamodel D2 TestRun). Created per TestAssignment by the test-run service (one run per assignment, idempotent); bridged 1:1 to the FormInstance that acts as the run's evidence template. FACTS ONLY — verdicts belong to evaluation (Module D3)." }
  indexes { test_assignment_id test_request_id sample_id laboratory_id standard_id status form_instance_id }
  id: string {
    definition ""
    modality SHALL
  }
  standard_id: string {
    definition ""
    modality SHALL
  }
  conformance_test: string {
    definition "Conformance test id this run executes (form's conformance_test URN when declared, else the R 60-3 form id)"
    modality SHALL
  }
  test_assignment_id: reference(TestAssignment) {
    definition "The assignment (form × sample tuple) this run executes — one run per assignment"
    modality SHALL
    on_delete cascade
    required true
  }
  test_request_id: reference(TestRequest)[0..1] {
    definition "Denormalized from the assignment for query efficiency"
    modality MAY
    on_delete nullify
    required false
  }
  sample_id: reference(MeasuringInstrumentSample) {
    definition "The physical sample under test"
    modality SHALL
    on_delete restrict
    required true
  }
  laboratory_id: reference(TestLaboratory) {
    definition "Lab performing the run (denormalized from the assignment)"
    modality SHALL
    on_delete restrict
    required true
  }
  method_version: string[0..1] {
    definition "Version pin of the test method/form schema (metamodel D2 methodVersion)"
    modality MAY
  }
  operator: string[0..1] {
    definition "Lab evaluator performing the run — the derived LEAD (operators[0].name) for compatibility; the full team lives in operators"
    modality MAY
  }
  operators: reference(RunOperator)[0..*] {
    definition "The lab operators who ran this run (multi-operator runs, TODO.deploying/05 — e.g. load handling needs two people); each entry signs off its own part of the evidence. operators[0] is the lead (the singular `operator` mirrors its name)"
    modality MAY
    on_delete cascade
  }
  started: datetime {
    definition ""
    modality SHALL
  }
  ended: datetime[0..1] {
    definition ""
    modality MAY
  }
  status: enum {
    definition "Lifecycle: PLANNED (created, no evidence yet) → IN_PROGRESS (evidence being recorded) → COMPLETED (admissible, form submitted) | INVALIDATED (a test-setup constraint was violated or the evidence is inadmissible — the run is void AS A TEST)."
    modality SHALL
    enum_values { PLANNED IN_PROGRESS COMPLETED INVALIDATED }
  }
  equipment: reference(TestRunEquipment)[0..*] {
    definition "Equipment used, with calibration references (embedded)"
    modality SHALL
    on_delete cascade
  }
  evidence: reference(EvidenceRecord)[0..*] {
    definition "Recorded data-input values with per-measurement sign-off (embedded)"
    modality SHALL
    on_delete cascade
  }
  superseded_evidence: reference(EvidenceRecord)[0..*] {
    definition "Evidence archive of a redone run (embedded): when an INVALIDATED run is redone (redoRun), its current evidence moves here verbatim — history is kept but no longer participates in admissibility."
    modality MAY
    on_delete cascade
  }
  redo_count: integer[0..1] {
    definition "Number of times this run was redone from INVALIDATED (redoRun)"
    modality MAY
  }
  constraint_checks: reference(ConstraintCheckResult)[0..*] {
    definition "Executed test-setup constraint checks (embedded; fig3-1/2a/2b, interval-consistency)"
    modality SHALL
    on_delete cascade
  }
  form_instance_id: reference(FormInstance)[0..1] {
    definition "1:1 link to the FormInstance that is the run's evidence template"
    modality MAY
    on_delete nullify
    required false
  }
  admissibility: reference(RunAdmissibility)[0..1] {
    definition "Computed admissibility gate (embedded helper); refreshed by computeAdmissibility"
    modality MAY
  }
  created: datetime {
    definition ""
    modality SHALL
  }
  modified: datetime {
    definition ""
    modality SHALL
  }
}
class VerificationMark#data {
  description { "One verification mark applied to the sample after a passed verification (metamodel identity-provenance.VerificationMark; OIML V 1:2022, 3.04). The mark designator is national-regulation content — the record carries the string, never a shape registry." }
  helper { true }
  id: string {
    definition ""
    modality SHALL
  }
  mark: string {
    definition "Mark designator (e.g. the national verification mark)"
    modality SHALL
  }
  location: string[0..1] {
    definition "Where on the instrument the mark sits (R 91-1, 7.14: space at visible spots)"
    modality MAY
  }
  clause: string[0..1] {
    definition "Clause the mark discharges (e.g. R 91-1, 8.2.4)"
    modality MAY
  }
  applied_at: datetime {
    definition ""
    modality SHALL
  }
  applied_by: string[0..1] {
    definition ""
    modality MAY
  }
}
class SealStatus#data {
  description { "The state of one seal on a sample (VIML 2.20 sealing — protection against unauthorized intervention, e.g. R 91-1, 7.13 a–c: adjustment means, metrology-relevant parts, software integrity). Embedded on MeasuringInstrumentSample.seals; set/renewed by a passed verification's marking and securing." }
  helper { true }
  id: string {
    definition ""
    modality SHALL
  }
  protects: string {
    definition "What the seal protects (adjustment means, metrology-relevant replaceable parts, software integrity)"
    modality SHALL
  }
  means: string[0..1] {
    definition "Sealing means — mechanical, electronic, or other technical means giving clear evidence of tampering"
    modality MAY
  }
  location: string[0..1] {
    definition ""
    modality MAY
  }
  status: enum {
    definition ""
    modality SHALL
    enum_values { INTACT BROKEN REPLACED VOID }
  }
  set_by: string[0..1] {
    definition "VerificationRecord id that set/renewed this seal state"
    modality MAY
  }
  set_at: datetime[0..1] {
    definition ""
    modality MAY
  }
}
class VerificationSignal#data {
  description { "One posted out-of-cycle verification signal (the signal-event channel of the re-verification triggers, TODO.roadmap/21): an event that may invalidate the current verification before its validity window elapses (e.g. tyre-change on an ego speed meter, R 91-1, 6.15.3 Note 2). Embedded on MeasuringInstrumentSample.verification_signals; the trigger engine (browser/src/data/verification.ts) matches pending signals against the signal triggers of the governing VerificationProcess and fires the bound sample_verification action; consumed_by records the re-verification that answered the signal." }
  helper { true }
  event: string {
    definition "Signal event name (e.g. tyre-change)"
    modality SHALL
  }
  at: datetime {
    definition ""
    modality SHALL
  }
  notes: text[0..1] {
    definition ""
    modality MAY
  }
  consumed_by: string[0..1] {
    definition "VerificationRecord id of the re-verification that answered this signal; absent = pending"
    modality MAY
  }
}
class VerificationEquipment#data {
  description { "One piece of test equipment used in a verification (traceability — the D2 TestRun.equipment shape { id, cal_cert? }, re-declared here so the verification entities stand alone in Core)." }
  helper { true }
  id: string {
    definition "Lab-local equipment identifier (e.g. reference speed meter, traffic simulator)"
    modality SHALL
  }
  cal_cert: string[0..1] {
    definition "Calibration certificate reference (traceability)"
    modality MAY
  }
}
class VerificationRecord#data {
  store { verificationRecords }
  description { "One verification event on ONE sample (metamodel v0.6.1 evaluation.Verification; OIML V 1:2022, 2.09): kind, the executed process definition, the per-requirement verdicts over the process's assessment scope (the shared D3 Verdict shape — the same machinery as TestReportDetermination.verdicts, computed from the verification test set's evidence), the marks applied and securing state set after a pass, the assessing authority/lab/equipment, the validity window instance (assessed_date + the process's window = valid_until — the timer trigger fires when reached), and the chain to the previous verification (subsequent/periodic kinds). The record's own lifecycle is the verification_record state machine; the sample's validity lifecycle is sample_verification." }
  indexes { sample_id model_id standard_id kind status }
  id: string {
    definition ""
    modality SHALL
  }
  standard_id: string {
    definition ""
    modality SHALL
  }
  sample_id: reference(MeasuringInstrumentSample) {
    definition "The verified sample — one verification event per sample per event"
    modality SHALL
    on_delete restrict
    required true
  }
  model_id: reference(MeasuringInstrumentModel)[0..1] {
    definition "Denormalized from sample_id.model_id for query efficiency"
    modality MAY
    on_delete restrict
    required false
  }
  kind: enum {
    definition "VIML 2.12 initial / 2.13 subsequent / 2.14 mandatory periodic; in-service = the Recommendation's inspection kind (R 91-1, 8.4)"
    modality SHALL
    enum_values { initial subsequent periodic in-service }
  }
  process_id: string {
    definition "VerificationProcess definition id in data/<rec>/evaluation/verification.yaml (e.g. initial-verification)"
    modality SHALL
  }
  tests: string[][0..*] {
    definition "Conformance-test identifiers actually executed (/conf/... — a subset of the process definition's test set; R 91-1, 8.2.2 allows combining/switching the laboratory and field accuracy tests)"
    modality SHALL
  }
  status: enum {
    definition "Lifecycle per evaluation/state-machines.yaml verification_record machine; MARKED = passed + marks/securing applied"
    modality SHALL
    enum_values { DRAFT IN_PROGRESS ASSESSED PASSED FAILED MARKED }
  }
  outcome: enum {
    definition "The conformity assessment result over the process's scope; pass => marking/securing + the validity window opens"
    modality SHALL
    enum_values { pass fail indeterminate }
  }
  verdicts: reference(Verdict)[0..*] {
    definition "Per-requirement verdicts over the process's assessment scope (embedded) — computed by the same verdict machinery the type evaluation uses, over the verification test set's evidence, with the process's limits where they differ (e.g. in-service MPE)"
    modality SHALL
  }
  marks: reference(VerificationMark)[0..*] {
    definition "Verification marks applied after a pass (embedded; VIML 3.04, R 91-1, 7.14/8.2.4)"
    modality SHALL
  }
  laboratory_id: reference(TestLaboratory)[0..1] {
    definition "Laboratory that performed the verification tests (the accuracy tests may be lab- or field-based, R 91-1, 8.2.2)"
    modality MAY
    on_delete restrict
    required false
  }
  authority: string[0..1] {
    definition "The metrological authority carrying out the verification (R 91-1, 8.2/8.3)"
    modality MAY
  }
  equipment: reference(VerificationEquipment)[0..*] {
    definition "Test equipment used (traceability) — { id, cal_cert? } entries"
    modality MAY
  }
  assessed_by: string {
    definition ""
    modality SHALL
  }
  assessed_date: date {
    definition ""
    modality SHALL
  }
  valid_until: date[0..1] {
    definition "assessed_date + the process validity window — the timer re-verification trigger fires when reached"
    modality MAY
  }
  certificate_number: string[0..1] {
    definition "Verification certificate reference (VIML 3.02)"
    modality MAY
  }
  previous_verification_id: reference(VerificationRecord)[0..1] {
    definition "The chain: the verification this one supersedes (subsequent/periodic kinds)"
    modality MAY
    on_delete nullify
    required false
  }
  trigger_event: string[0..1] {
    definition "What brought this verification about: scheduled | <signal event id> (e.g. tyre-change)"
    modality MAY
  }
  created: datetime {
    definition ""
    modality SHALL
  }
  modified: datetime {
    definition ""
    modality SHALL
  }
}
