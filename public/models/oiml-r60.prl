  field main_power_supply : text { label "Main power supply" }
  field battery : text { label "Battery (type, voltage)" }
  field indicator : text { label "Indicator" ref cites "urn:oiml:pub:r:76:2006#clause-T.2.2.2" }
  field data_printer : text { label "Data printer" }
  field other_accessories : text { label "Other accessories" }
  field further_remarks : text { label "Further remarks concerning accessories" }
}
form r60-3/sec-4.7 {
  name "Selection of sample(s) tested"
  description "Definition of the test pattern, justification of the selection of the test sample(s), and adjustments made during testing"
  data_class FormInstance#data
  section "R 60-3, 4.7–4.8"
  note "R 60-3 presents this as three printed tables — 4.7.1 (test pattern definition), 4.7.2 (selection justification), and 4.8 (adjustments and modifications). All three are PER SAMPLE: each row of the samples array carries the sample's own model designation, E_max, n_LC, v_min and DR (§4.7.1), so family reports with mixed-capacity samples record each capacity against its own designation — the earlier form-level hoisting of E_max/n_LC/v_min/DR broke mixed-capacity families (audit C5) and is removed."
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.7"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.8"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.7.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.7.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.7.1/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.7.2/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.8/table-1"
  field samples : array {
    label "Samples"
    items { object }
    min_items 1
    fields {
      field model_designation : string { label "Model designation" description "Model designation of THIS sample (per-row, R 60-3 §4.7.1)." required true }
      field serial_number : string { label "Serial number" required true }
      field emax : number { label "Maximum capacity, stem:[E_max]" unit "g, kg, or t" required true ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.5" }
      field nlc : integer { label "Maximum number of load cell intervals, stem:[n_LC]" required true ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.8" }
      field vmin : number { label "Minimum load cell verification interval, stem:[v_min]" unit "g, kg, or t" required true ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.11" }
      field dr : number { label "Minimum dead load output return, stem:[DR]" unit "g, kg, or t" ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.10" }
      field selection_justification : text { label "Justification / Remark" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.3" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.4" }
      field selection_test_report_number : string { label "Test Report No. (selection)" }
      field adjustments_modifications : text { label "Adjustments and modifications made to the sample" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.3" }
      field adjustments_test_report_number : string { label "Test Report No. (adjustments)" }
      field further_information_adjustments : text { label "Further information concerning adjustments" }
    }
  }
}
form r60-3/sec-4.9.1 {
  name "General information of the load cell under test"
  description "General information of the load cell under test specified by the manufacturer"
  data_class FormInstance#data
  section "R 60-3, 4.9.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.1/table-1"
  field manufacturer_name : string { label "Manufacturer's name/trade mark" required true }
  field type_designation : string { label "Manufacturer's type designation (or load cell model number)" required true }
  field serial_number : string { label "Serial number" required true }
  field construction : string { label "Load cell construction" examples "S-type, ring type, bending beam" }
  field material : string { label "Load cell material" }
  field sealing : string { label "Sealing of strain gauge application" examples "hermetically, potted" }
  field digital : boolean { label "Digital load cell" true_label "Yes" false_label "No" }
  field accuracy_classes : string { label "Accuracy classes" }
  field nlc : integer { label "Maximum number of verification intervals, stem:[n_LC]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-4" }
  field emax : number { label "Maximum capacity, stem:[E_max]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.7" }
  field emin : number { label "Minimum capacity, stem:[E_min]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.8" }
  field vmin : number { label "Minimum load cell verification interval, stem:[v_min = (E_max − E_min) / Y]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-4" }
  field dr : number { label "Minimum dead load output return, stem:[DR = 1/2 (E_max − E_min) / Z]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.10" ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9" }
  field rated_output : string { label "Rated output" unit "unitsml(mV/V),counts" }
  field input_impedance : number { label "Input impedance" description "Mandatory for strain gauge load cells" unit "unitsml(Ohm)" required_when "ocl{family.classification.construction = 'strain-gauge'}" }
  field cable_connection : enum { label "Cable connection" description "Mandatory for strain gauge load cells" required_when "ocl{family.classification.construction = 'strain-gauge'}" values { 4-wire 6-wire } }
  field cable_length : number { label "Cable length" description "Mandatory for strain gauge load cells with 4-wire connection" unit "unitsml(m)" required_when "ocl{cable_connection = '4-wire'}" }
  field additional_information : text { label "Additional information concerning the type (connection equipment, interfaces, etc.)" }
}
form r60-3/sec-4.9.2 {
  name "Additional information for the performance tests"
  description "Additional information for the performance tests"
  data_class FormInstance#data
  section "R 60-3, 4.9.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.2/table-1"
