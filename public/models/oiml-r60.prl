table mpe_tiers {
  title ""
  description "MPE tier breakpoints per accuracy class (R 60-1, Table 4)"
  columns {
    accuracy_class: string
    load_min: number "v"
    load_max: number "v"
    limit_factor: number
  }
  data {
    "A" "0" "50000" "0.5"
    "A" "50000" "200000" "1"
    "A" "200000" "null" "1.5"
    "B" "0" "5000" "0.5"
    "B" "5000" "20000" "1"
    "B" "20000" "null" "1.5"
    "C" "0" "500" "0.5"
    "C" "500" "2000" "1"
    "C" "2000" "null" "1.5"
    "D" "0" "50" "0.5"
    "D" "50" "200" "1"
    "D" "200" "null" "1.5"
  }
}
table test_runs {
  title ""
  description "Load applications per test point by accuracy class"
  columns {
    accuracy_class: string
    runs: integer
  }
  data {
    "A" "5"
    "B" "5"
    "C" "3"
    "D" "3"
  }
}
table temperature_increment {
  title ""
  description "MDLO evaluation temperature increment by accuracy class"
  columns {
    accuracy_class: string
    increment: number "degC"
  }
  data {
    "A" "2"
    "B" "5"
    "C" "5"
    "D" "5"
  }
}
table loading_stabilisation_times {
  title ""
  description "Combined loading and stabilisation times to be achieved prior to reading, by accuracy class and load-change magnitude (R 60-2, Table 1; loading/unloading ≈ half the time, remainder stabilisation, both recorded in absolute values)"
  columns {
    load_change_gt: number "kg"
    load_change_max: number "kg"
    class_cd: integer "s"
    class_b: integer "s"
    class_a: integer "s"
  }
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-table-1"
  data {
    "0" "10" "10" "15" "20"
    "10" "100" "20" "30" "40"
    "100" "1000" "30" "45" "60"
    "1000" "10000" "40" "60" "80"
    "10000" "100000" "50" "75" "100"
    "100000" "null" "60" "90" "120"
  }
}
table emc_severities {
  title ""
  description "EMC disturbance test severities (R 60-2, 2.10.7.x; IEC 61000-4 series)"
  columns {
    test: string
    parameter: string
    value: string
    clause: string
  }
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7"
  data {
    "bursts" "level" "3 (IEC 61000-4-4)" "2.10.7.6"
    "bursts" "power_lines" "2 kV" "2.10.7.6"
    "bursts" "signal_lines" "1 kV" "2.10.7.6"
    "surge" "level" "3 (IEC 61000-4-5)" "2.10.7.7"
    "surge" "line_to_line" "1 kV" "2.10.7.7"
    "surge" "line_to_earth" "2 kV" "2.10.7.7"
    "esd" "contact" "6 kV" "2.10.7.8"
    "esd" "air" "8 kV" "2.10.7.8"
    "rf_radiated" "field_strength" "10 V/m" "2.10.7.9"
    "rf_radiated" "frequency_range" "80 MHz – 3000 MHz (26 MHz lower bound for cells without power/I/O lines)" "2.10.7.9"
    "rf_conducted" "frequency_range" "0.15 – 80 MHz" "2.10.7.10"
    "rf_conducted" "amplitude" "10 V (emf, 50 Ohm)" "2.10.7.10"
    "short_time_reduction" "test_a" "0 % residual, 0.5 cycles" "2.10.7.5"
    "short_time_reduction" "test_b" "0 % residual, 1 cycle" "2.10.7.5"
    "short_time_reduction" "test_c" "40 % residual, 10 cycles" "2.10.7.5"
    "short_time_reduction" "test_d" "70 % residual, 25 cycles" "2.10.7.5"
    "short_time_reduction" "test_e" "80 % residual, 250 cycles" "2.10.7.5"
    "short_time_reduction" "short_interruption" "0 % residual, 250 cycles" "2.10.7.5"
  }
}
table profiles {
  title "Per-dimension value bindings"
  columns ""
  profiles {
    profile mpe_tiers { description "MPE tier breakpoints per accuracy class (R 60-1, Table 4)" dimension accuracy_class unit "v" binding { A: [{ min: 0 max: 50000 factor: 0.5 } { min: 50000 max: 200000 factor: 1 } { min: 200000 factor: 1.5 }] B: [{ min: 0 max: 5000 factor: 0.5 } { min: 5000 max: 20000 factor: 1 } { min: 20000 factor: 1.5 }] C: [{ min: 0 max: 500 factor: 0.5 } { min: 500 max: 2000 factor: 1 } { min: 2000 factor: 1.5 }] D: [{ min: 0 max: 50 factor: 0.5 } { min: 50 max: 200 factor: 1 } { min: 200 factor: 1.5 }] } }
    profile test_runs { description "Load applications per test point" dimension accuracy_class type integer binding { A: 5 B: 5 C: 3 D: 3 } }
    profile temperature_increment { description "MDLO evaluation temperature increment" dimension accuracy_class unit "°C" type integer binding { A: 2 B: 5 C: 5 D: 5 } }
    profile n_LC_range { description "Allowed verification interval range" dimension accuracy_class type range binding { A: { min: 50000 } B: { min: 5000 max: 100000 } C: { min: 500 max: 10000 } D: { min: 100 max: 1000 } } }
    profile p_LC_range { description "Apportioning factor range (R 60-1, 5.3.2 declares 0.3–0.8 — see source_discrepancy for the legacy 0.3–1.0 binding)" dimension technology type range source_discrepancy { summary "Legacy value model carries analogue-passive p_LC 0.3–1.0; R 60-1, 5.3.2 declares 0.3 ≤ p_LC ≤ 0.8" sources { "urn:oiml:pub:r:60-1:2021#clause-5.3.2" } resolution follows_clause_x rationale "The analogue-passive { min: 0.3, max: 1.0 } binding is the legacy value carried for provenance; R 60-1:2021, 5.3.2 declares 0.3 ≤ p_LC ≤ 0.8 and is canonical — enforced by /req/metrological/mpe and /req/electronic/p-lc-constraint. The dissenting side is the legacy data model itself, not a clause of the 2021 edition, so only the canonical clause is cited." } binding { analogue-passive: { min: 0.3 max: 1 default: 0.7 } analogue-active: { min: 0.7 max: 0.8 default: 0.7 } digital: { min: 0.7 max: 0.8 default: 0.7 } } }
    profile min_temperature_span { description "Minimum special temperature range span" dimension accuracy_class unit "°C" type integer binding { A: 5 B: 15 C: 30 D: 30 } }
  }
}
term durability {
  label "durability"
  definition "ability of a measuring instrument to maintain its performance characteristics over a period of use"
  vocab_ref { register viml-2022 clause "5.15" }
  section "3.1"
  source "urn:oiml:pub:v:1:2022#clause-5.15 urn:oiml:pub:r:60-1:2021#clause-3.1 urn:oiml:pub:r:60-1:2021#clause-3.1.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term legal-metrology {
  label "legal metrology"
  definition "practice and process of applying statutory and regulatory structure and enforcement to metrology"
  vocab_ref { register viml-2022 clause "1.01" }
  section "3.1"
  source "urn:oiml:pub:v:1:2022#clause-1.01 urn:oiml:pub:r:60-1:2021#clause-3.1.2"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term load-cell {
  label "load cell"
  definition "measuring transducer that will produce an output in response to an applied load. This output may be converted by another device into measurement units such as mass"
  section "3.1"
  source "urn:oiml:pub:r:60-1:2021#clause-3.1.3"
  language "en"
  form_type "abbreviation"
  part_of_speech "noun"
  alt { LC }
  abbreviations { LC }
}
term analogue-passive-load-cell {
  label "analogue-passive load cell"
  definition "load cell from which the output provides either measurable data or direct information representing the measurand value"
  section "3.1"
  note "The ratio between output and input may be adjustable and this type of load cell may utilise passive electronics (e.g. strain gauges) and passive temperature compensation elements."
  source "urn:oiml:pub:r:60-1:2021#clause-3.1.3.1"
  scope_note "The ratio between output and input may be adjustable and this type of load cell may utilise passive electronics (e.g. strain gauges) and passive temperature compensation elements."
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term analogue-active-load-cell {
  label "analogue-active load cell"
  definition "load cell which is capable of performing the functions of an analogue-passive load cell and which also utilises active electronics"
  section "3.1"
  note "May utilise active electronics for gaining an electronic representation of the measurand value, active temperature compensation, and similar functions."
  source "urn:oiml:pub:r:60-1:2021#clause-3.1.3.2"
  scope_note "May utilise active electronics for gaining an electronic representation of the measurand value, active temperature compensation, and similar functions."
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term digital-load-cell {
  label "digital load cell"
  definition "analogue-active load cell which includes an analogue to digital conversion device providing a representation of the measurand value in some unprocessed digital format"
  section "3.1"
  source "urn:oiml:pub:r:60-1:2021#clause-3.1.3.3"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term digital-load-cell-further-processing {
  label "digital load cell equipped with further data processing"
  definition "analogue-active load cell which includes an analogue to digital conversion device providing a representation of the measurand value in some digital format and includes further digital processing (e.g. scaling)"
  section "3.1.3.4"
  source "urn:oiml:pub:r:60-1:2021#clause-3.1.3.4"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term marking {
  label "marking"
  definition "affixing of one or more marks"
  vocab_ref { register viml-2022 clause "2.19" }
  section "3.1"
  source "urn:oiml:pub:v:1:2022#clause-2.19 urn:oiml:pub:r:60-1:2021#clause-3.1.4"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term metrological-supervision {
  label "metrological supervision"
  definition "activity of legal metrological control to check the observance of metrology laws and regulations"
  vocab_ref { register viml-2022 clause "2.03" }
  section "3.1"
  source "urn:oiml:pub:v:1:2022#clause-2.03 urn:oiml:pub:r:60-1:2021#clause-3.1.5"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term measuring-transducer {
  label "measuring transducer"
  definition "device, used in measurement, that provides an output quantity having a specified relation to the input quantity"
  vocab_ref { register vim-2012 clause "3.7" }
  section "3.1"
  source "urn:oiml:v:2:200#clause-3.7 urn:oiml:pub:r:60-1:2021#clause-3.1.6"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term performance-test {
  label "performance test"
  definition "test to verify whether the load cell under test is capable of performing its intended functions"
  section "3.1"
  source "urn:oiml:pub:r:60-1:2021#clause-3.1.7"
  scope_note "Also defined in OIML D 11, 3.21.4 (Part 4 Annex A.1.12 cross-reference)"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term rated-operating-condition {
  label "rated operating condition"
  definition "operating condition that must be fulfilled during measurement in order that a measuring instrument or measuring system perform as designed"
  section "3.1.8"
  source "urn:oiml:pub:r:60-1:2021#clause-3.1.8 urn:oiml:pub:r:60-1:2021#clause-3.8.4"
  scope_note "Defined twice by the source (R 60-1, 3.1.8 and 3.8.4, identical wording) — one register entry binds both fragments (TODO.roadmap/26)."
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term sealing {
  label "sealing"
  definition "means intended to protect the measuring instrument against any unauthorised modification, readjustment, removal of parts, software, etc."
  vocab_ref { register viml-2022 clause "2.20" }
  section "3.1"
  source "urn:oiml:pub:v:1:2022#clause-2.20 urn:oiml:pub:r:60-1:2021#clause-3.1.9"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term type-evaluation {
  label "type (pattern) evaluation"
  definition "conformity assessment procedure on one or more specimens of an identified type (pattern) of measuring instruments which results in an evaluation report and/or an evaluation certificate"
  vocab_ref { register viml-2022 clause "2.04" }
  section "3.1"
  source "urn:oiml:pub:v:1:2022#clause-2.04 urn:oiml:pub:r:60-1:2021#clause-3.1.10"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term type-approval {
  label "type approval"
  definition "decision of legal relevance, based on the review of the type evaluation report, that the type of a measuring instrument complies with the relevant statutory requirements and results in the issuance of the type approval certificate"
  vocab_ref { register viml-2022 clause "2.05" }
  section "3.1"
  source "urn:oiml:pub:v:1:2022#clause-2.05 urn:oiml:pub:r:60-1:2021#clause-3.1.11"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term compression-loading {
  label "compression loading"
  definition "applying a compressive force to the load receptor of a load cell"
  section "3.2"
  source "urn:oiml:pub:r:60-1:2021#clause-3.2 urn:oiml:pub:r:60-1:2021#clause-3.2.1 urn:oiml:pub:r:60-1:2021#clause-3.2.1.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term tension-loading {
  label "tension loading"
  definition "applying a tension force to the load receptor of a load cell"
  section "3.2"
  source "urn:oiml:pub:r:60-1:2021#clause-3.2.1.2"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term strain-gauge {
  label "strain gauge"
  definition "analogue resistive element that is attached to a load cell structure and that changes resistance depending on the deformation of the load cell structure when compression or tension forces are applied to the load cell"
  section "3.3"
  source "urn:oiml:pub:r:60-1:2021#clause-3.3 urn:oiml:pub:r:60-1:2021#clause-3.3.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term humidity-symbol {
  label "humidity symbol"
  definition "symbol assigned to a load cell that indicates the conditions of humidity under which the load cell has been tested"
  section "3.4"
  source "urn:oiml:pub:r:60-1:2021#clause-3.4 urn:oiml:pub:r:60-1:2021#clause-3.4.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term load-cell-family {
  label "load cell family"
  definition "group of load cells which for the purposes of type evaluation are considered as one family and that share the same material, measurement technique, strain gauge attachment principle, construction method, specifications, and metrological characteristics"
  section "3.4"
  source "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term load-cell-interval {
  label "load cell interval"
  definition "subdivision of the load cell measuring range"
  section "3.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5 urn:oiml:pub:r:60-1:2021#clause-3.5.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term load-cell-measuring-range {
  label "load cell measuring range"
  definition "range between D_max and D_min, equal to (D_max - D_min)"
  section "3.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.2"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term load-cell-output {
  label "load cell output"
  definition "measurable quantity into which a load cell converts the measured input quantity"
  section "3.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.3"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term v {
  label "load cell verification interval"
  definition "load cell interval, expressed in units of mass, used in the test of the load cell for accuracy classification"
  symbol v
  section "3.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.4"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term emax {
  label "maximum capacity"
  definition "largest value of a quantity expressed in units of mass, which may be applied to a load cell"
  symbol E_max
  section "3.5.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.5"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term dmax {
  label "maximum load of the measuring range"
  definition "largest value of a quantity expressed in units of mass which can be introduced to a load cell under test"
  symbol D_max
  section "3.5.6"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.6"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term maximum-measuring-range {
  label "maximum measuring range"
  definition "range between E_max and E_min, equal to (E_max - E_min)"
  section "3.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.7"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term nlc {
  label "maximum number of load cell verification intervals"
  definition "maximum number of load cell verification intervals into which the maximum measuring range may be divided"
  symbol n_LC
  section "3.5.8"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.8"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term emin {
  label "minimum dead load"
  definition "smallest value of a quantity (expressed in mass units) that may be applied to a load cell"
  symbol E_min
  section "3.5.9"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.9"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term dr {
  label "minimum dead load output return"
  definition "difference of load cell output, expressed in units of mass at D_min, measured before and after application of a load of D_max"
  symbol DR
  section "3.5.10"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.10"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term vmin {
  label "minimum load cell verification interval"
  definition "smallest load cell verification interval in units of mass into which the maximum measuring range (E_max - E_min) can be divided"
  symbol v_min
  section "3.5.11"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.11"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term dmin {
  label "minimum load of the measuring range"
  definition "smallest value of a quantity expressed in units of mass, applied to a load cell under test"
  symbol D_min
  section "3.5.12"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.12"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term n {
  label "number of load cell verification intervals"
  definition "total of load cell verification intervals into which the maximum measuring range is divided"
  symbol n
  section "3.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.13"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term z {
  label "relative minimum dead load output return"
  definition "ratio of the maximum measuring range, to two times the minimum dead load output return DR"
  symbol Z
  section "3.5.14"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.14"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term y {
  label "relative minimum load cell verification interval"
  definition "ratio of the maximum measuring range, to the minimum load cell verification interval v_min"
  symbol Y
  section "3.5.15"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.15"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term elim {
  label "safe load limit"
  definition "maximum load that can be applied without producing a permanent shift in the performance characteristics beyond those specified"
  symbol E_lim
  section "3.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.16"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term warm-up-time {
  label "warm-up time"
  definition "time between the moment power is applied to a load cell and the moment at which the load cell is capable of complying with the requirements"
  section "3.5"
  source "urn:oiml:pub:r:60-1:2021#clause-3.5.17"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term creep {
  label "creep"
  definition "change in load cell output occurring with time while under constant load and with all environmental conditions and other variables also remaining constant"
  section "3.7"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7 urn:oiml:pub:r:60-1:2021#clause-3.7.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term plc {
  label "apportioning factor"
  definition "value of a dimensionless fraction expressed as a decimal (e.g. 0.7) representing that portion of an error observed in the instrument which is attributed to the load cell alone"
  symbol p_LC
  section "3.7"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.2"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
}
term durability-error {
  label "durability error"
  definition "difference between the intrinsic error after a period of use and the initial intrinsic error of a measuring instrument"
  section "3.7.3"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.3"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term expanded-uncertainty {
  label "expanded uncertainty"
  definition "quantity defining an interval about the result of a measurement that may be expected to encompass a large fraction of the distribution of values that could reasonably be attributed to the measurand"
  section "3.7.4"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.4"
  scope_note "Source cites OIML G 1-100 (GUM) [7] as the definition's origin (R 60-1, 3.7.4)."
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term fault-detection-output {
  label "fault detection output"
  definition "electrical representation issued by the load cell indicating that a fault condition exists"
  section "3.7.6"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.6"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term initial-intrinsic-error {
  label "initial intrinsic error"
  definition "intrinsic error of a measuring instrument as determined prior to performance tests and durability evaluations"
  section "3.7.8"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.8"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term load-cell-intrinsic-error {
  label "load cell intrinsic error"
  definition "error resulting from a load cell, determined under reference conditions"
  section "3.7.9"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.9"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term mpe {
  label "maximum permissible error"
  definition "extreme value of measurement error, with respect to a known reference quantity value, permitted by specifications or regulations for a given measurement, measuring instrument, or measuring system"
  symbol MPE
  vocab_ref { register vim-2012 clause "4.26" }
  vocab_term "maximum permissible measurement error"
  section "3.7.10"
  source "urn:oiml:v:2:200#clause-4.26 urn:oiml:pub:r:60-1:2021#clause-3.7.10"
  language "en"
  form_type "symbol"
  part_of_speech "noun"
  alt { MPE }
  abbreviations { MPE }
}
term fault {
  label "fault"
  definition "difference between the error of indication and the intrinsic error of a measuring instrument"
  vocab_ref { register viml-2022 clause "5.12" }
  section "3.7"
  source "urn:oiml:pub:v:1:2022#clause-5.12 urn:oiml:pub:r:60-1:2021#clause-3.7.5"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term hysteresis-error {
  label "Hysteresis error"
  definition "difference in load cell output readings for the same applied force between the reading obtained by increasing the load from D_min and the reading obtained by decreasing the load from D_max"
  section "3.7"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.7"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term measurement-error {
  label "measurement error"
  definition "measured quantity minus a reference quantity value"
  section "3.7.11"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.11"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term measured-quantity-value {
  label "measured quantity (value)"
  definition "quantity value representing a measurement result"
  section "3.7.12"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.12"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term non-linearity {
  label "non-linearity"
  definition "deviation from the average of the values of load cell signals from a straight line through zero force applied and maximum force applied"
  section "3.7"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.13"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term repeatability-error {
  label "repeatability error"
  definition "difference between load cell output readings taken from consecutive tests under the same loading and environmental conditions of measurement"
  section "3.7"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.14"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term resolution {
  label "resolution"
  definition "smallest change in a quantity being measured that causes a perceptible change in the corresponding indication"
  vocab_ref { register vim-2012 clause "4.14" }
  section "3.7"
  source "urn:oiml:v:2:200#clause-4.14 urn:oiml:pub:r:60-1:2021#clause-3.7.15"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term significant-durability-error {
  label "significant durability error"
  definition "durability error exceeding the value specified in the applicable Recommendation"
  section "3.7.16"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.16"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term significant-fault {
  label "significant fault"
  definition "fault exceeding the applicable fault limit value"
  vocab_ref { register viml-2022 clause "5.14" }
  section "3.7"
  source "urn:oiml:pub:v:1:2022#clause-5.14 urn:oiml:pub:r:60-1:2021#clause-3.7.17"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term span-stability {
  label "span stability"
  definition "capability of a load cell to maintain the load cell output of the load cell's measuring range over a period of use within specified limits"
  section "3.7"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.18"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term temperature-effect-mdlo {
  label "temperature effect on minimum dead load output"
  definition "change of the signal output under minimum dead load due to a change in ambient temperature"
  section "3.7"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.19"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term temperature-effect-sensitivity {
  label "temperature effect on sensitivity"
  definition "change in sensitivity due to a change in ambient temperature"
  section "3.7"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.20"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term type-approval-mark {
  label "type approval mark"
  definition "mark applied to a measuring instrument certifying its conformity to the approved type"
  section "3.7.21"
  source "urn:oiml:pub:r:60-1:2021#clause-3.7.21"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term disturbance {
  label "disturbance"
  definition "influence quantity having a value within the limits specified in the relevant Recommendation, but outside the specified rated operating conditions of a measuring instrument"
  vocab_ref { register viml-2022 clause "5.19" }
  section "3.8"
  source "urn:oiml:pub:v:1:2022#clause-5.19 urn:oiml:pub:r:60-1:2021#clause-3.8 urn:oiml:pub:r:60-1:2021#clause-3.8.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term influence-factor {
  label "influence factor"
  definition "influence quantity having a value which ranges within the rated operating conditions of a measuring instrument"
  vocab_ref { register viml-2022 clause "5.18" }
  section "3.8"
  source "urn:oiml:pub:v:1:2022#clause-5.18 urn:oiml:pub:r:60-1:2021#clause-3.8.2"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term influence-quantity {
  label "influence quantity"
  definition "quantity that, in a direct measurement, does not affect the quantity that is actually measured, but that affects the relation between the indication and the measurement result"
  vocab_ref { register vim-2012 clause "2.52" }
  section "3.8"
  source "urn:oiml:v:2:200#clause-2.52 urn:oiml:pub:r:60-1:2021#clause-3.8.3"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term reference-condition {
  label "reference (operating) condition"
  definition "operating condition prescribed for evaluating the performance of a measuring instrument or measuring system or for comparison of measurement results"
  vocab_ref { register vim-2012 clause "4.11" }
  vocab_term "reference operating condition"
  section "3.8"
  source "urn:oiml:v:2:200#clause-4.11 urn:oiml:pub:r:60-1:2021#clause-3.8.5"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term abbr-ac {
  label "AC"
  definition "Alternating Current"
  section "3.9"
  language "en"
  form_type "abbreviation"
  part_of_speech "noun"
}
term abbr-ch {
  label "CH"
  definition "Cyclic Humidity"
  section "3.9"
  language "en"
  form_type "abbreviation"
  part_of_speech "noun"
}
term abbr-dc {
  label "DC"
  definition "Direct Current"
  section "3.9"
  language "en"
  form_type "abbreviation"
  part_of_speech "noun"
}
term abbr-emc {
  label "EMC"
  definition "Electro Magnetic Compatibility"
  section "3.9"
  language "en"
  form_type "abbreviation"
  part_of_speech "noun"
}
term abbr-eut {
  label "EUT"
  definition "Equipment Under Test"
  section "3.9"
  language "en"
  form_type "abbreviation"
  part_of_speech "noun"
}
term abbr-nh {
  label "NH"
  definition "No Humidity"
  section "3.9"
  language "en"
  form_type "abbreviation"
  part_of_speech "noun"
}
term abbr-sh {
  label "SH"
  definition "Steady-State Humidity"
  section "3.9"
  language "en"
  form_type "abbreviation"
  part_of_speech "noun"
}
term electronic-measuring-instrument {
  label "electronic measuring instrument"
  definition "instrument intended to measure an electrical or non-electrical quantity using electronic means and/or equipped with electronic devices (OIML D 11, 3.1)"
  section "A.1.1"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term module {
  label "module"
  definition "device performing a specific function or functions and (usually) manufactured and constructed such that it can be separately evaluated according to prescribed metrological and technical performance requirements (OIML D 11, 3.2)"
  section "A.1.2"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.2"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term device {
  label "device"
  definition "identifiable instrument or part of an instrument or of a family of instruments that performs a specific function or functions (OIML D 11, 3.3)"
  section "A.1.3"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.3"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term checking-facility {
  label "checking facility"
  definition "facility incorporated in a measuring instrument which enables significant faults to be detected and acted upon (OIML D 11, 3.19)"
  section "A.1.4"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.4"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term automatic-checking-facility {
  label "automatic checking facility"
  definition "checking facility that operates without the intervention of an operator (OIML D 11, 3.19.1)"
  section "A.1.5"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.5"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term permanent-automatic-checking-facility-p {
  label "permanent automatic checking facility (type P)"
  definition "automatic checking facility that operates at each measurement cycle (OIML D 11, 3.19.1.1)"
  section "A.1.6"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.6"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term intermittent-automatic-checking-facility-i {
  label "intermittent automatic checking facility (type I)"
  definition "automatic checking facility that operates at certain time intervals or per fixed number of measurement cycles (OIML D 11, 3.19.1.2)"
  section "A.1.7"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.7"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term non-automatic-checking-facility-n {
  label "non-automatic checking facility (type N)"
  definition "checking facility that requires the intervention of an operator (OIML D 11, 3.19.2)"
  section "A.1.8"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.8"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term durability-protection-facility {
  label "durability protection facility"
  definition "facility incorporated in a measuring instrument that enables significant durability errors to be detected and acted upon (OIML D 11, 3.20)"
  section "A.1.9"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.9"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term test {
  label "test"
  definition "series of operations intended to verify the compliance of the equipment under test (EUT) with specified requirements (OIML D 11, 3.21)"
  section "A.1.10"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.10"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term test-procedure {
  label "test procedure"
  definition "detailed description of the test operations (OIML D 11, 3.21.1)"
  section "A.1.11"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.11"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term mains-power {
  label "mains power"
  definition "primary external source of electrical power for an instrument, including all sub-assemblies (OIML D 11, 3.22)"
  section "A.1.13"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.13"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term power-converter {
  label "power converter (power supply device)"
  definition "sub-assembly converting the voltage from the mains power to a voltage suitable for other sub-assemblies (OIML D 11, 3.23)"
  section "A.1.14"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.14"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term auxiliary-battery {
  label "auxiliary battery"
  definition "battery that is mounted in, or connected to, an instrument that can be powered by the mains power as well, and capable of supplying power to the complete instrument for a reasonable period of time (OIML D 11, 3.25)"
  section "A.1.15"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.15"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term back-up-battery {
  label "back-up battery"
  definition "battery that is intended to maintain power supply for specific functions of an instrument in the absence of the primary power supply that includes both mains power & auxiliary battery (OIML D 11, 3.26)"
  section "A.1.16"
  source "urn:oiml:pub:r:60-4:2021#clause-A.1.16"
  scope_note "Example: to preserve stored data"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
term weighing-module {
  label "weighing module"
  definition "part of the weighing instrument that comprises all mechanical and electronic devices (i.e. load receptor, load-transmitting device, load cell, and analogue data processing device or digital data processing device) but not having the means to display the weighing result. It may optionally have devices for further processing (digital) data and operating the instrument (OIML R 76-1, T.2.2.7)"
  section "A.2.1"
  source "urn:oiml:pub:r:60-4:2021#clause-A.2.1"
  language "en"
  form_type "fullForm"
  part_of_speech "noun"
}
form r60-3/sec-4.1 {
  name "Authority Info"
  description "Issuing authority responsible for the evaluation report"
  data_class FormInstance#data
  section "R 60-3, 4.1"
  scope administrative
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-4.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.1/table-1"
  field authority_name : string { label "Authority Name" description "Name of the issuing authority" scope administrative required true ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field address : string { label "Address" description "Address of the issuing authority" scope administrative required true ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field report_number : string { label "Report Number" description "Report number" scope administrative required true ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field application_number : string { label "Application number" description "Application number" required true targets { /req/technical/mandatory-additional-info } ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field period_of_tests : string { label "Period Of Tests" description "Date range of performing the tests" scope administrative required true ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field date_of_issuing : date { label "Date of issuing this Report" description "Date of issuing this Report" scope administrative required true ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field responsible_person_name : string { label "Responsible person name" description "Name of the responsible person" scope administrative required true ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field responsible_person_signature : attachment { label "Responsible person signature" description "Signature of the responsible person" scope administrative required true ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field stamp : attachment { label "Stamp(s)" description "Stamp(s) of the issuing authority (if applicable)" scope administrative ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" ref report-format "urn:oiml:pub:r:60-3:2021#clause-4" }
}
form r60-3/sec-4.2 {
  name "Synopsis"
  description "Synopsis of examination and test results"
  data_class FormInstance#data
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-4.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.2/table-1"
  field fulfils_all_requirements : boolean { label "Fulfils All Requirements?" description "The load cell under test fulfils ALL the applicable requirements according to OIML R 60-1" required true true_label "Yes" false_label "No" ref cites "urn:oiml:pub:r:60-3:2021#clause-4.1" }
  field remarks : text { label "Remarks" }
}
form r60-3/sec-4.3.1 {
  name "Examinations"
  description "Summary of general examinations — pass/fail status of the documentation and inscription examinations"
  data_class FormInstance#data
  note "Refer to tests defined in the respective references"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-4.3.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3.1/table-1"
  field documentation : boolean { label "Documentation" description "Result of the documentation examination" required true true_label "Passed" false_label "Failed" ref cites "urn:oiml:pub:r:60-2:2021#clause-2.5" }
  field inscriptions : boolean { label "Inscription and presentation of load cell information" description "Result of the inscription and presentation examination" required true true_label "Passed" false_label "Failed" ref cites "urn:oiml:pub:r:60-1:2021#clause-6.2" ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3" }
}
form r60-3/sec-4.3.2-a {
  name "Performance tests"
  description "Performance tests for general load cells — pass/fail status of the metrological tests performed at the specified temperatures"
  data_class FormInstance#data
  note "This form is to be filled per temperature at which the performance tests were conducted. According to R 60-3, 4.1.2, the tests should be performed at 20 °C, then X_1 °C and X_2 °C, then at 20 °C."
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3.2/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3.2/table-2"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10"
  field test_temperature : number { label "Temperature where the performance tests were conducted" description "Temperature at which the performance tests were conducted for the load cell under test" unit "degC" required true }
  field maximum_permissible_errors : boolean { label "Maximum permissible measurement errors" description "Result of the maximum permissible measurement error test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.3" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.1" }
  field repeatability_error : boolean { label "Repeatability error" description "Result of the repeatability error test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.4" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.1" }
  field temperature_effect_on_mdlo : boolean { label "Temperature effect on minimum dead load output return" description "Result of the temperature effect on minimum dead load output test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.6.1.3" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.1" }
  field creep_test : boolean { label "Creep test" description "Result of the creep test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.5.1" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.2" }
  field dead_load_output_return : boolean { label "Minimum dead load output return (DR)" description "Result of the minimum dead load output return test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.5.2" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.3" }
  field barometric_pressure_effects : boolean { label "Barometric pressure effects at ambient temperature" description "Result of the barometric pressure effects test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.6.2" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.4" }
  field humidity_effects : boolean { label "Humidity effects (CH, SH)" description "Result of the humidity effects test (CH or SH as applicable to the load cell marking)" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.6.3" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.5" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.6" }
}
form r60-3/sec-4.3.2-b {
  name "Performance tests (digital)"
  description "Additional performance tests for digital load cells — pass/fail status of electronic and software tests"
  data_class FormInstance#data
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3.2/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.3.2/table-2"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7"
  applicability {
    technology: [digital]
  }
  field warm_up_time : boolean { label "Warm-up time" description "Result of the warm-up time test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.1" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.3" }
  field power_voltage_variations : boolean { label "Power voltage variations" description "Result of the power voltage variation test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.2" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.3" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.4" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.4" }
  field short_time_power_reductions : boolean { label "Short-time power reductions" description "Result of the short-time power reduction test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.5" }
  field bursts : boolean { label "Bursts (electrical fast transients)" description "Result of the electrical fast transient burst test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.6" }
  field surge : boolean { label "Surge" description "Result of the surge test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.7" }
  field electrostatic_discharge : boolean { label "Electrostatic discharge" description "Result of the electrostatic discharge test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.8" }
  field electromagnetic_susceptibility : boolean { label "Electromagnetic susceptibility" description "Result of the radiated electromagnetic susceptibility test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.9" }
  field conducted_electromagnetic_fields : boolean { label "Immunity to conducted electromagnetic fields" description "Result of the conducted electromagnetic field immunity test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.10" }
  field span_stability : boolean { label "Span stability" description "Result of the span stability test" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.6" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.11" }
  field software : boolean { label "Software" description "Result of the software examination" required true true_label "Passed" false_label "Failed" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.1" }
}
