}
requirement /req/classification/accuracy-classes {
  name "Accuracy classes and their symbols"
  statement "Load cells shall be ranked according to their overall performance capabilities into one of the four accuracy classes whose designations are as follows: Class A; Class B; Class C; Class D."
  binds_to { group.classification.accuracy_class }
  parameters {
    param accuracy_class: enum { description "The accuracy class designation determines n_LC limits, MPE breakpoints, number of test runs, and temperature increment requirements." enum_values { A B C D } }
  }
  verification { method definitional description "Accuracy class is a classification decision, not a testable property. The class is assigned based on the load cell's n_LC and test performance." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.1"
}
requirement /req/classification/max-verification-intervals {
  name "Maximum number of load cell verification intervals"
  statement "The maximum number of load cell verification intervals, n_LC, into which the maximum measuring range E_max - E_min can be divided in a measuring system shall be within the limits: Class A >= 50,000 (unlimited); Class B 5,000 to 100,000; Class C 500 to 10,000; Class D 100 to 1,000."
  binds_to { group.parameters.n_lc group.classification.accuracy_class }
  parameters {
    param n_LC: integer { description "Maximum number of load cell verification intervals. Ranges by class: A: ≥ 50000 (unlimited); B: [5000, 100000]; C: [500, 10000]; D: [100, 1000]." unit "intervals" }
  }
  limit {
    expression "ocl{group.parameters.n_lc >= lookupProfile('n_LC_range', group.classification.accuracy_class).min and (lookupProfile('n_LC_range', group.classification.accuracy_class).max.oclIsUndefined() or group.parameters.n_lc <= lookupProfile('n_LC_range', group.classification.accuracy_class).max)}"
    uses { group.parameters.n_lc group.classification.accuracy_class profile:n_LC_range formula:lookupProfile }
  }
  acceptance_criteria {
    type: "tiered"
    description: "n_LC must fall within the range prescribed for the declared accuracy class.\n"
    variable: "n_LC"
    variable_unit: "intervals"
    tiers:
      - range:
          min: 50000
        limit:
          expression: "Class A: n_LC ≥ 50000"
      - range:
          min: 5000
          max: 100000
        limit:
          expression: "Class B: 5000 ≤ n_LC ≤ 100000"
      - range:
          min: 500
          max: 10000
        limit:
          expression: "Class C: 500 ≤ n_LC ≤ 10000"
      - range:
          min: 100
          max: 1000
        limit:
          expression: "Class D: 100 ≤ n_LC ≤ 1000"
  }
  verification { method computational description "n_LC = (E_max - E_min) / v_min. Verified by computing from manufacturer's declared values." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.2"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.2"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-table-1"
}
requirement /req/classification/min-verification-interval {
  name "Minimum load cell verification interval"
  statement "The minimum load cell verification interval, v_min, shall be specified by the manufacturer."
  binds_to { group.parameters.v_min }
  verification { method inspection description "v_min is a manufacturer-declared value. Verified by checking it is specified in the accompanying documentation." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.3"
}
requirement /req/classification/supplementary-loading {
  name "Supplementary classifications for loading type"
  statement "Load cells shall also be classified by the intended manner in which a load is applied to the load cell wherever there would be a risk of confusing the manner of loading (i.e. compression loading, tension loading or universal). A load cell may bear different classifications according to the intended manner in which a load is applied. For multiple capacity load cells, each capacity shall be classified separately."
  binds_to { group.classification.load_type }
  parameters {
    param load_type: enum { description "Type of loading the load cell is designed for. Required when not clearly apparent from construction." enum_values { compression tension universal beam } }
  }
  verification { method inspection description "Loading type classification is inspected from the load cell markings and documentation." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.4"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.4"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-table-6"
}
requirement /req/classification/complete-classification {
  name "Complete load cell classification"
  statement "The load cell shall be classified corresponding to the following six parameters: accuracy class designation; maximum number of load cell verification intervals; intended manner of the application of the load, if necessary; special limits of working temperature, if applicable; humidity symbol, if applicable; and additional characterisation information."
  binds_to { group.classification.accuracy_class group.parameters.n_lc group.classification.load_type family.parameters.t_min family.parameters.t_max family.classification.humidity_class }
  verification { method inspection description "Complete classification is verified by inspecting all six parameters in the documentation and markings." }
  dependencies { /req/classification/accuracy-classes /req/classification/max-verification-intervals /req/classification/supplementary-loading }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.5"
}
requirement /req/classification/standard-classification {
  name "Standard classification"
  statement "Standard classifications shall be used."
  guidance "Examples: C2 (Class C, 2000 intervals); C3 with arrows and temperature range; C2 NH (Class C, 2000 intervals, not subjected to humidity test)."
  binds_to { group.classification.accuracy_class group.parameters.n_lc }
  verification { method inspection description "Verified by checking that the classification designation follows the standard format per R 60-1, 5.1.6." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.6"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.6"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-table-2"
}
requirement /req/classification/multiple-classifications {
  name "Multiple classifications"
  statement "Load cells that have comprehensive classifications for the manner in which the load is applied to the load cell shall be accompanied by the relative information for each classification."
  binds_to { group.classification.load_type }
  verification { method inspection description "Verified by checking that documentation covers all declared classification variants." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.7"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.7"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-table-3"
}
requirement /req/electronic/p-lc-constraint {
  name "Apportioning factor constraint for electronic load cells"
  statement "The MPE shall be determined using an apportioning factor p_LC greater than or equal to 0.7 and less than or equal to 0.8 (0.7 <= p_LC <= 0.8) substituted for the apportioning factor declared by the manufacturer."
  binds_to { family.parameters.p_lc family.classification.technology }
  parameters {
    param p_LC: number { description "Apportioning factor for electronic load cells. Must be in range [0.7, 0.8] — overrides any value declared by the manufacturer." unit "dimensionless" default 0.7 range { min 0.7 max 0.8 } }
  }
  limit {
    expression "ocl{family.parameters.p_lc >= 0.7 and family.parameters.p_lc <= 0.8}"
    uses { family.parameters.p_lc family.classification.technology }
  }
  acceptance_criteria {
    type: "threshold"
    description: "p_LC shall be within [0.7, 0.8] for electronic load cells.\n"
    limit:
      expression: "p_LC"
      operator: "gte"
      threshold_expression: "0.7"
      unit: "dimensionless"
  }
  verification { method computational description "Verified by checking the declared p_LC value in the test report against the allowed range." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1"
}
requirement /req/electronic/no-significant-faults {
  name "Faults"
  statement "An analogue-active load cell shall be designed and manufactured such that when it is exposed to electrical disturbances either significant faults do not occur, or significant faults are detected and acted upon."
  guidance "The choice of whether faults must not occur or must be detected and acted upon is left to the manufacturer. A fault in value that is equal to or smaller than v_min is allowed."
  binds_to { group.parameters.v_min family.classification.technology }
  acceptance_criteria {
    type: "qualitative"
    description: "Either no significant faults occur during disturbance tests, or significant faults are detected and acted upon (fault ≤ v_min is allowed).\n"
    items:
      - description: "No significant fault occurs during electrical disturbances"
        reference: "urn:oiml:pub:r:60-1:2021#clause-5.7.1.1"
      - description: "Significant faults are detected and acted upon automatically"
        reference: "urn:oiml:pub:r:60-1:2021#clause-5.7.1.1"
  }
  verification { method testing description "Verified by EMC susceptibility tests per R 60-2, 2.10.7." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1.1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1.1"
}
requirement /req/electronic/acting-on-faults {
  name "Acting upon significant faults"
  statement "When a significant fault has been detected, either the load cell shall be made inoperative automatically or a fault detection output shall be issued automatically. This fault detection output shall continue until the fault has been resolved."
  binds_to { model.parameters.output_signal }
  acceptance_criteria {
    type: "qualitative"
    description: "Fault response mechanism must activate automatically and persist until the fault is resolved.\n"
    items:
      - description: "Load cell becomes inoperative automatically upon significant fault"
        reference: "urn:oiml:pub:r:60-1:2021#clause-5.7.1.2"
      - description: "Fault detection output is issued automatically and persists"
        reference: "urn:oiml:pub:r:60-1:2021#clause-5.7.1.2"
  }
  verification { method inspection description "Inspected during type evaluation by reviewing design documentation and functional testing." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1.2"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1.4"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1.5"
}
requirement /req/electronic/durability {
  name "Durability"
  statement "The load cell shall be suitably durable so that the requirements of this Recommendation may be met in accordance with the intended use of the load cell."
  binds_to { group.parameters.mpe }
  acceptance_criteria {
    type: "qualitative"
    description: "Load cell shall maintain compliance with all requirements throughout its intended service life.\n"
    items:
      - description: "Load cell meets all metrological requirements after durability testing"
  }
  verification { method deferred description "Assessed through the overall type evaluation process; no single specific test. Durability is inferred from successful completion of all test procedures." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1.3"
}
requirement /req/electronic/warm-up-time {
  name "Warm-up time"
  statement "During the designed warm-up time of an analogue-active load cell there shall be no transmission of measurement results."
  binds_to { model.parameters.warm_up_time }
  acceptance_criteria {
    type: "qualitative"
    description: "No measurement results shall be transmitted during warm-up period.\n"
    items:
      - description: "No measurement output during manufacturer-specified warm-up time"
  }
  verification { method inspection description "Inspected by reviewing design documentation and verifying warm-up behavior during test." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.1"
}
requirement /req/electronic/power-voltage-ac {
  name "Mains power supply (AC)"
  statement "An analogue-active load cell that operates from a mains power supply shall be designed to comply with the metrological requirements if the mains power supply varies in voltage from -15% to +10% of the supply voltage."
  binds_to { model.parameters.power_voltage group.parameters.mpe }
  parameters {
    param voltage_variation_low: number { description "Maximum negative voltage variation from nominal" unit "%" default -15 range { min -15 max -15 } }
    param voltage_variation_high: number { description "Maximum positive voltage variation from nominal" unit "%" default 10 range { min 10 max 10 } }
  }
  limit {
    expression "ocl{abs(e_l) <= abs(group.parameters.mpe)}"
    uses { observable:e_l model.parameters.power_voltage group.parameters.mpe formula:lookupMPE table:mpe_tiers }
  }
  acceptance_criteria {
    type: "threshold"
    description: "All metrological requirements met with mains voltage varying from -15% to +10% of nominal.\n"
    limit:
      expression: "|E_L|"
      operator: "lte"
      threshold_expression: "MPE"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "when mains voltage varies -15% to +10% of nominal"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.2"
}
requirement /req/electronic/power-voltage-dc {
  name "Battery power supply (DC)"
  statement "An analogue-active load cell that operates from a battery power supply shall either continue to function correctly, or not provide a measurement result whenever the voltage is below the value specified by the manufacturer."
  binds_to { model.parameters.power_voltage }
  acceptance_criteria {
    type: "qualitative"
    description: "Either correct operation maintained, or measurement output suppressed when battery voltage drops below threshold.\n"
    items:
      - description: "Load cell functions correctly at low battery voltage"
        reference: "urn:oiml:pub:r:60-1:2021#clause-5.7.2.3"
      - description: "No measurement result provided when voltage below manufacturer's threshold"
        reference: "urn:oiml:pub:r:60-1:2021#clause-5.7.2.3"
  }
  verification { method testing description "Verified by DC voltage variation test per R 60-2, 2.10.7." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.3"
}
requirement /req/electronic/power-voltage-variations {
  name "Maximum allowable variations during voltage variations"
  statement "All functions shall operate as designed. All measurement results shall be within maximum permissible errors."
  binds_to { model.parameters.power_voltage group.parameters.mpe }
  limit {
    expression "ocl{abs(e_l) <= abs(group.parameters.mpe)}"
    uses { observable:e_l model.parameters.power_voltage group.parameters.mpe formula:lookupMPE table:mpe_tiers }
  }
  acceptance_criteria {
    type: "threshold"
    description: "All functions operate correctly and errors remain within MPE during voltage variations.\n"
    limit:
      expression: "|E_L|"
      operator: "lte"
      threshold_expression: "MPE"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "during AC/DC voltage variations"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.4"
}
requirement /req/electronic/disturbances {
  name "Disturbances"
  statement "When an analogue-active load cell is subjected to the disturbances specified in R 60-2, 2.10.7.5 to 2.10.7.10, the difference between the load cell output due to a disturbance and the load cell output without disturbance (fault) shall satisfy the conditions in section 5.7.1.1."
  guidance "Disturbances include: short-time power reductions, bursts (electrical fast transients), surge, electrostatic discharge, electromagnetic susceptibility, and immunity to conducted electromagnetic fields."
  binds_to { group.parameters.v_min }
  limit {
    expression "ocl{abs(fault) <= 1}"
    uses { observable:fault group.parameters.v_min }
    notes "Significant-fault limit is one verification interval (1 v, R 60-1, 5.7.1.1 NOTE); the fault difference is expressed in v units — not the v_min mass value."
  }
  acceptance_criteria {
    type: "threshold"
    description: "Fault (output difference due to disturbance) shall not exceed the significant fault threshold per section 5.7.1.1.\n"
    limit:
      expression: "|fault|"
      operator: "lte"
      threshold_expression: "v_min"
      unit: "v"
    per_condition: "for each EMC disturbance type per R 60-2, 2.10.7.5–2.10.7.10"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5"
}
requirement /req/electronic/span-stability {
  name "Span stability"
  statement "When an analogue-active load cell is subjected to the span stability test specified in R 60-2, 2.10.7.11, the variation in the load cell span measurement results shall not exceed the greater of: half the load cell verification interval; or half the absolute value of the MPE for the applied test load D_max."
  guidance "Not applicable to Class A load cells. p_LC = 1.0 for span stability tests."
  binds_to { group.parameters.mpe sample.test_context.d_max group.classification.accuracy_class }
  parameters {
    param p_LC_span: number { description "p_LC used for span stability MPE — always 1.0, regardless of manufacturer's declared value." default 1 range { min 1 max 1 } }
  }
  limit {
    expression "ocl{abs(span_variation) <= max(0.5, 0.5 * abs(lookupMPE(sample.test_context.d_max, group.classification.accuracy_class, 1.0)))}"
    uses { observable:span_variation group.parameters.mpe group.classification.accuracy_class sample.test_context.d_max formula:lookupMPE formula:maxAllowableSpanVariation table:mpe_tiers }
  }
  applicability {
    accuracy_class: [B, C, D]
  }
  acceptance_criteria {
    type: "threshold"
    description: "Span variation ≤ max(0.5v, 0.5 × |MPE|) using p_LC = 1.0.\n"
    limit:
      expression: "|Δspan|"
      operator: "lte"
      threshold_expression: "max(0.5, 0.5 × |MPE|)"
      referenced_function: "maxAllowableSpanVariation"
      unit: "v"
    per_condition: "over duration test period per R 60-2, 2.10.7.11"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.6"
}
requirement /req/metrological/measuring-range-min {
  name "Minimum load of the measuring range"
  statement "The value of the smallest load applied to a load cell during test which is expressed in units of mass shall not be less than E_min."
  binds_to { sample.test_context.d_min family.parameters.e_min }
  limit {
    expression "ocl{sample.test_context.d_min >= family.parameters.e_min}"
    uses { sample.test_context.d_min family.parameters.e_min }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Minimum test load shall be at least E_min"
    limit:
      expression: "L_test"
      operator: "gte"
      threshold_expression: "E_min"
      unit: "mass units"
  }
  verification { method definitional description "Satisfied by definition — the measuring range lower bound is defined as E_min. Verified during test report review by confirming test loads start at or above E_min." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.2"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.2.1"
}
requirement /req/metrological/measuring-range-max {
  name "Maximum load of the measuring range"
  statement "The value of the largest load applied to a load cell during test which is expressed in units of mass shall not be greater than E_max."
  binds_to { sample.test_context.d_max model.parameters.e_max }
  limit {
    expression "ocl{sample.test_context.d_max <= model.parameters.e_max}"
    uses { sample.test_context.d_max model.parameters.e_max }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Maximum test load shall not exceed E_max"
    limit:
      expression: "L_test"
      operator: "lte"
      threshold_expression: "E_max"
      unit: "mass units"
  }
  verification { method definitional description "Satisfied by definition — the measuring range upper bound is defined as E_max. Verified during test report review by confirming test loads do not exceed E_max." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.2"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.2.2"
}
requirement /req/metrological/mpe-table {
  name "Maximum permissible errors for each accuracy class"
  statement "The MPE values for each accuracy class are tabulated in Table 4 of R 60-1 as a function of the load m (in verification units v) relative to the load cell verification interval. The first tier covers m ≤ 500 v, second tier 500 v < m ≤ 2000 v, third tier m > 2000 v. MPE values scale with the apportioning factor p_LC."
  guidance "Tier breakpoints are universal across accuracy classes (per R 60-1, Table 4). MPE is applicable after increasing as well as decreasing the force applied (includes hysteresis)."
  binds_to { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc }
  parameters {
    param accuracy_class: enum { description "Determines the MPE scaling for each tier." enum_values { A B C D } }
  }
  limit {
    expression "ocl{group.parameters.mpe = lookupMPE(load, group.classification.accuracy_class, family.parameters.p_lc)}"
    uses { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc formula:lookupMPE table:mpe_tiers }
  }
  verification { method definitional description "Satisfied by definition — the MPE values per tier are declared in R 60-1 Table 4 and referenced by the type-evaluation requirement (clause 5.3.2)." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.3.1"
}
requirement /req/metrological/mpe {
  name "Maximum permissible errors on type evaluation"
  statement "The MPE on type evaluation shall be the values derived using the expressions: p_LC x 0.5 v for the first tier, p_LC x 1.0 v for the second tier, and p_LC x 1.5 v for the third tier, where the load breakpoints per accuracy class are given in Table 4 of R 60-1. The apportioning factor p_LC shall be in the range 0.3 to 0.8 and defaults to 0.7 if not specified."
  guidance "MPE is applicable after increasing as well as decreasing the force applied (includes hysteresis). For analogue-active and digital load cells, p_LC shall be 0.7 to 0.8."
  binds_to { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc }
  subjects { subject 1 { entity_id "dimensions.p_LC" label "Apportioning factor" } subject 2 { entity_id "dimensions.accuracyClass" label "Accuracy class" } }
  parameters {
    param p_LC: number { description "Apportioning factor applied to MPE. For analogue-passive load cells: 0.3 ≤ p_LC ≤ 1.0 (default 0.7). For analogue-active and digital: 0.7 ≤ p_LC ≤ 0.8." unit "dimensionless" default 0.7 range { min 0.3 max 1 } }
    param accuracy_class: enum { description "Determines the load breakpoints (in v units) for the three MPE tiers. Class A: 0–50000–200000; Class B: 0–5000–20000; Class C: 0–500–2000; Class D: 0–50–200." enum_values { A B C D } }
  }
  limit {
    expression "ocl{group.parameters.mpe = lookupMPE(load, group.classification.accuracy_class, family.parameters.p_lc) and family.parameters.p_lc >= 0.3 and family.parameters.p_lc <= 0.8}"
    uses { group.parameters.mpe group.classification.accuracy_class family.parameters.p_lc formula:lookupMPE table:mpe_tiers }
  }
  acceptance_criteria {
    type: "tiered"
    description: "Maximum permissible errors are expressed as factor × p_LC × v, where the factor depends on the load range (in verification intervals v). Breakpoints vary by accuracy class — see class-specific requirements for concrete values.\n"
    variable: "load"
    variable_unit: "v"
    limit_expression: "factor × p_LC"
    referenced_function: "lookupMPE"
    tiers:
      - range:
          min: 0
        limit:
          factor: 0.5
          expression: "0.5 × p_LC"
      - range:
          min: 0
        limit:
          factor: 1
          expression: "1.0 × p_LC"
      - range:
          min: 0
        limit:
          factor: 1.5
          expression: "1.5 × p_LC"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.3.2"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-2.2/s1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.3.2"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-table-5"
}
requirement /req/metrological/repeatability {
  name "Repeatability error"
  statement "The maximum difference between the results of five identical load applications for classes A and B and of three identical load applications for classes C and D shall not be greater than the absolute value of the MPE for that load."
  guidance "Classes A and B require 5 runs; classes C and D require 3 runs."
  binds_to { group.parameters.mpe group.classification.accuracy_class }
  subjects { subject 1 { entity_id "test_protocol.runs" label "Number of runs" } }
  parameters {
    param runs: integer { description "Number of identical load applications per test point. Classes A and B: 5 runs. Classes C and D: 3 runs." range { min 3 max 5 } }
  }
  limit {
    expression "ocl{abs(e_r) <= abs(group.parameters.mpe)}"
    uses { observable:e_r group.parameters.mpe group.classification.accuracy_class table:test_runs }
  }
  acceptance_criteria {
    type: "threshold"
    description: "The repeatability error (max difference between run indications) shall not exceed the absolute value of MPE for that load.\n"
    limit:
      expression: "|E_R|"
      operator: "lte"
      threshold_expression: "|MPE|"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "per load point, across all runs"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.4"
}
requirement /req/metrological/creep {
  name "Creep"
  statement "The difference between the reading taken upon the application of a maximum load (D_max) and the reading observed within and after 30 minutes of exposure of 90% to 100% of E_max shall not exceed 0.7 times the absolute value of MPE for the applied load. The MPE for creep shall always be determined using p_LC = 0.7 regardless of any value declared by the manufacturer."
  binds_to { group.parameters.mpe model.parameters.e_max sample.test_context.d_max }
  parameters {
    param p_LC_creep: number { description "p_LC used for creep MPE calculation — always 0.7 regardless of manufacturer's declared value." default 0.7 range { min 0.7 max 0.7 } }
  }
  limit {
    uses { observable:c_c group.parameters.mpe group.classification.accuracy_class model.parameters.e_max sample.test_context.d_max formula:lookupMPE table:mpe_tiers }
    accepts { verdict creep op lte limit "ocl{0.7 * abs(lookupMPE(sample.test_context.d_max, group.classification.accuracy_class, 0.7))}" }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Creep over 30 minutes shall not exceed 0.7 × |MPE| for the applied load, using p_LC = 0.7.\n"
    limit:
      expression: "|creep_reading - initial_reading|"
      operator: "lte"
      threshold_expression: "0.7 × |MPE|"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "over 30 minutes at 90%–100% of E_max"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.5.1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.5"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.5.1"
}
requirement /req/metrological/creep-20-30 {
  name "Creep difference between 20 and 30 minutes"
  statement "The difference in readings taken after 20 minutes of exposure to 90% to 100% of E_max and at 30 minutes of exposure shall not exceed 0.15 times the absolute value of MPE."
  binds_to { group.parameters.mpe sample.test_context.d_max }
  limit {
    expression "ocl{abs(c_c_30_20) <= 0.15 * abs(lookupMPE(sample.test_context.d_max, group.classification.accuracy_class, 0.7))}"
    uses { observable:c_c_30_20 group.parameters.mpe group.classification.accuracy_class sample.test_context.d_max formula:lookupMPE table:mpe_tiers }
  }
  acceptance_criteria {
    type: "threshold"
    description: "The difference between readings at 20 min and 30 min shall not exceed 0.15 × |MPE|.\n"
    limit:
      expression: "|reading_30min - reading_20min|"
      operator: "lte"
      threshold_expression: "0.15 × |MPE|"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "between 20 and 30 minutes of load exposure"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.5.1"
}
requirement /req/metrological/dr {
  name "Minimum dead load output return (DR)"
  statement "The difference between the initial reading of the minimum load output (D_min) and the reading of D_min at the conclusion of the creep test shall not exceed half the value of the load cell verification interval (0.5 v)."
  binds_to { group.parameters.dr sample.test_context.v }
  limit {
    expression "ocl{abs(c_dr) <= 0.5}"
    uses { observable:c_dr group.parameters.dr sample.test_context.v }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Dead load output return shall not exceed 0.5 verification intervals.\n"
    limit:
      expression: "|D_min_final - D_min_initial|"
      operator: "lte"
      threshold_expression: "0.5"
      unit: "v"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.5.2"
}
requirement /req/metrological/temperature-limits {
  name "Temperature limits"
  statement "Excluding temperature effects on minimum dead load output, the load cell shall perform within the limits of error in section 5.3.2 over the temperature range of -10 degC to +40 degC, unless otherwise specified."
  binds_to { group.parameters.mpe family.parameters.t_min family.parameters.t_max }
  limit {
    expression "ocl{abs(e_l) <= abs(group.parameters.mpe)}"
    uses { observable:e_l group.parameters.mpe family.parameters.t_min family.parameters.t_max formula:lookupMPE table:mpe_tiers }
  }
  acceptance_criteria {
    type: "threshold"
    description: "All measurement errors shall remain within MPE over the standard temperature range -10°C to +40°C.\n"
    limit:
      expression: "|E_L|"
      operator: "lte"
      threshold_expression: "MPE"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "over temperature range -10°C to +40°C"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1.1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1.1"
}
requirement /req/metrological/special-temperature-limits {
  name "Special temperature limits"
  statement "Load cells for which particular limits of working temperature are specified shall satisfy the conditions defined in section 5.3.2 within those ranges. The span of these ranges shall be at least 5 degC for class A, 15 degC for class B, and 30 degC for classes C and D."
  binds_to { family.parameters.t_min family.parameters.t_max group.classification.accuracy_class group.parameters.mpe }
  parameters {
    param min_temperature_span: integer { description "Minimum span of special working temperature range. Class A: ≥ 5°C. Class B: ≥ 15°C. Classes C and D: ≥ 30°C." unit "°C" }
  }
  limit {
    expression "ocl{(family.parameters.t_max - family.parameters.t_min) >= lookupProfile('min_temperature_span', group.classification.accuracy_class) and abs(e_l) <= abs(group.parameters.mpe)}"
    uses { family.parameters.t_min family.parameters.t_max group.classification.accuracy_class group.parameters.mpe observable:e_l profile:min_temperature_span formula:lookupProfile }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Measurement errors within MPE over the specified temperature range, with minimum span per class.\n"
    limit:
      expression: "|E_L|"
      operator: "lte"
      threshold_expression: "MPE"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "within specified special temperature limits"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1.2"
}
requirement /req/metrological/temperature-effect-mdlo {
  name "Temperature effect on minimum dead load output"
  statement "The minimum dead load output of the load cell over the specified temperature range shall not vary by an amount greater than p_LC times v_min for any change in ambient temperature of 2 degC for class A, or 5 degC for classes B, C and D."
  binds_to { family.parameters.p_lc group.parameters.v_min group.classification.accuracy_class }
  parameters {
    param temperature_increment: integer { description "Temperature increment over which the MDLO change is evaluated. Class A: 2°C. Classes B, C, D: 5°C." unit "°C" }
  }
  limit {
    uses { observable:c_m observable:delta_t profile:temperature_increment family.parameters.p_lc group.parameters.v_min sample.test_context.d_max sample.test_context.d_min group.classification.accuracy_class }
    accepts { verdict mdlo_normalized op lte limit "ocl{p_lc}" }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Temperature effect on MDLO shall not exceed p_LC × v_min per temperature increment.\n"
    limit:
      expression: "|ΔMDLO|"
      operator: "lte"
      threshold_expression: "p_LC × v_min"
      unit: "v"
    per_condition: "per temperature increment"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1.3"
}
requirement /req/metrological/barometric-pressure {
  name "Barometric pressure"
  statement "The output of the load cell shall not vary by an amount greater than v_min for any incremental change in barometric pressure equivalent to 1 kPa."
  binds_to { group.parameters.v_min }
  limit {
    uses { observable:c_p observable:delta_p model.parameters.e_max family.parameters.e_min group.parameters.n_lc group.parameters.v_min }
    notes "Limit is one minimum verification interval (1 v_min) per 1 kPa (R 60-1, 5.6.2); the barometric_normalized verdict normalizes the raw change C_P (v) per kPa and converts to v_min units via (E_max−E_min)/n_LC (R 60-3, 2.1.6), so the limit is 1 — never the v_min mass value."
    accepts { verdict barometric_normalized op lte limit "ocl{1}" }
  }
  acceptance_criteria {
    type: "threshold"
    description: "Barometric pressure effect on output shall not exceed v_min per 1 kPa pressure change.\n"
    limit:
      expression: "|Δoutput|"
      operator: "lte"
      threshold_expression: "v_min"
      unit: "v"
    per_condition: "per 1 kPa barometric pressure change"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.2"
}
requirement /req/metrological/humidity-ch {
  name "Humidity error for CH or unmarked load cells"
  statement "The influence of exposure to cyclic temperature conditions on the load cell output for minimum load shall not be greater than 4% of the difference between the output on E_max and that at E_min. The influence on the load cell output for the maximum load shall not be greater than the load cell verification interval v."
  guidance "Applicable to load cells marked CH or with no humidity symbol marking. Not applicable to load cells marked NH or SH."
  binds_to { group.parameters.n_lc sample.test_context.v family.classification.humidity_class }
  limit {
    expression "ocl{abs(c_hmin) <= 0.04 * group.parameters.y and abs(c_hmax) <= 1}"
    uses { observable:c_hmin observable:c_hmax group.parameters.n_lc group.parameters.y }
    notes "Min-load effect: 4 % of (E_max − E_min) output = 0.04·Y in v units (R 60-1, 5.6.3 — the model's 0.04·n_lc used the wrong ratio); max-load effect: 1 v (5.6.3)."
  }
  applicability {
    humidity_class: [CH]
  }
  acceptance_criteria {
    type: "qualitative"
    description: "Two conditions must be satisfied after cyclic humidity exposure: minimum load effect ≤ 4% of span, and maximum load effect ≤ v.\n"
    items:
      - description: "Influence on minimum load output ≤ 4% of (output at E_max − output at E_min)\n"
        reference: "urn:oiml:pub:r:60-1:2021#clause-5.6.3.1"
      - description: "Influence on maximum load output ≤ 1 verification interval (v)\n"
        reference: "urn:oiml:pub:r:60-1:2021#clause-5.6.3.1"
  }
  source_discrepancy { summary "R 60-3 form criterion for the max-load humidity effect (C_Hmax ≤ MPE) contradicts the R 60-1 requirement text (C_Hmax ≤ 1 v)" sources { "urn:oiml:pub:r:60-1:2021#clause-5.6.3.1" "urn:oiml:pub:r:60-3:2021#clause-2.1.7" } resolution follows_clause_x rationale "The model follows R 60-1, 5.6.3.1 — the normative requirement clause (max-load effect shall not exceed the verification interval v) — which R 60-3's own Table 6.10.1-a mpc column (= 1) confirms; only R 60-3, 2.1.7 prose states ≤ MPE. The conformance/form layer carries the same annotation. See analysis/deep-audit-r60.md F5/X5." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.3.1"
}
requirement /req/metrological/humidity-sh {
  name "Humidity error for SH marked load cells"
  statement "A load cell shall meet the MPE applicable to the load applied as specified in Table 4, when exposed to conditions of relative humidity variations as specified in R 60-2, 2.10.6."
  guidance "Applicable to load cells marked SH only. Not applicable to load cells marked NH or CH or with no humidity symbol."
  binds_to { group.parameters.mpe family.classification.humidity_class }
  limit {
    expression "ocl{abs(e_l) <= abs(group.parameters.mpe)}"
    uses { observable:e_l group.parameters.mpe family.classification.humidity_class formula:lookupMPE table:mpe_tiers }
  }
  applicability {
    humidity_class: [SH]
  }
  acceptance_criteria {
    type: "threshold"
    description: "Measurement errors shall remain within MPE during steady-state humidity exposure.\n"
    limit:
      expression: "|E_L|"
      operator: "lte"
      threshold_expression: "MPE"
      referenced_function: "lookupMPE"
      unit: "v"
    per_condition: "during steady-state humidity exposure per R 60-2, 2.10.6"
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.3.2"
}
requirement /req/technical/software {
  name "Software sealing"
  statement "Provision shall be made for appropriate sealing by mechanical, electronic and/or cryptographic means, making any change that affects the metrological integrity of the device impossible or evident. Any embedded programming that influences the raw count output of the load cell will be evaluated under the terms of this Recommendation. Software that modifies load cell performance shall comply with OIML D 31."
  guidance "Severity level I with validation procedure A is required. For digital load cells, legally relevant software shall comply with OIML D 31 provisions."
  binds_to { model.parameters.software_identification family.classification.technology }
  applicability {
    technology: [analogue-active, digital]
  }
  acceptance_criteria {
    type: "qualitative"
    description: "Software sealing provisions must be in place and documented; the four D 31 application specifics of R 60-1, 6.1 must hold.\n"
    items:
      - description: "Sealing by mechanical, electronic, and/or cryptographic means provided"
        reference: "urn:oiml:pub:r:60-1:2021#clause-6.1"
      - description: "Severity level I with validation procedure A declared and examined"
        reference: "urn:oiml:pub:r:60-1:2021#clause-6.1"
      - description: "Software identification imprint exception per OIML D 31, 5.1.1 applied (if used)"
        reference: "urn:oiml:pub:r:60-1:2021#clause-6.1"
      - description: "Conformity of manufactured devices to the approved type per OIML D 31, 5.2.5(a)"
        reference: "urn:oiml:pub:r:60-1:2021#clause-6.1"
      - description: "Field software update via verified or traced update per OIML D 31, 5.2.6.2/5.2.6.3"
        reference: "urn:oiml:pub:r:60-1:2021#clause-6.1"
      - description: "Software documentation per OIML D 31, 6.1.1"
        reference: "urn:oiml:pub:r:60-1:2021#clause-6.1"
  }
  verification { method inspection description "Inspected during documentation examination per R 60-2, 2.3." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.1"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.1"
}
requirement /req/technical/mandatory-markings {
  name "Mandatory markings on the load cell"
  statement "The following mandatory markings shall be clearly and indelibly marked on the load cell: manufacturer's name or trade mark; manufacturer's type designation or load cell model; serial number; maximum capacity E_max; year of production; type approval mark (if applicable)."
  guidance "If size limitations prevent all markings, manufacturer's name, type designation, serial number, and E_max shall be provided as a minimum on the load cell itself."
  binds_to { model.identity.manufacturer model.identity.model_designation model.identity.serial_number model.parameters.e_max model.identity.year_of_production model.identity.type_approval_mark }
  acceptance_criteria {
    type: "qualitative"
    description: "All mandatory markings present, clear, and indelible.\n"
    items:
      - description: "Manufacturer's name or trade mark present"
      - description: "Type designation or load cell model marked"
      - description: "Serial number marked"
      - description: "Maximum capacity E_max marked"
      - description: "Year of production marked"
      - description: "Type approval mark present (if applicable)"
  }
  verification { method inspection description "Visual inspection of the load cell during documentation examination per R 60-2, 2.3." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.2.1"
}
requirement /req/technical/mandatory-additional-info {
  name "Mandatory additional information"
  statement "The following mandatory information shall be provided in an accompanying document: manufacturer's name or trade mark; type designation; accuracy class(es); type of load; working temperature when required; humidity symbol when required; E_max; E_min; E_lim; v_min (or Y); p_LC if not 0.7; and other pertinent conditions."
  binds_to { model.identity.manufacturer model.identity.model_designation group.classification.accuracy_class group.classification.load_type family.parameters.t_min family.parameters.t_max family.classification.humidity_class model.parameters.e_max family.parameters.e_min family.parameters.e_lim group.parameters.v_min group.parameters.y family.parameters.p_lc }
  acceptance_criteria {
    type: "qualitative"
    description: "All mandatory information items present in accompanying document.\n"
    items:
      - description: "Manufacturer's name or trade mark in documentation"
      - description: "Type designation in documentation"
      - description: "Accuracy class(es) specified"
      - description: "Type of load specified"
      - description: "Working temperature range specified (when required)"
      - description: "Humidity symbol specified (when required)"
      - description: "E_max value specified"
      - description: "E_min value specified"
      - description: "E_lim value specified"
      - description: "v_min (or Y) specified"
      - description: "p_LC specified if not 0.7"
  }
  verification { method inspection description "Inspected during documentation examination per R 60-2, 2.3." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.2.2"
}
requirement /req/technical/non-mandatory-info {
  name "Non-mandatory additional information"
  statement "The following information may optionally be specified: relative v_min (Y) for weighing instruments; relative DR (Z) for weighing instruments; and other information considered necessary by the manufacturer."
  binds_to { group.parameters.y group.parameters.z }
  obligation should
  verification { method deferred description "Non-mandatory information is optional; no specific verification required." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.2.3"
}
requirement /req/technical/class-designation {
  name "Accuracy class designation"
  statement "Class A load cells shall be designated by the character \"A\", class B by \"B\", class C by \"C\" and class D by the character \"D\"."
  binds_to { group.classification.accuracy_class }
  parameters {
    param class_symbol: enum { description "Single character designation for the accuracy class" enum_values { A B C D } }
  }
  verification { method inspection description "Verified by checking the marking uses the correct single-character designation." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.2.4.1"
}
requirement /req/technical/load-type-designation {
  name "Designation of the type of load applied"
  statement "The designation of the type of load applied to the load cell shall be specified when it is not clearly apparent from the load cell construction, using the standard symbols for tension, compression, beam, or universal."
  binds_to { group.classification.load_type }
  parameters {
    param load_symbol: enum { description "Standard symbol for the loading direction" enum_values { tension compression beam universal } }
  }
  verification { method inspection description "Verified by inspecting the load cell designation marking." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.2.4.2"
}
requirement /req/technical/temperature-designation {
  name "Working temperature designation"
  statement "The special limits of working temperature shall be specified when the load cell cannot perform within the limits of error over the standard temperature range. The limits of temperature shall be designated in degrees Celsius."
  binds_to { family.parameters.t_min family.parameters.t_max }
  parameters {
    param temperature_range: string { description "Special temperature limits in °C (e.g., \"-10/+40\"). Required only when load cell cannot meet MPE over the standard range." }
  }
  verification { method inspection description "Verified by checking the temperature designation on markings and documentation." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.2.4.3"
}
requirement /req/technical/humidity-designation {
  name "Humidity symbols"
  statement "A load cell not designed to meet humidity performance criteria shall be marked NH. A load cell designed to meet cyclic humidity criteria shall be marked CH or not be marked. A load cell designed to meet steady-state humidity criteria shall be marked SH."
  binds_to { family.parameters.humidity_symbol family.classification.humidity_class }
  parameters {
    param humidity_symbol: enum { description "Humidity classification marking: CH (cyclic humidity), NH (no humidity test), SH (steady-state humidity), or unmarked (= CH)." enum_values { CH NH SH unmarked } }
  }
  verification { method inspection description "Verified by checking the humidity symbol marking on the load cell." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.2.4.4"
}
requirement /req/technical/nlc-designation {
  name "Maximum number of load cell verification intervals designation"
  statement "The maximum number of load cell verification intervals for which the accuracy class applies shall be designated in actual units or, when combined with the accuracy class designation, in units of 1000."
  binds_to { group.parameters.n_lc }
  parameters {
    param n_LC: integer { description "Number of verification intervals. In designation format: e.g., C3 = Class C with 3000 intervals (3 × 1000)." unit "intervals" }
  }
  verification { method inspection description "Verified by checking the n_LC designation on the load cell marking." }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.2.4.5"
}
requirement_class /req/iso-17065/body {
  name "ISO/IEC 17065 certification-body organizational requirements"
  subject "Product certification body — legal status, impartiality, structure and resources"
}
requirement_class /req/iso-17065/process {
  name "ISO/IEC 17065 certification process requirements (clause 7)"
  subject "Product certification process — application to complaints"
}
requirement_class /req/cs {
  name "OIML-CS certification process requirements"
  subject "OIML-CS type evaluation and certification process"
}
requirement_class /req/iso-17025/lab {
  name "ISO/IEC 17025 laboratory resource requirements (clause 6)"
  subject "Testing/calibration laboratory — personnel, equipment and metrological traceability"
}
requirement_class /req/iso-17025/process {
  name "ISO/IEC 17025 laboratory process requirements (clause 7)"
  subject "Laboratory test lifecycle — request review to reporting, complaints and nonconforming work"
}
requirement_class /req/iso-17067/scheme-content {
  name "ISO/IEC 17067 product-certification scheme content"
  subject "Product certification scheme — the elements its rules, procedures and management documents specify"
}
requirement_class /req/class-a {
  name "Class A load cell requirements"
  subject "Class A load cell requirements"
  applicability {
    accuracy_class: [A]
  }
  dependencies { /req/metrological /req/classification }
}
requirement_class /req/class-b {
  name "Class B load cell requirements"
  subject "Class B load cell requirements"
  applicability {
    accuracy_class: [B]
  }
  dependencies { /req/metrological /req/classification }
}
requirement_class /req/class-c {
  name "Class C load cell requirements"
  subject "Class C load cell requirements"
  applicability {
    accuracy_class: [C]
  }
  dependencies { /req/metrological /req/classification }
}
requirement_class /req/class-d {
  name "Class D load cell requirements"
  subject "Class D load cell requirements"
  applicability {
    accuracy_class: [D]
  }
  dependencies { /req/metrological /req/classification }
}
requirement_class /req/classification {
  name "Classification requirements for load cells"
  subject "load cell classification"
}
requirement_class /req/electronic {
  name "Requirements for analogue-active and digital load cells"
  subject "electronic load cell"
  guidance "These requirements apply in addition to the base metrological requirements."
  applicability {
    technology: [analogue-active, digital]
  }
  dependencies { /req/metrological }
}
requirement_class /req/metrological {
  name "Metrological requirements for load cells"
  subject "load cell metrology"
  dependencies { /req/classification }
}
requirement_class /req/technical {
  name "Technical requirements for load cells"
  subject "load cell technical"
}
instrument LoadCell {
  extends MeasuringInstrumentModel
  measurand_kind force
  definition "Measuring transducer that will produce an output in response to an applied load. This output may be converted by another device into measurement units such as mass."
  note "A LoadCell MODEL is what gets type-evaluated and approved; physical units are MeasuringInstrumentSample instances of that Model (INV-10 delegation: Sample -> Model -> Family)."
  variant analogue_passive { name "Analogue-passive load cell" definition "Load cell from which the output provides either measurable data or direct information representing the measurand value; may utilise passive electronics (e.g. strain gauges) and passive temperature compensation elements." source { doc "urn:oiml:pub:r:60-1:2021" clause "3.1.3.1" } }
  variant analogue_active { name "Analogue-active load cell" definition "Load cell which is capable of performing the functions of an analogue-passive load cell and which also utilises active electronics (electronic representation of the measurand value, active temperature compensation, and similar functions)." source { doc "urn:oiml:pub:r:60-1:2021" clause "3.1.3.2" } }
  variant digital { name "Digital load cell" definition "Analogue-active load cell which includes an analogue to digital conversion device providing a representation of the measurand value in some unprocessed digital format." source { doc "urn:oiml:pub:r:60-1:2021" clause "3.1.3.3" } }
  variant digital_with_processing { name "Digital load cell equipped with further data processing" definition "Analogue-active load cell which includes an analogue to digital conversion device providing a representation of the measurand value in some digital format and includes further digital processing (e.g. scaling)." source { doc "urn:oiml:pub:r:60-1:2021" clause "3.1.3.4" } }
  dimension technology {
    label "Technology"
    scope family
    description "Load cell signal processing technology"
    reference { doc "urn:oiml:pub:r:60-1:2021" clause "5.7" }
    values {
      analogue-passive { label "Analogue passive" description "Load cell without built-in electronics" }
      analogue-active { label "Analogue active" description "Load cell with built-in analogue electronics such as an amplifier or A/D converter" }
      digital { label "Digital" description "Load cell with digital output and built-in digital processing" }
      digital-with-processing { label "Digital with further data processing" description "Digital load cell including further digital processing (e.g. scaling)" }
    }
  }
  dimension accuracy_class {
    label "Accuracy Class"
    scope group
    description "Load cell accuracy classification ranked by metrological performance"
    reference { doc "urn:oiml:pub:r:60-1:2021" clause "5.1.1" }
    values {
      A { label "Class A" description "Highest accuracy class" payload { n_lc_limits { lower: "50000" upper: "unlimited" } } }
      B { label "Class B" description "High accuracy class" payload { n_lc_limits { lower: "5000" upper: "100000" } } }
      C { label "Class C" description "Medium accuracy class" payload { n_lc_limits { lower: "500" upper: "10000" } } }
      D { label "Class D" description "Lower accuracy class" payload { n_lc_limits { lower: "100" upper: "1000" } } }
    }
  }
  dimension humidity_class {
    label "Humidity Class"
    scope family
    description "Humidity exposure classification for the load cell"
    reference { doc "urn:oiml:pub:r:60-1:2021" clause "6.2.4.4" }
    values {
      CH { label "Cyclic humidity" description "Load cell designed for cyclic humidity exposure. Default for unmarked load cells." }
      SH { label "Steady-state humidity" description "Load cell designed for steady-state humidity exposure" }
      NH { label "Not humidity-tested" description "Load cell not subjected to humidity testing, marked with the NH symbol" }
      none { label "No marking" description "No humidity symbol marked — R 60-3, 4.9.2's explicit case; R 60-1 treats unmarked cells as CH by default" }
    }
  }
  dimension load_type {
    label "Load type"
    scope group
    description "Direction and manner in which load is applied to the load cell"
    reference { doc "urn:oiml:pub:r:60-1:2021" clause "5.1.4" }
    values {
      compression { label "Compression" description "Load applied in compression" }
      tension { label "Tension" description "Load applied in tension" }
      beam-shear { label "Beam (shear)" description "Load applied through a shear beam configuration" }
      beam-bending { label "Beam (bending)" description "Load applied through a bending beam configuration" }
      universal { label "Universal" description "Load cell capable of both compression and tension loading" }
    }
  }
  dimension construction {
    label "Construction"
    scope family
    description "Measurement-technique construction of the load cell sensing element"
    reference { doc "urn:oiml:pub:r:60-1:2021" clause "3.3" }
    values {
      strain-gauge { label "Strain gauge" description "Bonded analogue resistive element that changes resistance with deformation of the load cell structure" }
    }
  }
  family {
    metamodel_class MeasuringInstrumentModelFamily
    definition "Group of load cells which for the purposes of type evaluation are considered as one family, sharing material, measurement technique, construction method and specifications, and comprising one or more load cell groups with identical metrological characteristics."
    source { doc "urn:oiml:pub:r:60-1:2021" clause "3.4.2" }
  }
  family_criteria {
    "same material or combination of materials (e.g. mild steel, stainless steel, aluminium)"
    "same design of the measurement technique (e.g. strain gauges bonded to metal)"
    "same principle used to attach the strain gauge to the load cell"
    "same method of construction (shape, sealing of strain gauges, mounting method, manufacturing method)"
    "same set of specifications (output rating, input impedance, supply voltage, cable details)"
    "one or more load cell groups, all cells in a group having identical metrological characteristics (class, n_LC, temperature rating, etc.)"
  }
  family_defaults {
    dimensions { technology humidity_class construction }
    parameters { humidity_symbol e_min p_lc t_min t_max rated_output input_impedance output_impedance recommended_excitation excitation_maximum safe_overload transducer_material atmospheric_protection }
  }
  model_group {
    definition "Within one MeasuringInstrumentModelFamily, a load cell group is a set of Models having identical metrological characteristics (R 60-1, 5.1.5). Sample selection for type evaluation is performed per group."
    note "Sample selection within a family/group for type evaluation follows R 60-2, 2.4 with a practical example in R 60-2, Annex D."
    identical_characteristics { metrological_class n_lc y z temperature_rating }
    identical_attributes { accuracy_class n_lc y z t_min t_max }
    source { doc "urn:oiml:pub:r:60-1:2021" clause "3.4.2" }
    source { doc "urn:oiml:pub:r:60-1:2021" clause "5.1.5" }
    sample_selection { doc "urn:oiml:pub:r:60-2:2021" clause "2.4" }
    sample_selection { doc "urn:oiml:pub:r:60-2:2021" clause "Annex D" }
  }
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.1.3" }
}
attribute_definition technology {
  name "Technology"
  definition "Load cell signal processing technology (analogue-passive, analogue-active, digital, digital with further data processing)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7"
  value_type string
  origin design-fixed
  scope family
  category administrative
  is_dimension true
  enum technology
}
attribute_definition accuracy_class {
  name "Accuracy class"
  definition "Load cell accuracy class designation (A, B, C or D) ranked by overall performance capabilities."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.1"
  value_type string
  origin declared
  scope group
  category metrological
  is_dimension true
  enum accuracy_class
  irdi "0112/2///61987#ABA901"
}
attribute_definition humidity_symbol {
  symbol "humiditySymbol"
  name "Humidity symbol"
  definition "Symbol assigned to a load cell that indicates the conditions of humidity under which the load cell has been tested (CH, SH or NH)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.1"
  value_type string
  origin declared
  scope family
  category administrative
  is_dimension true
  enum humidity_class
}
attribute_definition load_type {
  name "Load type"
  definition "Intended manner in which a load is applied to the load cell (compression, tension, beam, universal)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.4"
  value_type string
  origin declared
  scope group
  category metrological
  is_dimension true
  enum load_type
}
attribute_definition e_max {
  symbol "E_max"
  name "Maximum capacity"
  definition "Largest value of a quantity expressed in units of mass, which may be applied to a load cell."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.5"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin design-fixed
  scope model
  category metrological
  is_dimension false
}
attribute_definition e_min {
  symbol "E_min"
  name "Minimum dead load"
  definition "Smallest value of a quantity (expressed in mass units) that may be applied to a load cell."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.9"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin design-fixed
  scope family
  category metrological
  is_dimension false
}
attribute_definition e_lim {
  symbol "E_lim"
  name "Safe load limit"
  definition "Maximum load that can be applied without producing a permanent shift in the performance characteristics beyond those specified."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.16"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin design-fixed
  scope family
  category metrological
  is_dimension false
}
attribute_definition v_min {
  symbol "v_min"
  name "Minimum load cell verification interval"
  definition "Smallest load cell verification interval in units of mass into which the maximum measuring range (E_max - E_min) can be divided."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.11"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin design-fixed
  scope group
  category metrological
  is_dimension false
  derived "(self.e_max - self.e_min) / self.y"
}
attribute_definition n_lc {
  symbol "n_LC"
  name "Maximum number of load cell verification intervals"
  definition "Maximum number of load cell verification intervals into which the maximum measuring range may be divided."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.8"
  quantity_kind count
  value_type QuantityValue
  origin design-fixed
  scope group
  category metrological
  is_dimension false
}
attribute_definition p_lc {
  symbol "p_LC"
  name "Apportioning factor"
  definition "Value of a dimensionless fraction expressed as a decimal (for example, 0.7) representing that portion of an error observed in the (weighing) instrument which is attributed to the load cell alone."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.2"
  quantity_kind dimensionless
  value_type QuantityValue
  origin design-fixed
  scope family
  category metrological
  is_dimension false
}
attribute_definition d_max {
  symbol "D_max"
  name "Maximum load of the measuring range"
  definition "Largest value of a quantity expressed in units of mass which can be introduced to a load cell under test."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.6"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin test-dependent
  scope sample
  category metrological
  is_dimension false
}
attribute_definition d_min {
  symbol "D_min"
  name "Minimum load of the measuring range"
  definition "Smallest value of a quantity expressed in units of mass, applied to a load cell under test."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.12"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin test-dependent
  scope sample
  category metrological
  is_dimension false
}
attribute_definition v {
  symbol "v"
  name "Load cell verification interval"
  definition "Load cell interval, expressed in units of mass, used in the test of the load cell for accuracy classification."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.4"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin test-dependent
  scope sample
  category metrological
  is_dimension false
}
attribute_definition n {
  symbol "n"
  name "Number of load cell verification intervals"
  definition "Total of load cell verification intervals into which the maximum measuring range is divided."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.13"
  quantity_kind count
  value_type QuantityValue
  origin test-dependent
  scope sample
  category metrological
  is_dimension false
  derived "(self.e_max - self.e_min) / self.v"
}
attribute_definition dr {
  symbol "DR"
  name "Minimum dead load output return"
  definition "Difference of load cell output, expressed in units of mass at the minimum dead load (D_min), measured before and after application of a load of D_max."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.10"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin test-dependent
  scope group
  category metrological
  is_dimension false
  derived "(self.e_max - self.e_min) / (2 * self.z)"
}
attribute_definition y {
  symbol "Y"
  name "Relative minimum load cell verification interval"
  definition "Ratio of the maximum measuring range to the minimum load cell verification interval, v_min; describes the resolution of the load cell independent from its capacity."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.15"
  quantity_kind dimensionless
  value_type QuantityValue
  origin design-fixed
  scope group
  category metrological
  is_dimension false
  derived "(self.e_max - self.e_min) / self.v_min"
}
attribute_definition z {
  symbol "Z"
  name "Relative minimum dead load output return"
  definition "Ratio of the maximum measuring range to two times the minimum dead load output return, DR; used to describe multi-interval instruments."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.14"
  quantity_kind dimensionless
  value_type QuantityValue
  origin design-fixed
  scope group
  category metrological
  is_dimension false
  derived "(self.e_max - self.e_min) / (2 * self.dr)"
}
attribute_definition mr {
  symbol "MR"
  name "Load cell measuring range (for verification)"
  definition "Range between the maximum load of the measuring range D_max and the minimum load of the measuring range D_min."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.2"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin test-dependent
  scope sample
  category metrological
  is_dimension false
  derived "self.d_max - self.d_min"
}
attribute_definition mr_max {
  symbol "MR_max"
  name "Maximum measuring range"
  definition "Range of values of the quantity expressed in units of mass that may be applied to a load cell (E_max - E_min)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.7"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin design-fixed
  scope model
  category metrological
  is_dimension false
  derived "self.e_max - self.e_min"
}
attribute_definition mpe {
  symbol "MPE"
  name "Maximum permissible error"
  definition "Extreme value of measurement error, with respect to a known reference quantity value, permitted by this Recommendation for a load cell; tiered by accuracy class and applied load (R 60-1, 5.3.2 Table 4)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.10"
  quantity_kind verification_interval
  unit "v"
  value_type QuantityValue
  origin design-fixed
  scope group
  category metrological
  is_dimension false
  derived "lookupMPE(load, self.accuracy_class, self.p_lc)"
}
attribute_definition mpe_lc {
  symbol "MPE_LC"
  name "Apportioned maximum permissible error"
  definition "Load-cell share of the weighing instrument's maximum permissible error, obtained by apportioning with p_LC."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.3.2"
  quantity_kind verification_interval
  unit "v"
  value_type QuantityValue
  origin design-fixed
  scope group
  category metrological
  is_dimension false
  derived "self.p_lc * MPE_instrument(self.accuracy_class)"
}
attribute_definition t_min {
  symbol "T_min"
  name "Minimum operating temperature"
  definition "Lowest temperature of the rated operating range over which the load cell performs within the limits of error (special limits of working temperature, if specified)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1"
  quantity_kind temperature
  unit "degC"
  value_type QuantityValue
  origin declared
  scope family
  category metrological
  is_dimension false
  irdi "0112/2///61987#ABA621"
}
attribute_definition t_max {
  symbol "T_max"
  name "Maximum operating temperature"
  definition "Highest temperature of the rated operating range over which the load cell performs within the limits of error (special limits of working temperature, if specified)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.1"
  quantity_kind temperature
  unit "degC"
  value_type QuantityValue
  origin declared
  scope family
  category metrological
  is_dimension false
  irdi "0112/2///61987#ABA623"
}
attribute_definition warm_up_time {
  symbol "warmUpTime"
  name "Warm-up time"
  definition "Time between the moment power is applied to a load cell and the moment at which the load cell is capable of complying with the requirements."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.17"
  quantity_kind time
  unit "min"
  value_type QuantityValue
  origin declared
  scope model
  category electrical
  is_dimension false
  irdi "0112/2///61987#ABB026"
}
attribute_definition rated_output {
  name "Rated output"
  definition "Nominal load cell output (the measurable quantity into which a load cell converts the measured input quantity) per volt of excitation at maximum capacity, with tolerance."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.3"
  quantity_kind voltage-ratio
  unit "mV/V"
  value_type QuantityValue
  origin declared
  scope family
  category electrical
  is_dimension false
}
attribute_definition input_impedance {
  name "Input impedance"
  definition "Electrical impedance across the excitation terminals, with tolerance."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  quantity_kind electrical-resistance
  unit "Ω"
  value_type QuantityValue
  origin declared
  scope family
  category electrical
  is_dimension false
  irdi "0112/2///61987#ABP114"
}
attribute_definition output_impedance {
  name "Output impedance"
  definition "Electrical impedance across the output terminals, with tolerance."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  quantity_kind electrical-resistance
  unit "Ω"
  value_type QuantityValue
  origin declared
  scope family
  category electrical
  is_dimension false
  irdi "0112/2///61987#ABP162"
}
attribute_definition adc_input_per_v_min {
  symbol "µV/v_min"
  name "A/D converter input signal per v_min"
  definition "Input signal per minimum load cell verification interval at the analogue-to-digital converter — rated output times excitation voltage divided by n_LC, expressed in µV per v_min. R 60-2, 2.4.6 selects, for analogue-active and digital load cells of a family, the cell with the minimum µV/v_min for all applicable tests."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.4.6"
  quantity_kind voltage
  unit "µV"
  value_type QuantityValue
  origin derived
  scope group
  category electrical
  is_dimension false
  derived "self.rated_output * self.recommended_excitation / self.n_lc * 1000"
}
attribute_definition recommended_excitation {
  name "Recommended excitation"
  definition "Recommended excitation voltage range (AC or DC) for the load cell."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  quantity_kind voltage
  unit "V"
  value_type QuantityValue
  origin declared
  scope family
  category electrical
  is_dimension false
}
attribute_definition excitation_maximum {
  name "Excitation maximum"
  definition "Maximum excitation voltage the load cell can withstand."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  quantity_kind voltage
  unit "V"
  value_type QuantityValue
  origin declared
  scope family
  category electrical
  is_dimension false
}
attribute_definition safe_overload {
  name "Safe overload"
  definition "Maximum overload the load cell can withstand without permanent damage, expressed as a percentage of E_max; relates to the safe load limit E_lim (R 60-1, 3.5.16)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.16"
  quantity_kind dimensionless
  unit "%"
  value_type QuantityValue
  origin declared
  scope family
  category dimensional
  is_dimension false
}
attribute_definition transducer_material {
  name "Transducer material"
  definition "Material or combination of materials of the load cell sensing element (e.g. mild steel, stainless steel, aluminium)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  value_type string
  origin design-fixed
  scope family
  category material
  is_dimension false
}
attribute_definition atmospheric_protection {
  name "Atmospheric protection"
  definition "Protection method against environmental exposure (e.g. sealing of the strain gauges)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  value_type string
  origin design-fixed
  scope family
  category material
  is_dimension false
}
attribute_definition construction_type {
  name "Load cell construction"
  definition "Mechanical construction type of the load cell (bending beam, shear beam, column, etc.)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  value_type string
  origin design-fixed
  scope group
  category dimensional
  is_dimension false
}
attribute_definition gauge_type {
  name "Gauge type"
  definition "Strain-gauge sensing-element construction classification (bonded foil, semiconductor, thin film)."
  value_type string
  origin design-fixed
  scope family
  category construction
  is_dimension false
}
attribute_definition bridge_type {
  name "Bridge type"
  definition "Wheatstone bridge configuration of the strain-gauge circuit (full bridge, half bridge, quarter bridge)."
  value_type string
  origin design-fixed
  scope family
  category construction
  is_dimension false
}
attribute_definition conversion_factor_f {
  symbol "f"
  name "Conversion factor"
  definition "Number of indicated units per load cell verification interval, v, used to convert indicating-instrument readings into verification intervals."
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.4"
  quantity_kind dimensionless
  unit "counts/v"
  value_type QuantityValue
  origin test-dependent
  scope sample
  category metrological
  is_dimension false
}
attribute_definition temperature_variation {
  symbol "ΔT_test"
  name "Ambient temperature variation during a test"
  definition "Difference between the extreme ambient temperatures noted during a test run. The temperature is deemed stable when this does not exceed one fifth of the temperature range of the load cell under test (t_max − t_min), without being greater than 2 °C; a run recorded under unstable temperature is INVALID (not failed)."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.1"
  quantity_kind temperature
  unit "degC"
  value_type QuantityValue
  origin test-dependent
  scope sample
  category metrological
  is_dimension false
}
attribute_definition power_voltage {
  name "Power supply voltage"
  definition "Supply voltage of an analogue-active or digital load cell (mains AC or battery DC), with the permitted variation range."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2"
  quantity_kind voltage
  unit "V"
  value_type QuantityValue
  origin declared
  scope model
  category electrical
  is_dimension false
}
attribute_definition interfaces {
  name "Interfaces"
  definition "Digital communication interfaces of a digital load cell (e.g. RS-485, CAN)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.1.3.3"
  value_type string
  origin declared
  scope model
  category electrical
  is_dimension false
  irdi "0112/2///61987#ABB279"
}
attribute_definition output_signal {
  name "Output signal"
  definition "Format of the (digital) output signal providing the representation of the measurand value."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.1.3.3"
  value_type string
  origin declared
  scope model
  category electrical
  is_dimension false
}
attribute_definition software_identification {
  name "Software identification"
  definition "Identification (version) of the legally relevant software of a digital load cell, per OIML D 31."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6.1"
  value_type string
  origin declared
  scope model
  category administrative
  is_dimension false
  irdi "0112/2///61360_7#CBA046"
}
attribute_definition signal_bandwidth {
  name "Signal bandwidth"
  definition "Analog bandwidth of the signal-conditioning path — the frequency at which the path attenuates by 3 dB; the upper bound of dynamic load variation the electronics can resolve."
  quantity_kind frequency
  unit "Hz"
  value_type QuantityValue
  origin declared
  scope model
  category electrical
  is_dimension false
}
attribute_definition indication {
  symbol "I"
  name "Indication"
  definition "The indication of the load cell — the live output reading in units of mass served by the twin interface (the load cell output converted to measurement units, R 60-1, 3.5.3)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.3"
  quantity_kind mass
  unit "kg"
  value_type QuantityValue
  origin measured
  scope sample
  category metrological
  is_dimension false
}
attribute_definition cable_length {
  name "Cable length"
  definition "Length of the load cell's integral cable — part of the specification set a load cell family shares (materials, technique, attachment, construction, specifications: output rating, input impedance, supply voltage, cable details) per R 60-1, 3.4.2 (e). OPTIONAL: declared when present on the model's datasheet."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.4.2"
  quantity_kind length
  unit "m"
  value_type QuantityValue
  origin declared
  scope model
  category administrative
  is_dimension false
}
attribute_definition additional_markings {
  name "Additional markings"
  definition "Markings on the load cell beyond the required set — the manufacturer's optional markings (logos, supplementary codes, production references) recorded with the model and verified on the sample during the markings examination. OPTIONAL: declared when present."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-6"
  value_type string
  origin declared
  scope model
  category administrative
  is_dimension false
}
attribute_definition additional_characterisation {
  name "Additional characterisation"
  definition "Additional characterisation information completing the load cell classification — the sixth parameter of the complete classification (accuracy class, n_LC, load application, temperature limits, humidity symbol, additional characterisation) per R 60-1, 5.1.5 (f), elaborated in 5.1.6 and 5.1.7 and Figure 4. OPTIONAL: declared when the classification uses it."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.1.5"
  value_type string
  origin declared
  scope group
  category administrative
  is_dimension false
}
capability load-cell {
  label "Load Cell"
  description "Base capability — all load cells have this. The instrument measures force/load."
  has_parameters { e_max e_min n_lc v_min dr y z p_lc }
  satisfies_requirements { /req/metrological/mpe /req/metrological/repeatability /req/metrological/creep /req/metrological/dr /req/metrological/temperature-effect-mdlo /req/metrological/barometric-pressure }
  verified_by_tests { /conf/metrological-tests/measurement-error-repeatability-mdlo /conf/metrological-tests/creep /conf/metrological-tests/dr /conf/metrological-tests/barometric-pressure }
}
capability strain-gauge {
  label "Strain Gauge"
  description "Uses strain gauge technology for measurement"
  requires { load-cell }
  has_parameters { rated_output input_impedance recommended_excitation excitation_maximum gauge_type bridge_type }
}
capability electronic {
  label "Electronic"
  description "Abstract — instruments with built-in electronics"
  abstract true
  satisfies_requirements { /req/electronic/no-significant-faults /req/electronic/disturbances }
  verified_by_tests { /conf/electronic-tests/short-time-power /conf/electronic-tests/bursts /conf/electronic-tests/surge /conf/electronic-tests/esd /conf/electronic-tests/emc-susceptibility /conf/electronic-tests/conducted-emc }
}
capability analogue-active {
  label "Analogue Active"
  description "Load cell with built-in analogue electronics (amplifier, A/D converter)"
  extends { electronic }
  requires { load-cell electronic }
  has_parameters { signal_bandwidth }
}
capability digital {
  label "Digital"
  description "Load cell with digital output and built-in processing"
  extends { electronic }
  requires { load-cell electronic }
  has_parameters { power_voltage interfaces output_signal software_identification signal_bandwidth }
  satisfies_requirements { /req/electronic/warm-up-time /req/electronic/power-voltage-variations /req/electronic/span-stability /req/technical/software }
  verified_by_tests { /conf/electronic-tests/warm-up-time /conf/electronic-tests/power-voltage /conf/electronic-tests/span-stability /conf/examinations/software }
}
capability humidity-ch {
  label "Cyclic Humidity"
  description "Load cell designed for cyclic humidity exposure (CH marked or unmarked)"
  requires { load-cell }
  satisfies_requirements { /req/metrological/humidity-ch }
  verified_by_tests { /conf/metrological-tests/humidity-ch }
}
capability humidity-sh {
  label "Steady-state Humidity"
  description "Load cell designed for steady-state humidity exposure (SH marked)"
  requires { load-cell }
  satisfies_requirements { /req/metrological/humidity-sh }
  verified_by_tests { /conf/metrological-tests/humidity-sh }
}
behavior creep {
  kind temporal
  stimulus force
  response "Change in load cell output occurring with time while under constant load and with all environmental conditions and other variables also remaining constant."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.1"
  verified_by { /conf/metrological-tests/creep }
}
behavior dead-load-output-return {
  kind static
  stimulus force
  response "Difference of load cell output, expressed in units of mass at the minimum dead load (D_min), measured before and after application of a load of D_max."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.10"
  verified_by { /conf/metrological-tests/dr }
}
behavior hysteresis {
  kind static
  stimulus force
  response "Difference in load cell output readings for the same applied force between the reading obtained by increasing the load from minimum load (D_min) and the reading obtained by decreasing the load from maximum load (D_max)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.7"
  verified_by { /conf/metrological-tests/measurement-error-repeatability-mdlo }
}
behavior non-linearity {
  kind static
  stimulus force
  response "Deviation from the average of the values of load cell signals from a straight line through zero force applied and maximum force applied."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.13"
  verified_by { /conf/metrological-tests/measurement-error-repeatability-mdlo }
}
behavior repeatability {
  kind static
  stimulus force
  response "Difference between load cell output readings taken from consecutive tests under the same loading and environmental conditions of measurement."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.14"
  verified_by { /conf/metrological-tests/measurement-error-repeatability-mdlo }
}
behavior temp-effect-min-dead-load {
  kind influence-response
  stimulus temperature
  response "Change of the signal output under minimum dead load due to a change in ambient temperature."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.19"
  verified_by { /conf/metrological-tests/measurement-error-repeatability-mdlo }
}
behavior temp-effect-sensitivity {
  kind influence-response
  stimulus temperature
  response "Change in sensitivity due to a change in ambient temperature."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.20"
  verified_by { /conf/metrological-tests/measurement-error-repeatability-mdlo }
}
behavior barometric-effect {
  kind influence-response
  stimulus pressure
  response "Change in load cell output due to a change in barometric pressure."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.2"
  verified_by { /conf/metrological-tests/barometric-pressure }
}
behavior span-stability {
  kind temporal
  stimulus time
  response "Capability of a load cell to maintain the load cell output of the load cell's measuring range over a period of use within specified limits."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.7.18"
  verified_by { /conf/electronic-tests/span-stability }
}
behavior warm-up-drift {
  kind temporal
  stimulus time
  response "Change in load cell indication with time during the designed warm-up period after switch-on — the interval over which no transmission of measurement results occurs."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.1"
  verified_by { /conf/electronic-tests/warm-up-time }
}
behavior humidity-cyclic-response {
  kind influence-response
  stimulus relative_humidity
  response "Change in load cell output due to exposure to cyclic damp heat (CH class or unmarked load cells), bounded at the minimum load and at the maximum load (applying IEC 60068-2-30)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.3"
  verified_by { /conf/metrological-tests/humidity-ch }
}
behavior humidity-steady-response {
  kind influence-response
  stimulus relative_humidity
  response "Change in load cell output due to exposure to steady-state damp heat (SH-marked load cells), bounded by the maximum permissible error for the applied load (applying IEC 60068-2-78)."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6.3"
  verified_by { /conf/metrological-tests/humidity-sh }
}
behavior response-to-bursts {
  kind influence-response
  stimulus electrical_fast_transient
  response "Change in load cell output due to electrical fast transients (bursts) applied to power supply lines and I/O circuits — the fault against the output without disturbance stays within the significant-fault criterion (applying IEC 61000-4-4)."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.6"
  verified_by { /conf/electronic-tests/bursts }
}
behavior response-to-surges {
  kind influence-response
  stimulus surge
  response "Change in load cell output due to surge events applied to power supply lines, line-to-line and line-to-earth — the fault against the output without disturbance stays within the significant-fault criterion (applying IEC 61000-4-5)."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.7"
  verified_by { /conf/electronic-tests/surge }
}
behavior response-to-esd {
  kind influence-response
  stimulus electrostatic_discharge
  response "Change in load cell output due to electrostatic discharge, contact and air application — the fault against the output without disturbance stays within the significant-fault criterion (applying IEC 61000-4-2)."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.8"
  verified_by { /conf/electronic-tests/esd }
}
behavior response-to-rf-em-fields {
  kind influence-response
  stimulus em_field
  response "Change in load cell output due to radiated and conducted radio-frequency electromagnetic fields — the fault against the output without disturbance stays within the significant-fault criterion (applying IEC 61000-4-3 and IEC 61000-4-6)."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.9"
  verified_by { /conf/electronic-tests/emc-susceptibility /conf/electronic-tests/conducted-emc }
}
behavior response-to-power-voltage-variation {
  kind influence-response
  stimulus mains_voltage
  response "Change in load cell span when the power supply voltage varies within the rated limits (−15 % to +10 % for AC mains; below the manufacturer-specified value for DC battery supply) — the span variation stays within the maximum permissible error."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.4"
  verified_by { /conf/electronic-tests/power-voltage }
}
behavior response-to-short-time-power-reduction {
  kind influence-response
  stimulus voltage_dip
  response "Change in load cell output due to short-time power reductions and interruptions of the supply — the fault against the output without disturbance stays within the significant-fault criterion."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.5"
  verified_by { /conf/electronic-tests/short-time-power }
}
behavior durability {
  kind temporal
  stimulus time
  response "Ability of a measuring instrument to maintain its performance characteristics over a period of use."
  source { doc "OIML-V1" clause "5.15" }
}
behavior self_test {
  kind procedural
  stimulus invoke
  response "The load cell runs its self-diagnostic and reports a diagnostic report; a detected significant fault drives the operational state machine to fault — the cell is made inoperative automatically or a fault detection output is issued until the fault is resolved."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1.2"
}
behavior load_weight {
  kind measurement
  stimulus force
  response "The load cell's measurement behavior: an applied load is transduced, conditioned and scaled into an indication — the signal chain of R 60-1, 4 (Figure 2). Its executable anatomy (steps, registers, invariants) is declared by the process of the same id in model/processes.prl."
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-4"
}
condition_set load-cell-reference-conditions {
  role reference
  subject LoadCell
  entries {
    temperature { value 20 unit "degC" tolerance 2 note "Reference temperature; stabilise at 20 degC +/- 2 degC (R 60-2, 2.10.1). Temperature is stable when the difference between extreme temperatures noted during the test does not exceed one fifth of the temperature range of the load cell under test, without being greater than 2 degC (R 60-2, 2.7.3.1)." }
    relative_humidity { value 50 unit "%RH" note "Reference relative humidity for non-humidity tests (R 60-2, 2.10.6; test-conditions legacy file)." }
    barometric_pressure { value "local ambient" unit "kPa" note "Ambient pressure recorded during the test for correction of pressure-sensitive readings (R 60-2, 2.7.3.8)." }
    acceleration_of_gravity { value "local value" unit "m/s2" note "Local value or the value declared for the testing laboratory, used in the calculation of the applied force (R 60-2, 2.7.3.2)." }
    power_voltage { value "nominal rated value" unit "V" note "Manufacturer-declared supply voltage (mains AC or battery DC) for analogue-active and digital load cells (R 60-1, 5.7.2)." }
  }
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.2"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.3"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.4"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.5"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.6"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.7"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.8"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.9"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.10"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.11"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.7.3.12"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1"
}
condition_set load-cell-rated-conditions {
  role rated
  subject LoadCell
  entries {
    temperature { value -10..+40 unit "degC" note "Default temperature limits (R 60-1, 5.6.1.1) unless special limits t_min/t_max are specified (R 60-1, 5.6.1.2); special span at least 5 degC (class A), 15 degC (class B), 30 degC (classes C, D)." }
    relative_humidity { value "per humidity class" unit "%RH" note "CH (or unmarked): cyclic humidity exposure per R 60-2, 2.10.5.12; SH: steady-state humidity per R 60-2, 2.10.6.11; NH: not humidity-tested (R 60-1, 5.6.3)." }
    barometric_pressure { value "unrestricted ambient" unit "kPa" note "Output shall not vary by more than v_min for any 1 kPa incremental change (R 60-1, 5.6.2)." }
    power_voltage { value "nominal -15 % .. +10 %" unit "V" note "Mains AC variation range (R 60-1, 5.7.2); battery DC: function correctly or give no result below the manufacturer-specified voltage." }
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.6"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2"
}
condition_set load-cell-limiting-conditions {
  role limiting
  subject LoadCell
  entries {
    mass { value "up to E_lim" unit "kg" note "Maximum load that can be applied without producing a permanent shift in the performance characteristics beyond those specified (R 60-1, 3.5.16); see also safe_overload (% of E_max)." }
    voltage { value "up to excitation_maximum" unit "V" note "Maximum excitation voltage the load cell can withstand (declared, family-level)." }
    temperature { value "manufacturer-declared storage range" unit "degC" note "Survival outside the rated range without permanent shift; R 60 specifies no standardized storage limits — declared per model." }
  }
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.16"
}
conformance_class /conf/class-a {
  title "Class A load cell conformance"
  name "Class A load cell type evaluation"
  target /req/class-a
  subject "Class A load cell type evaluation"
  description "Conformance tests for Class A load cells. 5 runs per load point, 2°C MDLO temperature increment. No span stability test."
  applicability {
    accuracy_class: [A]
  }
  dependencies { /conf/metrological-tests /conf/examinations /conf/electronic-tests }
}
conformance_class /conf/class-b {
  title "Class B load cell conformance"
  name "Class B load cell type evaluation"
  target /req/class-b
  subject "Class B load cell type evaluation"
  description "Conformance tests for Class B load cells. 5 runs per load point, 5°C MDLO temperature increment. Span stability test for electronic load cells."
  applicability {
    accuracy_class: [B]
  }
  dependencies { /conf/metrological-tests /conf/examinations /conf/electronic-tests }
}
conformance_class /conf/class-c {
  title "Class C load cell conformance"
  name "Class C load cell type evaluation"
  target /req/class-c
  subject "Class C load cell type evaluation"
  description "Conformance tests for Class C load cells. 3 runs per load point, 5°C MDLO temperature increment. Span stability test for electronic load cells."
  applicability {
    accuracy_class: [C]
  }
  dependencies { /conf/metrological-tests /conf/examinations /conf/electronic-tests }
}
conformance_class /conf/class-d {
  title "Class D load cell conformance"
  name "Class D load cell type evaluation"
  target /req/class-d
  subject "Class D load cell type evaluation"
  description "Conformance tests for Class D load cells. 3 runs per load point, 5°C MDLO temperature increment. Span stability test for electronic load cells."
  applicability {
    accuracy_class: [D]
  }
  dependencies { /conf/metrological-tests /conf/examinations /conf/electronic-tests }
}
conformance_class /conf/electronic-tests {
  title "Electronic load cell conformance tests"
  name "Conformance tests for analogue-active and digital load cells"
  target /req/electronic
  subject "electronic load cell testing"
  description "Test procedures for verifying compliance with additional requirements for analogue-active and digital load cells, covering warm-up time, power supply variations, electromagnetic disturbances, and span stability."
  applicability {
    technology: [analogue-active, digital]
  }
  test_subject {
    entity: "MeasuringInstrument"
    classification_dimensions: "{\"accuracy_class\":[\"A\",\"B\",\"C\",\"D\"],\"technology\":[\"analogue-active\",\"digital\"],\"humidity_class\":[\"CH\",\"SH\",\"NH\"]}"
  }
  dependencies { /conf/metrological-tests }
}
conformance_class /conf/examinations {
  title "Examination conformance tests"
  name "Examination tests for load cells"
  target /req/technical
  subject "load cell examination"
  description "Examination procedures for verifying compliance with technical requirements for markings, software, documentation, and suitability for testing."
}
conformance_class /conf/metrological-tests {
  title "Metrological conformance tests"
  name "Metrological conformance tests for load cells"
  target /req/metrological
  subject "load cell testing"
  description "Test procedures for verifying compliance with the metrological requirements for all load cells, including measurement error, repeatability, temperature effects, creep, dead load output return, barometric pressure, and humidity."
  test_subject {
    entity: "MeasuringInstrument"
    classification_dimensions: "{\"accuracy_class\":[\"A\",\"B\",\"C\",\"D\"],\"technology\":[\"analogue-passive\",\"analogue-active\",\"digital\"],\"humidity_class\":[\"CH\",\"SH\",\"NH\"]}"
  }
}
