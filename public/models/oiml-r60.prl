  field working_temperature_lower : number { label "Working temperature lower limit" description "If other than stem:[-10 \"unitsml(degC)\"]" unit "unitsml(degC)" default -10 }
  field humidity_symbol : enum { label "Humidity symbol" dimension humidity_class }
  field loading_designation : enum { label "Loading designation" dimension load_type ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.4.2" }
  field emin : number { label "Minimum dead load, stem:[E_min]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.8" }
  field elim : number { label "Safe load limit, stem:[E_lim]" unit "unitsml(g),unitsml(kg),unitsml(t)" }
  field excitation_voltage : enum { label "Excitation voltage" values { AC DC } }
  field plc : number { label "Value of the apportionment factor, stem:[p_LC]" description "If not equal to 0.7" default 0.7 ref requirement "urn:oiml:pub:r:60-1:2021#clause-4" }
}
