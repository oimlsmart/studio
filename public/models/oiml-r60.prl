form r60-3/sec-4.9.5 {
  name "Documentation supplied with the test pattern by the applicant"
  description "Documentation supplied with the test pattern by the applicant"
  data_class FormInstance#data
  section "R 60-3, 4.9.5"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.5"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.5/table-1"
  field documents : array {
    label "Documents"
    items { object }
    fields {
      field name : string { label "Name of the document" required true }
      field content : text { label "Content" }
      field version : string { label "Version No." }
      field issue_date : date { label "Date of issue" }
    }
  }
}
form r60-3/sec-4.9.6 {
  name "Inscriptions and presentations of load cell information"
  description "Inscriptions and presentations of load cell information according to manufacturer statement"
  data_class FormInstance#data
  section "R 60-3, 4.9.6"
  note "This form is completed three times — once for each presentation medium (on the load cell, in the accompanying document, in the data sheet). Each instance captures which inscription items are present in that medium. Serial number and year of production are not applicable to the data sheet instance per R 60-3, 4.9.6."
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.6"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.6/table-1"
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2"
  instances {
    instance on-load-cell { name "On the load cell" }
    instance accompanying-document { name "Accompanying document" }
    instance data-sheet { name "In the data sheet" }
  }
  field name_or_trademark : boolean { label "Name or trademark of manufacturer" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.1" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field model_designation : boolean { label "Manufacturer's own designation or load cell model" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.1" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field serial_number : boolean { label "Serial number" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.1" }
  field year_of_production : boolean { label "Year of production" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.1" }
  field accuracy_class_symbols : boolean { label "Accuracy class(es) and their symbols" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.4.1" }
  field nlc : boolean { label "Maximum number of load cell verification intervals, stem:[n_LC]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.4.5" }
  field type_of_load : boolean { label "Type of load" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.4.2" }
  field working_temperature : boolean { label "Working temperature designation" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.4.3" }
  field humidity_nh : boolean { label "Humidity symbol \"NH\"" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.4.4" }
  field humidity_sh : boolean { label "Humidity symbol \"SH\"" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.4.4" }
  field humidity_ch_or_none : boolean { label "No humidity symbol or \"CH\"" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.4.4" }
  field emin : boolean { label "Minimum dead load, stem:[E_min]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field emax : boolean { label "Maximum capacity, stem:[E_max]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.1" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field elim : boolean { label "Safe load limit, stem:[E_lim]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field vmin : boolean { label "Minimum load cell verification interval, stem:[v_min]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field relative_vmin_y : boolean { label "Relative stem:[v_min] (stem:[Y])" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.3" }
  field dr : boolean { label "Minimum dead load output return, stem:[DR]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.3" }
  field relative_dr_z : boolean { label "Relative DR (stem:[Z])" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.3" }
  field rated_output : boolean { label "Rated output" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field excitation_voltage : boolean { label "Excitation voltage" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field input_impedance : boolean { label "Input impedance" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field cable_connection : boolean { label "Cable connection" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field cable_length : boolean { label "Cable length" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field plc : boolean { label "Apportionment factor, stem:[p_LC]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" }
  field further_information : boolean { label "Further information" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.2" ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2.3" }
}
form r60-3/sec-4.9.7 {
  name "Model range and load cell family definitions"
  description "Various designs within the model range and definition of load cell families including construction characteristics"
  data_class FormInstance#data
  section "R 60-3, 4.9.7–4.9.11"
  note "Three entity levels: LoadCellModel — a specific capacity variant (stem:[E_max], stem:[E_min], stem:[n_LC], stem:[v_min], stem:[DR]). LoadCellFamily — shared construction characteristics; owns its models. A family can span multiple accuracy classes and technologies; its identity is the construction, not the metrological parameters. ModelRange — the top-level product line; owns its families. R 60-3 presents these as separate printed tables (4.9.7 model variants, 4.9.9 family construction, 4.9.10 dimensions, 4.9.11 load transmissions) but they are one domain hierarchy. The printed report renders multiple tables from this one data structure."
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.7"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.8"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.9"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.10"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.11"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.7/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.8/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.9/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.10/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.11/table-1"
  field families : array {
    label "Load cell families"
    items { object }
    fields {
      field model_designation : string { label "Type / Model designation" required true }
      field application_of_load : string { label "Application of load" examples "tension / compression" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.2.1" }
      field load_cell_construction : string { label "Load cell construction" examples "bending beam" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.3" }
      field material : string { label "Material or combination of materials" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.4.2" }
      field shape : string { label "Shape" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.4.2" }
      field measuring_technique : string { label "Design of measuring technique" examples "strain gauge bonded to metal" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.3.1" }
      field sealing_of_strain_gauges : string { label "Sealing of strain gauges" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.4.2" }
      field mounting_method : string { label "Mounting method" ref cites "urn:oiml:pub:r:60-3:2021#clause-4.9.11" }
      field load_transmission : string { label "Load transmission" ref cites "urn:oiml:pub:r:60-3:2021#clause-4.9.11" }
      field output_rating : string { label "Output rating" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.4.2" }
      field supply_voltage : string { label "Supply voltage" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.4.2" }
      field input_impedance : string { label "Input impedance" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.4.2" }
      field cable_connection : string { label "Cable connection" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.4.2" }
      field cable_length : string { label "Cable length" ref cites "urn:oiml:pub:r:60-1:2021#clause-3.4.2" }
      field dimensions : attachment { label "Pictures / Drawings of the load cell dimensions" ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.10" }
      field load_transmissions : attachment { label "Pictures / Drawings of the recommended load transmissions" ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.11" }
      field models : array {
        label "Model variants within this family"
        items { object }
        fields {
          field model_designation : string { label "Model designation" required true }
          field emax : number { label "Maximum capacity, stem:[E_max]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.7" }
          field emin : number { label "Minimum dead load, stem:[E_min]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.8" }
          field nlc : integer { label "Maximum number of load cell intervals, stem:[n_LC]" ref requirement "urn:oiml:pub:r:60-1:2021#clause-4" }
          field vmin : number { label "Minimum load cell verification interval, stem:[v_min]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-4" }
          field dr : number { label "Minimum dead load output return, stem:[DR]" unit "unitsml(g),unitsml(kg),unitsml(t)" ref requirement "urn:oiml:pub:r:60-1:2021#clause-3.5.10" }
        }
      }
    }
  }
  field documentation : attachment { label "Relevant photographs / documentation of the model range" ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.9.8" }
  field further_remarks : text { label "Further remarks concerning the definition of load cell families / construction" }
}
