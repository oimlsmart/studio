    definition "R 60-3 form identifier being omitted (e.g. 'humidity-sh')"
    modality SHALL
  }
  reason: text {
    definition "Justification, e.g. 'Not applicable — CH humidity class, SH test not required'"
    modality SHALL
  }
  decided_by: enum {
