  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.4.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.4.1/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.4"
  field company : string { label "Company" required true }
  field address : string { label "Address" }
  field contact_information : string { label "Contact information" }
}
form r60-3/sec-4.4.2 {
  name "Applicant"
  description "General information regarding the evaluation process — applicant"
  data_class FormInstance#data
  section "R 60-3, 4.4.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.4.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.4.2/table-1"
  field company : string { label "Company" }
  field representative : string { label "Representative (name, telephone)" }
  field address : string { label "Address" }
  field contact_information : string { label "Contact information" }
  field reference : string { label "Reference" }
  field date_of_application : date { label "Date of application" }
  field application_number : string { label "Application number" }
  field authorised_by_manufacturer : boolean { label "Applicant authorised by the manufacturer (documented)" true_label "Yes" false_label "No" }
  field no_concurrent_application : boolean { label "Statement that no concurrent application for OIML type evaluation has been made to any other OIML Issuing Authority (see Procedural Document PD-05 [29], 4.1.2 b)" true_label "Yes" false_label "No" }
  field remarks : text { label "Remarks" }
}
form r60-3/sec-4.4.3 {
  name "Testing laboratories involved in the tests"
  description "General information regarding the evaluation process — testing laboratories involved in the tests"
  data_class FormInstance#data
  section "R 60-3, 4.4.3"
  note "This table has to be completed for each test laboratory."
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.4.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.4.3/table-1"
  field testing_laboratories : array {
    label "Testing laboratories"
    items { object }
    fields {
      field name : string { label "Name" }
      field address : string { label "Address" }
      field application_number : string { label "Application number" }
      field tests_by_lab : string { label "Tests by this laboratory" }
      field date_period : string { label "Date/period of tests" }
      field test_engineers : string { label "Name(s) of test engineer(s)" }
      field accredited_by : string { label "Accredited by" }
      field accreditation_number : string { label "Accreditation number" }
      field accreditation_expires : date { label "Accreditation expires (date)" }
      field accreditation_includes_r60 : boolean { label "Accreditation includes R 60" true_label "Yes" false_label "No" }
      field accreditation_edition : string { label "Accreditation edition" }
      field peer_assessment_details : text { label "Details of relevant peer assessment or assessment by other means" }
      field offsite_test_details : text { label "In case tests have been performed at locations other than the address of this laboratory, give details here" }
      field responsible_person : string { label "Name of the responsible person" }
      field signature_date : date { label "Date of signature" }
      field stamp_signature : attachment { label "Stamp (if applicable) and signature of the responsible person" }
      field remarks : text { label "Remarks" }
    }
  }
}
form r60-3/sec-4.5 {
  name "General information concerning the load cell type"
  description "General information concerning the load cell type as provided by the manufacturer prior to the evaluation"
  data_class FormInstance#data
  section "R 60-3, 4.5"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.5"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.5/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.5/table-2"
  field manufacturer_name : string { label "Manufacturer's name/trade mark" required true }
  field type_designation : string { label "Manufacturer's type designation (or load cell model number)" required true }
  field accuracy_classes : string { label "Accuracy classes" }
  field accuracy_classes_range : string { label "Range of accuracy classes" }
  field nlc : integer { label "Maximum number of verification intervals, stem:[n_LC]" }
  field nlc_range : string { label "Range of verification intervals" }
  field emax : number { label "Maximum capacity, stem:[E_max]" unit "unitsml(g),unitsml(kg),unitsml(t)" }
  field emax_range : string { label "Range of maximum capacities" }
  field emin : number { label "Minimum capacity, stem:[E_min]" unit "unitsml(g),unitsml(kg),unitsml(t)" }
  field emin_range : string { label "Range of minimum capacities" }
  field vmin : number { label "Minimum load cell verification interval, stem:[v_min = (E_max - E_min) / Y]" unit "unitsml(g),unitsml(kg),unitsml(t)" }
  field vmin_range : string { label "Range of v_min values" }
  field dr : number { label "Minimum dead load output return, stem:[DR = 1/2 (E_max - E_min) / Z]" unit "unitsml(g),unitsml(kg),unitsml(t)" }
  field dr_range : string { label "Range of DR values" }
  field rated_output : string { label "Rated output" unit "unitsml(mV/V),counts" }
  field rated_output_range : string { label "Range of rated outputs" }
  field input_impedance : number { label "Input impedance" unit "unitsml(Ohm)" required_when "ocl{family.classification.construction = 'strain-gauge'}" }
  field input_impedance_range : string { label "Range of input impedances" }
}
form r60-3/sec-4.6 {
  name "Accessories supplied with the test pattern by the applicant"
  description "Accessories supplied with the test pattern by the applicant, with remarks and specifications"
  data_class FormInstance#data
  section "R 60-3, 4.6"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.6"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-4.6/table-1"
