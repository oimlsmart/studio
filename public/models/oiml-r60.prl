form r60-3/sec-5.4 {
  name "Documentation Examination"
  description "Documentation for type approval examination"
  data_class FormInstance#data
  section "R 60-3, 5.4"
  requirements { /req/technical/mandatory-additional-info }
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.5"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.4/table-1"
  conformance_process /conf/examinations/documentation
  field documentation_items : array {
    label "Documentation checklist"
    description "Required documentation submitted for type approval review"
    default "[{\"item\":\"Description of the general principle of measurement\",\"reference\":\"urn:oiml:pub:r:60-2:2021#clause-2.5\"},{\"item\":\"List and characteristics of essential components + details\",\"reference\":\"\"},{\"item\":\"Mechanical drawings\",\"reference\":\"urn:oiml:pub:r:60-2:2021#clause-2.5\"},{\"item\":\"Electric/electronic diagrams\",\"reference\":\"urn:oiml:pub:r:60-2:2021#clause-2.5\"},{\"item\":\"Installation requirements\",\"reference\":\"urn:oiml:pub:r:60-2:2021#clause-2.5\"},{\"item\":\"Sealing plan\",\"reference\":\"\"},{\"item\":\"Panel layout\",\"reference\":\"\"},{\"item\":\"General information of the software\",\"reference\":\"urn:oiml:pub:r:60-2:2021#clause-2.5\"},{\"item\":\"Operating instructions\",\"reference\":\"urn:oiml:pub:r:60-2:2021#clause-2.5\"},{\"item\":\"Information supporting manufacturer's assumption of compliance\",\"reference\":\"urn:oiml:pub:r:60-2:2021#clause-2.5\"}]"
    items { object }
    targets { /req/technical/mandatory-additional-info }
    fields {
      field item : string { label "Document item" description "Description of the required document" }
      field r60_reference : string { label "R 60 reference" description "Clause reference in R 60-2" }
      field present : boolean { label "Present" description "Whether the document has been submitted" true_label "Yes" false_label "No" }
      field remarks : string { label "Remarks" }
    }
  }
  field further_information : text { label "Further information" description "Additional information relevant to the documentation review" }
  field remarks : text { label "Remarks" description "Additional observations or notes from the documentation review" }
  field overall_result : boolean { label "Overall result" description "PASS if all required documents are present and complete; FAIL otherwise" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "" pass_if "ocl{overall_result}" }
}
form r60-3/sec-5.1 {
  name "Marking Examination"
  description "Marking requirements examination (R 60-1, 6.2)"
  data_class FormInstance#data
  section "R 60-3, 5.1"
  requirements { /req/technical/mandatory-markings /req/technical/class-designation /req/technical/load-type-designation /req/technical/temperature-designation /req/technical/humidity-designation /req/technical/nlc-designation }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.2"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.6"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.1.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.1.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.1.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.1.1/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.1.2/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.1.3/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5"
  conformance_process /conf/examinations/inscriptions
  field mandatory_markings_on_load_cell : array {
    label "Mandatory markings on load cell"
    description "Markings that must appear on the load cell itself"
    default "[{\"information\":\"Name or trademark of manufacturer\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.1\"},{\"information\":\"Manufacturer's own designation or load cell model\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.1\"},{\"information\":\"Serial number\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.1\"},{\"information\":\"Maximum capacity, E_max\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.1\"},{\"information\":\"Year of production\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.1\"},{\"information\":\"Type approval mark (if applicable)\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.1\"}]"
    items { object }
    targets { /req/technical/mandatory-markings }
    fields {
      field r60_reference : string { label "R 60 reference" description "Clause reference in R 60-1" }
      field information : string { label "Information" description "Description of the required marking" }
      field fulfils_requirements : boolean { label "Fulfils requirements" description "Whether this marking is present and correct" true_label "Yes" false_label "No" }
    }
  }
  field mandatory_markings_on_load_cell_or_document : array {
    label "Mandatory markings on load cell or document"
    description "Markings that may appear on the load cell or in accompanying documentation"
    default "[{\"information\":\"Accuracy classes and their symbols\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.4.1\"},{\"information\":\"Maximum number of load cell verification intervals, n_LC\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.4.5\"},{\"information\":\"Loading designation (if necessary)\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.4.2\"},{\"information\":\"Working temperature designation\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.4.3\"},{\"information\":\"Humidity symbol NH\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.4.4\"},{\"information\":\"Humidity symbol SH\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.4.4\"},{\"information\":\"Minimum dead load, E_min\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.2\"},{\"information\":\"Safe load limit, E_lim\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.2\"},{\"information\":\"Minimum load cell verification interval (v_min)\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-5.1.3, urn:oiml:pub:r:60-1:2021#clause-6.2.2\"},{\"information\":\"Other pertinent conditions\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-6.2.2\"},{\"information\":\"Apportionment factor, p_LC (if not equal to 0.7)\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-3.7.2, urn:oiml:pub:r:60-1:2021#clause-5.3.2\"},{\"information\":\"Standard classification\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-5.1.6\"},{\"information\":\"Multiple classifications\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-5.1.7\"}]"
    items { object }
    targets { /req/technical/class-designation /req/technical/load-type-designation /req/technical/temperature-designation /req/technical/humidity-designation /req/technical/nlc-designation }
    fields {
      field r60_reference : string { label "R 60 reference" }
      field information : string { label "Information" description "Description of the required marking" }
      field on_load_cell : boolean { label "On load cell" description "Whether this marking appears on the load cell" true_label "Yes" false_label "No" }
      field in_document : boolean { label "In document" description "Whether this marking appears in the documentation" true_label "Yes" false_label "No" }
      field fulfils_requirements : boolean { label "Fulfils requirements" description "Whether this marking is present and correct" true_label "Yes" false_label "No" }
    }
  }
  field additional_markings : array {
    label "Non-mandatory, additional information (R 60-1, 6.2.3)"
    description "Additional information that may be marked (humidity symbol CH, Y, Z)"
    default "[{\"information\":\"Humidity symbol \\\"CH\\\"\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-5.6.3.1\"},{\"information\":\"Relative v_min (Y)\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-3.5.15\"},{\"information\":\"Relative DR (Z)\",\"reference\":\"urn:oiml:pub:r:60-1:2021#clause-3.5.14\"}]"
    items { object }
    targets { /req/technical/humidity-designation }
    fields {
      field r60_reference : string { label "R 60 reference" }
      field information : string { label "Information" }
      field on_load_cell : boolean { label "On load cell" true_label "Yes" false_label "No" }
      field in_document : boolean { label "In document" true_label "Yes" false_label "No" }
      field fulfils_requirements : boolean { label "Fulfils requirements" true_label "Yes" false_label "No" }
    }
  }
  pass_fail { criteria "All mandatory markings present and correct" pass_if "ocl{mandatory_markings_on_load_cell->forAll(m | m.fulfils_requirements) and mandatory_markings_on_load_cell_or_document->forAll(m | m.fulfils_requirements) and additional_markings->forAll(m | m.fulfils_requirements)}" }
}
form r60-3/sec-5.3 {
  name "Software Examination"
  description "Software examination (R 60-1, 6.1)"
  data_class FormInstance#data
  section "R 60-3, 5.3"
  requirements { /req/technical/software }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-6.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.3/table-1"
  conformance_process /conf/examinations/software
  field date : date { label "Date of examination" description "Date when the software examination was performed" required true }
  field observer : string { label "Observer" description "Name of the person performing the examination" }
  field serial_number : string { label "Serial number" description "Serial number of the load cell under test" required true }
  field software_version : string { label "Software version" description "Version identifier of the embedded software" targets { /req/technical/software } }
  field identification_code : string { label "Identification code" description "Software identification code displayed at power-on or on demand" targets { /req/technical/software } }
  field software_sealed : boolean { label "Software sealed" description "Whether the software is protected by a seal or equivalent means" true_label "Yes" false_label "No" targets { /req/technical/software } }
  field auto_change_identification_code : boolean { label "Auto-change identification code" description "Whether the identification code changes automatically if the software is modified" true_label "Yes" false_label "No" targets { /req/technical/software } }
  field fixed_version_number : boolean { label "Fixed version number" description "Whether the software version number is fixed and cannot be altered" true_label "Yes" false_label "No" targets { /req/technical/software } }
  field remarks : text { label "Remarks" description "Additional observations or notes from the examination" }
  field d31_conformity : array {
    label "OIML D 31 conformity items (R 60-1, 6.1)"
    description "The four D 31 application specifics required for legally relevant software of digital load cells"
    items { object }
    fields {
      field item : enum { enum_values { severity-level { label "Severity level I with validation procedure A declared and examined" } imprint-exception { label "Software identification imprint exception (D 31, 5.1.1) applied, if used" } type-conformity { label "Conformity of manufactured devices to the approved type (D 31, 5.2.5(a))" } verified-update { label "Field update via verified or traced update (D 31, 5.2.6.2/5.2.6.3)" } documentation { label "Software documentation per D 31, 6.1.1" } } }
      field conforms : boolean { true_label "Yes" false_label "No" }
    }
  }
  field overall_result : boolean { label "Overall result" description "PASS if all software requirements are met; FAIL otherwise" required true measurement_method evaluated evaluation { rule "ocl{software_sealed and auto_change_identification_code and fixed_version_number and d31_conformity->forAll(i | i.conforms)}" condition "Software sealed + identification code handling + fixed version + all D 31 items conform" specification_reference "R 60-1, 6.1" } true_label "Pass" false_label "Fail" }
  pass_fail { criteria "" pass_if "ocl{software_sealed and auto_change_identification_code and fixed_version_number and d31_conformity->forAll(i | i.conforms)}" }
}
form r60-3/sec-5.2 {
  name "Suitability Examination"
  description "Suitability for testing examination"
  data_class FormInstance#data
  section "R 60-3, 5.2"
  requirements { /req/technical/mandatory-additional-info }
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.3"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-5.2/table-1"
  conformance_process /conf/examinations/suitability
  field date : date { label "Date of examination" description "Date when the suitability examination was performed" required true }
  field observer : string { label "Observer" description "Name of the person performing the examination" }
  field serial_number : string { label "Serial number" description "Serial number of the load cell under test" required true }
  field suitability_items : array {
    label "Suitability checklist"
    description "Checklist of items verifying the load cell is suitable for type testing"
    items { object }
    targets { /req/technical/mandatory-additional-info }
    fields {
      field item : string { label "Item" description "Description of the suitability check item" }
      field fulfils_requirements : boolean { label "Fulfils requirements" true_label "Yes" false_label "No" }
    }
  }
  field remarks : text { label "Remarks" description "Additional observations or notes from the examination" }
  field overall_result : boolean { label "Overall result" description "PASS if all suitability items are met; FAIL otherwise" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "" pass_if "ocl{overall_result = 'pass'}" }
}
form r60-3/table-6.9 {
  name "Barometric Pressure"
  description "Barometric pressure effects (C_P)"
  data_class FormInstance#data
  header r60-3/header-b
  section "R 60-3, 6.9"
  requirements { /req/metrological/barometric-pressure }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.6.2"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.4"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.6"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.9"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-7"
  calculation_context { dimensions true }
  conformance_process /conf/metrological-tests/barometric-pressure
  field conversion_factor_f : number { label "Conversion factor (f)" definition "Ratio of indication change to load change at 75% of Max. Converts counts to verification units (v)." unit "counts/v" symbol f required true measurement_method computed calculation conversionFactor calculation_bindings { avgIndicationAt75pct: reference_indication_75pct indicationAtDmin: indication_at_dmin n: n_test_intervals} specification_reference "R 60-3, 2.1.2.4" }
  field reference_indication_75pct : number { label "Reference indication at 75%" definition "Average indication at the 75% load point, used to compute f." unit "counts" required true measurement_method direct }
  field indication_at_dmin : number { label "Indication at D_min" definition "Load cell indication at minimum test load (D_min), used to compute f." unit "counts" required true measurement_method direct }
  field n_lc : integer { label "Number of verification intervals (n_LC)" definition "Maximum number of load cell verification intervals n_LC, declared by the manufacturer." symbol nLC required true measurement_method declared specification_reference "R 60-1, 3.5.8" }
  field emax : number { label "Maximum capacity (E_max)" definition "Maximum capacity of the load cell." unit "g, kg, or t" symbol Emax required true measurement_method declared specification_reference "R 60-1, 3.5.5" }
  field emin : number { label "Minimum dead load (E_min)" definition "Minimum dead load of the load cell." unit "g, kg, or t" symbol Emin measurement_method declared specification_reference "R 60-1, 3.5.9" }
  field y : integer { label "Relative v_min (Y)" definition "Ratio of the maximum measuring range to v_min (Y = (E_max - E_min)/v_min)." symbol Y measurement_method declared specification_reference "R 60-1, 3.5.15" }
  field n_test_intervals : number { label "Verification intervals of the tested range (n)" definition "Number of verification intervals of the measuring range under test — (E_max − E_min)/v_min when the test spans the classified range (R 60-3, 2.1.2.4). Input n of the conversion-factor calculation." symbol n measurement_method derived derivation "ocl{(emax - emin) / vmin}" specification_reference "R 60-3, 2.1.2.4" }
  field vmin : number { label "Minimum verification interval (v_min)" definition "The minimum load cell verification interval. The maximum permissible change per kPa equals v_min." unit "g, kg, or t" symbol vmin required true measurement_method declared specification_reference "R 60-1, 5.1.3" }
  field pressure_readings : array {
    label "Barometric pressure readings"
    definition "Minimum dead load output indication at different barometric pressures. Minimum 2 readings at different pressures required."
    items { object }
    min_items 2
    fields {
      field pressure : number { label "Pressure" definition "Barometric pressure at the time of the reading." unit "kPa" required true measurement_method direct }
      field indication : number { label "Indication" definition "Load cell indication at minimum dead load at this barometric pressure." unit "counts" required true measurement_method direct }
      field time : string { label "Time" definition "Absolute time of the reading (HH:MM)." pattern "\\d{2}:\\d{2}" measurement_method direct }
      field change_v : number { label "Change (v)" definition "Change in indication from the prior pressure reading, divided by f, in verification units." unit "v" symbol CP measurement_method derived derivation "ocl{if $index = 0 then 0 else (indication - $prev.indication) / conversion_factor_f endif}" specification_reference "R 60-3, 2.1.6" }
      field delta_p : number { label "Pressure step (ΔP)" definition "Pressure span of this step (P_2 − P_1). The baseline row carries 1 kPa — inert, since its C_P is 0 — so the canonical verdict derivation is defined on every row." unit "kPa" symbol delta_p measurement_method derived derivation "ocl{if $index = 0 then 1 else abs(pressure - $prev.pressure) endif}" specification_reference "R 60-3, 2.1.6" }
      field change_per_kpa : number { label "Change (v_min/kPa)" definition "Pressure-induced change normalized per kPa and converted to v_min units via (E_max − E_min)/n_LC — the canonical barometric_normalized verdict quantity." unit "v_min/kPa" symbol CP-vmin verdict barometric_normalized measurement_method derived specification_reference "R 60-3, 2.1.6" }
      field mpc : number { label "MPC (v_min/kPa)" definition "Maximum permissible change per kPa = 1 v_min per kPa (R 60-1, 5.6.2)." unit "v_min/kPa" measurement_method declared derivation "ocl{1}" specification_reference "R 60-1, 5.6.2" }
      field within_mpc : boolean { label "Within MPC" definition "Evaluation: whether the pressure-induced change per kPa is within the MPC." measurement_method evaluated evaluation { rule "" verdict barometric_normalized op lte limit "ocl{1}" condition "|C_P(v_min/kPa)| <= 1 v_min per kPa" specification_reference "R 60-1, 5.6.2" } true_label "Yes" false_label "No" }
    }
  }
  field overall_result : boolean { label "Overall result" definition "PASS iff all barometric pressure effects are within MPC." required true measurement_method evaluated evaluation { rule "ocl{pressure_readings->forAll(r | r.within_mpc)}" condition "All |C_P| per kPa <= 1 v_min" specification_reference "R 60-1, 5.6.2" } true_label "Pass" false_label "Fail" }
  pass_fail { criteria "C_P(v_min) <= 1 v_min per 1 kPa" pass_if "ocl{pressure_readings->forAll(r | r.within_mpc)}" }
}
form r60-3/form-6.14 {
  name "Bursts"
  description "Bursts (electrical fast transients) test - power supply lines and I/O circuits"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.14"
  requirements { /req/electronic/disturbances }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.6"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.4"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.4.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.4.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.14"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.14.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.14.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-17"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-18"
  conformance_process /conf/electronic-tests/bursts
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" required true targets { /req/electronic/disturbances } }
  field dmin_value : number { label "Dmin Value" unit "g, kg, or t" targets { /req/electronic/disturbances } }
  field power_supply_lines : array {
    label "Power Supply Lines"
    description "Form 6.14.1 - power supply lines, test voltage 2 kV, 1 min each polarity"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field test_load : number { label "Test Load" unit "g, kg, or t" }
      field connection : enum { label "Connection" values { L_ground { label "L_ground" } N_ground { label "N_ground" } PE_ground { label "PE_ground" } } }
      field polarity : enum { label "Polarity" values { positive { label "Positive" } negative { label "Negative" } } }
      field indication_without_disturbance : number { label "Indication Without Disturbance" unit "counts" measurement_method direct }
      field indication : number { label "Indication" unit "counts" }
      field difference : number { label "Difference" unit "v" calculation "ocl{(indication - indication_without_disturbance) / conversion_factor_f}" }
      field significant_fault : boolean { label "Significant Fault" calculation "ocl{abs(difference) > 1}" true_label "Yes" false_label "No" }
      field remarks : string { label "Remarks" }
    }
  }
  field io_circuits : array {
    label "Io Circuits"
    description "Form 6.14.2 - I/O circuits and communications lines"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field test_load : number { label "Test Load" unit "g, kg, or t" }
      field cable_interface : string { label "Cable Interface" }
      field polarity : enum { label "Polarity" values { positive { label "Positive" } negative { label "Negative" } } }
      field indication_without_disturbance : number { label "Indication Without Disturbance" unit "counts" measurement_method direct }
      field indication : number { label "Indication" unit "counts" }
      field difference : number { label "Difference" unit "v" calculation "ocl{(indication - indication_without_disturbance) / conversion_factor_f}" }
      field significant_fault : boolean { label "Significant Fault" calculation "ocl{abs(difference) > 1}" true_label "Yes" false_label "No" }
      field remarks : string { label "Remarks" }
    }
  }
  field equipment_used : text { label "Equipment Used" }
  field remarks : text { label "Remarks" }
  field overall_result : boolean { label "Overall Result" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "No significant fault (> v_min) or fault detected and acted upon" pass_if "ocl{power_supply_lines->forAll(r | not r.significant_fault) and io_circuits->forAll(r | not r.significant_fault)}" }
}
form r60-3/form-6.18 {
  name "Conducted EMC"
  description "Immunity to conducted electromagnetic fields test"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.18"
  requirements { /req/electronic/disturbances }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.10"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.8"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.8.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.8.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.8.3"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.8.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.18"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.18.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-24"
  conformance_process /conf/electronic-tests/conducted-emc
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" required true targets { /req/electronic/disturbances } }
  field dmin_value : number { label "Dmin Value" unit "g, kg, or t" targets { /req/electronic/disturbances } }
  field rate_of_sweep : string { label "Rate Of Sweep" targets { /req/electronic/disturbances } }
  field test_load : number { label "Test Load" targets { /req/electronic/disturbances } }
  field test_load_material : string { label "Test Load Material" targets { /req/electronic/disturbances } }
  field test_conditions : object {
    label "Test Conditions"
    targets { /req/electronic/disturbances }
    fields {
      field output_gained_method : enum { label "Output Gained Method" values { actual_loads { label "Actual_loads" } simulating_loading { label "Simulating_loading" } } }
      field simulating_using : string { label "Simulating Using" }
      field frequency_low_mhz : number { label "Frequency Low Mhz" unit "MHz" }
      field frequency_high_mhz : number { label "Frequency High Mhz" unit "MHz" }
      field rf_voltage : number { label "Rf Voltage" unit "V" }
      field cable_exposed : string { label "Cable Exposed" }
      field modulation_pct : number { label "Modulation Pct" unit "%" }
      field dwell_time_s : number { label "Dwell Time S" unit "s" }
    }
  }
  field cycle_phases : array {
    label "Frequency cycle measurements (R 60-3, Table 6.18)"
    description "Per frequency cycle and phase (Initial / During exposure / After) — load, time, reference vs indicated quantity, error, relative error, MPE and result"
    items { object }
    targets { /req/electronic/disturbances }
    fields {
      field phase : string { label "Cycle phase" enum_values { initial during-exposure after } }
      field load : string { label "Load" }
      field time_start : string { label "Time (start)" }
      field time_stop : string { label "Time (stop)" }
      field reference_quantity : number { label "Reference quantity" }
      field indicated_quantity : number { label "Indicated quantity" }
      field error_vmin : number { label "Error [v_min]" unit "v_min" }
      field relative_error_pct : number { label "Relative error [%]" unit "%" }
      field mpe_pct : number { label "MPE [%]" unit "%" }
      field result : string { label "Pass / Fail" enum_values { pass fail } }
    }
  }
  field fault_limit_pct : number { label "Fault limit [%]" description "Declared fault limit for the observed-faults evaluation (R 60-3, Table 6.18)" unit "%" measurement_method declared }
  field has_mains_or_io_ports : boolean { label "Mains supply or I/O ports fitted" description "Whether the load cell has a mains power supply or other input/output port. When false, this test is not applicable (R 60-2, 2.10.7.10; the radiated test of 2.10.7.9 then applies from 26 MHz)." measurement_method declared true_label "Yes" false_label "No" specification_reference "R 60-2, 2.10.7.10" }
  field frequency_cycles : array {
    label "Frequency Cycles"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field frequency : number { label "Frequency" unit "MHz" }
      field fault_deviation : string { label "Fault Deviation" }
      field significant : boolean { label "Significant" true_label "Yes" false_label "No" }
      field acts_on_fault : boolean { label "Acts On Fault" true_label "Yes" false_label "No" }
    }
  }
  field observations : text { label "Observations" }
  field overall_result : boolean { label "Overall Result" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "No significant fault or fault detected and acted upon" pass_if "ocl{frequency_cycles->forAll(c | not c.significant) or frequency_cycles->forAll(c | c.acts_on_fault)}" }
}
form r60-3/table-6.8 {
  name "Creep DR"
  description "Creep (C_C) and minimum dead load output return (C_DR)"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.8"
  requirements { /req/metrological/creep /req/metrological/creep-20-30 /req/metrological/dr }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.5.1"
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.5.2"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.2"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.3"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.5"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.5.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.5.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.8"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-6"
  calculation_context { dimensions true tables { mpe_tiers } }
  conformance_process { /conf/metrological-tests/creep /conf/metrological-tests/dr }
  field conversion_factor_f : number { label "Conversion factor (f)" definition "Ratio of indication change to load change at 75% of Max. Converts counts to verification units (v)." unit "counts/v" symbol f required true measurement_method computed calculation conversionFactor calculation_bindings { avgIndicationAt75pct: reference_indication_75pct indicationAtDmin: indication_at_dmin n: n_test_intervals} specification_reference "R 60-3, 2.1.2.4" }
  field reference_indication_75pct : number { label "Reference indication at 75%" definition "Average indication at the 75% load point, used to compute f." unit "counts" required true measurement_method direct }
  field indication_at_dmin : number { label "Indication at D_min" definition "Load cell indication at minimum test load (D_min) used to compute f." unit "counts" required true measurement_method direct }
  field n_lc : integer { label "Number of verification intervals (n_LC)" definition "Maximum number of load cell verification intervals n_LC, declared by the manufacturer." symbol nLC required true measurement_method declared specification_reference "R 60-1, 3.5.8" }
  field y : integer { label "Relative v_min (Y)" definition "Ratio of the maximum measuring range to v_min (Y = (E_max - E_min)/v_min)." symbol Y measurement_method declared specification_reference "R 60-1, 3.5.15" }
  field emax : number { label "Maximum capacity (E_max)" definition "Maximum capacity of the load cell." unit "g, kg, or t" symbol Emax required true measurement_method declared specification_reference "R 60-1, 3.5.5" }
  field emin : number { label "Minimum dead load (E_min)" definition "Minimum dead load of the load cell." unit "g, kg, or t" symbol Emin measurement_method declared specification_reference "R 60-1, 3.5.9" }
  field vmin : number { label "Minimum verification interval (v_min)" definition "Minimum load cell verification interval." unit "g, kg, or t" symbol vmin required true measurement_method declared specification_reference "R 60-1, 3.5.11" }
  field n_test_intervals : number { label "Verification intervals of the tested range (n)" definition "Number of verification intervals of the measuring range under test — (E_max − E_min)/v_min when the test spans the classified range (R 60-3, 2.1.2.4). Input n of the conversion-factor calculation." symbol n measurement_method derived derivation "ocl{(emax - emin) / vmin}" specification_reference "R 60-3, 2.1.2.4" }
  field dmin : number { label "Minimum test load (D_min)" definition "The minimum test load (dead load) applied during the creep test." unit "g, kg, or t" symbol Dmin required true measurement_method declared }
  field dmax : number { label "Maximum test load (D_max)" definition "The maximum test load applied during the creep test." unit "g, kg, or t" symbol Dmax required true measurement_method declared }
  field initial_dmin_indication : number { label "Initial D_min indication" definition "The load cell indication (counts) at D_min before the creep load is applied. Reference point for DR calculation." unit "counts" measurement_method direct }
  field initial_dmax_indication : number { label "Initial D_max indication" definition "The load cell indication (counts) at D_max immediately after loading. Reference point for creep calculation." unit "counts" measurement_method direct }
  field creep_readings : array {
    label "Creep readings"
    definition "Time-series indication readings during the creep test at D_max (and D_min). Creep is the change in indication over time under constant load."
    items { object }
    series { axis elapsed_min { unit "min" role time } cell { symbol change_v unit "v" } }
    fields {
      field test_load : string { label "Test load" definition "The load applied at this reading point: D_min or D_max." measurement_method declared }
      field indication_counts : number { label "Indication (counts)" definition "Load cell indication reading at this time point." unit "counts" measurement_method direct }
      field elapsed_min : number { label "Elapsed time (min)" definition "Time elapsed since the initial D_max loading, in minutes. The numeric time axis of the series — verdicts address readings by it (t = 20, t = 30 per R 60-3, 2.1.5.2), never by string matching or by extreme value." unit "min" measurement_method direct specification_reference "R 60-3, 2.1.5.2" }
      field indication_time : string { label "Indication time" definition "Absolute time of the reading (HH:MM:SS)." pattern "\\d{2}:\\d{2}:\\d{2}" measurement_method direct }
      field barometric_pressure : number { label "Barometric pressure" definition "Atmospheric pressure at time of reading, for correction if needed." unit "kPa" measurement_method direct }
      field change_v : number { label "Creep change (v)" definition "Change in indication from the initial D_max loading, divided by f, in verification units." unit "v" symbol CC measurement_method derived calculation creep calculation_bindings { indicationAtTime: indication_counts initialIndication: initial_dmax_indication conversion_factor_f: conversion_factor_f} specification_reference "R 60-3, 2.1.5" }
      field elapsed_time : string { label "Elapsed time" definition "Time elapsed since the initial D_max loading (mm:ss) — recorded display companion of the numeric elapsed_min axis (verdicts address readings by elapsed_min, never by this string)." measurement_method direct }
    }
  }
  field dr_readings : array {
    label "DR readings"
    definition "Minimum dead load output return measurements after the creep test. DR is the difference between the final and initial D_min indications."
    items { object }
    fields {
      field indication_counts : number { label "Indication (counts)" definition "Load cell indication after returning to D_min." unit "counts" measurement_method direct }
      field indication_time : string { label "Time" definition "Absolute time of DR reading (HH:MM:SS)." pattern "\\d{2}:\\d{2}:\\d{2}" measurement_method direct }
      field barometric_pressure : number { label "Barometric pressure" definition "Atmospheric pressure at time of DR reading." unit "kPa" measurement_method direct }
      field change_v : number { label "DR change (v)" definition "Change from initial D_min indication, divided by f. This is the dead load output return C_DR." unit "v" symbol CDR measurement_method derived calculation deadLoadOutputReturn calculation_bindings { minLoadIndication2: indication_counts minLoadIndication1: initial_dmin_indication conversion_factor_f: conversion_factor_f} specification_reference "R 60-3, 2.1.5.4" }
    }
  }
  field max_creep_change_v : number { label "Maximum creep change (v)" definition "Maximum creep change across all D_max readings in verification units." unit "v" symbol CC measurement_method derived derivation "ocl{creep_readings->collect(r | r.change_v)->max()}" }
  field creep_30min : number { label "Creep at 30 min (v)" definition "Creep change at exactly the 30-minute reading, in verification units." unit "v" symbol CC measurement_method derived derivation "ocl{reading_at(window(creep_readings->select(r | r.test_load = 'D_max'), 'elapsed_min', 20, 30), 'elapsed_min', 30, 'change_v')}" specification_reference "R 60-3, 2.1.5.2" }
  field creep_20min : number { label "Creep at 20 min (v)" definition "Creep change at the 20-minute reading, in verification units." unit "v" symbol CC measurement_method derived derivation "ocl{reading_at(window(creep_readings->select(r | r.test_load = 'D_max'), 'elapsed_min', 20, 30), 'elapsed_min', 20, 'change_v')}" specification_reference "R 60-3, 2.1.5.2" }
  field creep_30_20_diff : number { label "Creep 30-20 difference (v)" definition "Difference between creep at 30 min and 20 min per R 60-3, 2.1.5.2." unit "v" symbol CC-30-20 measurement_method derived derivation "ocl{creep_30min - creep_20min}" specification_reference "R 60-3, 2.1.5.2" }
  field mpe_at_dmax : number { label "MPE at D_max (v), p_LC = 0.7" definition "Maximum permissible error at D_max with p_LC forced to 0.7 for creep evaluation per R 60-1, 5.5.1." unit "v" symbol MPE measurement_method lookup calculation mpe calculation_bindings { load: dmax accuracy_class: accuracy_class p_lc: plc_for_creep} specification_reference "R 60-1, 5.5.1" }
  field plc_for_creep : number { label "Apportionment factor for creep" definition "Apportionment factor fixed at 0.7 for creep MPE evaluation per R 60-1, 5.5.1." measurement_method declared default 0.7 }
  field dr_value : number { label "DR value (v)" definition "Final dead load output return value in verification units." unit "v" symbol CDR measurement_method derived derivation "ocl{dr_readings->collect(r | r.change_v)->last()}" }
  field actual_time_s : number { label "Actual test duration" definition "Duration of the creep test in seconds." unit "s" measurement_method direct }
  field specified_time_s : number { label "Specified test duration" definition "Required test duration per R 60-2 in seconds." unit "s" measurement_method declared specification_reference "R 60-2, 2.10.2" }
  field mpe_for_dr : number { label "MPE for DR" definition "Maximum permissible error for DR evaluation = 0.5 v." unit "v" measurement_method declared specification_reference "R 60-1, 5.5.2" }
  field creep_30min_result : boolean { label "30-min creep result" definition "Whether the total creep over 30 minutes is within 0.7 x |MPE| at D_max." measurement_method evaluated evaluation { rule "ocl{abs(max_creep_change_v) <= 0.7 * abs(mpe_at_dmax)}" condition "|C_C(30 min)| <= 0.7 x |MPE|" specification_reference "R 60-1, 5.5.1" } true_label "Pass" false_label "Fail" }
  field creep_20_30_result : boolean { label "20-30 min creep result" definition "Whether the creep change between 20 and 30 minutes is within 0.15 x |MPE|." measurement_method evaluated evaluation { rule "ocl{abs(creep_30min - creep_20min) <= 0.15 * abs(mpe_at_dmax)}" condition "|C_C(30-20)| <= 0.15 x |MPE|" specification_reference "R 60-1, 5.5.1" } true_label "Pass" false_label "Fail" }
  field dr_half_v_result : boolean { label "DR <= 0.5 v result" definition "Whether the dead load output return does not exceed 0.5 v." measurement_method evaluated evaluation { rule "ocl{if actual_time_s / specified_time_s <= 1 then abs(dr_value) <= 0.5 else abs(dr_value) <= 0.5 * (1 - (actual_time_s / specified_time_s - 1)) endif}" condition "|C_DR| <= 0.5(1 - (x-1)) v with x = actual time/specified time (relaxed rule for 100-150 % loading times, R 60-3, 2.1.5.6)" specification_reference "R 60-3, 2.1.5.6" } true_label "Pass" false_label "Fail" }
  field dr_within_manuf_spec_result : boolean { label "DR within manufacturer spec" definition "Whether DR is within the manufacturer's specified DR value (if different from 0.5 v) — assessed by the evaluator against the declared group DR; no machine-computable rule (the declared DR is a group-level characteristic outside this form's sample scope)." measurement_method declared true_label "Pass" false_label "Fail" }
  pass_fail { criteria "30-min creep C_C(t) <= 0.7 * |MPE|; 20-30 min difference C_C(30-20) <= 0.15 * |MPE|; C_DR <= 0.5 v (if time intervals met)" pass_if "ocl{creep_30min_result and creep_20_30_result and dr_half_v_result}" }
}
form r60-3/form-6.17 {
  name "EMC Susceptibility"
  description "Electromagnetic susceptibility test"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.17"
  requirements { /req/electronic/disturbances }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.9"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.7"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.7.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.7.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.7.3"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.7.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.17"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.17.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.17.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-23"
  conformance_process /conf/electronic-tests/emc-susceptibility
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" required true targets { /req/electronic/disturbances } }
  field dmin_value : number { label "Dmin Value" unit "g, kg, or t" targets { /req/electronic/disturbances } }
  field rate_of_sweep : string { label "Rate Of Sweep" targets { /req/electronic/disturbances } }
  field test_load : number { label "Test Load" unit "g, kg, or t" targets { /req/electronic/disturbances } }
  field test_load_material : string { label "Test Load Material" targets { /req/electronic/disturbances } }
  field without_disturbance : object {
    label "Without Disturbance"
    targets { /req/electronic/disturbances }
    fields {
      field indication : number { label "Indication" unit "counts" }
      field difference : number { label "Difference" unit "v" }
    }
  }
  field disturbance_results : array {
    label "Disturbance Results"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field antenna : string { label "Antenna" }
      field frequency_range_mhz : string { label "Frequency Range Mhz" description "e.g. 80-3000 MHz" }
      field polarisation : enum { label "Polarisation" values { vertical { label "Vertical" } horizontal { label "Horizontal" } } }
      field facing : enum { label "Facing" values { front { label "Front" } right { label "Right" } left { label "Left" } rear { label "Rear" } } }
      field indication : number { label "Indication" unit "counts" }
      field difference : number { label "Difference" unit "v" calculation "ocl{(indication - without_disturbance.indication) / conversion_factor_f}" }
      field significant_fault : boolean { label "Significant Fault" calculation "ocl{abs(difference) > 1}" true_label "Yes" false_label "No" }
      field remarks : string { label "Remarks" }
    }
  }
  field test_setup_description : text { label "Test Setup Description" description "Form 6.17.2 - description of test setup" targets { /req/electronic/disturbances } }
  field remarks : text { label "Remarks" }
  field overall_result : boolean { label "Overall Result" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "No significant fault (> v_min)" pass_if "ocl{disturbance_results->forAll(r | not r.significant_fault)}" }
}
form r60-3/form-6.16 {
  name "ESD"
  description "Electrostatic discharge test - direct and indirect application"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.16"
  requirements { /req/electronic/disturbances }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.8"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.6"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.6.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.6.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.6.3"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.6.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.16"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.16.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.16.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.16.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-20"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-21"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-22"
  conformance_process /conf/electronic-tests/esd
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" required true targets { /req/electronic/disturbances } }
  field dmin_value : number { label "Dmin Value" unit "g, kg, or t" targets { /req/electronic/disturbances } }
  field discharge_types : object {
    label "Discharge Types"
    targets { /req/electronic/disturbances }
    fields {
      field contact_discharges : boolean { label "Contact Discharges" true_label "Yes" false_label "No" }
      field paint_penetration : boolean { label "Paint Penetration" true_label "Yes" false_label "No" }
      field air_discharges : boolean { label "Air Discharges" true_label "Yes" false_label "No" }
      field polarity : enum { label "Polarity" values { positive { label "Positive" } negative { label "Negative" } } }
    }
  }
  field direct_application : array {
    label "Direct Application"
    description "Form 6.16.1 - direct application"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field test_load : number { label "Test Load" unit "g, kg, or t" }
      field test_voltage_kv : number { label "Test Voltage Kv" unit "kV" }
      field no_of_discharges : integer { label "No Of Discharges" description ">= 10" }
      field repetition_interval_s : number { label "Repetition Interval S" unit "s" }
      field indication_without : number { label "Indication Without Disturbance" unit "counts" measurement_method direct }
      field indication : number { label "Indication" unit "counts" }
      field difference : number { label "Difference" unit "v" calculation "ocl{(indication - indication_without) / conversion_factor_f}" }
      field significant_fault : boolean { label "Significant Fault" calculation "ocl{abs(difference) > 1}" true_label "Yes" false_label "No" }
      field remarks : string { label "Remarks" }
    }
  }
  field horizontal_coupling_plane : array {
    label "Horizontal Coupling Plane"
    description "Form 6.16.2.1 - horizontal coupling plane"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field test_load : number { label "Test Load" unit "g, kg, or t" }
      field test_voltage_kv : number { label "Test Voltage Kv" unit "kV" }
      field no_of_discharges : integer { label "No Of Discharges" }
      field repetition_interval_s : number { label "Repetition Interval S" unit "s" }
      field indication_without : number { label "Indication Without Disturbance" unit "counts" measurement_method direct }
      field indication : number { label "Indication" unit "counts" }
      field difference : number { label "Difference" unit "v" calculation "ocl{(indication - indication_without) / conversion_factor_f}" }
      field significant_fault : boolean { label "Significant Fault" calculation "ocl{abs(difference) > 1}" true_label "Yes" false_label "No" }
      field remarks : string { label "Remarks" }
    }
  }
  field vertical_coupling_plane : array {
    label "Vertical Coupling Plane"
    description "Form 6.16.2.2 - vertical coupling plane"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field test_load : number { label "Test Load" unit "g, kg, or t" }
      field test_voltage_kv : number { label "Test Voltage Kv" unit "kV" }
      field no_of_discharges : integer { label "No Of Discharges" }
      field repetition_interval_s : number { label "Repetition Interval S" unit "s" }
      field indication_without : number { label "Indication Without Disturbance" unit "counts" measurement_method direct }
      field indication : number { label "Indication" unit "counts" }
      field difference : number { label "Difference" unit "v" calculation "ocl{(indication - indication_without) / conversion_factor_f}" }
      field significant_fault : boolean { label "Significant Fault" calculation "ocl{abs(difference) > 1}" true_label "Yes" false_label "No" }
      field remarks : string { label "Remarks" }
    }
  }
  field test_points : object {
    label "Test Points"
    description "Form 6.16.3 - specification of test points"
    targets { /req/electronic/disturbances }
    fields {
      field direct_contact_discharges : text { label "Direct Contact Discharges" }
      field direct_air_discharges : text { label "Direct Air Discharges" }
      field indirect_application : text { label "Indirect Application" }
    }
  }
  field remarks : text { label "Remarks" }
  field overall_result : boolean { label "Overall Result" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "No significant fault (> v_min)" pass_if "ocl{direct_application->forAll(r | not r.significant_fault) and horizontal_coupling_plane->forAll(r | not r.significant_fault) and vertical_coupling_plane->forAll(r | not r.significant_fault)}" }
}
form r60-3/table-6.10.1 {
  name "Humidity CH"
  description "Humidity effects for CH or unmarked load cells"
  data_class FormInstance#data
  header r60-3/header-b
  section "R 60-3, 6.10.1"
  requirements { /req/metrological/humidity-ch }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.6.3"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.5"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.7"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.7.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.1.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.2.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.5"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.5.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-8"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-9"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-10"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-11"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-12"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-13"
  calculation_context { dimensions true tables { mpe_tiers } }
  conformance_process /conf/metrological-tests/humidity-ch
  field conversion_factor_f : number { label "Conversion Factor F" definition "Ratio of indication change to load change at 75% of Max. Converts counts to verification units (v)." unit "counts/v" symbol f required true measurement_method computed calculation conversionFactor calculation_bindings { avgIndicationAt75pct: reference_indication_75pct indicationAtDmin: indication_at_dmin n: n_test_intervals} specification_reference "R 60-3, 2.1.2.4" }
  field reference_indication_75pct : number { label "Reference indication at 75%" definition "Average indication at the 75% load point, used to compute f." unit "counts" required true measurement_method direct }
  field indication_at_dmin : number { label "Indication at D_min" definition "Load cell indication at minimum test load (D_min), used to compute f." unit "counts" required true measurement_method direct }
  field nlc : integer { label "Maximum number of verification intervals (n_LC)" definition "The maximum number of load cell verification intervals. Required for computing C_Hmin limit." symbol nLC required true measurement_method declared specification_reference "R 60-1, 5.1.3" }
  field y : integer { label "Relative v_min (Y)" definition "Ratio of the maximum measuring range to v_min (Y = (E_max - E_min)/v_min)." symbol Y measurement_method declared specification_reference "R 60-1, 3.5.15" }
  field emax : number { label "Maximum capacity (E_max)" definition "Maximum capacity of the load cell." unit "g, kg, or t" symbol Emax required true measurement_method declared specification_reference "R 60-1, 3.5.5" }
  field emin : number { label "Minimum dead load (E_min)" definition "Minimum dead load of the load cell." unit "g, kg, or t" symbol Emin measurement_method declared specification_reference "R 60-1, 3.5.9" }
  field vmin : number { label "Minimum verification interval (v_min)" definition "Minimum load cell verification interval." unit "g, kg, or t" symbol vmin required true measurement_method declared specification_reference "R 60-1, 3.5.11" }
  field n_test_intervals : number { label "Verification intervals of the tested range (n)" definition "Number of verification intervals of the measuring range under test — (E_max − E_min)/v_min when the test spans the classified range (R 60-3, 2.1.2.4). Input n of the conversion-factor calculation." symbol n measurement_method derived derivation "ocl{(emax - emin) / vmin}" specification_reference "R 60-3, 2.1.2.4" }
  field plc : number { label "Apportionment factor (p_LC)" definition "Apportionment factor applied to MPE. Default 0.7." symbol pLC measurement_method declared default 0.7 specification_reference "R 60-1, 3.7.2" }
  field dmin : number { label "Minimum test load (D_min)" definition "Minimum test load applied during the humidity test." unit "g, kg, or t" symbol Dmin required true measurement_method declared }
  field dmax : number { label "Maximum test load (D_max)" definition "Maximum test load applied during the humidity test." unit "g, kg, or t" symbol Dmax required true measurement_method declared }
  field summary : object {
    label "Humidity Effects Summary"
    definition "Table 6.10.1(a): comparison of indications before and after humidity exposure."
    fields {
      field test_loads : array {
        label "Per-load-point readings"
        definition "Indication readings at each test load, before and after humidity exposure."
        items { object }
        fields {
          field test_load : number { label "Test Load" definition "Applied test load at this measurement point." unit "g, kg, or t" measurement_method direct }
          field indication_before : number { label "Indication Before" definition "Load cell indication at this load before humidity exposure." unit "counts" measurement_method direct }
          field time_before : string { label "Time Before" definition "Time of before-humidity reading." measurement_method direct }
          field indication_after : number { label "Indication After" definition "Load cell indication at this load after humidity exposure." unit "counts" measurement_method direct }
          field time_after : string { label "Time After" definition "Time of after-humidity reading." measurement_method direct }
          field change_v : number { label "Change V" definition "Change in indication due to humidity exposure, in verification units." unit "v" measurement_method derived derivation "ocl{(indication_after - indication_before) / conversion_factor_f}" specification_reference "R 60-3, 2.1.7" }
          field mpc_v : number { label "MPC V" definition "Maximum permissible change at this load point (MPE at the applied load, R 60-1, Table 4)." unit "v" measurement_method lookup calculation mpe calculation_bindings { load: test_load accuracy_class: accuracy_class p_lc: plc} }
        }
      }
      field avg_indication_dmin_before : number { label "Avg Indication Dmin Before" definition "Average indication at D_min before humidity exposure." unit "counts" measurement_method derived derivation "ocl{test_loads->select(r | r.test_load = dmin)->collect(r | r.indication_before)->average()}" }
      field avg_indication_dmin_after : number { label "Avg Indication Dmin After" definition "Average indication at D_min after humidity exposure." unit "counts" measurement_method derived derivation "ocl{test_loads->select(r | r.test_load = dmin)->collect(r | r.indication_after)->average()}" }
      field chmin : number { label "C_Hmin" definition "Humidity effect on minimum test load indication: (avg_after - avg_before) / f, in verification units." unit "v" symbol CHmin measurement_method derived calculation humidityCHmin calculation_bindings { indDminAfter: avg_indication_dmin_after indDminBefore: avg_indication_dmin_before conversion_factor_f: conversion_factor_f} specification_reference "R 60-3, 2.1.7.1" }
      field chmin_limit : number { label "C_Hmin Limit (4% Y)" definition "Maximum permissible humidity effect on minimum test load: 4% of the (E_max - E_min) output, i.e. 0.04·Y in v units (R 60-1, 5.6.3)." unit "v" measurement_method computed derivation "ocl{0.04 * y}" specification_reference "R 60-1, 5.6.3" }
      field chmin_result : boolean { label "C_Hmin Result" definition "Evaluation: whether |C_Hmin| is within the 4% n_LC limit." measurement_method evaluated evaluation { rule "ocl{abs(chmin) <= chmin_limit}" condition "|C_Hmin| <= 4% * Y" specification_reference "R 60-1, 5.6.3.1" } true_label "Pass" false_label "Fail" }
      field avg_indication_dmax_before : number { label "Avg Indication Dmax Before" definition "Average indication at D_max before humidity exposure." unit "counts" measurement_method derived derivation "ocl{test_loads->select(r | r.test_load = dmax)->collect(r | r.indication_before)->average()}" }
      field avg_indication_dmax_after : number { label "Avg Indication Dmax After" definition "Average indication at D_max after humidity exposure." unit "counts" measurement_method derived derivation "ocl{test_loads->select(r | r.test_load = dmax)->collect(r | r.indication_after)->average()}" }
      field chmax : number { label "C_Hmax" definition "Humidity effect on the span: change in the difference (D_max - D_min) indication due to humidity exposure, in verification units." unit "v" symbol CHmax measurement_method derived calculation humidityCHmax calculation_bindings { avgDmaxAfter: avg_indication_dmax_after avgDminAfter: avg_indication_dmin_after avgDmaxBefore: avg_indication_dmax_before avgDminBefore: avg_indication_dmin_before conversion_factor_f: conversion_factor_f} specification_reference "R 60-3, 2.1.7" }
      field chmax_limit : number { label "C_Hmax Limit (1 v)" definition "Maximum permissible humidity effect on maximum load: one load cell verification interval (R 60-1, 5.6.3)." unit "v" symbol MPE measurement_method declared default 1 specification_reference "R 60-1, 5.6.3" source_discrepancy { summary "R 60-3, 2.1.7 states the max-load humidity effect limit as ≤ MPE, contradicting R 60-1, 5.6.3.1 (≤ 1 v)" sources { "urn:oiml:pub:r:60-1:2021#clause-5.6.3.1" "urn:oiml:pub:r:60-3:2021#clause-2.1.7" } resolution follows_clause_x rationale "This form follows the normative Part 1 limit of 1 v, which R 60-3's own Table 6.10.1-a mpc column (= 1) confirms; only R 60-3, 2.1.7 prose states ≤ MPE. See analysis/deep-audit-r60.md F5." } }
      field chmax_result : boolean { label "C_Hmax Result" definition "Evaluation: whether |C_Hmax| is within |MPE|." measurement_method evaluated evaluation { rule "ocl{abs(chmax) <= abs(chmax_limit)}" condition "|C_Hmax| <= |MPE|" specification_reference "R 60-1, 5.6.3" } true_label "Pass" false_label "Fail" }
    }
  }
  field load_test_before : array { subform_ref load-test-row { } label "Load test before humidity exposure" definition "R 60-3 table 6.10.1(b) for classes C/D, 6.10.1(d) for classes A/B. Load test data taken before humidity exposure. n_runs resolves at runtime from the active accuracy_class via the conformance test's instances: 3 for C/D, 5 for A/B (static shape: C/D)." }
  field load_test_after : array { subform_ref load-test-row { } label "Load test after humidity exposure" definition "R 60-3 table 6.10.1(c) for classes C/D, 6.10.1(e) for classes A/B. Load test data taken after humidity exposure. n_runs resolves at runtime from the active accuracy_class via the conformance test's instances: 3 for C/D, 5 for A/B (static shape: C/D)." }
  field overall_result : boolean { label "Overall Result" definition "PASS iff both C_Hmin and C_Hmax evaluations pass." required true measurement_method evaluated evaluation { rule "ocl{summary.chmin_result and summary.chmax_result}" condition "C_Hmin <= 4% * Y AND C_Hmax <= 1 v (R 60-1, 5.6.3)" specification_reference "R 60-1, 5.6.3" } true_label "Pass" false_label "Fail" }
  pass_fail { criteria "C_Hmin <= 4% of (E_max - E_min) output; C_Hmax <= 1 v (R 60-1, 5.6.3)" pass_if "ocl{summary.chmin_result and summary.chmax_result}" }
}
form r60-3/table-6.10.2 {
  name "Humidity SH"
  description "Humidity effects for SH marked load cells"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.10.2"
  requirements { /req/metrological/humidity-sh }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.6.3.2"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.6"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.8"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.5"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.10.5.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-13"
  calculation_context { dimensions true tables { mpe_tiers } }
  conformance_process /conf/metrological-tests/humidity-sh
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" symbol f required true measurement_method computed calculation conversionFactor calculation_bindings { avgIndicationAt75pct: reference_indication_75pct indicationAtDmin: indication_at_dmin n: n_test_intervals} targets { /req/metrological/humidity-sh } }
  field reference_indication_75pct : number { label "Reference indication at 75%" unit "counts" required true measurement_method direct }
  field indication_at_dmin : number { label "Indication at D_min" unit "counts" required true measurement_method direct }
  field dmin : number { label "Minimum test load (D_min)" unit "g, kg, or t" symbol Dmin required true measurement_method declared }
  field dmax : number { label "Maximum test load (D_max)" unit "g, kg, or t" symbol Dmax required true measurement_method declared }
  field nlc : integer { label "Number of verification intervals (n_LC)" symbol nLC required true measurement_method declared }
  field y : integer { label "Relative v_min (Y)" definition "Ratio of the maximum measuring range to v_min (Y = (E_max - E_min)/v_min)." symbol Y measurement_method declared specification_reference "R 60-1, 3.5.15" }
  field emax : number { label "Maximum capacity (E_max)" definition "Maximum capacity of the load cell." unit "g, kg, or t" symbol Emax required true measurement_method declared specification_reference "R 60-1, 3.5.5" }
  field emin : number { label "Minimum dead load (E_min)" definition "Minimum dead load of the load cell." unit "g, kg, or t" symbol Emin measurement_method declared specification_reference "R 60-1, 3.5.9" }
  field vmin : number { label "Minimum verification interval (v_min)" definition "Minimum load cell verification interval." unit "g, kg, or t" symbol vmin required true measurement_method declared specification_reference "R 60-1, 3.5.11" }
  field n_test_intervals : number { label "Verification intervals of the tested range (n)" definition "Number of verification intervals of the measuring range under test — (E_max − E_min)/v_min when the test spans the classified range (R 60-3, 2.1.2.4). Input n of the conversion-factor calculation." symbol n measurement_method derived derivation "ocl{(emax - emin) / vmin}" specification_reference "R 60-3, 2.1.2.4" }
  field plc : number { label "Apportionment factor (p_LC)" symbol pLC measurement_method declared default 0.7 }
  field page_load_test_before : string { label "Page of Load Test Before Humidity" }
  field page_load_test_during : string { label "Page of Load Test During Humidity" }
  field page_load_test_after : string { label "Page of Load Test After Humidity" }
  field test_loads : array {
    label "Test Loads"
    items { object }
    targets { /req/metrological/humidity-sh }
    fields {
      field test_load : number { label "Test Load" unit "g, kg, or t" required true }
      field reference_indication : number { label "Reference Indication" unit "counts" symbol Ri measurement_method computed calculation referenceIndication calculation_bindings { testLoad: test_load d_min: dmin d_max: dmax n: n_test_intervals conversion_factor_f: conversion_factor_f} }
      field condition_20c_50rh : object {
        label "Reference (20 degC or range mean) / 50 % RH"
        fields {
          field temperature : number { label "Temperature" unit "degC" }
          field humidity : number { label "Humidity" unit "%" }
          field indication : number { label "Indication" unit "counts" }
          field error_EL : number { label "Error (E_L)" unit "v" symbol EL measurement_method derived calculation loadCellError calculation_bindings { avgIndication: indication referenceIndication: reference_indication conversion_factor_f: conversion_factor_f} }
        }
      }
      field condition_high_85rh : object {
        label "High temp of range / 85 % RH (48 h)"
        fields {
          field temperature : number { label "Temperature" unit "degC" }
          field humidity : number { label "Humidity" unit "%" }
          field indication : number { label "Indication" unit "counts" }
          field error_EL : number { label "Error (E_L)" unit "v" symbol EL measurement_method derived calculation loadCellError calculation_bindings { avgIndication: indication referenceIndication: reference_indication conversion_factor_f: conversion_factor_f} }
        }
      }
      field condition_20c_return : object {
        label "Reference (20 degC or range mean) Return"
        fields {
          field temperature : number { label "Temperature" unit "degC" }
          field humidity : number { label "Humidity" unit "%" }
          field indication : number { label "Indication" unit "counts" }
          field error_EL : number { label "Error (E_L)" unit "v" symbol EL measurement_method derived calculation loadCellError calculation_bindings { avgIndication: indication referenceIndication: reference_indication conversion_factor_f: conversion_factor_f} }
        }
      }
      field mpe : number { label "MPE" unit "v" symbol MPE measurement_method lookup calculation mpe calculation_bindings { load: test_load accuracy_class: accuracy_class p_lc: plc} }
    }
  }
  field overall_result : boolean { label "Overall Result" required true measurement_method evaluated evaluation { rule "ocl{test_loads->forAll(l | abs(l.condition_20c_50rh.error_EL) <= abs(l.mpe) and abs(l.condition_high_85rh.error_EL) <= abs(l.mpe) and abs(l.condition_20c_return.error_EL) <= abs(l.mpe))}" condition "All |E_L| <= |MPE| at all humidity conditions" specification_reference "R 60-1, 5.6.3" } true_label "Pass" false_label "Fail" }
  pass_fail { criteria "All |E_L| <= |MPE| at all humidity conditions" pass_if "ocl{test_loads->forAll(l | abs(l.condition_20c_50rh.error_EL) <= abs(l.mpe) and abs(l.condition_high_85rh.error_EL) <= abs(l.mpe) and abs(l.condition_20c_return.error_EL) <= abs(l.mpe))}" }
}
form r60-3/sec-6.2 {
  name "Initial Tests"
  description "Initial tests and general notes — units, measurement range, conditions, input impedance"
  data_class FormInstance#data
  section "R 60-3, 6.2"
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.2"
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.5.2"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.8.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.2.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.2.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.2.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.2.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.2.1/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.2.2/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.2.3/table-1"
  field test_units : array {
    label "Units used for measurement results"
    description "Unit (e.g. counts, digits, g, kg, t) in which the measurement result is displayed"
    default "[{\"r60_reference\":\"2.10.1\",\"test_procedure\":\"Measurement error, repeatability error and temperature effect on minimum dead load output\"},{\"r60_reference\":\"2.10.2\",\"test_procedure\":\"Determination of creep error\"},{\"r60_reference\":\"2.10.3\",\"test_procedure\":\"Minimum dead load output return (DR)\"},{\"r60_reference\":\"2.10.4\",\"test_procedure\":\"Barometric pressure effects (Atmospheric pressure)\"},{\"r60_reference\":\"2.10.5\",\"test_procedure\":\"Humidity effects for load cells marked with CH or no mark\"},{\"r60_reference\":\"2.10.6\",\"test_procedure\":\"Humidity effects for load cells marked SH\"},{\"r60_reference\":\"2.10.7\",\"test_procedure\":\"Additional tests for analogue-active cells\"}]"
    items { object }
    fields {
      field r60_reference : string { label "R 60-2 reference" }
      field test_procedure : string { label "Test procedure" }
      field unit : string { label "Unit" }
    }
  }
  field measurement_range : array {
    label "Measurement range"
    description "D_max, D_min, and conversion factor for each test procedure"
    default "[{\"test_procedure_ref\":\"2.10.1\"},{\"test_procedure_ref\":\"2.10.2\"},{\"test_procedure_ref\":\"2.10.3\"},{\"test_procedure_ref\":\"2.10.4\"},{\"test_procedure_ref\":\"2.10.5\"},{\"test_procedure_ref\":\"2.10.6\"},{\"test_procedure_ref\":\"2.10.7\"}]"
    items { object }
    fields {
      field test_procedure_ref : string { label "Test procedure (R 60-2 ref)" }
      field dmax : number { label "D_max" }
      field dmin : number { label "D_min" }
      field conversion_factor_f : number { label "Conversion factor (f)" description "indication / v" }
      field fulfils_requirements : boolean { label "Fulfils requirements" true_label "Yes" false_label "No" }
    }
  }
  field measurement_range_passed : boolean { label "Measurement range passed" true_label "Yes" false_label "No" }
  field conditions_check : array {
    label "Conditions"
    description "Verify v_min <= (D_max - D_min) / n with n = n_LC, n_LC - 500, n_LC - 1000"
    default "[{\"test_procedure_ref\":\"2.10.1\"},{\"test_procedure_ref\":\"2.10.2\"},{\"test_procedure_ref\":\"2.10.3\"},{\"test_procedure_ref\":\"2.10.4\"},{\"test_procedure_ref\":\"2.10.5\"},{\"test_procedure_ref\":\"2.10.6\"},{\"test_procedure_ref\":\"2.10.7\"}]"
    items { object }
    fields {
      field test_procedure_ref : string { label "Test procedure (R 60-2 ref)" }
      field dmin : number { label "D_min" }
      field dmax : number { label "D_max" }
      field nlc : integer { label "n_LC" }
      field check_nlc : boolean { label "Fulfilled with n_LC" true_label "Yes" false_label "No" }
      field check_nlc_500 : boolean { label "Fulfilled with n_LC - 500" true_label "Yes" false_label "No" }
      field check_nlc_1000 : boolean { label "Fulfilled with n_LC - 1000" true_label "Yes" false_label "No" }
    }
  }
  field conditions_passed : boolean { label "Conditions passed" true_label "Yes" false_label "No" }
  field input_impedance : object {
    label "Input impedance"
    description "Measured input impedance compared to specification in R 60-3, 4.5"
    fields {
      field measured_value : number { label "Measured value" unit "Ohm" }
      field specified_value : number { label "Specified value" unit "Ohm" }
      field within_spec : boolean { label "Within specification" true_label "Yes" false_label "No" }
    }
  }
}
form r60-3/table-6.5 {
  name "Load Cell Errors"
  description "Load cell errors (E_L) calculation across four test temperatures"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.5"
  requirements { /req/metrological/mpe }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.3.1"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.1.12"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.2.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.5"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-3"
  calculation_context { dimensions true tables { mpe_tiers } }
  conformance_process /conf/metrological-tests/measurement-error-repeatability-mdlo
  field conversion_factor_f : number { label "Conversion factor (f)" definition "Ratio of the change in indication to the corresponding change in load at 75% of maximum capacity. Converts counts to verification units (v)." unit "counts/v" symbol f required true measurement_method computed calculation conversionFactor calculation_bindings { avgIndicationAt75pct: reference_indication_75pct indicationAtDmin: indication_at_dmin n: n_test_intervals} specification_reference "R 60-3, 2.1.2.4" }
  field indication_at_dmin : number { label "Indication at D_min" definition "Load cell indication at minimum test load (D_min), used as the lower reference point for computing f." unit "counts" required true measurement_method direct }
  field n_lc : integer { label "Number of verification intervals (n_LC)" definition "Maximum number of load cell verification intervals n_LC, declared by the manufacturer." symbol nLC required true measurement_method declared specification_reference "R 60-1, 3.5.8" }
  field y : integer { label "Relative v_min (Y)" definition "Ratio of the maximum measuring range to v_min (Y = (E_max - E_min)/v_min)." symbol Y measurement_method declared specification_reference "R 60-1, 3.5.15" }
  field emax : number { label "Maximum capacity (E_max)" definition "Maximum capacity of the load cell." unit "g, kg, or t" symbol Emax required true measurement_method declared specification_reference "R 60-1, 3.5.5" }
  field emin : number { label "Minimum dead load (E_min)" definition "Minimum dead load of the load cell." unit "g, kg, or t" symbol Emin measurement_method declared specification_reference "R 60-1, 3.5.9" }
  field vmin : number { label "Minimum verification interval (v_min)" definition "Minimum load cell verification interval." unit "g, kg, or t" symbol vmin required true measurement_method declared specification_reference "R 60-1, 3.5.11" }
  field n_test_intervals : number { label "Verification intervals of the tested range (n)" definition "Number of verification intervals of the measuring range under test — (E_max − E_min)/v_min when the test spans the classified range (R 60-3, 2.1.2.4). Input n of the conversion-factor calculation." symbol n measurement_method derived derivation "ocl{(emax - emin) / vmin}" specification_reference "R 60-3, 2.1.2.4" }
  field v_mass : number { label "Verification interval (v, mass)" definition "The load cell verification interval of the tested range in mass units — (D_max − D_min)/n. Used to express loads in v for the changeover-point evaluation." unit "g, kg, or t" symbol v measurement_method derived derivation "ocl{(dmax - dmin) / n_test_intervals}" specification_reference "R 60-1, 3.5.4" }
  field dmin : number { label "Minimum test load (D_min)" definition "The minimum test load applied during the test. The lower bound of the measurement range." unit "g, kg, or t" symbol Dmin required true measurement_method declared }
  field dmax : number { label "Maximum test load (D_max)" definition "The maximum test load applied during the test. The upper bound of the measurement range." unit "g, kg, or t" symbol Dmax required true measurement_method declared }
  field test_load_75pct : number { label "75% test load" definition "Test load at 75% of maximum capacity (E_max), used to determine the conversion factor f." unit "g, kg, or t" required true measurement_method declared targets { /req/metrological/mpe } }
  field reference_indication_75pct : number { label "Reference indication at 75%" definition "Average indication at the 75% load point, used as the reference for computing the conversion factor." unit "counts" required true measurement_method direct }
  field plc : number { label "Apportionment factor (p_LC)" definition "The apportionment factor applied to MPE values. Default 0.7 per R 60-1, 3.7.2 unless otherwise marked." symbol pLC measurement_method declared default 0.7 specification_reference "R 60-1, 3.7.2, 5.3.2" }
  field temperature_series : array {
    label "Temperature test series"
    definition "Load cell error measurements at each of four test temperatures per R 60-2 Table 6: 20°C, T_1, T_2, 20°C (return)"
    items { object }
    min_items 4
    max_items 4
    targets { /req/metrological/mpe /req/metrological/temperature-limits }
    fields {
      field temperature : number { label "Temperature" definition "The ambient temperature at which this test series is conducted, in degrees Celsius." unit "degC" required true measurement_method direct }
      field test_loads : array {
        label "Test load measurements"
        definition "Individual load point measurements at this temperature. Each row records the applied load, observed indication, and computed error."
        description "At least five increasing load points incl. values at or near MPE changes, then decreasing with the same points (R 60-2, 2.10.1.8; hysteresis per R 60-1, 5.3)"
        items { object }
        min_items 5
        fields {
          field test_load : number { label "Test load" definition "The applied test load at this measurement point, in mass units." unit "g, kg, or t" required true measurement_method direct }
          field direction : enum { label "Direction" definition "Whether this reading is in the increasing or decreasing load sequence (hysteresis per R 60-1, 5.3)" required true measurement_method direct enum_values { increasing decreasing } }
          field indication : number { label "Indication" definition "The load cell output reading (in counts) observed at this test load and temperature." unit "counts" required true measurement_method direct }
          field reference_indication : number { label "Reference indication (R_i)" definition "Reference indication at this test load, computed from the test load, D_min, D_max, n, and f per R 60-3, 2.1.2.6." unit "indication units" symbol Ri required true measurement_method computed calculation referenceIndication calculation_bindings { testLoad: test_load d_min: dmin d_max: dmax n: n_test_intervals conversion_factor_f: conversion_factor_f} specification_reference "R 60-3, 2.1.2.6" }
          field error_EL : number { label "Error (E_L)" definition "Load cell error at this point: the signed difference between observed indication and reference indication, divided by the conversion factor f, expressed in verification units (v)." unit "v" symbol EL required true measurement_method derived calculation loadCellError calculation_bindings { avgIndication: indication referenceIndication: reference_indication conversion_factor_f: conversion_factor_f} specification_reference "R 60-3, 2.1.2.2" }
          field mpe : number { label "MPE" definition "Maximum permissible error for this test load, determined by the accuracy class tier table (R 60-1, Table 4). The absolute error must not exceed this value." unit "v" symbol MPE measurement_method lookup calculation mpe calculation_bindings { load: test_load accuracy_class: accuracy_class p_lc: plc} specification_reference "R 60-1, 5.3.1, Table 4" }
          field within_mpe : boolean { label "Within MPE" definition "Evaluation result: whether the absolute load cell error is within the maximum permissible error at this point." measurement_method evaluated evaluation { rule "ocl{abs(error_EL) <= abs(mpe)}" condition "|E_L| <= |MPE|" specification_reference "R 60-1, 5.3.1" } true_label "Yes" false_label "No" }
          field changeover : object {
            label "Changeover point evaluation (digital cells)"
            definition "For digital load cells with an output interval greater than 0.20 v, the error prior to rounding is evaluated via the changeover point: P = I + ½v − ΔL, E = P − L, E_c = E − E_0 ≤ MPE (R 60-2, 2.10.7.2). Leave empty for analogue cells."
            fields {
              field delta_l : number { label "Additional load (ΔL)" definition "Additional load successively added until the digital output increases unambiguously by one output increment (I + v)." unit "g, kg, or t" measurement_method direct specification_reference "R 60-2, 2.10.7.2" }
              field error_prior_rounding : number { label "Error prior to rounding (E, v)" definition "E = P − L with P = I + ½v − ΔL, expressed in v: indication/f + 0.5 − ΔL/v − L/v." unit "v" measurement_method derived derivation "ocl{indication / conversion_factor_f + 0.5 - delta_l / v_mass - test_load / v_mass}" specification_reference "R 60-2, 2.10.7.2" }
              field error_corrected : number { label "Corrected error (E_c, v)" definition "E_c = E − E_0, with E_0 the prior-rounding error at the minimum test load D_min (the D_min row of this series)." unit "v" symbol EC measurement_method derived derivation "ocl{error_prior_rounding - test_loads->select(r | r.test_load = dmin)->first().changeover.error_prior_rounding}" specification_reference "R 60-2, 2.10.7.2" }
              field within_mpe_corrected : boolean { label "E_c within MPE" definition "Evaluation: whether the corrected error prior to rounding is within the MPE (R 60-2, 2.10.7.2: E_c ≤ MPE)." measurement_method evaluated evaluation { rule "ocl{abs(error_corrected) <= abs(mpe)}" condition "|E_c| <= |MPE|" specification_reference "R 60-2, 2.10.7.2" } true_label "Yes" false_label "No" }
            }
          }
        }
      }
    }
  }
  field dmin_pass : boolean { label "D_min result" definition "Whether the load cell passes the test at minimum test load." measurement_method evaluated true_label "Pass" false_label "Fail" }
  field overall_result : boolean { label "Overall result" definition "Aggregate pass/fail: PASS if and only if every |E_L| <= |MPE| at every test load at every temperature." required true measurement_method evaluated evaluation { rule "ocl{temperature_series->forAll(t | t.test_loads->forAll(l | l.within_mpe))}" condition "All |E_L| <= |MPE| at every test load at every temperature" specification_reference "R 60-1, 5.3.1" } true_label "Pass" false_label "Fail" }
  pass_fail { criteria "All |E_L| <= |MPE| for every test load at every temperature" pass_if "ocl{temperature_series->forAll(t | t.test_loads->forAll(l | l.within_mpe))}" }
}
form r60-3/table-6.3-6.4 {
  name "Load Test"
  description "Load test data — load cell error E_L with N runs per test load. R 60-3 publishes this as two printed tables (6.3 for 3 runs at classes C/D, 6.4 for 5 runs at classes A/B). Our data model has one form, parameterized by accuracy_class, that materializes both — fully DRY. This is the parameterization principle: the same dimension (accuracy_class) flows from the requirement (R 60-1, MPE tier) through the conformance test (R 60-2, §2.10.1 procedure count) to the test report form (R 60-3, table 6.3/6.4). The number of runs is `n_runs`."
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.3 (3 runs) / 6.4 (5 runs)"
  requirements { /req/metrological/mpe /req/metrological/repeatability }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.3"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-2"
  conformance_process /conf/metrological-tests/measurement-error-repeatability-mdlo
  applicability {
    accuracy_class: [A, B, C, D]
  }
  field electronics_power_voltage : string { label "Power supply voltage" description "Voltage of the power supply used during the test (AC or DC as applicable)" }
  field test_loads : array { subform_ref load-test-row { } label "Test load measurements" description "Per-load-point measurements. Each row records the applied test load, N runs of (indication, time), and computed aggregates (mean, repeatability). N is 3 for classes C/D, 5 for classes A/B (R 60-2, §2.10.1), resolved at runtime from the conformance test's `instances` declaration (/conf/metrological-tests/measurement-error-repeatability-mdlo); the static shape below is the class C/D table (R 60-3, 6.3)." }
}
form r60-3/sec-6.1 {
  name "Performance Test Summary"
  description "Results of the performance tests — data-derived from test form instances"
  data_class FormInstance#data
  section "R 60-3, 6.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.1.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.1/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.1.1/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6"
  field base_tests : array {
    label "Performance test results"
    description "Summary of base metrological performance tests — auto-derived from test form instances"
    items { object }
    fields {
      field form_id : string { label "Form" }
      field clause : string { label "Clause" }
      field test_name : string { label "Performance Test" required true }
      field temperature : string { label "Temperature" }
      field page_no : string { label "Report Page No." }
      field max_error_v : number { label "Max Error (v)" unit "v" }
      field passed : boolean { label "Passed" }
      field failed : boolean { label "Failed" }
      field remark : string { label "Remark" }
    }
  }
  field electronic_tests : array {
    label "Digital load cell test results"
    description "Summary of additional tests for digital load cells — auto-derived from test form instances"
    items { object }
    fields {
      field form_id : string { label "Form" }
      field clause : string { label "Clause" }
      field test_name : string { label "Performance Test" required true }
      field temperature : string { label "Temperature" }
      field page_no : string { label "Report Page No." }
      field max_error_v : number { label "Max Error (v)" unit "v" }
      field passed : boolean { label "Passed" }
      field failed : boolean { label "Failed" }
      field remark : string { label "Remark" }
    }
  }
}
form r60-3/form-6.12 {
  name "Power Voltage"
  description "Power voltage variation test"
  data_class FormInstance#data
  header r60-3/header-b
  section "R 60-3, 6.12"
  requirements { /req/electronic/power-voltage-ac /req/electronic/power-voltage-dc /req/electronic/power-voltage-variations }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.2"
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.3"
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.4"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.4"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.2.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.2.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.2.3"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.2.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.12"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.12.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-15"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.12.1/table-1"
  calculation_context { dimensions true tables { mpe_tiers } }
  conformance_process /conf/electronic-tests/power-voltage
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" required true targets { /req/electronic/power-voltage-ac /req/electronic/power-voltage-dc } }
  field dmax : number { label "Maximum test load (D_max)" unit "g, kg, or t" required true measurement_method declared targets { /req/electronic/power-voltage-variations } }
  field plc : number { label "Apportionment factor (p_LC)" measurement_method declared default 0.7 targets { /req/electronic/power-voltage-variations } }
  field main_voltage : string { label "Main Voltage" required true targets { /req/electronic/power-voltage-ac /req/electronic/power-voltage-dc } }
  field supply_type : enum { label "Supply Type" required true values { AC { label "AC" } DC { label "DC" } } targets { /req/electronic/power-voltage-ac /req/electronic/power-voltage-dc } }
  field preloads : array {
    label "Preloads"
    items { object }
    min_items 3
    max_items 3
    targets { /req/electronic/power-voltage-variations }
    fields {
      field test_load : string { label "Test Load" description "D_min or D_max" }
      field indication : number { label "Indication" unit "counts" }
      field time : string { label "Time" }
    }
  }
  field voltage_tests : object {
    label "Voltage Tests"
    targets { /req/electronic/power-voltage-variations }
    fields {
      field initial_run : object {
        label "Initial Run"
        fields {
          field dmin_indication : number { label "Dmin Indication" }
          field dmax_indication : number { label "Dmax Indication" }
          field span_counts : number { label "Span Counts" calculation "ocl{dmax_indication - dmin_indication}" }
          field span_vmin : number { label "Span Vmin" calculation "ocl{span_counts / conversion_factor_f}" }
        }
      }
      field lower_limit : object {
        label "Lower Limit"
        fields {
          field dmin_indication : number { label "Dmin Indication" }
          field dmax_indication : number { label "Dmax Indication" }
          field span_counts : number { label "Span Counts" calculation "ocl{dmax_indication - dmin_indication}" }
          field span_vmin : number { label "Span Vmin" calculation "ocl{span_counts / conversion_factor_f}" }
          field change : number { label "Change" calculation "ocl{span_vmin - initial_run.span_vmin}" }
        }
      }
      field upper_limit : object {
        label "Upper Limit"
        fields {
          field dmin_indication : number { label "Dmin Indication" }
          field dmax_indication : number { label "Dmax Indication" }
          field span_counts : number { label "Span Counts" calculation "ocl{dmax_indication - dmin_indication}" }
          field span_vmin : number { label "Span Vmin" calculation "ocl{span_counts / conversion_factor_f}" }
          field change : number { label "Change" calculation "ocl{span_vmin - initial_run.span_vmin}" }
        }
      }
      field mpc : number { label "Mpc" unit "v" calculation "ocl{abs(lookup_mpe(dmax, accuracy_class, plc))}" source_discrepancy { summary "R 60-3, Form 6.12 note 3 and its mpc column state the power-voltage span change limit as v_min, while R 60-1, 5.7.2.4 requires measurement results to stay within the maximum permissible errors during voltage variations" sources { "urn:oiml:pub:r:60-3:2021#clause-6.12" "urn:oiml:pub:r:60-1:2021#clause-5.7.2.4" } resolution follows_clause_x rationale "The form follows the normative Part 1 limit (|MPE| at D_max): R 60-1, 5.7.2.4 requires all measurement results to stay within the MPE during voltage variations, and the same tension in Form 6.11 is resolved there by note 5 defining mpc as |MPE|. The v_min wording of Form 6.12 note 3 is the dissenting print. See analysis/deep-audit-r60.md F6." } }
    }
  }
  field overall_result : boolean { label "Overall Result" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "Change of span must not exceed mpc (|MPE| at D_max) at lower/upper voltage limits — R 60-3, Form 6.12 notes 3 vs 5 discrepancy annotated on the mpc field" pass_if "ocl{abs(voltage_tests.lower_limit.change) <= voltage_tests.mpc and abs(voltage_tests.upper_limit.change) <= voltage_tests.mpc}" }
}
form r60-3/table-6.6 {
  name "Repeatability"
  description "Repeatability errors (E_R) calculation across four test temperatures"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.6"
  requirements { /req/metrological/repeatability }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.4"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.1.15"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.6"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-4"
  calculation_context { dimensions true tables { mpe_tiers } }
  conformance_process /conf/metrological-tests/measurement-error-repeatability-mdlo
  field conversion_factor_f : number { label "Conversion factor (f)" definition "Ratio of indication change to load change at 75% of Max. Converts counts to verification units (v)." unit "counts/v" symbol f required true measurement_method computed calculation conversionFactor calculation_bindings { avgIndicationAt75pct: reference_indication_75pct indicationAtDmin: indication_at_dmin n: n_test_intervals} specification_reference "R 60-3, 2.1.2.4" }
  field reference_indication_75pct : number { label "Reference indication at 75%" definition "Average indication at the 75% load point, used to compute f." unit "counts" required true measurement_method direct }
  field indication_at_dmin : number { label "Indication at D_min" definition "Load cell indication at minimum test load (D_min), used to compute f." unit "counts" required true measurement_method direct }
  field n_lc : integer { label "Number of verification intervals (n_LC)" definition "Maximum number of load cell verification intervals n_LC, declared by the manufacturer." symbol nLC required true measurement_method declared specification_reference "R 60-1, 3.5.8" }
  field y : integer { label "Relative v_min (Y)" definition "Ratio of the maximum measuring range to v_min (Y = (E_max - E_min)/v_min)." symbol Y measurement_method declared specification_reference "R 60-1, 3.5.15" }
  field emax : number { label "Maximum capacity (E_max)" definition "Maximum capacity of the load cell." unit "g, kg, or t" symbol Emax required true measurement_method declared specification_reference "R 60-1, 3.5.5" }
  field emin : number { label "Minimum dead load (E_min)" definition "Minimum dead load of the load cell." unit "g, kg, or t" symbol Emin measurement_method declared specification_reference "R 60-1, 3.5.9" }
  field vmin : number { label "Minimum verification interval (v_min)" definition "Minimum load cell verification interval." unit "g, kg, or t" symbol vmin required true measurement_method declared specification_reference "R 60-1, 3.5.11" }
  field n_test_intervals : number { label "Verification intervals of the tested range (n)" definition "Number of verification intervals of the measuring range under test — (E_max − E_min)/v_min when the test spans the classified range (R 60-3, 2.1.2.4). Input n of the conversion-factor calculation." symbol n measurement_method derived derivation "ocl{(emax - emin) / vmin}" specification_reference "R 60-3, 2.1.2.4" }
  field plc : number { label "Apportionment factor (p_LC)" definition "Apportionment factor applied to MPE. Default 0.7 per R 60-1, 3.7.2 unless otherwise marked." symbol pLC measurement_method declared default 0.7 specification_reference "R 60-1, 3.7.2, 5.3.2" }
  field temperature_series : array {
    label "Temperature test series"
    definition "Repeatability error measurements at each of four test temperatures (20°C, T_1, T_2, 20°C return)"
    items { object }
    min_items 4
    max_items 4
    fields {
      field temperature : number { label "Temperature" definition "Ambient temperature at which this repeatability test is conducted." unit "degC" required true measurement_method direct }
      field test_loads : array {
        label "Test load measurements"
        definition "Repeatability error at each load point for this temperature."
        items { object }
        fields {
          field test_load : number { label "Test load" definition "The applied test load at this measurement point." unit "g, kg, or t" required true measurement_method direct }
          field runs : array {
            label "Run readings"
            definition "Per-run indication readings at this load point used to compute repeatability error."
            items { object }
            min_items 3
            fields {
              field run_number : integer { label "Run number" required true measurement_method declared }
              field indication : number { label "Indication (counts)" unit "counts" required true measurement_method direct }
            }
          }
          field repeatability_error_v : number { label "Repeatability error (E_R)" definition "Repeatability error in verification units: (max indication − min indication) / f." unit "v" symbol ER measurement_method derived calculation repeatabilityError calculation_bindings { indications: runs.indication conversion_factor_f: conversion_factor_f} specification_reference "R 60-3, 2.1.3" }
          field mpe : number { label "MPE" definition "Maximum permissible error for this test load from the accuracy class tier table (R 60-1, Table 4)." unit "v" symbol MPE measurement_method lookup calculation mpe calculation_bindings { load: test_load accuracy_class: accuracy_class p_lc: plc} specification_reference "R 60-1, 5.4, Table 4" }
          field within_mpe : boolean { label "Within MPE" definition "Evaluation: whether the repeatability error is within the MPE." measurement_method evaluated evaluation { rule "ocl{abs(repeatability_error_v) <= abs(mpe)}" condition "|E_R| <= |MPE|" specification_reference "R 60-1, 5.4" } true_label "Yes" false_label "No" }
        }
      }
    }
  }
  field overall_result : boolean { label "Overall result" definition "PASS iff |E_R| <= |MPE| at every test load at every temperature." required true measurement_method evaluated evaluation { rule "ocl{temperature_series->forAll(t | t.test_loads->forAll(l | l.within_mpe))}" condition "All |E_R| <= |MPE| at every test load at every temperature" specification_reference "R 60-1, 5.4" } true_label "Pass" false_label "Fail" }
  pass_fail { criteria "All E_R <= |MPE| for every test load at every temperature" pass_if "ocl{temperature_series->forAll(t | t.test_loads->forAll(l | l.within_mpe))}" }
}
form r60-3/form-6.13 {
  name "Short Time Power"
  description "Short-time power reductions test"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.13"
  requirements { /req/electronic/disturbances }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.5"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.3"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.3.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.3.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.3.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.13"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.13.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-16"
  conformance_process /conf/electronic-tests/short-time-power
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" required true targets { /req/electronic/disturbances } }
  field dmin_value : number { label "Dmin Value" unit "g, kg, or t" targets { /req/electronic/disturbances } }
  field reference_voltage_range : number { label "Reference Voltage Range" unit "V" required true targets { /req/electronic/disturbances } }
  field disturbance_tests : array {
    label "Disturbance Tests"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field test_load : number { label "Test Load" unit "g, kg, or t" }
      field amplitude_pct : number { label "Amplitude Pct" unit "%" }
      field duration_cycles : number { label "Duration Cycles" unit "cycles" }
      field number_of_disturbances : integer { label "Number Of Disturbances" }
      field indication_without : number { label "Indication Without" unit "counts" }
      field indication_with : number { label "Indication With" unit "counts" }
      field difference : number { label "Difference" unit "v" calculation "ocl{(indication_with - indication_without) / conversion_factor_f}" }
      field repetition_interval_v : number { label "Repetition Interval V" unit "v" }
      field significant_fault : boolean { label "Significant Fault" calculation "ocl{abs(difference) > 1}" true_label "Yes" false_label "No" }
      field remarks : string { label "Remarks" }
    }
  }
  field equipment_used : text { label "Equipment Used" }
  field remarks : text { label "Remarks" }
  field overall_result : boolean { label "Overall Result" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "No significant fault (> v_min) or fault detected and acted upon" pass_if "ocl{disturbance_tests->forAll(r | not r.significant_fault)}" }
}
form r60-3/form-6.19 {
  name "Span Stability"
  description "Span stability test measurement data"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.19"
  requirements { /req/electronic/span-stability }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.6"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.11"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.9"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.9.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.9.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.9.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1/table-1"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1/table-2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1/table-3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1/table-4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1/table-5"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1/table-6"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1/table-7"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.19.1/table-8"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-25"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-26"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-27"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-28"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-29"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-30"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-31"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-32"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-33"
  calculation_context { header r60-3/header-a dimensions true tables { mpe_tiers } }
  conformance_process /conf/electronic-tests/span-stability
  applicability {
    accuracy_class: [B, C, D]
  }
  field conversion_factor_f : number { label "Conversion Factor F" definition "Ratio of indication change to load change at 75% of Max. Converts counts to verification units (v)." unit "counts/v" required true measurement_method computed specification_reference "R 60-3, 2.1.2.4" }
  field dmin_value : number { label "Minimum Test Load (D_min)" definition "The minimum test load applied at each measurement." unit "g, kg, or t" measurement_method declared }
  field dmax_value : number { label "Maximum Test Load (D_max)" definition "The maximum test load applied at each measurement." unit "g, kg, or t" measurement_method declared }
  field measurements : array {
    label "Span stability measurements"
    definition "Eight repeated measurements of the load cell span over time. Each measurement records D_min and D_max indications, computes the span, and checks for drift."
    items { object }
    min_items 8
    fields {
      field measurement_no : integer { label "Measurement No" definition "Sequential measurement number (1-8)." required true measurement_method declared }
      field readings : object {
        label "Readings"
        definition "Individual run readings at D_min and D_max."
        fields {
          field dmin : array {
            label "D_min readings"
            definition "Load cell indication readings at minimum test load for each run."
            items { object }
            min_items 3
            max_items 5
            fields {
              field indication : number { label "Indication" definition "Load cell output at D_min for this run." unit "counts" measurement_method direct }
              field time : string { label "Time" definition "Absolute time of reading (HH:MM:SS)." pattern "\\d{2}:\\d{2}:\\d{2}" measurement_method direct }
            }
          }
          field dmax : array {
            label "D_max readings"
            definition "Load cell indication readings at maximum test load for each run."
            items { object }
            min_items 3
            max_items 5
            fields {
              field indication : number { label "Indication" definition "Load cell output at D_max for this run." unit "counts" measurement_method direct }
              field time : string { label "Time" definition "Absolute time of reading (HH:MM:SS)." pattern "\\d{2}:\\d{2}:\\d{2}" measurement_method direct }
            }
          }
        }
      }
      field avg_dmin : number { label "Average D_min Indication" definition "Mean of all run indications at D_min." unit "counts" measurement_method derived derivation "ocl{mean(readings.dmin->collect(r | r.indication))}" specification_reference "R 60-3, 2.2.9" }
      field avg_dmax : number { label "Average D_max Indication" definition "Mean of all run indications at D_max." unit "counts" measurement_method derived derivation "ocl{mean(readings.dmax->collect(r | r.indication))}" specification_reference "R 60-3, 2.2.9" }
      field span : number { label "Span" definition "The difference between average D_max and average D_min indications: avg_dmax - avg_dmin." unit "counts" measurement_method derived derivation "ocl{avg_dmax - avg_dmin}" specification_reference "R 60-3, 2.2.9" }
      field span_vmin : number { label "Span (v_min)" definition "The span expressed in verification units: span / conversion_factor_f." unit "v" measurement_method derived derivation "ocl{span / conversion_factor_f}" specification_reference "R 60-3, 2.2.9" }
      field variation : number { label "Variation from first (v_min)" definition "Absolute difference between this measurement's span_vmin and the first measurement's span_vmin." unit "v" measurement_method derived derivation "ocl{abs(span_vmin - measurements[0].span_vmin)}" specification_reference "R 60-1, 5.7.2.6" }
      field within_limit : boolean { label "Within limit" definition "Evaluation: whether the span variation is within the maximum allowable variation." measurement_method evaluated evaluation { rule "ocl{variation <= max_allowable_variation}" condition "variation <= max(0.5 v_min, 0.5 * |MPE|)" specification_reference "R 60-1, 5.7.2.6" } true_label "Yes" false_label "No" }
      field evaluator : string { label "Evaluator" definition "Name of the person who performed this measurement." measurement_method declared }
      field remarks : text { label "Remarks" definition "Free-text notes about this measurement." measurement_method declared }
      field conditions : object {
        label "Conditions"
        definition "Environmental conditions at the time of this measurement."
        fields {
          field date : date { label "Date" definition "Date of this measurement." measurement_method direct }
          field time : string { label "Time" definition "Start time of this measurement." measurement_method direct }
          field temperature : number { label "Temperature" definition "Ambient temperature during measurement." unit "degC" measurement_method direct }
          field relative_humidity : number { label "Relative Humidity" definition "Relative humidity during measurement." unit "%" measurement_method direct }
          field barometric_pressure : number { label "Barometric Pressure" definition "Atmospheric pressure during measurement." unit "kPa" measurement_method direct }
        }
      }
    }
  }
  field max_allowable_variation : number { label "Maximum Allowable Variation" definition "The maximum permissible span variation: max(0.5 v_min, 0.5 * |MPE|) per R 60-1, 5.7.2.6." unit "v" measurement_method computed derivation "ocl{max(0.5, lookup_mpe(dmax_value, accuracy_class, 1.0) * 0.5)}" specification_reference "R 60-1, 5.7.2.6" }
  field overall_result : boolean { label "Overall Result" definition "PASS iff every measurement's span variation is within the maximum allowable variation." required true measurement_method evaluated evaluation { rule "ocl{measurements->forAll(m | m.within_limit)}" condition "All variations <= max(0.5 v_min, 0.5 * |MPE|)" specification_reference "R 60-1, 5.7.2.6" } true_label "Pass" false_label "Fail" }
  pass_fail {
    criteria "Span variation between any two measurements must not exceed max(0.5 v_min, 0.5 * |MPE|) per R 60-1, 5.7.2.6"
    pass_if "ocl{measurements->forAll(m | m.within_limit)}"
    derivation {
      value span_vmin { calculation "ocl{span / conversion_factor_f}" for_each measurements unit "v" }
      value variation { calculation "ocl{abs(span_vmin - measurements[0].span_vmin)}" for_each measurements unit "v" }
      value max_allowable_variation { calculation "ocl{max(0.5, lookup_mpe(dmax_value, accuracy_class, 1.0) * 0.5)}" unit "v" }
      value within_limit { calculation "ocl{variation <= max_allowable_variation}" for_each measurements }
    }
  }
}
form r60-3/form-6.15 {
  name "Surge"
  description "Surge test"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.15"
  requirements { /req/electronic/disturbances }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.5"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.7"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.5"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.5.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.5.2"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.15"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.15.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-19"
  conformance_process /conf/electronic-tests/surge
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" required true targets { /req/electronic/disturbances } }
  field dmin_value : number { label "Dmin Value" targets { /req/electronic/disturbances } }
  field unit : enum { label "Unit" values { g { label "G" } kg { label "Kg" } t { label "T" } } }
  field test_conditions : object {
    label "Test Conditions"
    targets { /req/electronic/disturbances }
    fields {
      field output_gained_method : enum { label "Output Gained Method" values { actual_loads { label "Actual_loads" } simulating_loading { label "Simulating_loading" } } }
      field simulating_using : string { label "Simulating Using" }
      field cable_type : enum { label "Cable Type" values { symmetrical { label "Symmetrical" } unsymmetrical { label "Unsymmetrical" } } }
      field line_to_line_kv : number { label "Line To Line Kv" unit "kV" }
      field line_to_earth_kv : number { label "Line To Earth Kv" unit "kV" }
      field test_load_value : number { label "Test Load Value" }
    }
  }
  field test_cycles : array {
    label "Test Cycles"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults }
    fields {
      field cycle_phase : enum { label "Cycle Phase" values { initial { label "Initial" } during_exposure { label "During_exposure" } after { label "After" } } }
      field load : number { label "Load" }
      field time_start : string { label "Time Start" }
      field time_stop : string { label "Time Stop" }
      field reference : number { label "Reference" }
      field indicated : number { label "Indicated" }
      field error : number { label "Error" unit "v" }
      field relative_error_pct : number { label "Relative Error Pct" unit "%" }
      field mpe_pct : number { label "Mpe Pct" unit "%" }
    }
  }
  field observed_faults : array {
    label "Observed Faults"
    items { object }
    targets { /req/electronic/disturbances /req/electronic/no-significant-faults /req/electronic/acting-on-faults }
    fields {
      field fault_type : enum { label "Fault Type" values { line_to_line_up { label "Line_to_line_up" } line_to_line_down { label "Line_to_line_down" } line_to_earth_up { label "Line_to_earth_up" } line_to_earth_down { label "Line_to_earth_down" } } }
      field fault_limit_pct : number { label "Fault Limit Pct" unit "%" }
      field fault_deviation : string { label "Fault Deviation" }
      field significant : boolean { label "Significant" true_label "Yes" false_label "No" }
      field acts_on_fault : boolean { label "Acts On Fault" true_label "Yes" false_label "No" }
    }
  }
  field omission_justification : text { label "Omission justification" description "Justification for not conducting the surge test, per R 60-2, 2.10.7.7 (intended use and installation details rendering the test unnecessary — e.g. no outdoor installation and no signal lines longer than 10 m). Mandatory when the test is omitted; the justification is noted in the test report." measurement_method declared specification_reference "R 60-2, 2.10.7.7" }
  field observations : text { label "Observations" }
  field overall_result : boolean { label "Overall Result" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "No significant fault or fault detected and acted upon" pass_if "ocl{observed_faults->forAll(f | not f.significant) or observed_faults->forAll(f | f.acts_on_fault)}" }
}
form r60-3/table-6.7 {
  name "Temperature MDLO"
  description "Temperature effects on minimum dead load output (C_M)"
  data_class FormInstance#data
  header r60-3/header-a
  section "R 60-3, 6.7"
  requirements { /req/metrological/temperature-effect-mdlo }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.6.1.3"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.1.16"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.1.4"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.7"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-5"
  calculation_context { dimensions true }
  conformance_process /conf/metrological-tests/measurement-error-repeatability-mdlo
  field conversion_factor_f : number { label "Conversion factor (f)" definition "Ratio of indication change to load change at 75% of Max. Converts counts to verification units (v)." unit "counts/v" symbol f required true measurement_method computed calculation conversionFactor calculation_bindings { avgIndicationAt75pct: reference_indication_75pct indicationAtDmin: indication_at_dmin n: n_test_intervals} specification_reference "R 60-3, 2.1.2.4" }
  field reference_indication_75pct : number { label "Reference indication at 75%" definition "Average indication at the 75% load point, used to compute f." unit "counts" required true measurement_method direct }
  field indication_at_dmin : number { label "Indication at D_min" definition "Load cell indication at minimum test load (D_min), used to compute f." unit "counts" required true measurement_method direct }
  field n_lc : integer { label "Number of verification intervals (n_LC)" definition "Maximum number of load cell verification intervals n_LC, declared by the manufacturer." symbol nLC required true measurement_method declared specification_reference "R 60-1, 3.5.8" }
  field y : integer { label "Relative v_min (Y)" definition "Ratio of the maximum measuring range to v_min (Y = (E_max - E_min)/v_min)." symbol Y measurement_method declared specification_reference "R 60-1, 3.5.15" }
  field emax : number { label "Maximum capacity (E_max)" definition "Maximum capacity of the load cell." unit "g, kg, or t" symbol Emax required true measurement_method declared specification_reference "R 60-1, 3.5.5" }
  field emin : number { label "Minimum dead load (E_min)" definition "Minimum dead load of the load cell." unit "g, kg, or t" symbol Emin measurement_method declared specification_reference "R 60-1, 3.5.9" }
  field vmin : number { label "Minimum verification interval (v_min)" definition "Minimum load cell verification interval." unit "g, kg, or t" symbol vmin required true measurement_method declared specification_reference "R 60-1, 3.5.11" }
  field n_test_intervals : number { label "Verification intervals of the tested range (n)" definition "Number of verification intervals of the measuring range under test — (E_max − E_min)/v_min when the test spans the classified range (R 60-3, 2.1.2.4). Input n of the conversion-factor calculation." symbol n measurement_method derived derivation "ocl{(emax - emin) / vmin}" specification_reference "R 60-3, 2.1.2.4" }
  field plc : number { label "Apportionment factor (p_LC)" definition "Apportionment factor. Also serves as the maximum permissible change (MPC) per temperature increment." symbol pLC measurement_method declared default 0.7 specification_reference "R 60-1, 3.7.2" }
  field temperature_readings : array {
    label "Temperature readings"
    definition "Minimum dead load output indication at each test temperature. Four temperatures per R 60-2: 20°C, T_1, T_2, 20°C (return)."
    items { object }
    min_items 4
    max_items 4
    fields {
      field temperature : number { label "Temperature" definition "Ambient temperature at which the MDLO indication is recorded." unit "degC" required true measurement_method direct }
      field indication : number { label "Indication" definition "Average initial minimum test load indication at this temperature, obtained from the load test data (Table 6.3/6.4)." unit "counts" required true measurement_method direct }
      field change_v : number { label "Change (v)" definition "Change in MDLO indication from the prior temperature, divided by the conversion factor, in verification units." unit "v" symbol CM measurement_method derived derivation "ocl{if $index = 0 then 0 else (indication - $prev.indication) / conversion_factor_f endif}" specification_reference "R 60-3, 2.1.4" }
      field delta_t : number { label "Temperature step (ΔT)" definition "Temperature span of this step (T_2 − T_1). The baseline row carries 1 °C — inert, since its C_M is 0 — so the canonical verdict derivation is defined on every row." unit "degC" symbol delta_t measurement_method derived derivation "ocl{if $index = 0 then 1 else abs(temperature - $prev.temperature) endif}" specification_reference "R 60-3, 2.1.4" }
      field change_per_5deg : number { label "Change per temperature increment" definition "Temperature-induced MDLO change normalized by the class increment (5 degC for classes B/C/D, 2 degC for class A) and converted to v_min units — the canonical mdlo_normalized verdict quantity." unit "v" symbol CM-vmin verdict mdlo_normalized measurement_method derived specification_reference "R 60-3, 2.1.4" }
      field mpc : number { label "MPC" definition "Maximum permissible change per 5 degC (classes B/C/D) or per 2 degC (class A). Equal to p_LC." unit "v" measurement_method declared derivation "ocl{$context.p_LC}" specification_reference "R 60-1, 5.6.1.3" }
      field within_mpc : boolean { label "Within MPC" definition "Evaluation: whether the normalized temperature-induced change is within the MPC." measurement_method evaluated evaluation { rule "" verdict mdlo_normalized op lte limit "ocl{p_lc}" condition "|C_M(v_min)| per temperature increment <= p_LC" specification_reference "R 60-1, 5.6.1.3" } true_label "Yes" false_label "No" }
    }
  }
  field overall_result : boolean { label "Overall result" definition "PASS iff all temperature-induced MDLO changes are within MPC." required true measurement_method evaluated evaluation { rule "ocl{temperature_readings->forAll(r | r.within_mpc)}" condition "All |C_M| per 5 degC <= p_LC" specification_reference "R 60-1, 5.6.1.3" } true_label "Pass" false_label "Fail" }
  pass_fail { criteria "C_M(v) per 5 degC <= p_LC for classes B/C/D; per 2 degC for class A" pass_if "ocl{temperature_readings->forAll(r | r.within_mpc)}" }
}
form r60-3/form-6.11 {
  name "Warm Up Time"
  description "Warm-up time test for electronic load cells"
  data_class FormInstance#data
  header r60-3/header-b
  section "R 60-3, 6.11"
  requirements { /req/electronic/warm-up-time }
  ref requirement "urn:oiml:pub:r:60-1:2021#clause-5.7.2.1"
  ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7.3"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.1.1"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.1.2"
  ref calculation "urn:oiml:pub:r:60-3:2021#clause-2.2.1.3"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.11"
  ref report-format "urn:oiml:pub:r:60-3:2021#clause-6.11.1"
  ref report-format "urn:oiml:pub:r:60-3:2021#table-14"
  calculation_context { dimensions true tables { mpe_tiers } }
  conformance_process /conf/electronic-tests/warm-up-time
  field conversion_factor_f : number { label "Conversion Factor F" unit "counts/v" required true targets { /req/electronic/warm-up-time } }
  field dmax : number { label "Maximum test load (D_max)" unit "g, kg, or t" required true measurement_method declared targets { /req/electronic/warm-up-time } }
  field plc : number { label "Apportionment factor (p_LC)" measurement_method declared default 0.7 targets { /req/electronic/warm-up-time } }
  field duration_of_disconnection : string { label "Duration Of Disconnection" required true targets { /req/electronic/warm-up-time } }
  field readings : object {
    label "Readings"
    targets { /req/electronic/warm-up-time }
    fields {
      field initial_dmin : object {
        label "Initial Dmin"
        fields {
          field indication : number { label "Indication" unit "counts" }
          field time : string { label "Time" }
        }
      }
      field initial_dmax : object {
        label "Initial Dmax"
        fields {
          field indication : number { label "Indication" unit "counts" }
          field time : string { label "Time" }
        }
      }
      field initial_span_counts : number { label "Initial Span Counts" unit "counts" calculation "ocl{initial_dmax.indication - initial_dmin.indication}" }
      field initial_span_vmin : number { label "Initial Span Vmin" unit "v" calculation "ocl{initial_span_counts / conversion_factor_f}" }
      field after_5min_dmin : object {
        label "After 5min Dmin"
        fields {
          field indication : number { label "Indication" }
          field time : string { label "Time" }
        }
      }
      field after_5min_dmax : object {
        label "After 5min Dmax"
        fields {
          field indication : number { label "Indication" }
          field time : string { label "Time" }
        }
      }
      field after_5min_span_counts : number { label "After 5min Span Counts" calculation "ocl{after_5min_dmax.indication - after_5min_dmin.indication}" }
      field after_5min_span_vmin : number { label "After 5min Span Vmin" calculation "ocl{after_5min_span_counts / conversion_factor_f}" }
      field after_5min_change : number { label "After 5min Change" calculation "ocl{after_5min_span_vmin - initial_span_vmin}" }
      field after_15min_dmin : object {
        label "After 15min Dmin"
        fields {
          field indication : number { label "Indication" }
          field time : string { label "Time" }
        }
      }
      field after_15min_dmax : object {
        label "After 15min Dmax"
        fields {
          field indication : number { label "Indication" }
          field time : string { label "Time" }
        }
      }
      field after_15min_span_counts : number { label "After 15min Span Counts" calculation "ocl{after_15min_dmax.indication - after_15min_dmin.indication}" }
      field after_15min_span_vmin : number { label "After 15min Span Vmin" calculation "ocl{after_15min_span_counts / conversion_factor_f}" }
      field after_15min_change : number { label "After 15min Change" calculation "ocl{after_15min_span_vmin - initial_span_vmin}" }
      field after_30min_dmin : object {
        label "After 30min Dmin"
        fields {
          field indication : number { label "Indication" }
          field time : string { label "Time" }
        }
      }
      field after_30min_dmax : object {
        label "After 30min Dmax"
        fields {
          field indication : number { label "Indication" }
          field time : string { label "Time" }
        }
      }
      field after_30min_span_counts : number { label "After 30min Span Counts" calculation "ocl{after_30min_dmax.indication - after_30min_dmin.indication}" }
      field after_30min_span_vmin : number { label "After 30min Span Vmin" calculation "ocl{after_30min_span_counts / conversion_factor_f}" }
      field after_30min_change : number { label "After 30min Change" calculation "ocl{after_30min_span_vmin - initial_span_vmin}" }
      field mpc : number { label "Mpc" unit "v" calculation "ocl{abs(lookup_mpe(dmax, accuracy_class, plc))}" source_discrepancy { summary "R 60-3, Form 6.11 note 3 states the warm-up span change limit as v_min while note 5 of the same form defines mpc as the absolute value of the MPE for the maximum test load" sources { "urn:oiml:pub:r:60-3:2021#clause-6.11" "urn:oiml:pub:r:60-1:2021#clause-5.7.2.1" } resolution follows_clause_x rationale "The form follows note 5 (mpc = |MPE| at D_max): Form 6.11 note 2 judges all span errors against the MPE during the 30-minute test, so note 5's |MPE| definition is the consistent reading; note 3's v_min is the dissenting print. See analysis/deep-audit-r60.md F6." } }
    }
  }
  field overall_result : boolean { label "Overall Result" required true true_label "Pass" false_label "Fail" }
  pass_fail { criteria "Change of span must not exceed mpc (|MPE| at D_max, Form 6.11 note 5 — note 3's v_min wording is the dissenting print, discrepancy annotated on the mpc field)" pass_if "ocl{max(readings.after_5min_change, readings.after_15min_change, readings.after_30min_change) <= readings.mpc}" }
}
form r60-3/header-a {
  name "Form Header A"
  description "Header for load test forms (Form 3) with full identification and conditions"
  data_class FormInstance#data
  field application_no : string { required true }
  field load_cell_model : string { required true }
  field serial_no : string { required true }
  field emax : number { unit "g, kg, or t" required true }
  field emin : number { unit "g, kg, or t" }
  field nlc : integer { required true }
  field plc : number { required true }
  field Y : number { }
  field Z : number { }
  field vmin : number { unit "g, kg, or t" required true }
  field DR : number { unit "g, kg, or t" }
  field force_generating_system : string { }
  field dmax : number { unit "g, kg, or t" required true }
  field dmin : number { unit "g, kg, or t" required true }
  field indicating_instrument : string { }
  field evaluator : string { required true }
  field conditions : object {
    fields {
      field date_start : date { }
      field date_end : date { }
      field temperature_start : number { unit "degC" }
      field temperature_end : number { unit "degC" }
      field relative_humidity_start : number { unit "%" }
      field relative_humidity_end : number { unit "%" }
      field barometric_pressure_start : number { unit "kPa" }
      field barometric_pressure_end : number { unit "kPa" }
      field indicator_temperature_start : number { unit "degC" }
      field indicator_temperature_end : number { unit "degC" }
    }
  }
}
form r60-3/header-b {
  name "Form Header B"
  description "Header for humidity test forms (Form 4) with conditioning parameters"
  field application_no : string { required true }
  field load_cell_model : string { required true }
  field serial_no : string { required true }
  field emax : number { unit "g, kg, or t" required true }
  field nlc : integer { required true }
  field vmin : number { unit "g, kg, or t" required true }
  field plc : number { required true }
  field DR : number { unit "g, kg, or t" }
  field force_generating_system : string { }
  field indicating_instrument : string { }
  field evaluator : string { required true }
  field conditions : object {
    fields {
      field date_start : date { }
      field date_end : date { }
      field conditioning_period : string { }
      field reference_temperature : number { unit "degC" }
      field high_temperature : number { unit "degC" }
      field reference_relative_humidity : number { unit "%" }
      field high_relative_humidity : number { unit "%" }
    }
  }
}
form r60-3/header-c {
  name "Form Header C"
  description "Compact header for EMC/disturbance forms (Form 5)"
  field date : date { required true }
  field time : string { pattern "\\d{2}:\\d{2}:\\d{2}" }
  field temperature : number { unit "degC" }
  field relative_humidity : number { unit "%" }
  field barometric_pressure : number { unit "kPa" }
}
form r60-3/conditions {
  name "Form Conditions"
  description "Conditions block used in most test forms (Form 6)"
  field date_start : date { }
  field date_end : date { }
  field temperature_start : number { unit "degC" }
  field temperature_end : number { unit "degC" }
  field relative_humidity_start : number { unit "%" }
  field relative_humidity_end : number { unit "%" }
  field barometric_pressure_start : number { unit "kPa" }
  field barometric_pressure_end : number { unit "kPa" }
  field indicator_temperature_start : number { unit "degC" }
  field indicator_temperature_end : number { unit "degC" }
}
form r60-3/sh-humidity-header {
  name "SH Humidity Form"
  description "Humidity conditioning header for SH tests (Form 7)"
  field date : date { required true }
  field time : string { }
  field temperature : number { unit "degC" }
  field relative_humidity : number { unit "%" }
  field barometric_pressure : number { unit "kPa" }
}
subform load-test-row {
  type object
  description "One row of a load-test table: applied load + N runs of (indication, time) + computed aggregates (mean, repeatability error). N is parameterized by accuracy_class — the same dimension that drives the requirement MPE tier (R 60-1, Table 4) and the conformance test procedure count (R 60-2, §2.10.1, \"Classes A/B: 5 runs; Classes C/D: 3 runs\")."
  parameters {
    n_runs : integer { description "Number of runs per test_load. Static default materializes the class C/D table (R 60-3, 6.3); the per-class count (5 for A/B) resolves at runtime from the conformance test's `instances` declaration (/conf/metrological-tests/measurement-error-repeatability-mdlo, R 60-2 §2.10.1) — see services/program.service formProgramFor." default 3 }
  }
  field test_load : number { label "Test load" description "Applied test load at this measurement point." unit "g, kg, or t" required true measurement_method direct }
  field direction : enum { label "Direction" description "Whether this reading is in the increasing or decreasing load sequence (hysteresis per R 60-1, 5.3)." required true measurement_method direct enum_values { increasing decreasing } }
  field runs : array {
    label "Runs"
    description "Individual indication readings at this test load. Cardinality is parameterized: 3 for classes C/D, 5 for classes A/B (per R 60-2)."
    items { object }
    min_items "${{ n_runs }}"
    max_items "${{ n_runs }}"
    fields {
      field indication : number { label "Indication" unit "counts" required true measurement_method direct }
      field time : string { label "Time" description "Time of the reading (HH:MM:SS)" measurement_method direct }
    }
  }
  field average_indication : number { label "Average" description "Mean of the n_runs indications at this load." unit "counts" measurement_method derived derivation "ocl{mean(runs.indication)}" }
  field repeatability_error : number { label "Repeatability error" description "Max minus min across the n_runs indications at this load. Per R 60-3, 2.1.3, this is E_R (repeatability error in counts)." unit "counts" measurement_method derived derivation "ocl{max(runs.indication) - min(runs.indication)}" }
}
subform test-procedures {
  type object
  description "Indicates which R 60-2 test procedures this piece of equipment is used for. Corresponds to the \"form-1\" template in R 60-3, 4.10."
  field r60_2_2_10_1 : boolean { label "Measurement error, repeatability error and temperature effect on minimum dead load output" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.1" }
  field r60_2_2_10_2 : boolean { label "Determination of creep error" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.2" }
  field r60_2_2_10_3 : boolean { label "Minimum dead load output return (DR)" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.3" }
  field r60_2_2_10_4 : boolean { label "Barometric pressure effects" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.4" }
  field r60_2_2_10_5 : boolean { label "Humidity effects for load cells marked CH or no mark" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.5" }
  field r60_2_2_10_6 : boolean { label "Humidity effects for load cells marked SH" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.6" }
  field r60_2_2_10_7 : boolean { label "Additional tests for digital load cells" ref test-procedure "urn:oiml:pub:r:60-2:2021#clause-2.10.7" }
}
symbol c_c {
  name "Creep magnitude"
  definition "creep magnitude, expressed in terms of v at time t obtained over the 30 minutes creep test"
  type number
  unit "v"
  latex "C_C(t)"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id CC
  calculation creep
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.5" }
  formula { display "C_C = (indication − initial indication) / f" expression "(indication - initial_indication) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol c_c_30_20 {
  name "Creep difference 20–30 min"
  definition "difference between output at t = 30 minutes and at t = 20 minutes during creep test"
  type number
  unit "v"
  latex "C_C(30 – 20)"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id CC-30-20
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.5.2" }
  formula { display "C_C(30 − 20) = (test indication at 30 minutes − test indication at 20 minutes) / f" expression "(test_indication_30min - test_indication_20min) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol c_dr {
  name "Minimum dead load output return (v)"
  definition "minimum dead load output return, expressed in terms of v"
  type number
  unit "v"
  latex "C_DR"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id CDR
  calculation deadLoadOutputReturn
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.5" }
  formula { display "C_DR = (minimum test load indication₂ − minimum test load indication₁) / f" expression "(min_test_load_indication_2 - min_test_load_indication_1) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol c_hmax {
  name "Humidity effect on max load output"
  definition "humidity effect on maximum test load output, expressed in terms of v"
  type number
  unit "v"
  latex "C_Hmax"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id CHmax
  calculation humidityCHmax
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.7" }
  formula { display "C_Hmax = [(indication at D_max − indication at D_min)after − (indication at D_max − indication at D_min)before] / f" expression "((ind_dmax_after - ind_dmin_after) - (ind_dmax_before - ind_dmin_before)) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol c_hmin {
  name "Humidity effect on min load output"
  definition "humidity effect on minimum test load output, expressed in terms of v"
  type number
  unit "v"
  latex "C_Hmin"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id CHmin
  calculation humidityCHmin
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.7" }
  formula { display "C_Hmin = [(indication at D_min)after − (indication at D_min)before] / f" expression "(ind_dmin_after - ind_dmin_before) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol c_m {
  name "Temperature effect on MDLO"
  definition "temperature effect on minimum dead load output, expressed in terms of v"
  type number
  unit "v"
  latex "C_M"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id CM
  calculation temperatureMDLO
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.4" }
  formula { display "C_M = (average test indication at T₂ − average indication at T₁) / f" expression "(avg_test_indication_t2 - avg_indication_t1) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol c_m_vmin {
  name "Temperature effect on MDLO (mass units)"
  definition "temperature effect on minimum dead load output, expressed in terms of v_min per 5 °C for class B, C and D or per 2 °C for class A"
  type number
  unit "g, kg, or t per degC"
  latex "C_M(v_min)"
  kind observable
  origin derived
  legacy_id CM-vmin
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.4" }
  formula { display "C_M(v_min) = (average test indication at T₂ − average indication at T₁) / f, expressed per temperature increment" expression "(avg_test_indication_t2 - avg_indication_t1) / conversion_factor_f" inputs { conversion_factor_f v_min } }
}
symbol t_f {
  name "Temperature normalization factor"
  definition "temperature normalization factor T_f for the MDLO temperature effect: 5 for class B, C and D load cells, 2 for class A — bound from the temperature_increment profile by accuracy class"
  type integer
  unit "°C"
  latex "T_f"
  kind observable
  quantity_kind temperature
  origin lookup
  calculation lookupProfile
  profile temperature_increment
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.4" }
}
symbol delta_t {
  name "Temperature step span"
  definition "temperature difference (T_2 − T_1) of one MDLO test step, over which the change C_M is measured before normalization by T_f"
  type number
  unit "°C"
  latex "ΔT"
  kind observable
  quantity_kind temperature
  origin derived
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.4" }
}
symbol c_p {
  name "Barometric pressure effect"
  definition "barometric pressure effect, expressed in terms of v"
  type number
  unit "v"
  latex "C_P"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id CP
  calculation barometricPressureEffect
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.6" }
  formula { display "C_P = (indication at P₂ − indication at P₁) / f" expression "(indication_p2 - indication_p1) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol c_p_vmin {
  name "Barometric pressure effect (mass units)"
  definition "barometric pressure effect, expressed in terms of mass (g, kg, t) per kPa"
  type number
  unit "g, kg, or t per kPa"
  latex "C_P(v_min)"
  kind observable
  origin derived
  legacy_id CP-vmin
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.6" }
  formula { display "C_P(v_min) = (indication at P₂ − indication at P₁) / f, expressed in mass per kPa" expression "(indication_p2 - indication_p1) / conversion_factor_f" inputs { conversion_factor_f v_min } }
}
symbol delta_p {
  name "Barometric pressure step"
  definition "barometric pressure difference (P_2 − P_1) of one test step, over which the change C_P is measured before normalization per kPa"
  type number
  unit "kPa"
  latex "ΔP"
  kind observable
  quantity_kind pressure
  origin derived
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.6" }
}
symbol load {
  name "Load"
  definition "load m, expressed in verification units v — the independent variable of the MPE tier function (R 60-1, 5.3.1, Table 4); bound per test-load point at verdict time, never a sample-level fact (the MPE-equality requirements are definitional)"
  type number
  unit "v"
  latex "m"
  kind observable
  quantity_kind verification_interval
  origin measured
  legacy_id m
  source { doc "urn:oiml:pub:r:60-1:2021" clause "5.3.1" }
}
symbol dr {
  name "Minimum dead load output return (mass)"
  definition "minimum dead load output return, expressed in mass units (g, kg, t)"
  type number
  unit "g, kg, or t"
  latex "DR"
  kind attribute
  quantity_kind mass
  origin derived
  legacy_id DR
  attribute dr
  calculation deadLoadReturnMass
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.10" }
  formula { display "DR = (E_max − E_min) × C_DR / n_LC" expression "(e_max - e_min) * c_dr / n_lc" inputs { e_max e_min c_dr n_lc } }
}
symbol e_l {
  name "Load cell error"
  definition "load cell error, expressed in terms of v"
  type number
  unit "v"
  latex "E_L"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id EL
  calculation loadCellError
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.2" }
  formula { display "E_L = (average test indication − reference indication) / f" expression "(avg_test_indication - reference_indication) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol e_r {
  name "Repeatability error"
  definition "repeatability error, expressed in terms of v"
  type number
  unit "v"
  latex "E_R"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id ER
  calculation repeatabilityError
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.3" }
  formula { display "E_R = (maximum indication − minimum indication) / f" expression "(max_indication - min_indication) / conversion_factor_f" inputs { conversion_factor_f } }
}
symbol e_c {
  name "Corrected error prior to rounding"
  definition "corrected error prior to rounding via the changeover point (P = I + ½v − ΔL, E = P − L, E_c = E − E_0), for digital load cells with an output interval > 0.20 v, expressed in terms of v"
  type number
  unit "v"
  latex "E_c"
  kind observable
  quantity_kind verification_interval
  origin derived
  legacy_id EC
  calculation digitalChangeoverError
  source { doc "urn:oiml:pub:r:60-2:2021" clause "2.10.7.2" }
}
symbol conversion_factor_f {
  name "Conversion factor"
  definition "conversion factor, number of indicated units per verification interval, v"
  type number
  unit "counts/v"
  latex "f"
  kind attribute
  origin derived
  legacy_id f
  attribute conversion_factor_f
  calculation conversionFactor
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.2.4" }
  formula { display "f = (average indication at 0.75 × (D_max − D_min) − indication at D_min) / (0.75 × n)" expression "(indication_at_075_load - indication_at_dmin) / (0.75 * n)" inputs { d_max d_min n } }
  note "Use with initial 20 °C ascending load run only. Refer to R 60-2, 2.8.2."
}
symbol r_i {
  name "Reference indication"
  definition "reference indication (net test load), expressed in indication units"
  type number
  unit "indication units"
  latex "R_i"
  kind observable
  origin derived
  legacy_id Ri
  calculation referenceIndication
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.2.6" }
  formula { display "R_i = [(test load − D_min) / (D_max − D_min)] × n × f" expression "((test_load - d_min) / (d_max - d_min)) * n * conversion_factor_f" inputs { d_max d_min n conversion_factor_f } }
}
symbol y {
  name "Relative v_min"
  definition "relative v_min, Y = (E_max − E_min) / v_min"
  type number
  unit "dimensionless"
  latex "Y"
  kind formula
  quantity_kind dimensionless
  origin derived
  legacy_id Y
  attribute y
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.15" }
  formula { display "Y = (E_max − E_min) / v_min" expression "(e_max - e_min) / v_min" inputs { e_max e_min v_min } }
}
symbol z {
  name "Relative DR"
  definition "relative DR, Z = (E_max − E_min) / (2 × DR)"
  type number
  unit "dimensionless"
  latex "Z"
  kind formula
  quantity_kind dimensionless
  origin derived
  legacy_id Z
  attribute z
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.14" }
  formula { display "Z = (E_max − E_min) / (2 × DR)" expression "(e_max - e_min) / (2 * dr)" inputs { e_max e_min dr } }
}
symbol mr {
  name "Load cell measuring range"
  definition "load cell measuring range (for verification): range between the maximum load of the measuring range D_max and the minimum load of the measuring range D_min"
  type number
  unit "g, kg, or t"
  latex "MR"
  kind formula
  quantity_kind mass
  origin derived
  attribute mr
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.2" }
  formula { display "MR = D_max − D_min" expression "d_max - d_min" inputs { d_max d_min } }
}
symbol d_max {
  name "Maximum test load"
  definition "maximum test load"
  type number
  unit "g, kg, or t"
  latex "D_max"
  kind attribute
  quantity_kind mass
  origin declared
  legacy_id Dmax
  attribute d_max
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.6" }
}
symbol d_min {
  name "Minimum test load"
  definition "minimum test load"
  type number
  unit "g, kg, or t"
  latex "D_min"
  kind attribute
  quantity_kind mass
  origin declared
  legacy_id Dmin
  attribute d_min
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.12" }
}
symbol e_max {
  name "Maximum capacity"
  definition "maximum capacity of the load cell"
  type number
  unit "g, kg, or t"
  latex "E_max"
  kind attribute
  quantity_kind mass
  origin declared
  legacy_id Emax
  attribute e_max
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.5" }
}
symbol e_min {
  name "Minimum dead load"
  definition "minimum dead load of the load cell"
  type number
  unit "g, kg, or t"
  latex "E_min"
  kind attribute
  quantity_kind mass
  origin declared
  legacy_id Emin
  attribute e_min
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.9" }
}
symbol n {
  name "Number of verification intervals"
  definition "number of load cell verification intervals into which the load cell measuring range is divided"
  type integer
  latex "n"
  kind formula
  origin derived
  legacy_id n
  attribute n
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.13" }
  formula { display "n = (E_max − E_min) / v" expression "(e_max - e_min) / v" inputs { e_max e_min v } }
}
symbol n_lc {
  name "Maximum verification intervals"
  definition "maximum number of load cell verification intervals"
  type integer
  latex "n_LC"
  kind attribute
  origin declared
  legacy_id nLC
  attribute n_lc
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.8" }
}
symbol p_lc {
  name "Apportionment factor"
  definition "apportionment factor"
  type number
  unit "dimensionless"
  latex "p_LC"
  kind attribute
  quantity_kind dimensionless
  origin declared
  legacy_id pLC
  attribute p_lc
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.7.2" }
}
symbol v {
  name "Verification interval"
  definition "load cell verification interval"
  type number
  latex "v"
  kind attribute
  origin declared
  legacy_id v
  attribute v
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.4" }
}
symbol v_min {
  name "Minimum verification interval"
  definition "minimum load cell verification interval"
  type number
  unit "g, kg, or t"
  latex "v_min"
  kind attribute
  quantity_kind mass
  origin declared
  legacy_id vmin
  attribute v_min
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.5.11" }
}
symbol mpe {
  name "Maximum permissible error"
  definition "maximum permissible error"
  type number
  unit "v"
  latex "MPE"
  kind formula
  quantity_kind verification_interval
  origin lookup
  legacy_id MPE
  attribute mpe
  calculation mpe
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.7.10" }
}
symbol t_0 {
  name "Initial time"
  definition "time t_0 = 0 min when the initial indication at minimum test load is measured"
  type number
  unit "min"
  latex "t_0"
  kind observable
  quantity_kind time
  origin measured
  legacy_id t0
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.5" }
}
symbol t {
  name "Elapsed time"
  definition "time over the 30 minute creep test period after the initial indication (t_0 = 0 min) at minimum test load"
  type number
  unit "min"
  latex "t"
  kind observable
  quantity_kind time
  origin measured
  legacy_id t
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.5" }
}
symbol t_1 {
  name "Temperature 1"
  definition "temperature 1"
  type number
  unit "°C"
  latex "T_1"
  kind observable
  quantity_kind temperature
  origin measured
  legacy_id T1
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.4.2" }
}
symbol t_2 {
  name "Temperature 2"
  definition "temperature 2"
  type number
  unit "°C"
  latex "T_2"
  kind observable
  quantity_kind temperature
  origin measured
  legacy_id T2
  source { doc "urn:oiml:pub:r:60-3:2021" clause "2.1.4.2" }
}
symbol span_variation {
  name "Span variation"
  definition "variation of the load cell span measurement results over the span stability test duration (no R 60 letter symbol)"
  type number
  unit "v"
  latex "Δspan"
  kind observable
  quantity_kind verification_interval
  origin derived
  source { doc "urn:oiml:pub:r:60-1:2021" clause "5.7.2.6" }
}
symbol fault {
  name "Disturbance fault"
  definition "difference between the load cell output due to a disturbance and the output without disturbance (R 60-3, 2.1.9 \"difference\"); significant when exceeding v_min (R 60-1, 5.7.1.1 NOTE)"
  type number
  unit "v"
  latex "fault"
  kind observable
  quantity_kind verification_interval
  origin derived
  source { doc "urn:oiml:pub:r:60-1:2021" clause "5.7.2.5" }
}
calculation conversionFactor {
  name "conversionFactor"
  identifier "/calc/conversion-factor"
  category metrological
  description "Computes the conversion factor f per R 60-3 2.1.2.4"
  inputs {
    avgIndicationAt75pct : number { unit "counts" description "Average indication at 75% of Max" }
    indicationAtDmin : number { unit "counts" description "Indication at minimum test load" }
    n : integer { unit "1" description "Number of verification intervals of the measuring range under test" }
  }
  output : number { unit "counts/v" name "conversion_factor_f" description "Conversion factor from counts to verification units" }
  expression "ocl{(avgIndicationAt75pct - indicationAtDmin) / (0.75 * n)}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.4"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.4"
}
calculation vMin {
  name "vMin"
  identifier "/calc/v-min"
  category metrological
  description "Computes verification interval v_min per R 60-1, 3.5.11"
  inputs {
    d_max : number { unit "g, kg, or t" description "Maximum test load D_max" }
    d_min : number { unit "g, kg, or t" description "Minimum test load D_min" }
    n_lc : integer { unit "1" description "Number of verification intervals" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor" }
  }
  output : number { unit "g, kg, or t" name "v_min" description "Minimum verification interval" }
  expression "ocl{(d_max - d_min) / (n_lc * conversion_factor_f)}"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.11"
}
calculation mpe {
  name "mpe"
  identifier "/calc/mpe"
  category metrological
  description "Looks up MPE for a given load in v units per R 60-1 Table 4"
  inputs {
    load : number { unit "v" description "Test load in verification units" }
    accuracy_class : enum { unit "1" description "Accuracy class" enum_values { A B C D } }
    p_lc : number { unit "dimensionless" description "Apportioning factor" }
  }
  output : number { unit "v" name "mpe" description "Maximum permissible error at this load" }
  expression "ocl{lookupMPE(load, accuracy_class, p_lc)}"
  ref derives-from "urn:oiml:pub:r:60-1:2021#table-4"
}
calculation loadCellError {
  name "loadCellError"
  identifier "/calc/load-cell-error"
  category metrological
  description "Load cell error: E_L = (I - I_ref) / f"
  inputs {
    avgIndication : number { unit "counts" description "Average indication reading" }
    referenceIndication : number { unit "counts" description "Reference indication value" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor f" }
  }
  output : number { unit "v" name "e_l" description "Load cell error in verification units" }
  expression "ocl{(avgIndication - referenceIndication) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.1"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.3"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.4"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.5"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.6"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.7"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.8"
}
calculation repeatabilityError {
  name "repeatabilityError"
  identifier "/calc/repeatability-error"
  category metrological
  description "Repeatability error: E_R = (max - min) / f across runs"
  inputs {
    indications : collection { unit "1" description "Collection of indication readings across runs" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor f" }
  }
  output : number { unit "v" name "e_r" description "Repeatability error in verification units" }
  expression "ocl{(indications->max() - indications->min()) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.3"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.3"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.3.1"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.3.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.3.3"
}
calculation creep {
  name "creep"
  identifier "/calc/creep"
  category metrological
  description "Creep: C_C = (I_t - I_0) / f"
  inputs {
    indicationAtTime : number { unit "counts" description "Indication at time t" }
    initialIndication : number { unit "counts" description "Initial indication at D_max (t=0)" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor f" }
  }
  output : number { unit "v" name "c_c" description "Creep change in verification units" }
  expression "ocl{(indicationAtTime - initialIndication) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.1"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.3"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.4"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.5"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.6"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.7"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.8"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.9"
}
calculation deadLoadOutputReturn {
  name "deadLoadOutputReturn"
  identifier "/calc/dead-load-return"
  category metrological
  description "Dead load output return: DR = (I_min2 - I_min1) / f"
  inputs {
    minLoadIndication2 : number { unit "counts" description "Final indication at D_min after test" }
    minLoadIndication1 : number { unit "counts" description "Initial indication at D_min before test" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor f" }
  }
  output : number { unit "v" name "c_dr" description "Dead load output return in verification units" }
  expression "ocl{(minLoadIndication2 - minLoadIndication1) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.4"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5.4"
}
calculation barometricPressureEffect {
  name "barometricPressureEffect"
  identifier "/calc/barometric-effect"
  category metrological
  description "Barometric pressure effect: C_P = (I_2 - I_1) / f"
  inputs {
    indication2 : number { unit "counts" description "Indication at second pressure" }
    indication1 : number { unit "counts" description "Indication at first pressure" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor f" }
  }
  output : number { unit "v" name "change_v" description "Pressure-induced change in verification units" }
  expression "ocl{(indication2 - indication1) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.6"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.6"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.6.1"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.6.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.6.3"
}
calculation temperatureMDLO {
  name "temperatureMDLO"
  identifier "/calc/temperature-mdlo"
  category metrological
  description "Temperature effect on MDLO per 5 degC increment"
  inputs {
    indication2 : number { unit "counts" description "Indication at second temperature" }
    indication1 : number { unit "counts" description "Indication at first temperature" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor f" }
    temperature2 : number { unit "degC" description "Second temperature" }
    temperature1 : number { unit "degC" description "First temperature" }
  }
  output : number { unit "v" name "change_per_5deg" description "MDLO change per 5 degC in verification units" }
  expression "ocl{((indication2 - indication1) / conversion_factor_f) * 5 / abs(temperature2 - temperature1)}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.4"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.4"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.4.1"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.4.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.4.3"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.4.4"
}
calculation mdloStepChange {
  name "mdloStepChange"
  identifier "/calc/mdlo-step-change"
  category metrological
  description "Raw temperature effect on MDLO of one temperature step: C_M = (I_2 - I_1) / f, in v — BEFORE the T_f/(T_2-T_1) normalization and the v to v_min conversion (those live exactly once in the mdlo_normalized VerdictQuantity; the normalized per-5 degC form is temperatureMDLO). The honest close of the mdlo test's c_m variable, which previously had no named registry entry (PROPOSAL.R60-SSOT-Phase9.5 item 4, Response 4 item 4)."
  inputs {
    indication2 : number { unit "counts" description "Indication at second temperature" }
    indication1 : number { unit "counts" description "Indication at first temperature" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor f" }
  }
  output : number { unit "v" name "c_m" description "Raw MDLO step change in verification units" }
  expression "ocl{(indication2 - indication1) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.4.2"
}
calculation humidityCHmin {
  name "humidityCHmin"
  identifier "/calc/humidity-chmin"
  category metrological
  description "Humidity effect on minimum load output (CH cyclic): C_Hmin"
  inputs {
    indDminAfter : number { unit "counts" description "Average D_min indication after humidity exposure" }
    indDminBefore : number { unit "counts" description "Average D_min indication before humidity exposure" }
    conversion_factor_f : number { unit "counts/v" }
  }
  output : number { unit "v" name "c_hmin" }
  expression "ocl{(indDminAfter - indDminBefore) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7.1"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7.3"
}
calculation humidityCHmax {
  name "humidityCHmax"
  identifier "/calc/humidity-chmax"
  category metrological
  description "Humidity effect on span (CH cyclic): C_Hmax"
  inputs {
    avgDmaxAfter : number { unit "counts" }
    avgDminAfter : number { unit "counts" }
    avgDmaxBefore : number { unit "counts" }
    avgDminBefore : number { unit "counts" }
    conversion_factor_f : number { unit "counts/v" }
  }
  output : number { unit "v" name "c_hmax" }
  expression "ocl{((avgDmaxAfter - avgDminAfter) - (avgDmaxBefore - avgDminBefore)) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7.1"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7.2"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.7.3"
}
calculation maxAllowableSpanVariation {
  name "maxAllowableSpanVariation"
  identifier "/calc/max-allowable-span-variation"
  category electronic
  description "Maximum allowable span variation: max(0.5, 0.5 × |MPE|) with p_LC = 1.0"
  inputs {
    d_max : number { unit "1" description "Maximum test load" }
    accuracy_class : enum { unit "1" enum_values { A B C D } }
  }
  output : number { unit "v" name "maxVariation" description "Maximum allowable variation" }
  expression "ocl{max(0.5, 0.5 * abs(lookupMPE(d_max, accuracy_class, 1.0)))}"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.2.6"
}
calculation electronicDifference {
  name "electronicDifference"
  identifier "/calc/electronic-difference"
  category electronic
  description "Electronic disturbance difference between with/without readings"
  inputs {
    indicationWith : number { unit "counts" description "Indication with disturbance" }
    indicationWithout : number { unit "counts" description "Indication without disturbance" }
    conversion_factor_f : number { unit "counts/v" }
  }
  output : number { unit "v" name "difference" }
  expression "ocl{(indicationWith - indicationWithout) / conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.2"
}
calculation significantFault {
  name "significantFault"
  identifier "/calc/significant-fault"
  category electronic
  description "Determines if an electronic disturbance causes a significant fault (difference exceeds one verification interval, 1 v — the R 60-1, 5.7.1.1 NOTE v_min threshold expressed in the test's v units; R 60-3 forms print the difference column in v against a '> v_min' criterion)"
  inputs {
    difference : number { unit "v" description "Observed difference in verification units" }
  }
  output : boolean { unit "1" name "isSignificant" description "Whether the fault exceeds one verification interval" }
  expression "ocl{abs(difference) > 1}"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-5.7.1.1"
}
calculation deadLoadReturnMass {
  name "deadLoadReturnMass"
  identifier "/calc/dead-load-return-mass"
  category metrological
  description "Dead load output return in mass units: DR = (E_max − E_min) × C_DR / n_LC"
  inputs {
    e_max : number { unit "g, kg, or t" description "Maximum capacity E_max" }
    e_min : number { unit "g, kg, or t" description "Minimum dead load E_min" }
    c_dr : number { unit "v" description "Dead load output return C_DR in verification units" }
    n_lc : integer { unit "1" description "Maximum number of verification intervals n_LC" }
  }
  output : number { unit "g, kg, or t" name "dr" description "Dead load output return in mass units" }
  expression "ocl{(e_max - e_min) * c_dr / n_lc}"
  ref derives-from "urn:oiml:pub:r:60-1:2021#clause-3.5.10"
}
calculation referenceIndication {
  name "referenceIndication"
  identifier "/calc/reference-indication"
  category metrological
  description "Reference indication (net test load): R_i = [(test load − D_min) / (D_max − D_min)] × n × f"
  inputs {
    testLoad : number { unit "g, kg, or t" description "Applied test load" }
    d_min : number { unit "g, kg, or t" description "Minimum test load D_min" }
    d_max : number { unit "g, kg, or t" description "Maximum test load D_max" }
    n : integer { unit "1" description "Number of verification intervals" }
    conversion_factor_f : number { unit "counts/v" description "Conversion factor" }
  }
  output : number { unit "indication units" name "r_i" description "Reference indication in indication units" }
  expression "ocl{((testLoad - d_min) / (d_max - d_min)) * n * conversion_factor_f}"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.6"
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.2.6"
}
calculation digitalChangeoverError {
  name "digitalChangeoverError"
  identifier "/calc/digital-changeover-error"
  category metrological
  description "Error prior to rounding for digital load cells with an output interval > 0.20 v, via the changeover point: P = I + ½v − ΔL, E = P − L, E_c = E − E_0 (all inputs in v)"
  inputs {
    indication_v : number { unit "v" description "Digital output value I at the load, in v" }
    delta_l_v : number { unit "v" description "Additional load ΔL added until the output increases by one interval, in v" }
    test_load_v : number { unit "v" description "Applied load L, in v" }
    error_at_dmin_v : number { unit "v" description "Error E_0 at the minimum test load D_min, in v" }
  }
  output : number { unit "v" name "e_c" description "Corrected error prior to rounding, in v" }
  expression "ocl{indication_v + 0.5 - delta_l_v - test_load_v - error_at_dmin_v}"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.7.2"
}
calculation lookupMPE {
  name "lookupMPE"
  type table_lookup
  label "Maximum Permissible Error"
  description "Looks up MPE for a given load in v units per R 60-1 Table 4"
  output : number { unit "1" }
  params { load accuracy_class p_lc }
  lookup { key accuracy_class variable load multiplier p_lc }
  profile profiles.mpe_tiers
}
calculation lookupProfile {
  name "lookupProfile"
  type profile_lookup
  label "Dimension-keyed profile lookup"
  description "Returns the binding of a dimension-keyed profile from the profiles: section of tables.yaml for a classification dimension value, e.g. lookupProfile('n_LC_range', 'C') -> { min: 500, max: 10000 } and lookupProfile('min_temperature_span', 'A') -> 5. For range bindings a missing max means unbounded above."
  output : number { unit "1" }
  params { profile dimension_value }
  lookup { key dimension_value }
  profile profiles
}
verdict creep {
  symbol "C_C"
  behavior creep
  quantity { kind verification_interval unit "v" }
  derive "ocl{abs(c_c)}"
  inputs { c_c }
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.5"
}
verdict mdlo_normalized {
  symbol "C_M"
  behavior temp-effect-min-dead-load
  quantity { kind dimensionless }
  derive "ocl{abs(c_m * t_f / delta_t * (d_max - d_min) / (n * v_min))}"
  inputs { c_m t_f delta_t d_max d_min n v_min }
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.4"
}
verdict barometric_normalized {
  symbol "C_P"
  behavior barometric-effect
  quantity { kind dimensionless }
  derive "ocl{abs(c_p / delta_p * (e_max - e_min) / (n_lc * v_min))}"
  inputs { c_p delta_p e_max e_min n_lc v_min }
  ref derives-from "urn:oiml:pub:r:60-3:2021#clause-2.1.6"
}
competence_kind force_measurement {
  label "Force measurement"
  definition "Application and measurement of test loads over a force range with a force-generating system and a suitable indicating instrument (R 60-2, 2.7.2); the mass standards generating the force are traceable to national or international standards of mass (R 60-2, 2.7.3.2). The kind spans the deadweight machine / force standard machine and the load-application train — declared as a capability, never as named equipment (labs declare capabilities, not equipment)."
  source { doc "ISO/IEC 17025:2017, 6.4" clause "" }
}
competence_kind temperature_control {
  label "Temperature control"
  definition "Temperature conditioning of the instrument under test in a climatic chamber over the instrument's temperature range, held stable during a test within one fifth of that range and never more than 2 degC (R 60-2, 2.7.3.1)."
  source { doc "ISO/IEC 17025:2017, 6.4" clause "" }
}
competence_kind humidity_testing {
  label "Humidity testing"
  definition "Damp-heat exposure of the instrument under test: cyclic damp heat for CH-marked instruments (R 60-2, 2.10.5, applying IEC 60068-2-30 variant 2) or steady-state damp heat for SH-marked instruments (R 60-2, 2.10.6, applying IEC 60068-2-78)."
  source { doc "ISO/IEC 17025:2017, 6.4" clause "" }
  method_standard iec-60068-2-30 "Environmental testing — Part 2-30: Tests — Test Db: Damp heat, cyclic (12 h + 12 h cycle)"
  method_standard iec-60068-2-78 "Environmental testing — Part 2-78: Tests — Test Cab: Damp heat, steady state"
}
competence_kind pressure_control {
  label "Pressure control"
  definition "Barometric pressure variation for the determination of atmospheric pressure effects on the instrument's output (R 60-2, 2.10.4, verifying R 60-1, 5.6.2)."
  source { doc "ISO/IEC 17025:2017, 6.4" clause "" }
}
competence_kind emc_testing {
  label "EMC testing"
  definition "Electromagnetic disturbance immunity testing of electronic instruments: electrical fast transients/bursts, surges, electrostatic discharge, conducted and radiated radio-frequency electromagnetic disturbances (R 60-2, 2.10.7.6–2.10.7.10), each at the severity level the Recommendation's tables prescribe."
  source { doc "ISO/IEC 17025:2017, 6.4" clause "" }
  method_standard iec-61000-4-2 "Electromagnetic compatibility (EMC) — Part 4-2: Testing and measurement techniques — Electrostatic discharge immunity test"
  method_standard iec-61000-4-3 "Electromagnetic compatibility (EMC) — Part 4-3: Testing and measurement techniques — Radiated, radio-frequency, electromagnetic field immunity test"
  method_standard iec-61000-4-4 "Electromagnetic compatibility (EMC) — Part 4-4: Testing and measurement techniques — Electrical fast transient/burst immunity test"
  method_standard iec-61000-4-5 "Electromagnetic compatibility (EMC) — Part 4-5: Testing and measurement techniques — Surge immunity test"
  method_standard iec-61000-4-6 "Electromagnetic compatibility (EMC) — Part 4-6: Testing and measurement techniques — Immunity to conducted disturbances, induced by radio-frequency fields"
}
competence_kind power_supply_variation {
  label "Power supply variation"
  definition "Mains power supply variation and short-time power reduction testing of electronic instruments, AC and DC (R 60-2, 2.10.7.4–2.10.7.5), including the designed warm-up behaviour at power-on (R 60-2, 2.10.7.3)."
  source { doc "ISO/IEC 17025:2017, 6.4" clause "" }
  method_standard iec-61000-4-11 "Electromagnetic compatibility (EMC) — Part 4-11: Testing and measurement techniques — Voltage dips, short interruptions and voltage variations immunity tests"
  method_standard iec-61000-4-29 "Electromagnetic compatibility (EMC) — Part 4-29: Testing and measurement techniques — Voltage dips, short interruptions and voltage variations on d.c. input power port immunity tests"
}
competence_kind indication_readout {
  label "Indication readout"
  definition "Reading and recording of the instrument's output indication with a suitable indicating instrument of sufficient resolution over the measurement chain under test (R 60-2, 2.7.2)."
  source { doc "ISO/IEC 17025:2017, 6.4" clause "" }
}
competence_kind documentation_review {
  label "Documentation review"
  definition "Documentary examination of the type: the documentation supplied by the applicant, the suitability of the instrument's construction for its intended use, and its inscriptions and marking (R 60-2, 2.3–2.6) — a personnel review competence, not an equipment competence."
  source { doc "ISO/IEC 17025:2017, 6.2" clause "" }
}
competence_kind software_examination {
  label "Software examination"
  definition "Examination of the instrument's software and its documentation against the general requirements for software-controlled measuring instruments (R 60-2, 2.6, applying OIML D 31)."
  source { doc "ISO/IEC 17025:2017, 6.2" clause "" }
  method_standard oiml-d-31 "OIML D 31 General requirements for software-controlled measuring instruments"
}
constraint dead_load_max_geometry {
  stereotype inv
  name "Dead-load maximum geometry"
  check "ocl{model.parameters.d_max >= 0.9 * model.parameters.e_max and model.parameters.d_max <= model.parameters.e_max}"
  violation_meaning "The declared maximum test load D_max lies outside [0.9·E_max, E_max] — the test setup does not realize the upper end of the measuring range (R 60-2, 2.7.3.4: D_max shall be not less than 90 % of E_max, nor greater than E_max), so the type evaluation of this load cell is void."
  on_violation invalid
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.6" }
}
constraint dead_load_min_geometry {
  stereotype inv
  name "Dead-load minimum geometry"
  check "ocl{model.parameters.e_min <= model.parameters.d_min and model.parameters.d_min <= 0.1 * model.parameters.e_max}"
  violation_meaning "The declared minimum test load D_min lies outside [E_min, 0.1·E_max] — the test setup does not realize the lower end of the measuring range (R 60-2, 2.7.3.4: D_min shall be not less than E_min and not higher than 10 % of E_max), so the type evaluation of this load cell is void."
  on_violation invalid
  source { doc "urn:oiml:pub:r:60-1:2021" clause "3.6" }
}
discrepancy_record pd-02-vs-od-01-expert-review-cycle {
  status resolved
  summary "PD-02 Ed 3, 11.1 prescribes review of the on-going competence and suitability of experts \"at least once every four years\", citing OD-01, 13.4 (\"As outlined in OD-01, 13.4 [2]\"); OD-01 Ed 4, 13.4 prescribes review of the list of experts \"on a 3-yearly basis\" — the two official texts genuinely disagree."
  sources { "urn:oiml:pub:cs:pd-02:2022#clause-11.1" "urn:oiml:pub:cs:od-01:2022#clause-13.4" }
  resolution annotated_only
  rationale "RESOLVED AS A GENUINE SOURCE DISAGREEMENT (task 46): both official texts verified verbatim against the published PDFs on 2026-07-24 (reference-docs/cs/docs/). PD-02's \"as outlined in OD-01, 13.4\" misstates its target. Neither source governs: the pd-02 module keeps the four-year cycle (PD-02, 11.1), the od-01 module keeps the 3-yearly cycle (OD-01, 13.4) — both module headers record both texts; a CID-01 clarification candidate. Editorial note settled with it: OD-01, 13.4's own cross-reference \"In accordance with PD-02, 10.2 [11]\" is an error in OD-01 — the RC-advice discipline on continued suitability is PD-02, 11.3 (PD-02, 10.2 is scope extension)."
}
discrepancy_record d-32-g711-4-numbering-gap {
  status resolved
  summary "D 32:2018 Annex G's G.7.1.1 series skips G.7.1.1-4 (the printed sequence runs G.7.1.1-3 then G.7.1.1-5) — suspected as a conversion drop in the local presentation XML, verified as an editorial gap in the official printed document itself."
  sources { "urn:oiml:pub:d:32:2018#clause-G.7.1.1-3" "urn:oiml:pub:d:32:2018#clause-G.7.1.1-5" }
  resolution follows_clause_x
  governing "urn:oiml:pub:d:32:2018"
  rationale "The official printed D 32:2018 itself skips G.7.1.1-4 — an editorial gap in the source document, not a conversion drop (verified against reference-docs/oiml-d/d032-e18.pdf on 2026-07-24; task 46). The corpus cites the official body numbering as printed: G.7.1.1-1/-2/-3/-6, G.7.1.2-1, G.7.1.3-1 (all confirmed); no G.7.1.1-4 cite exists anywhere in the repo, and none should be added — the clause does not exist in the source."
}
discrepancy_record od-01-toc-vs-body-numbering {
  status resolved
  summary "OD-01 Ed 4's own printed Contents skips 7.2 (Obligations of Review Committee Members), so every TOC entry from 7.2 onward reads body-1 (TOC \"7.8 Review Committee Recommendations\" vs body 7.8 = Management Committee Voting) — the printed Contents disagrees with the body it indexes."
  sources { "urn:oiml:pub:cs:od-01:2022#contents" "urn:oiml:pub:cs:od-01:2022#clause-7.2" }
  resolution follows_clause_x
  governing "urn:oiml:pub:cs:od-01:2022#clause-7.2"
  rationale "The BODY numbering — which every internal cross-reference in the CS corpus uses (PD-02's \"OD-01, 13.4\"; the 7.8/7.9 gates) — is authoritative and is what the repo cites; the printed Contents' defect is an official-document defect, recorded here and in the od-01 module header (task 46; verified against reference-docs/cs/docs/oiml-cs-od-01-edition-4.pdf, retrieved 2026-07-24). The 7.6+ reconstruction is CONFIRMED against the body text."
}
state_machine Application {
  initial DRAFT
  states {
    DRAFT
    SUBMITTED
    SAMPLES_REQUESTED
    SAMPLES_RECEIVED
    UNDER_REVIEW
    ACCEPTED
    REJECTED
    CHANGES_REQUESTED
    WITHDRAWN
  }
  transition DRAFT -> SUBMITTED action submit {
  }
  transition SUBMITTED -> SAMPLES_REQUESTED action ia_requests_samples {
  }
  transition SAMPLES_REQUESTED -> SAMPLES_RECEIVED action ia_logs_samples {
  }
  transition SAMPLES_RECEIVED -> UNDER_REVIEW action ia_starts_review {
  }
  transition UNDER_REVIEW -> ACCEPTED action ia_accepts {
  }
  transition UNDER_REVIEW -> REJECTED action ia_rejects {
  }
  transition [SUBMITTED, SAMPLES_REQUESTED, SAMPLES_RECEIVED, UNDER_REVIEW] -> CHANGES_REQUESTED action ia_requests_changes {
  }
  transition CHANGES_REQUESTED -> UNDER_REVIEW action applicant_resubmits {
  }
  transition [SUBMITTED, SAMPLES_REQUESTED, SAMPLES_RECEIVED, UNDER_REVIEW, CHANGES_REQUESTED] -> WITHDRAWN action applicant_withdraws {
  }
}
state_machine TestRequest {
  initial DRAFT
  states {
    DRAFT
    ISSUED
    ACCEPTED_BY_LAB
    REJECTED_BY_LAB
    IN_PROGRESS
    COMPLETED
    WITHDRAWN
  }
  transition DRAFT -> ISSUED action ia_issues {
    cascade TestRequest {
      set {
        status: "ISSUED"
        issued_date: "now"
      }
    }
    cascade AuditEvent {
      action record
      with {
        entity_type: "testRequests"
        entity_id: "${this.id}"
        action: "issued"
        user_id: "user"
        basis: "IA issues the test request to the laboratory (PD-05 §4.3 dispatch) — declared transition side-effect (TODO.roadmap/52); actor/timestamp from the cascade context"
      }
    }
  }
  transition ISSUED -> ACCEPTED_BY_LAB action lab_accepts {
    cascade TestRequest {
      set {
        status: "ACCEPTED_BY_LAB"
        accepted_date: "now"
        accepted_by: "user"
      }
    }
  }
  transition ISSUED -> REJECTED_BY_LAB action lab_declines {
    cascade TestRequest {
      set {
        status: "REJECTED_BY_LAB"
      }
    }
  }
  transition ACCEPTED_BY_LAB -> IN_PROGRESS action lab_starts_testing {
    cascade TestRequest {
      set {
        status: "IN_PROGRESS"
        started_date: "now"
      }
    }
    cascade TestAssignment {
      where "test_request_id = ${this.id}"
      via start
      set {
        status: "IN_PROGRESS"
        started_date: "now"
      }
    }
  }
  transition IN_PROGRESS -> COMPLETED action lab_issues_test_report {
    cascade TestRequest {
      set {
        status: "COMPLETED"
        completed_date: "now"
      }
    }
    cascade TestReport {
      action submit
      where "test_request_id = ${this.id}"
      via lab_submits
    }
    cascade TestAssignment {
      where "test_request_id = ${this.id} AND status != OMITTED"
      via complete
      set {
        status: "COMPLETED"
        completed_date: "now"
      }
    }
  }
  transition [DRAFT, ISSUED] -> WITHDRAWN action ia_cancels {
    cascade TestRequest {
      set {
        status: "WITHDRAWN"
        withdrawn_date: "now"
      }
    }
    cascade TestAssignment {
      where "test_request_id = ${this.id} AND status != COMPLETED"
      via omit
      set {
        status: "OMITTED"
        omit_reason: "TR withdrawn"
      }
    }
  }
}
state_machine TestReport {
  initial DRAFT
  states {
    DRAFT
    SUBMITTED
    UNDER_REVIEW
    ACCEPTED
    REJECTED
  }
  transition DRAFT -> SUBMITTED action lab_submits {
    cascade TestReport {
      set {
        status: "SUBMITTED"
        submitted_date: "now"
      }
    }
    cascade FormInstance {
      action lock
      where "test_report_id = ${this.id} AND status != LOCKED"
      via test_report_issued
    }
  }
  transition SUBMITTED -> UNDER_REVIEW action ia_starts_review {
    cascade TestReport {
      set {
        status: "UNDER_REVIEW"
      }
    }
  }
  transition UNDER_REVIEW -> ACCEPTED action ia_accepts {
    cascade TestReport {
      set {
        status: "ACCEPTED"
      }
    }
  }
  transition UNDER_REVIEW -> REJECTED action ia_rejects {
    cascade TestReport {
      set {
        status: "REJECTED"
      }
    }
    cascade FormInstance {
      where "test_report_id = ${this.id} AND status = LOCKED"
      via ia_accepts
      set {
        status: "ACCEPTED"
      }
    }
  }
  transition SUBMITTED -> DRAFT action lab_withdraws_for_edit {
    cascade TestReport {
      set {
        status: "DRAFT"
      }
    }
    cascade FormInstance {
      where "test_report_id = ${this.id} AND status = LOCKED"
      via test_report_recalled
      set {
        status: "SUBMITTED"
      }
    }
  }
  transition UNDER_REVIEW -> DRAFT action ia_returns_to_lab {
    cascade TestReport {
      set {
        status: "DRAFT"
      }
    }
    cascade FormInstance {
      where "test_report_id = ${this.id} AND status = LOCKED"
      via test_report_recalled
      set {
        status: "SUBMITTED"
      }
    }
  }
}
state_machine FormInstance {
  initial DRAFT
  states {
    DRAFT
    IN_PROGRESS
    SUBMITTED
    LOCKED
    ACCEPTED
    REJECTED
  }
  transition DRAFT -> IN_PROGRESS action lab_starts_filling {
  }
  transition [DRAFT, IN_PROGRESS] -> SUBMITTED action lab_submits_with_report {
  }
  transition SUBMITTED -> LOCKED action test_report_issued {
  }
  transition LOCKED -> SUBMITTED action test_report_recalled {
  }
  transition LOCKED -> ACCEPTED action ia_accepts {
  }
  transition LOCKED -> REJECTED action ia_rejects {
  }
  transition ACCEPTED -> LOCKED action ia_reopens {
  }
  transition [IN_PROGRESS, SUBMITTED] -> DRAFT action run_redone {
  }
}
state_machine EvaluationReport {
  initial DRAFT
  states {
    DRAFT
    IN_REVIEW
    ALL_TR_REVIEWED
    APPROVED
    REJECTED
    CONDITIONALLY_APPROVED
  }
  transition DRAFT -> IN_REVIEW action ia_opens_first_tr {
  }
  transition IN_REVIEW -> ALL_TR_REVIEWED action last_tr_determined {
  }
  transition ALL_TR_REVIEWED -> APPROVED action ia_approves {
    cascade EvaluationReport {
      set {
        overall_decision: "APPROVED"
      }
    }
  }
  transition ALL_TR_REVIEWED -> REJECTED action ia_rejects {
    cascade EvaluationReport {
      set {
        overall_decision: "REJECTED"
      }
    }
  }
  transition ALL_TR_REVIEWED -> CONDITIONALLY_APPROVED action ia_approves_with_conditions {
    cascade EvaluationReport {
      set {
        overall_decision: "CONDITIONALLY_APPROVED"
      }
    }
  }
  transition [APPROVED, REJECTED, CONDITIONALLY_APPROVED] -> IN_REVIEW action ia_reopens {
    cascade EvaluationReport {
      set {
        overall_decision: "PENDING"
      }
    }
  }
}
state_machine Certificate {
  initial DRAFT
  states {
    DRAFT
    PENDING_REGISTRATION
    ACTIVE
    EXPIRED
    WITHDRAWN
    SUSPENDED
    UNDER_INVESTIGATION
  }
  transition DRAFT -> PENDING_REGISTRATION action submit {
  }
  transition PENDING_REGISTRATION -> ACTIVE action register {
  }
  transition ACTIVE -> EXPIRED action expire {
  }
  transition ACTIVE -> WITHDRAWN action withdraw {
  }
  transition ACTIVE -> SUSPENDED action suspend {
  }
  transition SUSPENDED -> ACTIVE action reinstate {
  }
  transition SUSPENDED -> WITHDRAWN action withdraw {
  }
  transition ACTIVE -> UNDER_INVESTIGATION action investigate {
  }
  transition UNDER_INVESTIGATION -> ACTIVE action clear {
  }
  transition UNDER_INVESTIGATION -> SUSPENDED action suspend {
  }
  transition UNDER_INVESTIGATION -> WITHDRAWN action withdraw {
  }
  transition [ACTIVE, EXPIRED] -> PENDING_REGISTRATION action renew {
  }
  transition [ACTIVE, EXPIRED] -> PENDING_REGISTRATION action revise {
  }
  transition [ACTIVE, EXPIRED] -> PENDING_REGISTRATION action transfer_ownership {
  }
}
state_machine TestAssignment {
  initial PENDING
  states {
    PENDING
    ACCEPTED
    IN_PROGRESS
    COMPLETED
    OMITTED
    FAILED
  }
  transition PENDING -> ACCEPTED action lab_accepts {
    cascade TestAssignment {
      set {
        accepted_date: "now"
      }
    }
  }
  transition [PENDING, ACCEPTED] -> IN_PROGRESS action start {
    cascade TestAssignment {
      set {
        started_date: "now"
      }
    }
  }
  transition [PENDING, ACCEPTED, IN_PROGRESS] -> COMPLETED action complete {
    cascade TestAssignment {
      set {
        completed_date: "now"
      }
    }
  }
  transition IN_PROGRESS -> FAILED action invalidate {
    cascade TestAssignment {
      set {
        completed_date: "now"
      }
    }
  }
  transition FAILED -> IN_PROGRESS action redo {
  }
  transition [PENDING, ACCEPTED, IN_PROGRESS, FAILED] -> OMITTED action omit {
  }
}
state_machine TestRun {
  initial PLANNED
  states {
    PLANNED
    IN_PROGRESS
    COMPLETED
    INVALIDATED
  }
  transition PLANNED -> IN_PROGRESS action record_evidence {
  }
  transition [PLANNED, IN_PROGRESS] -> COMPLETED action complete {
    guard "admissible"
    cascade FormInstance {
      where "id = ${this.form_instance_id} AND status != SUBMITTED"
      via lab_submits_with_report
      set {
        status: "SUBMITTED"
        result: "PASS"
        submitted_at: "now"
        modified: "now"
      }
    }
    cascade TestAssignment {
      where "id = ${this.test_assignment_id}"
      via complete
      set {
        status: "COMPLETED"
        completed_date: "now"
        form_instance_id: "${this.form_instance_id}"
      }
    }
  }
  transition [PLANNED, IN_PROGRESS] -> INVALIDATED action invalidate {
    cascade TestAssignment {
      where "id = ${this.test_assignment_id}"
      via invalidate
      set {
        status: "FAILED"
        completed_date: "now"
      }
    }
  }
  transition INVALIDATED -> PLANNED action redo {
    cascade TestAssignment {
      where "id = ${this.test_assignment_id} AND status = FAILED"
      via redo
      set {
        status: "IN_PROGRESS"
      }
    }
    cascade FormInstance {
      where "id = ${this.form_instance_id} AND status != DRAFT"
      via run_redone
      set {
        status: "DRAFT"
        modified: "now"
      }
    }
  }
}
