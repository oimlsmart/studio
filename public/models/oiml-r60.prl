  method "Apply increasing/decreasing test loads at four temperatures. 5 identical load applications per load point."
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1"
  ref derives-from "urn:oiml:pub:r:60-2:2021#clause-2.10.1"
